# AProf local scratch space and benchmark runtime artifacts.
tmp/*
!tmp/.gitkeep
benchmarks/aprof_benchmark/**/build/
benchmarks/aprof_benchmark/**/build_sim/
benchmarks/aprof_benchmark/**/data/
benchmarks/aprof_benchmark/**/output/
benchmarks/aprof_benchmark/**/msprof_sim_output/
benchmarks/aprof_benchmark/**/msprof_hw_output/
benchmarks/aprof_benchmark/**/PROF_*/
benchmarks/aprof_benchmark/**/OPPROF_*/
benchmarks/aprof_benchmark/**/mindstudio_profiler_log/
benchmarks/aprof_benchmark/**/mindstudio_profiler_output/
benchmarks/aprof_benchmark/**/*.db

# CANNBench keeps source projects and compact validation summaries in Git, but
# generated binaries, case payloads, local tool links, and profiling trees stay local.
benchmarks/cannbench/**/build*/
benchmarks/cannbench/**/data/
benchmarks/cannbench/**/results/
benchmarks/cannbench/**/docs/perf/
benchmarks/cannbench/.opencode/
benchmarks/cannbench/AGENTS.md
benchmarks/cannbench/asc-devkit
third_party/cann-bench/

# Remote SSH credentials (use server_config.example.json as template)
scripts/server_config.json
scripts/run_remote_fast_gelu_inject.py
scripts/run_remote_fast_gelu_inject_sim.py
benchmarks/reference_ops/fast_gelu/scripts/run_remote.py
benchmarks/reference_ops/fast_gelu/scripts/run_remote_profile_only.py
