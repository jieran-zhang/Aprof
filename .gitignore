# CANNBench keeps source projects and compact validation summaries in Git, but
# generated binaries, case payloads, local tool links, and profiling trees stay local.
scaffolding/benchmarks/cannbench/**/build*/
scaffolding/benchmarks/cannbench/**/data/
scaffolding/benchmarks/cannbench/**/results/
scaffolding/benchmarks/cannbench/**/docs/perf/
scaffolding/benchmarks/cannbench/.opencode/
scaffolding/benchmarks/cannbench/AGENTS.md
scaffolding/benchmarks/cannbench/asc-devkit
scaffolding/third_party/cann-bench/

# Remote SSH credentials (use server_config.example.json as template)
**/server_config.json
scaffolding/collection/scripts/run_remote_fast_gelu_inject.py
scaffolding/collection/scripts/run_remote_fast_gelu_inject_sim.py
scaffolding/benchmarks/reference_ops/fast_gelu/scripts/run_remote.py
scaffolding/benchmarks/reference_ops/fast_gelu/scripts/run_remote_profile_only.py

# Version-local installations and evidence payloads remain untracked.
**/.runtime-env/
scaffolding/evidence/external/

