{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/gate-outcome.schema.json",
  "title": "AProf machine GateOutcome 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "verdict", "state_path", "baseline_median_ns", "candidate_median_ns", "speedup", "speedup_lcb", "pair_count", "measurement_protocol", "measurement_cv", "utility", "eligible", "policy_update_eligible", "selected_as_best", "reasons", "decision_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string"},
    "verdict": {"enum": ["verified_noop", "static_rejected", "build_failed", "accuracy_failed", "runtime_failed", "artifacts_incomplete", "measurement_unstable", "attribution_uncertain", "stable_no_gain", "benchmark_specialized_gain", "heldout_regression", "production_safe_gain"]},
    "state_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline_median_ns": {"type": "number", "minimum": 0},
    "candidate_median_ns": {"type": "number", "minimum": 0},
    "speedup": {"type": "number", "minimum": 0},
    "speedup_lcb": {"type": "number", "minimum": 0},
    "pair_count": {"type": "integer", "minimum": 0},
    "measurement_protocol": {"enum": ["paired_log_speedup_deterministic_bootstrap_lcb_v1", "no_mutation_source_identity_v1"]},
    "measurement_cv": {"type": "number", "minimum": 0},
    "utility": {"type": "number"},
    "eligible": {"type": "boolean"},
    "policy_update_eligible": {"type": "boolean"},
    "selected_as_best": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "decision_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
