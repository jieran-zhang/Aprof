#include "kernel_operator.h"
#include "apply_adam_w_tiling.h"

union ApplyAdamWFloatBits {
    uint32_t bits;
    float value;
};

// CompareScalar count for FP32 must occupy a 256-byte multiple, hence AlignUp(valid, 64).
__aicore__ inline uint32_t ApplyAdamWCompareCount(uint32_t validCount)
{
    return ((validCount + 63U) / 64U) * 64U;
}

// Sqrt does not define non-positive inputs. Feed it only strictly-positive values,
// then restore sqrt(0)=0 and negative/NaN -> quiet NaN with Select mode 1.
__aicore__ inline void ApplyAdamWSafeSqrt(
    AscendC::LocalTensor<float> out, AscendC::LocalTensor<float> original,
    AscendC::LocalTensor<float> scratch, AscendC::LocalTensor<uint8_t> mask,
    uint32_t validCount, float quietNan)
{
    const uint32_t compareCount = ApplyAdamWCompareCount(validCount);
    AscendC::CompareScalar(mask, original, 0.0f, AscendC::CMPMODE::GT, compareCount);
    AscendC::Select(scratch, mask, original, 1.0f,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
    AscendC::Sqrt(out, scratch, validCount);
    AscendC::CompareScalar(mask, original, 0.0f, AscendC::CMPMODE::NE, compareCount);
    AscendC::Select(out, mask, out, 0.0f,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
    AscendC::CompareScalar(mask, original, 0.0f, AscendC::CMPMODE::GE, compareCount);
    AscendC::Select(out, mask, out, quietNan,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
}

// Div warns on zero denominators. Replace zero by one, divide safely, construct
// IEEE +/-Inf or NaN from the preserved numerator value, and restore only zero sites.
__aicore__ inline void ApplyAdamWSafeDiv(
    AscendC::LocalTensor<float> result, AscendC::LocalTensor<float> denominator,
    AscendC::LocalTensor<float> scratch, AscendC::LocalTensor<uint8_t> mask,
    uint32_t validCount, float quietNan, float positiveInf, float negativeInf)
{
    const uint32_t compareCount = ApplyAdamWCompareCount(validCount);
    AscendC::Duplicate(scratch, 1.0f, validCount);
    AscendC::CompareScalar(mask, denominator, 0.0f, AscendC::CMPMODE::EQ, compareCount);
    AscendC::Select(scratch, mask, scratch, denominator,
        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, validCount);
    AscendC::Div(result, result, scratch, validCount);

    AscendC::Duplicate(scratch, positiveInf, validCount);
    AscendC::CompareScalar(mask, result, 0.0f, AscendC::CMPMODE::GE, compareCount);
    AscendC::Select(scratch, mask, scratch, negativeInf,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
    AscendC::Compare(mask, result, result, AscendC::CMPMODE::EQ, compareCount);
    AscendC::Select(scratch, mask, scratch, quietNan,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
    AscendC::CompareScalar(mask, result, 0.0f, AscendC::CMPMODE::NE, compareCount);
    AscendC::Select(scratch, mask, scratch, quietNan,
        AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, validCount);
    AscendC::CompareScalar(mask, denominator, 0.0f, AscendC::CMPMODE::EQ, compareCount);
    AscendC::Select(result, mask, scratch, result,
        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, validCount);
}

class KernelApplyAdamWFloat {
public:
    __aicore__ inline explicit KernelApplyAdamWFloat(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR var, GM_ADDR grad, GM_ADDR m, GM_ADDR v, GM_ADDR y,
                                const __gm__ ApplyAdamWTilingData *tiling)
    {
        tiling_ = tiling;
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx >= tiling_->blockNum) {
            active_ = false;
            return;
        }
        active_ = true;
        const bool isTail = blockIdx + 1 == tiling_->blockNum;
        blockLength_ = isTail ? tiling_->blockTail : tiling_->blockFormer;
        loopCount_ = isTail ? tiling_->loopsTail : tiling_->loopsFormer;
        tailCount_ = isTail ? tiling_->tailTail : tiling_->tailFormer;
        const uint64_t offset = static_cast<uint64_t>(blockIdx) * tiling_->blockFormer;
        varGm_.SetGlobalBuffer((__gm__ float *)var + offset, blockLength_);
        gradGm_.SetGlobalBuffer((__gm__ float *)grad + offset, blockLength_);
        mGm_.SetGlobalBuffer((__gm__ float *)m + offset, blockLength_);
        vGm_.SetGlobalBuffer((__gm__ float *)v + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ float *)y + offset, blockLength_);
        const uint32_t tileBytes = tiling_->ubFormer * sizeof(float);
        pipe_->InitBuffer(qVar_, 1, tileBytes);
        pipe_->InitBuffer(qGrad_, 1, tileBytes);
        pipe_->InitBuffer(qM_, 1, tileBytes);
        pipe_->InitBuffer(qV_, 1, tileBytes);
        pipe_->InitBuffer(qOut_, 1, tileBytes);
        const uint32_t maskBytes = (((tiling_->ubFormer + 7U) / 8U + 255U) / 256U) * 256U;
        pipe_->InitBuffer(maskBuf_, maskBytes);
    }

    __aicore__ inline void Process()
    {
        if (!active_) return;
        for (uint32_t i = 0; i < loopCount_; ++i) {
            const uint32_t count = (i + 1 == loopCount_) ? tailCount_ : tiling_->ubFormer;
            const uint64_t offset = static_cast<uint64_t>(i) * tiling_->ubFormer;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        auto varLocal = qVar_.AllocTensor<float>();
        auto gradLocal = qGrad_.AllocTensor<float>();
        auto mLocal = qM_.AllocTensor<float>();
        auto vLocal = qV_.AllocTensor<float>();
        const uint32_t bytes = count * sizeof(float);
        AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(varLocal, varGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(gradLocal, gradGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(mLocal, mGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(vLocal, vGm_[offset], copyParams, padParams);
        qVar_.EnQue(varLocal); qGrad_.EnQue(gradLocal); qM_.EnQue(mLocal); qV_.EnQue(vLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        auto varLocal = qVar_.DeQue<float>();
        auto gradLocal = qGrad_.DeQue<float>();
        auto mLocal = qM_.DeQue<float>();
        auto vLocal = qV_.DeQue<float>();
        auto outLocal = qOut_.AllocTensor<float>();

        const float beta1 = tiling_->beta1;
        const float beta2 = tiling_->beta2;
        const float oneMinusBeta1 = tiling_->oneMinusBeta1;
        const float oneMinusBeta2 = tiling_->oneMinusBeta2;
        const float invBias1 = tiling_->invBias1;
        const float invBias2 = tiling_->invBias2;
        const float weightDecay = tiling_->weightDecay;
        const float epsilon = tiling_->epsilon;
        const float signedLr = tiling_->signedLr;
        ApplyAdamWFloatBits quietNan{tiling_->quietNanBits};
        ApplyAdamWFloatBits positiveInf{tiling_->positiveInfBits};
        ApplyAdamWFloatBits negativeInf{tiling_->negativeInfBits};
        auto mask = maskBuf_.Get<uint8_t>();

        AscendC::Muls(mLocal, mLocal, beta1, count);
        AscendC::Muls(outLocal, gradLocal, oneMinusBeta1, count);
        AscendC::Add(mLocal, mLocal, outLocal, count);
        AscendC::Muls(mLocal, mLocal, invBias1, count);
        AscendC::Mul(gradLocal, gradLocal, gradLocal, count);
        AscendC::Muls(vLocal, vLocal, beta2, count);
        AscendC::Muls(gradLocal, gradLocal, oneMinusBeta2, count);
        AscendC::Add(vLocal, vLocal, gradLocal, count);
        AscendC::Muls(vLocal, vLocal, invBias2, count);
        ApplyAdamWSafeSqrt(gradLocal, vLocal, outLocal, mask, count, quietNan.value);
        AscendC::Adds(gradLocal, gradLocal, epsilon, count);
        ApplyAdamWSafeDiv(mLocal, gradLocal, vLocal, mask, count,
            quietNan.value, positiveInf.value, negativeInf.value);
        if (weightDecay != 0.0f) {
            AscendC::Muls(outLocal, varLocal, weightDecay, count);
            AscendC::Add(mLocal, mLocal, outLocal, count);
        }
        AscendC::Muls(mLocal, mLocal, signedLr, count);
        AscendC::Add(outLocal, varLocal, mLocal, count);

        qOut_.EnQue(outLocal);
        qVar_.FreeTensor(varLocal); qGrad_.FreeTensor(gradLocal);
        qM_.FreeTensor(mLocal); qV_.FreeTensor(vLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        auto outLocal = qOut_.DeQue<float>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, copyParams);
        qOut_.FreeTensor(outLocal);
    }

    AscendC::TPipe *pipe_;
    const __gm__ ApplyAdamWTilingData *tiling_;
    bool active_;
    uint64_t blockLength_;
    uint32_t loopCount_, tailCount_;
    AscendC::GlobalTensor<float> varGm_, gradGm_, mGm_, vGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qVar_, qGrad_, qM_, qV_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskBuf_;
};

template <typename T>
class KernelApplyAdamWHalf {
public:
    __aicore__ inline explicit KernelApplyAdamWHalf(AscendC::TPipe *pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR var, GM_ADDR grad, GM_ADDR m, GM_ADDR v, GM_ADDR y,
                                const __gm__ ApplyAdamWTilingData *tiling)
    {
        tiling_ = tiling;
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const bool isTail = blockIdx + 1 == tiling_->blockNum;
        blockLength_ = isTail ? tiling_->blockTail : tiling_->blockFormer;
        loopCount_ = isTail ? tiling_->loopsTail : tiling_->loopsFormer;
        tailCount_ = isTail ? tiling_->tailTail : tiling_->tailFormer;
        const uint64_t offset = static_cast<uint64_t>(blockIdx) * tiling_->blockFormer;
        varGm_.SetGlobalBuffer((__gm__ T *)var + offset, blockLength_);
        gradGm_.SetGlobalBuffer((__gm__ T *)grad + offset, blockLength_);
        mGm_.SetGlobalBuffer((__gm__ T *)m + offset, blockLength_);
        vGm_.SetGlobalBuffer((__gm__ T *)v + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + offset, blockLength_);
        const uint32_t rawBytes = tiling_->ubFormer * sizeof(T);
        const uint32_t fpBytes = tiling_->ubFormer * sizeof(float);
        pipe_->InitBuffer(qRawVar_, 1, rawBytes);
        pipe_->InitBuffer(qRawGrad_, 1, rawBytes);
        pipe_->InitBuffer(qRawM_, 1, rawBytes);
        pipe_->InitBuffer(qRawV_, 1, rawBytes);
        pipe_->InitBuffer(qRawOut_, 1, rawBytes);
        pipe_->InitBuffer(bufA_, fpBytes); pipe_->InitBuffer(bufB_, fpBytes);
        pipe_->InitBuffer(bufC_, fpBytes); pipe_->InitBuffer(bufD_, fpBytes); pipe_->InitBuffer(bufE_, fpBytes);
        const uint32_t maskBytes = (((tiling_->ubFormer + 7U) / 8U + 255U) / 256U) * 256U;
        pipe_->InitBuffer(maskBuf_, maskBytes);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < loopCount_; ++i) {
            const uint32_t currentCount = (i + 1 == loopCount_) ? tailCount_ : tiling_->ubFormer;
            const uint64_t currentOffset = static_cast<uint64_t>(i) * tiling_->ubFormer;
            CopyIn(currentOffset, currentCount);
            auto a = bufA_.Get<float>(); auto b = bufB_.Get<float>();
            auto c = bufC_.Get<float>(); auto d = bufD_.Get<float>(); auto e = bufE_.Get<float>();
            const float beta1 = tiling_->beta1;
            const float beta2 = tiling_->beta2;
            const float oneMinusBeta1 = tiling_->oneMinusBeta1;
            const float oneMinusBeta2 = tiling_->oneMinusBeta2;
            const float invBias1 = tiling_->invBias1;
            const float invBias2 = tiling_->invBias2;
            const float weightDecay = tiling_->weightDecay;
            const float epsilon = tiling_->epsilon;
            const float signedLr = tiling_->signedLr;
            ApplyAdamWFloatBits quietNan{tiling_->quietNanBits};
            ApplyAdamWFloatBits positiveInf{tiling_->positiveInfBits};
            ApplyAdamWFloatBits negativeInf{tiling_->negativeInfBits};
            auto mask = maskBuf_.Get<uint8_t>();
            CastInputs(a, b, c, d, currentCount);
            AscendC::Muls(c, c, beta1, currentCount);
            AscendC::Muls(e, b, oneMinusBeta1, currentCount);
            AscendC::Add(c, c, e, currentCount);
            AscendC::Muls(c, c, invBias1, currentCount);
            AscendC::Mul(b, b, b, currentCount);
            AscendC::Muls(d, d, beta2, currentCount);
            AscendC::Muls(b, b, oneMinusBeta2, currentCount);
            AscendC::Add(d, d, b, currentCount);
            AscendC::Muls(d, d, invBias2, currentCount);
            ApplyAdamWSafeSqrt(b, d, e, mask, currentCount, quietNan.value);
            AscendC::Adds(b, b, epsilon, currentCount);
            ApplyAdamWSafeDiv(c, b, d, mask, currentCount,
                quietNan.value, positiveInf.value, negativeInf.value);
            if (weightDecay != 0.0f) {
                AscendC::Muls(e, a, weightDecay, currentCount);
                AscendC::Add(c, c, e, currentCount);
            }
            AscendC::Muls(c, c, signedLr, currentCount);
            AscendC::Add(a, a, c, currentCount);
            CastOutput(a, currentCount);
            CopyOut(currentOffset, currentCount);
        }
    }

private:
    __aicore__ inline void CopyOneIn(AscendC::TQue<AscendC::TPosition::VECIN, 1> &queue,
                                     AscendC::GlobalTensor<T> &src, uint64_t offset, uint32_t count)
    {
        auto raw = queue.AllocTensor<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(raw, src[offset], copyParams, padParams);
        queue.EnQue(raw);
    }

    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        CopyOneIn(qRawVar_, varGm_, offset, count);
        CopyOneIn(qRawGrad_, gradGm_, offset, count);
        CopyOneIn(qRawM_, mGm_, offset, count);
        CopyOneIn(qRawV_, vGm_, offset, count);
    }

    __aicore__ inline void CastOne(AscendC::LocalTensor<float> dst,
                                   AscendC::TQue<AscendC::TPosition::VECIN, 1> &queue, uint32_t count)
    {
        auto raw = queue.template DeQue<T>();
        AscendC::Cast(dst, raw, AscendC::RoundMode::CAST_NONE, count);
        queue.FreeTensor(raw);
    }

    __aicore__ inline void CastInputs(AscendC::LocalTensor<float> a, AscendC::LocalTensor<float> b,
                                     AscendC::LocalTensor<float> c, AscendC::LocalTensor<float> d,
                                     uint32_t count)
    {
        CastOne(a, qRawVar_, count); CastOne(b, qRawGrad_, count);
        CastOne(c, qRawM_, count); CastOne(d, qRawV_, count);
    }

    __aicore__ inline void CastOutput(AscendC::LocalTensor<float> src, uint32_t count)
    {
        auto raw = qRawOut_.AllocTensor<T>();
        AscendC::Cast(raw, src, AscendC::RoundMode::CAST_RINT, count);
        qRawOut_.EnQue(raw);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        auto raw = qRawOut_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], raw, copyParams);
        qRawOut_.FreeTensor(raw);
    }

    AscendC::TPipe *pipe_;
    const __gm__ ApplyAdamWTilingData *tiling_;
    uint64_t blockLength_;
    uint32_t loopCount_, tailCount_;
    AscendC::GlobalTensor<T> varGm_, gradGm_, mGm_, vGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qRawVar_, qRawGrad_, qRawM_, qRawV_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qRawOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufA_, bufB_, bufC_, bufD_, bufE_, maskBuf_;
};

extern "C" __global__ __vector__ void apply_adam_w_kernel(
    GM_ADDR var, GM_ADDR grad, GM_ADDR m, GM_ADDR v, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    const __gm__ ApplyAdamWTilingData *data = (__gm__ ApplyAdamWTilingData *)tiling;
    if (data->dtypeCode == APPLY_ADAM_W_FLOAT32) {
        KernelApplyAdamWFloat op(&pipe); op.Init(var, grad, m, v, y, data); op.Process();
    } else if (data->dtypeCode == APPLY_ADAM_W_FLOAT16) {
        KernelApplyAdamWHalf<half> op(&pipe); op.Init(var, grad, m, v, y, data); op.Process();
    } else {
        KernelApplyAdamWHalf<bfloat16_t> op(&pipe); op.Init(var, grad, m, v, y, data); op.Process();
    }
}
