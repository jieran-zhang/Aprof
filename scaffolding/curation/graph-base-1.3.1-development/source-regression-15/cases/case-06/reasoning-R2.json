  "candidates": [
    {
      "hypothesis_id": "hypothesis.primary",
      "problem_id": "problem.control_metadata_overhead",
      "mechanism": "GatherScalar 对每输出读取一个 index 和一个 x 并写一个 y；rank=r 时源码含2*r*N个64位除/模表达式，另有r*N次stride乘加。必要逻辑请求N*(indexBytes+2*xBytes)不等于HBM。主机逐index拒绝越界；kernel另有guard。tiling=ceil(N/C)，C=min(ceil(N/4096),actualAIV)。",
      "targets": [
        "target"
      ],
      "scope": {
        "task_id": "case-06",
        "parent_implementation_hash": "sha256:ce0841c9e0898cdb186a4c133ab1ef9bd2c84f05e93fd127aa9954d46cad571d",
        "workload_hash": "sha256:70a891319c0aeb68a2986e529f6cfb4affeeedfb5693eb67e3f7895274f1eaa1",
