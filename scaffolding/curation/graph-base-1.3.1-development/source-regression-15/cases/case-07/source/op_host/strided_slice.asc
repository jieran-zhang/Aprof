#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "strided_slice_tiling.h"
#include "../op_kernel/strided_slice_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
template <typename T> std::vector<T> List(const std::string &s) {
    std::vector<T> out; std::stringstream ss(s); std::string token;
    while (std::getline(ss, token, ',')) if (!token.empty()) out.push_back(static_cast<T>(std::stoll(token)));
    return out;
}
uint64_t Numel(const std::vector<uint64_t> &shape) { uint64_t n = 1; for (uint64_t d : shape) n *= d; return n; }
uint32_t ItemBytes(const std::string &s) {
    if (s == "int8" || s == "uint8") return 1;
    if (s == "float16" || s == "bfloat16") return 2;
    if (s == "float32" || s == "int32") return 4;
    if (s == "int64") return 8;
    throw std::invalid_argument("unsupported dtype: " + s);
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: strided_slice --shape DIMS --dtype TYPE --begin LIST --end LIST --strides LIST "
                     "--begin-mask N --end-mask N --ellipsis-mask N --shrink-axis-mask N --new-axis-mask N "
                     "--input FILE --output FILE [--device N]\n";
        return 2;
    }
    int device = 0; bool initialized = false, deviceSet = false; aclrtStream stream = nullptr;
    void *hostX = nullptr, *hostY = nullptr, *devX = nullptr, *devY = nullptr, *devTiling = nullptr;
    try {
        const auto shape = List<uint64_t>(Arg(argc, argv, "--shape"));
        const auto begin = List<int64_t>(Arg(argc, argv, "--begin"));
        const auto end = List<int64_t>(Arg(argc, argv, "--end"));
        const auto strides = List<int64_t>(Arg(argc, argv, "--strides"));
        const uint32_t itemBytes = ItemBytes(Arg(argc, argv, "--dtype"));
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); initialized = true;
        Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceSet = true;
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeStridedSliceTiling(shape, begin, end, strides,
            std::stoull(Arg(argc, argv, "--begin-mask", "0")),
            std::stoull(Arg(argc, argv, "--end-mask", "0")),
            std::stoull(Arg(argc, argv, "--ellipsis-mask", "0")),
            std::stoull(Arg(argc, argv, "--shrink-axis-mask", "0")),
            std::stoull(Arg(argc, argv, "--new-axis-mask", "0")), itemBytes, cores);
        const size_t xBytes = Numel(shape) * itemBytes, yBytes = tiling.totalLength * itemBytes;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostX, xBytes), "aclrtMallocHost input");
        Check(aclrtMallocHost(&hostY, yBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devX, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input");
        Check(aclrtMalloc(&devY, yBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--input"), hostX, xBytes)) throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devX, xBytes, hostX, xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        strided_slice_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devX), static_cast<uint8_t *>(devY), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostY, yBytes, devY, yBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostY, yBytes)) throw std::runtime_error("write output failed");
        std::cout << "strided_slice_kernel completed: numel=" << tiling.totalLength
                  << " output_rank=" << tiling.outputRank << " blocks=" << tiling.blockNum << "\n";
        aclrtFree(devTiling); devTiling = nullptr; aclrtFree(devY); devY = nullptr; aclrtFree(devX); devX = nullptr;
        aclrtFreeHost(hostY); hostY = nullptr; aclrtFreeHost(hostX); hostX = nullptr;
        aclrtDestroyStream(stream); stream = nullptr; aclrtResetDevice(device); deviceSet = false;
        aclFinalize(); initialized = false; return 0;
    } catch (const std::exception &e) {
        std::cerr << "strided_slice failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devY) aclrtFree(devY); if (devX) aclrtFree(devX);
        if (hostY) aclrtFreeHost(hostY); if (hostX) aclrtFreeHost(hostX); if (stream) aclrtDestroyStream(stream);
        if (deviceSet) aclrtResetDevice(device); if (initialized) aclFinalize(); return 1;
    }
}
