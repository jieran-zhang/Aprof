#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "foreach_addcdiv_scalar_tiling.h"

template <typename T>
class KernelForeachAddcdivScalar {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR x3, GM_ADDR y,
                                const __gm__ ForeachAddcdivTilingData *tiling) {
        tiling_ = tiling;
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * tiling_->blockLength;
        const uint64_t remain = tiling_->totalLength > offset ? tiling_->totalLength - offset : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x1_.SetGlobalBuffer((__gm__ T *)x1 + offset, length_);
        x2_.SetGlobalBuffer((__gm__ T *)x2 + offset, length_);
        x3_.SetGlobalBuffer((__gm__ T *)x3 + offset, length_);
        y_.SetGlobalBuffer((__gm__ T *)y + offset, length_);
        const uint32_t rawBytes = tiling_->tileElements * sizeof(T);
        pipe_.InitBuffer(x1Q_, 1, rawBytes);
        pipe_.InitBuffer(x2Q_, 1, rawBytes);
        pipe_.InitBuffer(x3Q_, 1, rawBytes);
        pipe_.InitBuffer(yQ_, 1, rawBytes);
        if constexpr (!std::is_same<T, float>::value) {
            const uint32_t fpBytes = tiling_->tileElements * sizeof(float);
            pipe_.InitBuffer(fp1_, fpBytes);
            pipe_.InitBuffer(fp2_, fpBytes);
            pipe_.InitBuffer(fp3_, fpBytes);
            pipe_.InitBuffer(fpOut_, fpBytes);
        }
    }

    __aicore__ inline void Process() {
        for (uint64_t off = 0; off < length_; off += tiling_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < tiling_->tileElements ? (length_ - off) : tiling_->tileElements);
            CopyIn(off, count);
            Compute(count);
            CopyOut(off, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t off, uint32_t count) {
        auto a = x1Q_.AllocTensor<T>();
        auto b = x2Q_.AllocTensor<T>();
        auto c = x3Q_.AllocTensor<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(a, x1_[off], p, pad);
        AscendC::DataCopyPad(b, x2_[off], p, pad);
        AscendC::DataCopyPad(c, x3_[off], p, pad);
        x1Q_.EnQue(a);
        x2Q_.EnQue(b);
        x3Q_.EnQue(c);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto a = x1Q_.DeQue<T>();
        auto b = x2Q_.DeQue<T>();
        auto c = x3Q_.DeQue<T>();
        auto out = yQ_.AllocTensor<T>();
        const float scalar = tiling_->scalar;
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Div(out, b, c, count);
            AscendC::Muls(out, out, scalar, count);
            AscendC::Add(out, a, out, count);
        } else {
            auto fa = fp1_.Get<float>();
            auto fb = fp2_.Get<float>();
            auto fc = fp3_.Get<float>();
            auto fo = fpOut_.Get<float>();
            AscendC::Cast(fa, a, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(fb, b, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(fc, c, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Div(fo, fb, fc, count);
            AscendC::Muls(fo, fo, scalar, count);
            AscendC::Add(fo, fa, fo, count);
            constexpr auto mode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(out, fo, mode, count);
        }
        yQ_.EnQue(out);
        x1Q_.FreeTensor(a);
        x2Q_.FreeTensor(b);
        x3Q_.FreeTensor(c);
    }

    __aicore__ inline void CopyOut(uint64_t off, uint32_t count) {
        auto out = yQ_.DeQue<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(y_[off], out, p);
        yQ_.FreeTensor(out);
    }

    AscendC::TPipe pipe_;
    const __gm__ ForeachAddcdivTilingData *tiling_;
    uint64_t length_;
    AscendC::GlobalTensor<T> x1_, x2_, x3_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> x1Q_, x2Q_, x3Q_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fp1_, fp2_, fp3_, fpOut_;
};

extern "C" __global__ __aicore__ void foreach_addcdiv_scalar_kernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR x3, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ ForeachAddcdivTilingData *t =
        reinterpret_cast<const __gm__ ForeachAddcdivTilingData *>(tilingAddr);
    if (t->dtype == FOREACH_ADCDIV_FLOAT32) {
        KernelForeachAddcdivScalar<float> op; op.Init(x1, x2, x3, y, t); op.Process();
    } else if (t->dtype == FOREACH_ADCDIV_FLOAT16) {
        KernelForeachAddcdivScalar<half> op; op.Init(x1, x2, x3, y, t); op.Process();
    } else {
        KernelForeachAddcdivScalar<bfloat16_t> op; op.Init(x1, x2, x3, y, t); op.Process();
    }
}
