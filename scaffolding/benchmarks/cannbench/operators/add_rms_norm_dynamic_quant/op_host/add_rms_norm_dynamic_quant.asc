#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "add_rms_norm_dynamic_quant_tiling.h"
#include "data_utils.h"
#include "../op_kernel/add_rms_norm_dynamic_quant_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &text) {
    std::vector<uint64_t> shape; std::stringstream stream(text); std::string token;
    while (std::getline(stream, token, ',')) shape.push_back(std::stoull(token));
    return shape;
}
uint64_t Numel(const std::vector<uint64_t> &shape) {
    uint64_t n = 1; for (uint64_t dim : shape) n *= dim; return n;
}
uint32_t DType(const std::string &name) {
    if (name == "float16") return ADD_RMS_QUANT_FLOAT16;
    if (name == "bfloat16") return ADD_RMS_QUANT_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + name);
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: add_rms_norm_dynamic_quant --shape M,N --dtype float16|bfloat16 "
                     "--epsilon E --x1 FILE --x2 FILE --gamma FILE --y FILE --xout FILE --scale FILE [--device N]\n";
        return 2;
    }
    int device = 0; aclrtStream stream = nullptr;
    void *hostX1=nullptr,*hostX2=nullptr,*hostGamma=nullptr,*hostY=nullptr,*hostXOut=nullptr,*hostScale=nullptr;
    void *devX1=nullptr,*devX2=nullptr,*devGamma=nullptr,*devY=nullptr,*devXOut=nullptr,*devScale=nullptr,*devTiling=nullptr;
    try {
        const auto shape = Shape(Arg(argc, argv, "--shape"));
        if (shape.size() != 2) throw std::invalid_argument("this benchmark requires rank-2 input");
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype"));
        const float epsilon = std::stof(Arg(argc, argv, "--epsilon", "1e-6"));
        const uint64_t numel = Numel(shape), hidden = shape.back();
        const size_t tensorBytes = numel * 2, gammaBytes = hidden * 2, yBytes = numel;
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeAddRmsQuantTiling(numel, static_cast<uint32_t>(hidden), dtype, epsilon, cores);
        const size_t scaleBytes = tiling.rows * sizeof(float);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
#define MALLOC_HOST(P, B, N) Check(aclrtMallocHost(&(P), (B)), "aclrtMallocHost " N)
#define MALLOC_DEV(P, B, N) Check(aclrtMalloc(&(P), (B), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc " N)
        MALLOC_HOST(hostX1,tensorBytes,"x1"); MALLOC_HOST(hostX2,tensorBytes,"x2");
        MALLOC_HOST(hostGamma,gammaBytes,"gamma"); MALLOC_HOST(hostY,yBytes,"y");
        MALLOC_HOST(hostXOut,tensorBytes,"xout"); MALLOC_HOST(hostScale,scaleBytes,"scale");
        MALLOC_DEV(devX1,tensorBytes,"x1"); MALLOC_DEV(devX2,tensorBytes,"x2");
        MALLOC_DEV(devGamma,gammaBytes,"gamma"); MALLOC_DEV(devY,yBytes,"y");
        MALLOC_DEV(devXOut,tensorBytes,"xout"); MALLOC_DEV(devScale,scaleBytes,"scale");
        MALLOC_DEV(devTiling,sizeof(tiling),"tiling");
#undef MALLOC_HOST
#undef MALLOC_DEV
        if (!ReadFile(Arg(argc,argv,"--x1"),hostX1,tensorBytes) ||
            !ReadFile(Arg(argc,argv,"--x2"),hostX2,tensorBytes) ||
            !ReadFile(Arg(argc,argv,"--gamma"),hostGamma,gammaBytes))
            throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devX1,tensorBytes,hostX1,tensorBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x1");
        Check(aclrtMemcpy(devX2,tensorBytes,hostX2,tensorBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x2");
        Check(aclrtMemcpy(devGamma,gammaBytes,hostGamma,gammaBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D gamma");
        Check(aclrtMemcpy(devTiling,sizeof(tiling),&tiling,sizeof(tiling),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
        const auto start=std::chrono::steady_clock::now();
        add_rms_norm_dynamic_quant_kernel<<<tiling.blockNum,nullptr,stream>>>(
            static_cast<uint8_t*>(devX1),static_cast<uint8_t*>(devX2),static_cast<uint8_t*>(devGamma),
            static_cast<uint8_t*>(devY),static_cast<uint8_t*>(devXOut),static_cast<uint8_t*>(devScale),
            static_cast<uint8_t*>(devTiling));
        Check(aclrtSynchronizeStream(stream),"kernel synchronize");
        const auto stop=std::chrono::steady_clock::now();
        Check(aclrtMemcpy(hostY,yBytes,devY,yBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");
        Check(aclrtMemcpy(hostXOut,tensorBytes,devXOut,tensorBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H xout");
        Check(aclrtMemcpy(hostScale,scaleBytes,devScale,scaleBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H scale");
        if (!WriteFile(Arg(argc,argv,"--y"),hostY,yBytes) ||
            !WriteFile(Arg(argc,argv,"--xout"),hostXOut,tensorBytes) ||
            !WriteFile(Arg(argc,argv,"--scale"),hostScale,scaleBytes))
            throw std::runtime_error("write output failed");
        std::cout << "add_rms_norm_dynamic_quant_kernel completed: rows=" << tiling.rows
                  << " hidden=" << tiling.hidden << " blocks=" << tiling.blockNum
                  << " elapsed_ms=" << std::chrono::duration<double,std::milli>(stop-start).count() << "\n";
        aclrtFree(devTiling);aclrtFree(devScale);aclrtFree(devXOut);aclrtFree(devY);aclrtFree(devGamma);aclrtFree(devX2);aclrtFree(devX1);
        aclrtFreeHost(hostScale);aclrtFreeHost(hostXOut);aclrtFreeHost(hostY);aclrtFreeHost(hostGamma);aclrtFreeHost(hostX2);aclrtFreeHost(hostX1);
        aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 0;
    } catch (const std::exception &e) {
        std::cerr << "add_rms_norm_dynamic_quant failed: " << e.what() << "\n";
        if(devTiling)aclrtFree(devTiling);if(devScale)aclrtFree(devScale);if(devXOut)aclrtFree(devXOut);if(devY)aclrtFree(devY);
        if(devGamma)aclrtFree(devGamma);if(devX2)aclrtFree(devX2);if(devX1)aclrtFree(devX1);
        if(hostScale)aclrtFreeHost(hostScale);if(hostXOut)aclrtFreeHost(hostXOut);if(hostY)aclrtFreeHost(hostY);
        if(hostGamma)aclrtFreeHost(hostGamma);if(hostX2)aclrtFreeHost(hostX2);if(hostX1)aclrtFreeHost(hostX1);
        if(stream)aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 1;
    }
}
