#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "apply_adam_w_common.h"
#include "data_utils.h"
#include "../op_kernel/apply_adam_w_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}

std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}

bool BoolArg(int argc, char **argv, const std::string &name, bool def = false) {
    const std::string value = Arg(argc, argv, name, def ? "1" : "0");
    return value == "1" || value == "true" || value == "True";
}

uint32_t ParseDType(const std::string &dtype) {
    if (dtype == "float32") return APPLY_ADAM_W_FLOAT32;
    if (dtype == "float16") return APPLY_ADAM_W_FLOAT16;
    if (dtype == "bfloat16") return APPLY_ADAM_W_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + dtype);
}
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        std::cerr << "usage: apply_adam_w --numel N --dtype float32|float16|bfloat16 --input-dir DIR --output FILE "
                     "--lr X --beta1 X --beta2 X --weight-decay X --epsilon X [--step N] [--maximize 0|1] [--device N]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    std::vector<void *> deviceInputs(4, nullptr);
    std::vector<void *> hostInputs(4, nullptr);
    void *deviceOutput = nullptr, *hostOutput = nullptr, *deviceTiling = nullptr;
    try {
        const uint64_t numel = std::stoull(Arg(argc, argv, "--numel"));
        const uint32_t dtype = ParseDType(Arg(argc, argv, "--dtype"));
        const size_t bytes = numel * (dtype == APPLY_ADAM_W_FLOAT32 ? 4 : 2);
        const std::string inputDir = Arg(argc, argv, "--input-dir", "input");
        const std::string outputFile = Arg(argc, argv, "--output", "output/output.bin");
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 0, ub = 0;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &ub), "query UB size");
        if (ub <= 0) {
            uint64_t platformUb = 0;
            auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
            platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, platformUb);
            ub = static_cast<int64_t>(platformUb);
        }
        auto tiling = ComputeApplyAdamWTiling(numel, dtype, cores, ub,
            std::stod(Arg(argc, argv, "--lr")), std::stod(Arg(argc, argv, "--beta1")),
            std::stod(Arg(argc, argv, "--beta2")), std::stod(Arg(argc, argv, "--weight-decay")),
            std::stod(Arg(argc, argv, "--epsilon", "1e-8")), std::stoll(Arg(argc, argv, "--step", "1")),
            BoolArg(argc, argv, "--maximize"));
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        const char *names[] = {"var.bin", "grad.bin", "m.bin", "v.bin"};
        for (size_t i = 0; i < 4; ++i) {
            Check(aclrtMallocHost(&hostInputs[i], bytes), "aclrtMallocHost input");
            Check(aclrtMalloc(&deviceInputs[i], bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input");
            if (!ReadFile(inputDir + "/" + names[i], bytes, hostInputs[i], bytes)) throw std::runtime_error("read input");
            Check(aclrtMemcpy(deviceInputs[i], bytes, hostInputs[i], bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
        }
        Check(aclrtMallocHost(&hostOutput, bytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&deviceOutput, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&deviceTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        Check(aclrtMemcpy(deviceTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        apply_adam_w_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(deviceInputs[0]), static_cast<uint8_t *>(deviceInputs[1]),
            static_cast<uint8_t *>(deviceInputs[2]), static_cast<uint8_t *>(deviceInputs[3]),
            static_cast<uint8_t *>(deviceOutput), static_cast<uint8_t *>(deviceTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOutput, bytes, deviceOutput, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(outputFile, hostOutput, bytes)) throw std::runtime_error("write output");
        std::cout << "apply_adam_w_kernel completed: numel=" << numel << " blocks=" << tiling.blockNum
                  << " tile=" << tiling.ubFormer << std::endl;
        aclrtFree(deviceTiling); aclrtFree(deviceOutput); aclrtFreeHost(hostOutput);
        for (size_t i = 0; i < 4; ++i) { aclrtFree(deviceInputs[i]); aclrtFreeHost(hostInputs[i]); }
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "ERROR: " << e.what() << std::endl;
        if (deviceTiling) aclrtFree(deviceTiling); if (deviceOutput) aclrtFree(deviceOutput);
        if (hostOutput) aclrtFreeHost(hostOutput);
        for (size_t i = 0; i < 4; ++i) { if (deviceInputs[i]) aclrtFree(deviceInputs[i]); if (hostInputs[i]) aclrtFreeHost(hostInputs[i]); }
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
