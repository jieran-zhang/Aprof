#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "swi_glu_tiling.h"
#include "data_utils.h"
#include "../op_kernel/swi_glu_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return SWIGLU_FLOAT16;
    if (s == "float32") return SWIGLU_FLOAT32;
    if (s == "bfloat16") return SWIGLU_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + s);
}
std::vector<uint64_t> ParseShape(const std::string &s) {
    std::vector<uint64_t> out;
    size_t begin = 0;
    while (begin < s.size()) {
        size_t end = s.find(',', begin);
        out.push_back(std::stoull(s.substr(begin, end - begin)));
        if (end == std::string::npos) break;
        begin = end + 1;
    }
    if (out.empty()) throw std::invalid_argument("shape must not be empty");
    return out;
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: swi_glu --shape D0,D1,... --dim N --dtype float16|float32|bfloat16 "
                     "--input FILE --output FILE [--device N]\n";
        return 2;
    }
    int device = 0;
    bool aclReady = false, deviceReady = false;
    aclrtStream stream = nullptr;
    void *hostIn = nullptr, *hostOut = nullptr, *devIn = nullptr, *devOut = nullptr, *devTiling = nullptr;
    try {
        const auto shape = ParseShape(Arg(argc, argv, "--shape"));
        int64_t dim = std::stoll(Arg(argc, argv, "--dim", "-1"));
        if (dim < 0) dim += static_cast<int64_t>(shape.size());
        if (dim < 0 || dim >= static_cast<int64_t>(shape.size())) throw std::invalid_argument("dim out of range");
        if ((shape[dim] & 1U) != 0) throw std::invalid_argument("split dimension must be even");
        uint64_t inputLength = 1, inner = 1;
        for (uint64_t d : shape) inputLength *= d;
        for (size_t i = static_cast<size_t>(dim) + 1; i < shape.size(); ++i) inner *= shape[i];
        const uint64_t outputLength = inputLength / 2;
        const uint64_t segmentLength = (shape[dim] / 2) * inner;
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype"));
        const size_t elementBytes = dtype == SWIGLU_FLOAT32 ? 4 : 2;
        const size_t inputBytes = inputLength * elementBytes;
        const size_t outputBytes = outputLength * elementBytes;
        device = std::stoi(Arg(argc, argv, "--device", "0"));

        Check(aclInit(nullptr), "aclInit"); aclReady = true;
        Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceReady = true;
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeSwiGluTiling(outputLength, segmentLength, dtype, cores);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostIn, inputBytes), "aclrtMallocHost input");
        Check(aclrtMallocHost(&hostOut, outputBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devIn, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input");
        Check(aclrtMalloc(&devOut, outputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--input"), hostIn, inputBytes)) throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devIn, inputBytes, hostIn, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        swi_glu_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devIn), static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOut, outputBytes, devOut, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, outputBytes)) throw std::runtime_error("write output failed");
        std::cout << "swi_glu_kernel completed: input=" << inputLength << " output=" << outputLength
                  << " segment=" << segmentLength << " blocks=" << tiling.blockNum << "\n";
        aclrtFree(devTiling); devTiling = nullptr; aclrtFree(devOut); devOut = nullptr; aclrtFree(devIn); devIn = nullptr;
        aclrtFreeHost(hostOut); hostOut = nullptr; aclrtFreeHost(hostIn); hostIn = nullptr;
        aclrtDestroyStream(stream); stream = nullptr; aclrtResetDevice(device); deviceReady = false; aclFinalize(); aclReady = false;
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "swi_glu failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOut) aclrtFree(devOut); if (devIn) aclrtFree(devIn);
        if (hostOut) aclrtFreeHost(hostOut); if (hostIn) aclrtFreeHost(hostIn);
        if (stream) aclrtDestroyStream(stream); if (deviceReady) aclrtResetDevice(device); if (aclReady) aclFinalize();
        return 1;
    }
}
