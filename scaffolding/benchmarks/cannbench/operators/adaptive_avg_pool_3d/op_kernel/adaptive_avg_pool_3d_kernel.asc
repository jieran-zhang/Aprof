#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "adaptive_avg_pool_3d_tiling.h"

template<typename T>__aicore__ inline float AdaptivePoolToFloat(T v){
 if constexpr(std::is_same<T,float>::value)return v;
 uint16_t r=*reinterpret_cast<uint16_t*>(&v);uint32_t bits=0;
 if constexpr(std::is_same<T,bfloat16_t>::value)bits=uint32_t(r)<<16;
 else{uint32_t sign=uint32_t(r&0x8000U)<<16,exp=(r>>10)&31U,m=r&1023U;bits=sign;if(exp==31U){bits|=0x7f800000U|(m<<13);if(m)bits|=0x400000U;}else if(exp)bits|=((exp+112U)<<23)|(m<<13);else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}m&=1023U;bits|=(uint32_t(e+127)<<23)|(m<<13);}}
 return *reinterpret_cast<float*>(&bits);
}
__aicore__ inline uint64_t AdaptivePoolStart(uint64_t out,uint64_t inSize,uint64_t outSize){return out*inSize/outSize;}
__aicore__ inline uint64_t AdaptivePoolEnd(uint64_t out,uint64_t inSize,uint64_t outSize){return ((out+1)*inSize+outSize-1)/outSize;}
template<typename T>__aicore__ inline float AdaptivePoolOne(const __gm__ T*x,uint64_t linear,const __gm__ AdaptiveAvgPool3DTilingData*t){
 uint64_t s=linear%t->outputSpatial,nc=linear/t->outputSpatial,od=s/(t->outH*t->outW),rem=s%(t->outH*t->outW),oh=rem/t->outW,ow=rem%t->outW;
 uint64_t ds=AdaptivePoolStart(od,t->inD,t->outD),de=AdaptivePoolEnd(od,t->inD,t->outD),hs=AdaptivePoolStart(oh,t->inH,t->outH),he=AdaptivePoolEnd(oh,t->inH,t->outH),ws=AdaptivePoolStart(ow,t->inW,t->outW),we=AdaptivePoolEnd(ow,t->inW,t->outW),base=nc*t->inputSpatial;
 float sum=0.0f;for(uint64_t d=ds;d<de;++d)for(uint64_t h=hs;h<he;++h){uint64_t row=base+(d*t->inH+h)*t->inW;for(uint64_t w=ws;w<we;++w)sum+=AdaptivePoolToFloat<T>(x[row+w]);}
 int32_t count=static_cast<int32_t>((de-ds)*(he-hs)*(we-ws));return sum/static_cast<float>(count);
}
template<typename T>class AdaptivePoolB16 {public:
 __aicore__ inline void Init(GM_ADDR xa,GM_ADDR ya,const __gm__ AdaptiveAvgPool3DTilingData*t){t_=t;x_=reinterpret_cast<const __gm__ T*>(xa);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ya),t->outputNumel);pipe_.InitBuffer(fp_,K*4);pipe_.InitBuffer(raw_,K*2);}
 __aicore__ inline void Process(){uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->blockLength,end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;auto fp=fp_.Get<float>();auto raw=raw_.Get<T>();for(uint64_t off=begin;off<end;off+=K){uint32_t count=uint32_t(end-off<K?end-off:K);for(uint32_t i=0;i<count;++i)fp.SetValue(i,AdaptivePoolOne<T>(x_,off+i,t_));AscendC::PipeBarrier<PIPE_ALL>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(raw,fp,mode,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[off],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();}}
 private:static constexpr uint32_t K=1024;const __gm__ AdaptiveAvgPool3DTilingData*t_;const __gm__ T*x_;AscendC::GlobalTensor<T>y_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>fp_,raw_;
};
__aicore__ inline void AdaptivePoolFloat(GM_ADDR xa,GM_ADDR ya,const __gm__ AdaptiveAvgPool3DTilingData*t){const __gm__ float*x=reinterpret_cast<const __gm__ float*>(xa);__gm__ float*y=reinterpret_cast<__gm__ float*>(ya);uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t->blockLength,end=begin+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;for(uint64_t i=begin;i<end;++i)y[i]=AdaptivePoolOne<float>(x,i,t);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void adaptive_avg_pool_3d_kernel(GM_ADDR x,GM_ADDR y,GM_ADDR til){const __gm__ AdaptiveAvgPool3DTilingData*t=reinterpret_cast<const __gm__ AdaptiveAvgPool3DTilingData*>(til);if(t->dtype==ADAPTIVE_POOL_FP16){AdaptivePoolB16<half>op;op.Init(x,y,t);op.Process();}else if(t->dtype==ADAPTIVE_POOL_BF16){AdaptivePoolB16<bfloat16_t>op;op.Init(x,y,t);op.Process();}else AdaptivePoolFloat(x,y,t);}
