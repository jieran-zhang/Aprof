#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;
using namespace matmul;

union WqBits { float f; uint32_t u; };

__aicore__ inline float WqHalfToFloat(uint16_t h) {
    uint32_t sign=uint32_t(h&0x8000U)<<16, exp=(h>>10)&31U, mant=h&1023U, bits=sign;
    if(exp==31U) bits|=0x7f800000U|(mant<<13);
    else if(exp) bits|=((exp+112U)<<23)|(mant<<13);
    else if(mant){int e=-14;while((mant&1024U)==0){mant<<=1;--e;}bits|=(uint32_t(e+127)<<23)|((mant&1023U)<<13);}
    WqBits z;z.u=bits;return z.f;
}
__aicore__ inline float WqBf16ToFloat(uint16_t h) { WqBits z;z.u=uint32_t(h)<<16;return z.f; }
__aicore__ inline uint16_t WqFloatToHalf(float x) {
    WqBits z;z.f=x;uint32_t u=z.u,sign=(u>>16)&0x8000U,exp=(u>>23)&255U,frac=u&0x7fffffU;
    if(exp==255U)return uint16_t(sign|(frac?0x7e00U:0x7c00U));int32_t he=int32_t(exp)-112;
    if(he>=31)return uint16_t(sign|0x7c00U);if(he<=0){if(he < -10)return uint16_t(sign);uint32_t mant=frac|0x800000U,shift=uint32_t(14-he),out=mant>>shift,rem=mant&((1U<<shift)-1U),mid=1U<<(shift-1U);if(rem>mid||(rem==mid&&(out&1U)))++out;return uint16_t(sign|out);}
    uint32_t out=frac>>13,rem=frac&0x1fffU;if(rem>0x1000U||(rem==0x1000U&&(out&1U)))++out;if(out==0x400U){out=0;++he;if(he>=31)return uint16_t(sign|0x7c00U);}return uint16_t(sign|(uint32_t(he)<<10)|out);
}
__aicore__ inline uint16_t WqFloatToBf16(float x) { WqBits z;z.f=x;uint32_t u=z.u;if((u&0x7f800000U)==0x7f800000U&&(u&0x007fffffU))return uint16_t((u>>16)|0x40U);uint32_t lsb=(u>>16)&1U;return uint16_t((u+0x7fffU+lsb)>>16); }

template<bool BF16>
__aicore__ inline void WqDequant(GM_ADDR weight,GM_ADDR scale,GM_ADDR offset,GM_ADDR out,
                                 uint64_t total,uint32_t n,uint32_t hasOffset,uint32_t logicalBlocks) {
    const __gm__ int8_t*w=reinterpret_cast<const __gm__ int8_t*>(weight);
    const __gm__ uint16_t*s=reinterpret_cast<const __gm__ uint16_t*>(scale);
    const __gm__ uint16_t*o=reinterpret_cast<const __gm__ uint16_t*>(offset);
    __gm__ uint16_t*y=reinterpret_cast<__gm__ uint16_t*>(out);
    (void)logicalBlocks;
    for(uint64_t i=0;i<total;++i){uint32_t col=uint32_t(i%n);float v=float(w[i]);
        if(hasOffset){float off=BF16?WqBf16ToFloat(o[col]):WqHalfToFloat(o[col]);v+=off;v=BF16?WqBf16ToFloat(WqFloatToBf16(v)):WqHalfToFloat(WqFloatToHalf(v));}
        float sc=BF16?WqBf16ToFloat(s[col]):WqHalfToFloat(s[col]);v*=sc;y[i]=BF16?WqFloatToBf16(v):WqFloatToHalf(v);
    }
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void wq_dequant_fp16(GM_ADDR w,GM_ADDR s,GM_ADDR o,GM_ADDR y,uint64_t t,uint32_t n,uint32_t ho,uint32_t lb){WqDequant<false>(w,s,o,y,t,n,ho,lb);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void wq_dequant_bf16(GM_ADDR w,GM_ADDR s,GM_ADDR o,GM_ADDR y,uint64_t t,uint32_t n,uint32_t ho,uint32_t lb){WqDequant<true>(w,s,o,y,t,n,ho,lb);}

template<typename T> class WqCubeKernel {
public:
    using AType=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;
    using BType=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;
    using CType=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;
    using BiasType=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;
    MatmulImpl<AType,BType,CType,BiasType> mm;
    __aicore__ inline void Run(GM_ADDR x,GM_ADDR w,GM_ADDR out,GM_ADDR tiling){
        AscendC::tiling::TCubeTiling t{};const __gm__ int32_t*src=reinterpret_cast<const __gm__ int32_t*>(tiling);int32_t*dst=reinterpret_cast<int32_t*>(&t);for(uint32_t i=0;i<sizeof(t)/sizeof(int32_t);++i)dst[i]=src[i];
        TPipe pipe;GlobalTensor<T>a,b;GlobalTensor<float>c;a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(w));c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out));mm.SetSubBlockIdx(0);mm.Init(&t,&pipe);mm.SetTensorA(a);mm.SetTensorB(b);mm.IterateAll(c);mm.End();
    }
};
extern "C" __global__ __aicore__ __attribute__((aic)) void wq_matmul_fp16(GM_ADDR x,GM_ADDR w,GM_ADDR y,GM_ADDR t){WqCubeKernel<half>op;op.Run(x,w,y,t);}
extern "C" __global__ __aicore__ __attribute__((aic)) void wq_matmul_bf16(GM_ADDR x,GM_ADDR w,GM_ADDR y,GM_ADDR t){WqCubeKernel<bfloat16_t>op;op.Run(x,w,y,t);}

template<bool BF16>
__aicore__ inline void WqPost(GM_ADDR x,GM_ADDR weight,GM_ADDR mat,GM_ADDR bias,GM_ADDR out,uint64_t total,uint32_t k,uint32_t n,uint32_t hasBias,uint32_t logicalBlocks){
    const __gm__ uint16_t*x16=reinterpret_cast<const __gm__ uint16_t*>(x);const __gm__ uint16_t*w16=reinterpret_cast<const __gm__ uint16_t*>(weight);
    const __gm__ float*m=reinterpret_cast<const __gm__ float*>(mat);const __gm__ uint16_t*b16=reinterpret_cast<const __gm__ uint16_t*>(bias);const __gm__ float*bf=reinterpret_cast<const __gm__ float*>(bias);__gm__ uint16_t*y=reinterpret_cast<__gm__ uint16_t*>(out);
    (void)logicalBlocks;
    for(uint64_t i=0;i<total;++i){uint32_t row=uint32_t(i/n),col=uint32_t(i%n);float v=m[i];if(v>-1.0f&&v<1.0f){float acc=0.0f,comp=0.0f;for(uint32_t q=0;q<k;++q){float av=BF16?WqBf16ToFloat(x16[uint64_t(row)*k+q]):WqHalfToFloat(x16[uint64_t(row)*k+q]);float bv=BF16?WqBf16ToFloat(w16[uint64_t(q)*n+col]):WqHalfToFloat(w16[uint64_t(q)*n+col]);float term=av*bv-comp,next=acc+term;comp=(next-acc)-term;acc=next;}v=acc;}if(hasBias)v+=BF16?bf[col]:WqHalfToFloat(b16[col]);y[i]=BF16?WqFloatToBf16(v):WqFloatToHalf(v);}
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void wq_post_fp16(GM_ADDR x,GM_ADDR w,GM_ADDR m,GM_ADDR b,GM_ADDR y,uint64_t t,uint32_t k,uint32_t n,uint32_t hb,uint32_t lb){WqPost<false>(x,w,m,b,y,t,k,n,hb,lb);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void wq_post_bf16(GM_ADDR x,GM_ADDR w,GM_ADDR m,GM_ADDR b,GM_ADDR y,uint64_t t,uint32_t k,uint32_t n,uint32_t hb,uint32_t lb){WqPost<true>(x,w,m,b,y,t,k,n,hb,lb);}
