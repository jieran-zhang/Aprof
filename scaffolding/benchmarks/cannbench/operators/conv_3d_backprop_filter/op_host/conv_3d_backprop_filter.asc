#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/conv_3d_backprop_filter_kernel.asc"

namespace {
void Check(aclError r, const char *what) { if (r != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(r)); }
std::string Arg(int argc, char **argv, const std::string &key, const std::string &fallback = "") { for (int i = 1; i + 1 < argc; ++i) if (argv[i] == key) return argv[i + 1]; return fallback; }
std::vector<uint64_t> Parse(const std::string &s) { std::vector<uint64_t> out; std::stringstream ss(s); std::string v; while (getline(ss, v, ',')) out.push_back(std::stoull(v)); return out; }
uint64_t Numel(const std::vector<uint64_t> &s) { uint64_t n = 1; for (auto v : s) n *= v; return n; }
struct TypeInfo { size_t item; matmul_tiling::DataType tile; };
TypeInfo Type(const std::string &s) { if (s == "float16") return {2, matmul_tiling::DataType::DT_FLOAT16}; if (s == "bfloat16") return {2, matmul_tiling::DataType::DT_FLOAT}; throw std::invalid_argument("dtype must be float16 or bfloat16"); }
AscendC::tiling::TCubeTiling MakeTiling(int m, int n, int k, const TypeInfo &work)
{
    matmul_tiling::PlatformInfo platform{platform_ascendc::SocVersion::ASCEND910B, 512 * 1024ULL, 128 * 1024ULL, 192 * 1024ULL, 64 * 1024ULL, 64 * 1024ULL};
    matmul_tiling::MatmulApiTiling api(platform); using matmul_tiling::TPosition; using matmul_tiling::CubeFormat;
    if (api.SetAType(TPosition::GM, CubeFormat::ND, work.tile, true) != 0 ||
        api.SetBType(TPosition::GM, CubeFormat::ND, work.tile, false) != 0 ||
        api.SetCType(TPosition::GM, CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT) != 0 ||
        api.SetBiasType(TPosition::GM, CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT) != 0 ||
        api.SetShape(m, n, k) != 0 || api.SetOrgShape(m, n, k) != 0 || api.SetBias(false) != 0)
        throw std::runtime_error("MatmulApiTiling setup failed");
    AscendC::tiling::TCubeTiling tiling{}; if (api.GetTiling(tiling) != 0) throw std::runtime_error("MatmulApiTiling GetTiling failed"); return tiling;
}
}

int main(int argc, char **argv)
{
    int device = 0; bool initialized = false, deviceSet = false; aclrtStream stream = nullptr;
    void *hx = nullptr, *hg = nullptr, *hy = nullptr, *dx = nullptr, *dg = nullptr, *dy = nullptr;
    void *dPackedGrad = nullptr, *dCol = nullptr, *dMat = nullptr, *dTiling = nullptr;
    try {
        auto xs = Parse(Arg(argc, argv, "--x-shape")), gs = Parse(Arg(argc, argv, "--grad-shape"));
        auto strides = Parse(Arg(argc, argv, "--strides")), pads = Parse(Arg(argc, argv, "--pads"));
        auto dilations = Parse(Arg(argc, argv, "--dilations")), fs = Parse(Arg(argc, argv, "--filter-size"));
        if (xs.size() != 5 || gs.size() != 5 || strides.size() != 3 || pads.size() != 6 || dilations.size() != 3 || fs.size() != 5) throw std::invalid_argument("invalid shape/attribute rank");
        uint64_t groups = std::stoull(Arg(argc, argv, "--groups", "1"));
        if (!groups || xs[1] % groups || gs[1] % groups || fs[0] != gs[1] || fs[1] != xs[1] / groups) throw std::invalid_argument("invalid groups/filter_size");
        uint64_t od = (xs[2] + pads[0] + pads[1] - dilations[0] * (fs[2] - 1) - 1) / strides[0] + 1;
        uint64_t oh = (xs[3] + pads[2] + pads[3] - dilations[1] * (fs[3] - 1) - 1) / strides[1] + 1;
        uint64_t ow = (xs[4] + pads[4] + pads[5] - dilations[2] * (fs[4] - 1) - 1) / strides[2] + 1;
        if (gs[0] != xs[0] || gs[2] != od || gs[3] != oh || gs[4] != ow) throw std::invalid_argument("grad spatial shape mismatch");
        std::string dtype = Arg(argc, argv, "--dtype"); TypeInfo inputType = Type(dtype), workType = dtype == "bfloat16" ? Type("bfloat16") : inputType;
        workType.item = dtype == "bfloat16" ? 4 : 2;
        uint64_t cinGroup = xs[1] / groups, coutGroup = gs[1] / groups, spatial = od * oh * ow, rows = xs[0] * spatial;
        uint64_t kGroup = cinGroup * fs[2] * fs[3] * fs[4], outGroup = coutGroup * kGroup;
        size_t xBytes = Numel(xs) * inputType.item, gradBytes = Numel(gs) * inputType.item, outBytes = Numel(fs) * inputType.item;
        size_t packedBytes = rows * coutGroup * workType.item, colBytes = rows * kGroup * workType.item, matBytes = outGroup * sizeof(float);
        device = std::stoi(Arg(argc, argv, "--device", "0")); Check(aclInit(nullptr), "aclInit"); initialized = true; Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceSet = true; Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        int64_t cores = 1; Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "vector core query");
        Check(aclrtMallocHost(&hx, xBytes), "host x"); Check(aclrtMallocHost(&hg, gradBytes), "host grad"); Check(aclrtMallocHost(&hy, outBytes), "host output");
        if (!ReadFile(Arg(argc, argv, "--x"), hx, xBytes) || !ReadFile(Arg(argc, argv, "--grad"), hg, gradBytes)) throw std::runtime_error("read input files");
        Check(aclrtMalloc(&dx, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "device x"); Check(aclrtMalloc(&dg, gradBytes, ACL_MEM_MALLOC_HUGE_FIRST), "device grad"); Check(aclrtMalloc(&dy, outBytes, ACL_MEM_MALLOC_HUGE_FIRST), "device output");
        Check(aclrtMalloc(&dPackedGrad, packedBytes, ACL_MEM_MALLOC_HUGE_FIRST), "packed grad workspace"); Check(aclrtMalloc(&dCol, colBytes, ACL_MEM_MALLOC_HUGE_FIRST), "im2col workspace"); Check(aclrtMalloc(&dMat, matBytes, ACL_MEM_MALLOC_HUGE_FIRST), "matmul workspace"); Check(aclrtMalloc(&dTiling, sizeof(AscendC::tiling::TCubeTiling), ACL_MEM_MALLOC_HUGE_FIRST), "tiling workspace");
        Check(aclrtMemcpy(dx, xBytes, hx, xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x"); Check(aclrtMemcpy(dg, gradBytes, hg, gradBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy grad");
        auto tiling = MakeTiling(int(coutGroup), int(kGroup), int(rows), workType); Check(aclrtMemcpy(dTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "copy tiling");
        auto alignedBlock = [cores](uint64_t total, size_t item) { uint64_t a = 32 / item; return ((total + uint64_t(cores) - 1) / uint64_t(cores) + a - 1) / a * a; };
        uint64_t gradTotal = rows * coutGroup, colTotal = rows * kGroup, gradBlock = alignedBlock(gradTotal, workType.item), colBlock = alignedBlock(colTotal, workType.item), outBlock = alignedBlock(outGroup, inputType.item);
        for (uint64_t group = 0; group < groups; ++group) {
            if (dtype == "float16") {
                c3d_pack_grad_fp16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dg), static_cast<uint8_t *>(dPackedGrad), gs[1], spatial, coutGroup, group, gradTotal, gradBlock);
                c3d_im2col_fp16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dx), static_cast<uint8_t *>(dCol), xs[1], xs[2], xs[3], xs[4], od, oh, ow, cinGroup, fs[2], fs[3], fs[4], strides[0], strides[1], strides[2], pads[0], pads[2], pads[4], dilations[0], dilations[1], dilations[2], group, colTotal, colBlock);
            } else {
                c3d_pack_grad_bf16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dg), static_cast<uint8_t *>(dPackedGrad), gs[1], spatial, coutGroup, group, gradTotal, gradBlock);
                c3d_im2col_bf16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dx), static_cast<uint8_t *>(dCol), xs[1], xs[2], xs[3], xs[4], od, oh, ow, cinGroup, fs[2], fs[3], fs[4], strides[0], strides[1], strides[2], pads[0], pads[2], pads[4], dilations[0], dilations[1], dilations[2], group, colTotal, colBlock);
            }
            Check(aclrtSynchronizeStream(stream), "pack/im2col sync");
            if (dtype == "float16") c3d_matmul_fp16<<<tiling.usedCoreNum, nullptr, stream>>>(static_cast<uint8_t *>(dPackedGrad), static_cast<uint8_t *>(dCol), static_cast<uint8_t *>(dMat), static_cast<uint8_t *>(dTiling));
            else c3d_matmul_bf16<<<tiling.usedCoreNum, nullptr, stream>>>(static_cast<uint8_t *>(dPackedGrad), static_cast<uint8_t *>(dCol), static_cast<uint8_t *>(dMat), static_cast<uint8_t *>(dTiling));
            Check(aclrtSynchronizeStream(stream), "matmul sync");
            uint8_t *groupOutput = static_cast<uint8_t *>(dy) + group * outGroup * inputType.item;
            if (dtype == "float16") c3d_cast_fp16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dMat), groupOutput, outGroup, outBlock);
            else c3d_cast_bf16<<<cores, nullptr, stream>>>(static_cast<uint8_t *>(dx), static_cast<uint8_t *>(dg), static_cast<uint8_t *>(dMat), groupOutput,
                xs[0], xs[1], gs[1], xs[2], xs[3], xs[4], od, oh, ow, cinGroup, coutGroup, fs[2], fs[3], fs[4], strides[0], strides[1], strides[2], pads[0], pads[2], pads[4], dilations[0], dilations[1], dilations[2], group, outGroup, outBlock);
            Check(aclrtSynchronizeStream(stream), "cast sync");
        }
        Check(aclrtMemcpy(hy, outBytes, dy, outBytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output"); if (!WriteFile(Arg(argc, argv, "--output"), hy, outBytes)) throw std::runtime_error("write output");
        std::cout << "conv_3d_backprop_filter completed output_numel=" << Numel(fs) << " groups=" << groups << " cube_cores=" << tiling.usedCoreNum << "\n";
        for (void *p : {dTiling, dMat, dCol, dPackedGrad, dy, dg, dx}) if (p) aclrtFree(p); for (void *p : {hy, hg, hx}) aclrtFreeHost(p); aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return 0;
    } catch (const std::exception &e) {
        std::cerr << "conv_3d_backprop_filter failed: " << e.what() << "\n";
        for (void *p : {dTiling, dMat, dCol, dPackedGrad, dy, dg, dx}) if (p) aclrtFree(p); for (void *p : {hy, hg, hx}) if (p) aclrtFreeHost(p); if (stream) aclrtDestroyStream(stream); if (deviceSet) aclrtResetDevice(device); if (initialized) aclFinalize(); return 1;
    }
}
