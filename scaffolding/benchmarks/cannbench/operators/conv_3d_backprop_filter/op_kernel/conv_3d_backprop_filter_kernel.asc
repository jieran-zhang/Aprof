#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;
using namespace matmul;

template <typename T>
__aicore__ inline float C3dToFloat(T v)
{
    uint16_t raw = *reinterpret_cast<uint16_t *>(&v);
    if constexpr (std::is_same<T, bfloat16_t>::value) {
        uint32_t bits = uint32_t(raw) << 16;
        return *reinterpret_cast<float *>(&bits);
    } else {
        uint32_t sign = uint32_t(raw & 0x8000U) << 16, exp = (raw >> 10) & 31U, mant = raw & 1023U;
        uint32_t bits = sign;
        if (exp == 31U) { bits |= 0x7f800000U | (mant << 13); if (mant) bits |= 0x400000U; }
        else if (exp) bits |= ((exp + 112U) << 23) | (mant << 13);
        else if (mant) { int e = -14; while ((mant & 1024U) == 0) { mant <<= 1; --e; } mant &= 1023U; bits |= (uint32_t(e + 127) << 23) | (mant << 13); }
        return *reinterpret_cast<float *>(&bits);
    }
}

template <typename Src, typename Work>
__aicore__ inline Work C3dConvert(Src v)
{
    if constexpr (std::is_same<Src, Work>::value) return v;
    else return C3dToFloat(v);
}

template <typename Src, typename Work>
__aicore__ inline void PackGrad(GM_ADDR grada, GM_ADDR packa, uint64_t cout, uint64_t spatial,
    uint64_t coutGroup, uint64_t group, uint64_t total, uint64_t blockLength)
{
    constexpr uint32_t TILE = 1024;
    const __gm__ Src *grad = reinterpret_cast<const __gm__ Src *>(grada);
    GlobalTensor<Work> packed; packed.SetGlobalBuffer(reinterpret_cast<__gm__ Work *>(packa), total);
    TPipe pipe; TBuf<TPosition::VECCALC> buf; pipe.InitBuffer(buf, TILE * sizeof(Work)); auto local = buf.Get<Work>();
    uint64_t begin = uint64_t(GetBlockIdx()) * blockLength, end = begin + blockLength; if (end > total) end = total;
    for (uint64_t off = begin; off < end; off += TILE) {
        uint32_t count = uint32_t(end - off < TILE ? end - off : TILE);
        for (uint32_t i = 0; i < count; ++i) {
            uint64_t linear = off + i, co = linear % coutGroup, row = linear / coutGroup;
            uint64_t s = row % spatial, n = row / spatial;
            local.SetValue(i, C3dConvert<Src, Work>(grad[(n * cout + group * coutGroup + co) * spatial + s]));
        }
        PipeBarrier<PIPE_ALL>(); DataCopyExtParams cp{1, uint32_t(count * sizeof(Work)), 0, 0, 0}; DataCopyPad(packed[off], local, cp); PipeBarrier<PIPE_ALL>();
    }
}

template <typename Src, typename Work>
__aicore__ inline void Im2Col3d(GM_ADDR xa, GM_ADDR cola, uint64_t cin, uint64_t d, uint64_t h, uint64_t w,
    uint64_t od, uint64_t oh, uint64_t ow, uint64_t cinGroup, uint64_t kd, uint64_t kh, uint64_t kw,
    uint64_t sd, uint64_t sh, uint64_t sw, uint64_t pf, uint64_t pt, uint64_t pl,
    uint64_t dd, uint64_t dh, uint64_t dw, uint64_t group, uint64_t total, uint64_t blockLength)
{
    constexpr uint32_t TILE = 1024;
    const __gm__ Src *x = reinterpret_cast<const __gm__ Src *>(xa);
    GlobalTensor<Work> col; col.SetGlobalBuffer(reinterpret_cast<__gm__ Work *>(cola), total);
    TPipe pipe; TBuf<TPosition::VECCALC> buf; pipe.InitBuffer(buf, TILE * sizeof(Work)); auto local = buf.Get<Work>();
    uint64_t begin = uint64_t(GetBlockIdx()) * blockLength, end = begin + blockLength; if (end > total) end = total;
    uint64_t ksize = cinGroup * kd * kh * kw, spatial = od * oh * ow, inputSpatial = d * h * w;
    for (uint64_t off = begin; off < end; off += TILE) {
        uint32_t count = uint32_t(end - off < TILE ? end - off : TILE);
        for (uint32_t i = 0; i < count; ++i) {
            uint64_t linear = off + i, kval = linear % ksize, row = linear / ksize;
            uint64_t s = row % spatial, n = row / spatial, owv = s % ow, q = s / ow, ohv = q % oh, odv = q / oh;
            uint64_t kwv = kval % kw; q = kval / kw; uint64_t khv = q % kh; q /= kh; uint64_t kdv = q % kd, ci = q / kd;
            int64_t id = int64_t(odv * sd + kdv * dd) - int64_t(pf);
            int64_t ih = int64_t(ohv * sh + khv * dh) - int64_t(pt);
            int64_t iw = int64_t(owv * sw + kwv * dw) - int64_t(pl);
            Work v{};
            if (id >= 0 && id < int64_t(d) && ih >= 0 && ih < int64_t(h) && iw >= 0 && iw < int64_t(w)) {
                uint64_t c = group * cinGroup + ci;
                v = C3dConvert<Src, Work>(x[(n * cin + c) * inputSpatial + uint64_t(id) * h * w + uint64_t(ih) * w + uint64_t(iw)]);
            }
            local.SetValue(i, v);
        }
        PipeBarrier<PIPE_ALL>(); DataCopyExtParams cp{1, uint32_t(count * sizeof(Work)), 0, 0, 0}; DataCopyPad(col[off], local, cp); PipeBarrier<PIPE_ALL>();
    }
}

template <typename T>
class FilterGradMatmul {
public:
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, T, true>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType> mm;
    __aicore__ inline void Run(GM_ADDR grad, GM_ADDR col, GM_ADDR out, GM_ADDR cubeTiling)
    {
        AscendC::tiling::TCubeTiling t{}; const __gm__ int32_t *src = reinterpret_cast<const __gm__ int32_t *>(cubeTiling); int32_t *dst = reinterpret_cast<int32_t *>(&t);
        for (uint32_t i = 0; i < sizeof(t) / sizeof(int32_t); ++i) dst[i] = src[i];
        TPipe pipe; GlobalTensor<T> a, b; GlobalTensor<float> c;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(grad)); b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(col)); c.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(out));
        mm.SetSubBlockIdx(0); mm.Init(&t, &pipe); mm.SetTensorA(a, true); mm.SetTensorB(b); mm.IterateAll(c); mm.End();
    }
};

template <typename T>
__aicore__ inline void CastOutput(GM_ADDR srca, GM_ADDR dsta, uint64_t total, uint64_t blockLength)
{
    constexpr uint32_t TILE = 1024; const __gm__ float *src = reinterpret_cast<const __gm__ float *>(srca);
    GlobalTensor<T> dst; dst.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dsta), total);
    TPipe pipe; TBuf<TPosition::VECCALC> fbuf, obuf; pipe.InitBuffer(fbuf, TILE * sizeof(float)); pipe.InitBuffer(obuf, TILE * sizeof(T)); auto fp = fbuf.Get<float>(); auto out = obuf.Get<T>();
    uint64_t begin = uint64_t(GetBlockIdx()) * blockLength, end = begin + blockLength; if (end > total) end = total;
    for (uint64_t off = begin; off < end; off += TILE) {
        uint32_t count = uint32_t(end - off < TILE ? end - off : TILE); for (uint32_t i = 0; i < count; ++i) fp.SetValue(i, src[off + i]);
        PipeBarrier<PIPE_ALL>(); constexpr auto mode = std::is_same<T, bfloat16_t>::value ? RoundMode::CAST_ROUND : RoundMode::CAST_NONE; Cast(out, fp, mode, count); PipeBarrier<PIPE_ALL>();
        DataCopyExtParams cp{1, uint32_t(count * sizeof(T)), 0, 0, 0}; DataCopyPad(dst[off], out, cp); PipeBarrier<PIPE_ALL>();
    }
}

__aicore__ inline void CorrectCastBf16(GM_ADDR xa, GM_ADDR grada, GM_ADDR srca, GM_ADDR dsta,
    uint64_t nCount, uint64_t cin, uint64_t cout, uint64_t d, uint64_t h, uint64_t w, uint64_t od, uint64_t oh, uint64_t ow,
    uint64_t cinGroup, uint64_t coutGroup, uint64_t kd, uint64_t kh, uint64_t kw,
    uint64_t sd, uint64_t sh, uint64_t sw, uint64_t pf, uint64_t pt, uint64_t pl,
    uint64_t dd, uint64_t dh, uint64_t dw, uint64_t group, uint64_t total, uint64_t blockLength)
{
    constexpr uint32_t TILE = 256; constexpr float LIMIT = 1.0f;
    const __gm__ bfloat16_t *x = reinterpret_cast<const __gm__ bfloat16_t *>(xa), *grad = reinterpret_cast<const __gm__ bfloat16_t *>(grada); const __gm__ float *src = reinterpret_cast<const __gm__ float *>(srca);
    GlobalTensor<bfloat16_t> dst; dst.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(dsta), total);
    TPipe pipe; TBuf<TPosition::VECCALC> fbuf, obuf; pipe.InitBuffer(fbuf, TILE * 4); pipe.InitBuffer(obuf, TILE * 2); auto fp = fbuf.Get<float>(); auto out = obuf.Get<bfloat16_t>();
    uint64_t begin = uint64_t(GetBlockIdx()) * blockLength, end = begin + blockLength; if (end > total) end = total;
    uint64_t spatial = od * oh * ow, inputSpatial = d * h * w, kernelVolume = kd * kh * kw;
    for (uint64_t off = begin; off < end; off += TILE) {
        uint32_t count = uint32_t(end - off < TILE ? end - off : TILE);
        for (uint32_t i = 0; i < count; ++i) {
            uint64_t linear = off + i, kval = linear % (cinGroup * kernelVolume), co = linear / (cinGroup * kernelVolume);
            uint64_t kwv = kval % kw, q = kval / kw, khv = q % kh; q /= kh; uint64_t kdv = q % kd, ci = q / kd; float value = src[linear];
            bool nonFinite = !(value <= 3.402823466e38f && value >= -3.402823466e38f);
            if (nonFinite || (value != 0.0f && value > -LIMIT && value < LIMIT)) {
                float sum = 0.0f;
                for (uint64_t n = 0; n < nCount; ++n) for (uint64_t s = 0; s < spatial; ++s) {
                    uint64_t owv = s % ow, sq = s / ow, ohv = sq % oh, odv = sq / oh;
                    int64_t id = int64_t(odv * sd + kdv * dd) - int64_t(pf), ih = int64_t(ohv * sh + khv * dh) - int64_t(pt), iw = int64_t(owv * sw + kwv * dw) - int64_t(pl);
                    if (id >= 0 && id < int64_t(d) && ih >= 0 && ih < int64_t(h) && iw >= 0 && iw < int64_t(w)) {
                        uint64_t xc = group * cinGroup + ci, gc = group * coutGroup + co;
                        sum += C3dToFloat(x[(n * cin + xc) * inputSpatial + uint64_t(id) * h * w + uint64_t(ih) * w + uint64_t(iw)]) * C3dToFloat(grad[(n * cout + gc) * spatial + s]);
                    }
                }
                value = sum;
            }
            fp.SetValue(i, value);
        }
        PipeBarrier<PIPE_ALL>(); Cast(out, fp, RoundMode::CAST_ROUND, count); PipeBarrier<PIPE_ALL>(); DataCopyExtParams cp{1, count * 2U, 0, 0, 0}; DataCopyPad(dst[off], out, cp); PipeBarrier<PIPE_ALL>();
    }
}

#define C3D_PACK_ENTRIES(NAME,SRC,WORK) \
extern "C" __global__ __aicore__ __attribute__((aiv)) void c3d_pack_grad_##NAME(GM_ADDR g,GM_ADDR p,uint64_t co,uint64_t sp,uint64_t cog,uint64_t group,uint64_t total,uint64_t block){PackGrad<SRC,WORK>(g,p,co,sp,cog,group,total,block);} \
extern "C" __global__ __aicore__ __attribute__((aiv)) void c3d_im2col_##NAME(GM_ADDR x,GM_ADDR col,uint64_t ci,uint64_t d,uint64_t h,uint64_t w,uint64_t od,uint64_t oh,uint64_t ow,uint64_t cig,uint64_t kd,uint64_t kh,uint64_t kw,uint64_t sd,uint64_t sh,uint64_t sw,uint64_t pf,uint64_t pt,uint64_t pl,uint64_t dd,uint64_t dh,uint64_t dw,uint64_t group,uint64_t total,uint64_t block){Im2Col3d<SRC,WORK>(x,col,ci,d,h,w,od,oh,ow,cig,kd,kh,kw,sd,sh,sw,pf,pt,pl,dd,dh,dw,group,total,block);} \
extern "C" __global__ __aicore__ __attribute__((aic)) void c3d_matmul_##NAME(GM_ADDR grad,GM_ADDR col,GM_ADDR out,GM_ADDR tiling){FilterGradMatmul<WORK> op;op.Run(grad,col,out,tiling);}

C3D_PACK_ENTRIES(fp16, half, half)
C3D_PACK_ENTRIES(bf16, bfloat16_t, float)
#undef C3D_PACK_ENTRIES

extern "C" __global__ __aicore__ __attribute__((aiv)) void c3d_cast_fp16(GM_ADDR src,GM_ADDR dst,uint64_t total,uint64_t block){CastOutput<half>(src,dst,total,block);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void c3d_cast_bf16(GM_ADDR x,GM_ADDR grad,GM_ADDR src,GM_ADDR dst,uint64_t n,uint64_t cin,uint64_t cout,uint64_t d,uint64_t h,uint64_t w,uint64_t od,uint64_t oh,uint64_t ow,uint64_t cig,uint64_t cog,uint64_t kd,uint64_t kh,uint64_t kw,uint64_t sd,uint64_t sh,uint64_t sw,uint64_t pf,uint64_t pt,uint64_t pl,uint64_t dd,uint64_t dh,uint64_t dw,uint64_t group,uint64_t total,uint64_t block){CorrectCastBf16(x,grad,src,dst,n,cin,cout,d,h,w,od,oh,ow,cig,cog,kd,kh,kw,sd,sh,sw,pf,pt,pl,dd,dh,dw,group,total,block);}
