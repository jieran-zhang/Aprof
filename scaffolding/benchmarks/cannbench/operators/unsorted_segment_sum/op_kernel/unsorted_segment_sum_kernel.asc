#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "unsorted_segment_sum_tiling.h"
template<typename T>__aicore__ inline T UssRead(__gm__ T*p){if constexpr(sizeof(T)==8){uint64_t b=AscendC::ReadGmByPassDCache(reinterpret_cast<__gm__ uint64_t*>(p));return *reinterpret_cast<T*>(&b);}else{uint32_t b=AscendC::ReadGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(p));return *reinterpret_cast<T*>(&b);}}
template<typename T>__aicore__ inline void UssWrite(__gm__ T*p,T v){if constexpr(sizeof(T)==8){uint64_t b=*reinterpret_cast<uint64_t*>(&v);AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint64_t*>(p),b);}else if constexpr(sizeof(T)==4){uint32_t b=*reinterpret_cast<uint32_t*>(&v);AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(p),b);}else{uint16_t b=*reinterpret_cast<uint16_t*>(&v);AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(p),b);}}

template<typename T,typename A,typename I>class UssAccum{public:__aicore__ inline void Init(GM_ADDR d,GM_ADDR ids,GM_ADDR a,const __gm__ UssTiling*t){t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(d),t->N*t->inner);id_.SetGlobalBuffer(reinterpret_cast<__gm__ I*>(ids),t->N);y_.SetGlobalBuffer(reinterpret_cast<__gm__ A*>(a),t->workspaceLength);p_.InitBuffer(xb_,4096*sizeof(T));p_.InitBuffer(yb_,4096*sizeof(A));if constexpr(!std::is_same<T,A>::value)p_.InitBuffer(fb_,4096*sizeof(float));}
 __aicore__ inline void Process(){if(AscendC::GetBlockIdx()!=0)return;for(uint64_t n=0;n<t_->N;++n){uint64_t s=static_cast<uint64_t>(id_.GetValue(n));for(uint64_t o=0;o<t_->inner;o+=4096){uint32_t z=static_cast<uint32_t>((t_->inner-o)<4096?(t_->inner-o):4096);auto x=xb_.Get<T>();auto y=yb_.Get<A>();AscendC::DataCopyExtParams cx{1,static_cast<uint32_t>(z*sizeof(T)),0,0,0},cy{1,static_cast<uint32_t>(z*sizeof(A)),0,0,0};AscendC::DataCopyPad(x,x_[n*t_->inner+o],cx,AscendC::DataCopyPadExtParams<T>{false,0,0,static_cast<T>(0)});AscendC::DataCopyPad(y,y_[s*t_->alignedInner+o],cy,AscendC::DataCopyPadExtParams<A>{false,0,0,static_cast<A>(0)});AscendC::PipeBarrier<PIPE_ALL>();if constexpr(!std::is_same<T,A>::value){auto f=fb_.Get<float>();AscendC::Cast(f,x,AscendC::RoundMode::CAST_NONE,z);AscendC::PipeBarrier<PIPE_V>();AscendC::Add(y,y,f,z);}else if constexpr(std::is_same<A,int64_t>::value){for(uint32_t k=0;k<z;++k)y.SetValue(k,y.GetValue(k)+x.GetValue(k));}else AscendC::Add(y,y,x,z);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(y_[s*t_->alignedInner+o],y,cy);AscendC::PipeBarrier<PIPE_ALL>();}}}
private:const __gm__ UssTiling*t_;AscendC::TPipe p_;AscendC::GlobalTensor<T>x_;AscendC::GlobalTensor<I>id_;AscendC::GlobalTensor<A>y_;AscendC::TBuf<AscendC::TPosition::VECCALC>xb_,yb_,fb_;};
template<typename T,typename A>__aicore__ inline void UssAccumIds(GM_ADDR d,GM_ADDR i,GM_ADDR a,const __gm__ UssTiling*t){if(t->idType==USS_ID_I32){UssAccum<T,A,int32_t>o;o.Init(d,i,a,t);o.Process();}else{UssAccum<T,A,int64_t>o;o.Init(d,i,a,t);o.Process();}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void unsorted_segment_sum_kernel(GM_ADDR d,GM_ADDR i,GM_ADDR a,GM_ADDR ta){const __gm__ UssTiling*t=reinterpret_cast<const __gm__ UssTiling*>(ta);if(t->dataType==USS_F16)UssAccumIds<half,float>(d,i,a,t);else if(t->dataType==USS_BF16)UssAccumIds<bfloat16_t,float>(d,i,a,t);else if(t->dataType==USS_F32)UssAccumIds<float,float>(d,i,a,t);else if(t->dataType==USS_I32)UssAccumIds<int32_t,int32_t>(d,i,a,t);else UssAccumIds<int64_t,int64_t>(d,i,a,t);}

template<typename D,typename A>class UssFinishOp{public:__aicore__ inline void Init(GM_ADDR a,GM_ADDR y,const __gm__ UssTiling*t){t_=t;in_.SetGlobalBuffer(reinterpret_cast<__gm__ A*>(a),t->workspaceLength);out_.SetGlobalBuffer(reinterpret_cast<__gm__ D*>(y),t->outputLength);p_.InitBuffer(ib_,4096*sizeof(A));if constexpr(!std::is_same<D,A>::value)p_.InitBuffer(ob_,4096*sizeof(D));}__aicore__ inline void Process(){if(AscendC::GetBlockIdx()!=0)return;for(uint64_t s=0;s<t_->numSegments;++s)for(uint64_t o=0;o<t_->inner;o+=4096){uint32_t z=static_cast<uint32_t>((t_->inner-o)<4096?(t_->inner-o):4096);auto i=ib_.Get<A>();AscendC::DataCopyExtParams ci{1,static_cast<uint32_t>(z*sizeof(A)),0,0,0};AscendC::DataCopyPad(i,in_[s*t_->alignedInner+o],ci,AscendC::DataCopyPadExtParams<A>{false,0,0,static_cast<A>(0)});AscendC::PipeBarrier<PIPE_ALL>();if constexpr(std::is_same<D,A>::value){AscendC::DataCopyExtParams co{1,static_cast<uint32_t>(z*sizeof(D)),0,0,0};AscendC::DataCopyPad(out_[s*t_->inner+o],i,co);}else{auto q=ob_.Get<D>();AscendC::Cast(q,i,AscendC::RoundMode::CAST_RINT,z);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams co{1,static_cast<uint32_t>(z*sizeof(D)),0,0,0};AscendC::DataCopyPad(out_[s*t_->inner+o],q,co);}AscendC::PipeBarrier<PIPE_ALL>();}}private:const __gm__ UssTiling*t_;AscendC::TPipe p_;AscendC::GlobalTensor<A>in_;AscendC::GlobalTensor<D>out_;AscendC::TBuf<AscendC::TPosition::VECCALC>ib_,ob_;};
extern "C" __global__ __aicore__ __attribute__((aiv)) void unsorted_segment_sum_finish(GM_ADDR a,GM_ADDR y,GM_ADDR ta){const __gm__ UssTiling*t=reinterpret_cast<const __gm__ UssTiling*>(ta);if(t->dataType==USS_F16){UssFinishOp<half,float>o;o.Init(a,y,t);o.Process();}else if(t->dataType==USS_BF16){UssFinishOp<bfloat16_t,float>o;o.Init(a,y,t);o.Process();}else if(t->dataType==USS_F32){UssFinishOp<float,float>o;o.Init(a,y,t);o.Process();}else if(t->dataType==USS_I32){UssFinishOp<int32_t,int32_t>o;o.Init(a,y,t);o.Process();}else{UssFinishOp<int64_t,int64_t>o;o.Init(a,y,t);o.Process();}}
