#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "apply_rotary_pos_emb_tiling.h"

template<typename T>class KernelRope{
public:
 __aicore__ inline void Init(GM_ADDR q,GM_ADDR k,GM_ADDR c,GM_ADDR s,GM_ADDR qo,GM_ADDR ko,const __gm__ RopeTilingData*t){
  t_=t;q_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(q),t_->total);k_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(k),t_->total);c_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(c),static_cast<uint64_t>(t_->cosBatched?t_->B:1)*t_->S*t_->D/2);s_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(s),static_cast<uint64_t>(t_->cosBatched?t_->B:1)*t_->S*t_->D/2);qOut_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(qo),t_->total);kOut_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ko),t_->total);
  begin_=static_cast<uint64_t>(AscendC::GetBlockIdx())*t_->rowsPerBlock;uint64_t rem=t_->rows>begin_?t_->rows-begin_:0;count_=rem<t_->rowsPerBlock?rem:t_->rowsPerBlock;uint32_t dFp=t_->D*sizeof(float),hFp=(t_->D/2)*sizeof(float);pipe_.InitBuffer(qFpBuf_,dFp);pipe_.InitBuffer(kFpBuf_,dFp);pipe_.InitBuffer(cFpBuf_,hFp);pipe_.InitBuffer(sFpBuf_,hFp);pipe_.InitBuffer(qOutFpBuf_,dFp);pipe_.InitBuffer(kOutFpBuf_,dFp);
  if constexpr(!std::is_same<T,float>::value){uint32_t dRaw=t_->D*sizeof(T),hRaw=(t_->D/2)*sizeof(T);pipe_.InitBuffer(qRawBuf_,dRaw);pipe_.InitBuffer(kRawBuf_,dRaw);pipe_.InitBuffer(cRawBuf_,hRaw);pipe_.InitBuffer(sRawBuf_,hRaw);pipe_.InitBuffer(qOutRawBuf_,dRaw);pipe_.InitBuffer(kOutRawBuf_,dRaw);}
 }
 __aicore__ inline void Process(){for(uint64_t i=0;i<count_;++i)Row(begin_+i);}
private:
 __aicore__ inline void Row(uint64_t row){uint32_t D=t_->D,H=D/2;uint64_t tmp=row;uint32_t seq,batch;if(t_->layout==0){tmp/=t_->N;seq=tmp%t_->S;batch=tmp/t_->S;}else{seq=tmp%t_->S;tmp/=t_->S;tmp/=t_->N;batch=tmp;}uint64_t base=row*D,trigBase=(t_->cosBatched?(static_cast<uint64_t>(batch)*t_->S+seq):seq)*H;auto qf=qFpBuf_.Get<float>();auto kf=kFpBuf_.Get<float>();auto cf=cFpBuf_.Get<float>();auto sf=sFpBuf_.Get<float>();AscendC::DataCopyExtParams cpD{1,D*static_cast<uint32_t>(sizeof(T)),0,0,0},cpH{1,H*static_cast<uint32_t>(sizeof(T)),0,0,0};
  if constexpr(std::is_same<T,float>::value){AscendC::DataCopyPad(qf,q_[base],cpD,AscendC::DataCopyPadExtParams<float>{true,0,0,0});AscendC::DataCopyPad(kf,k_[base],cpD,AscendC::DataCopyPadExtParams<float>{true,0,0,0});AscendC::DataCopyPad(cf,c_[trigBase],cpH,AscendC::DataCopyPadExtParams<float>{true,0,0,0});AscendC::DataCopyPad(sf,s_[trigBase],cpH,AscendC::DataCopyPadExtParams<float>{true,0,0,0});AscendC::PipeBarrier<PIPE_MTE2>();AscendC::PipeBarrier<PIPE_ALL>();}
  else{auto qr=qRawBuf_.Get<T>();auto kr=kRawBuf_.Get<T>();auto cr=cRawBuf_.Get<T>();auto sr=sRawBuf_.Get<T>();AscendC::DataCopyPad(qr,q_[base],cpD,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::DataCopyPad(kr,k_[base],cpD,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::DataCopyPad(cr,c_[trigBase],cpH,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::DataCopyPad(sr,s_[trigBase],cpH,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::PipeBarrier<PIPE_MTE2>();AscendC::PipeBarrier<PIPE_ALL>();const int32_t nd=static_cast<int32_t>(D),nh=static_cast<int32_t>(H);AscendC::Cast(qf,qr,AscendC::RoundMode::CAST_NONE,nd);AscendC::Cast(kf,kr,AscendC::RoundMode::CAST_NONE,nd);AscendC::Cast(cf,cr,AscendC::RoundMode::CAST_NONE,nh);AscendC::Cast(sf,sr,AscendC::RoundMode::CAST_NONE,nh);AscendC::PipeBarrier<PIPE_ALL>();}
  auto qof=qOutFpBuf_.Get<float>();auto kof=kOutFpBuf_.Get<float>();for(uint32_t d=0;d<D;++d){uint32_t angle,partner;float sign;if(t_->interleaved){angle=d/2;if((d&1)==0){partner=d+1;sign=-1.0f;}else{partner=d-1;sign=1.0f;}}else{angle=d%H;if(d<H){partner=d+H;sign=-1.0f;}else{partner=d-H;sign=1.0f;}}volatile float qa=qf.GetValue(d)*cf.GetValue(angle);volatile float qb=(sign*qf.GetValue(partner))*sf.GetValue(angle);volatile float ka=kf.GetValue(d)*cf.GetValue(angle);volatile float kb=(sign*kf.GetValue(partner))*sf.GetValue(angle);qof.SetValue(d,qa+qb);kof.SetValue(d,ka+kb);}AscendC::PipeBarrier<PIPE_ALL>();
  if constexpr(std::is_same<T,float>::value){AscendC::DataCopyPad(qOut_[base],qof,cpD);AscendC::DataCopyPad(kOut_[base],kof,cpD);}
  else{auto qor=qOutRawBuf_.Get<T>();auto kor=kOutRawBuf_.Get<T>();const int32_t nd=static_cast<int32_t>(D);constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(qor,qof,mode,nd);AscendC::Cast(kor,kof,mode,nd);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(qOut_[base],qor,cpD);AscendC::DataCopyPad(kOut_[base],kor,cpD);}
 }
 AscendC::TPipe pipe_;const __gm__ RopeTilingData*t_;AscendC::GlobalTensor<T>q_,k_,c_,s_,qOut_,kOut_;uint64_t begin_,count_;AscendC::TBuf<AscendC::TPosition::VECCALC>qFpBuf_,kFpBuf_,cFpBuf_,sFpBuf_,qOutFpBuf_,kOutFpBuf_,qRawBuf_,kRawBuf_,cRawBuf_,sRawBuf_,qOutRawBuf_,kOutRawBuf_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void apply_rotary_pos_emb_kernel(GM_ADDR q,GM_ADDR k,GM_ADDR c,GM_ADDR s,GM_ADDR qo,GM_ADDR ko,GM_ADDR tiling){const __gm__ RopeTilingData*t=reinterpret_cast<const __gm__ RopeTilingData*>(tiling);if(t->dtype==ROPE_F16){KernelRope<half>o;o.Init(q,k,c,s,qo,ko,t);o.Process();}else if(t->dtype==ROPE_F32){KernelRope<float>o;o.Init(q,k,c,s,qo,ko,t);o.Process();}else{KernelRope<bfloat16_t>o;o.Init(q,k,c,s,qo,ko,t);o.Process();}}
