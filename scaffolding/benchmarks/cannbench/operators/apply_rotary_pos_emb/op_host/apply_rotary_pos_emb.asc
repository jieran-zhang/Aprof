#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "apply_rotary_pos_emb_tiling.h"
#include "../op_kernel/apply_rotary_pos_emb_kernel.asc"
namespace{void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}std::vector<uint64_t>Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string x;while(std::getline(q,x,','))o.push_back(std::stoull(x));return o;}uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto x:s)n*=x;return n;}uint32_t DT(const std::string&s){if(s=="float16")return ROPE_F16;if(s=="float32")return ROPE_F32;if(s=="bfloat16")return ROPE_BF16;throw std::invalid_argument("unsupported dtype");}size_t Item(uint32_t d){return d==ROPE_F32?4:2;}}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: apply_rotary_pos_emb --shape B,S,N,D --cos-shape S,H --dtype TYPE --layout N --mode half|interleaved --query F --key F --cos F --sin F --query-out F --key-out F [--device N]\n";return 2;}int device=2;bool init=false,set=false;aclrtStream stream=nullptr;void*hq=nullptr,*hk=nullptr,*hc=nullptr,*hs=nullptr,*hqo=nullptr,*hko=nullptr,*dq=nullptr,*dk=nullptr,*dc=nullptr,*ds=nullptr,*dqo=nullptr,*dko=nullptr,*dtl=nullptr;
 try{auto sh=Shape(Arg(argc,argv,"--shape")),cs=Shape(Arg(argc,argv,"--cos-shape"));if(sh.size()!=4||(cs.size()!=2&&cs.size()!=3))throw std::invalid_argument("query rank 4 and cos rank 2/3 required");uint32_t layout=std::stoul(Arg(argc,argv,"--layout","0"));uint32_t B=sh[0],S=layout==0?sh[1]:sh[2],N=layout==0?sh[2]:sh[1],D=sh[3],dtype=DT(Arg(argc,argv,"--dtype"));bool batched=cs.size()==3;if((!batched&&(cs[0]!=S||cs[1]!=D/2))||(batched&&(cs[0]!=B||cs[1]!=S||cs[2]!=D/2)))throw std::invalid_argument("cos/sin shape mismatch");std::string mode=Arg(argc,argv,"--mode","half");if(mode!="half"&&mode!="interleaved")throw std::invalid_argument("bad rotaryMode");size_t item=Item(dtype),mainBytes=Numel(sh)*item,trigBytes=Numel(cs)*item;device=std::stoi(Arg(argc,argv,"--device","2"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(device),"aclrtSetDevice");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");auto t=ComputeRopeTiling(B,S,N,D,layout,mode=="interleaved",batched,dtype,cores);Check(aclrtCreateStream(&stream),"create stream");
  auto mh=[&](void**p,size_t n,const char*w){Check(aclrtMallocHost(p,n),w);};auto md=[&](void**p,size_t n,const char*w){Check(aclrtMalloc(p,n,ACL_MEM_MALLOC_HUGE_FIRST),w);};mh(&hq,mainBytes,"host q");mh(&hk,mainBytes,"host k");mh(&hc,trigBytes,"host cos");mh(&hs,trigBytes,"host sin");mh(&hqo,mainBytes,"host qo");mh(&hko,mainBytes,"host ko");md(&dq,mainBytes,"dev q");md(&dk,mainBytes,"dev k");md(&dc,trigBytes,"dev cos");md(&ds,trigBytes,"dev sin");md(&dqo,mainBytes,"dev qo");md(&dko,mainBytes,"dev ko");md(&dtl,sizeof(t),"dev tiling");
  if(!ReadFile(Arg(argc,argv,"--query"),hq,mainBytes)||!ReadFile(Arg(argc,argv,"--key"),hk,mainBytes)||!ReadFile(Arg(argc,argv,"--cos"),hc,trigBytes)||!ReadFile(Arg(argc,argv,"--sin"),hs,trigBytes))throw std::runtime_error("read input failed");auto cp=[&](void*d,const void*h,size_t n,const char*w){Check(aclrtMemcpy(d,n,h,n,ACL_MEMCPY_HOST_TO_DEVICE),w);};cp(dq,hq,mainBytes,"H2D q");cp(dk,hk,mainBytes,"H2D k");cp(dc,hc,trigBytes,"H2D cos");cp(ds,hs,trigBytes,"H2D sin");cp(dtl,&t,sizeof(t),"H2D tiling");apply_rotary_pos_emb_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dq),static_cast<uint8_t*>(dk),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(ds),static_cast<uint8_t*>(dqo),static_cast<uint8_t*>(dko),static_cast<uint8_t*>(dtl));Check(aclrtSynchronizeStream(stream),"sync");Check(aclrtMemcpy(hqo,mainBytes,dqo,mainBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H qo");Check(aclrtMemcpy(hko,mainBytes,dko,mainBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H ko");if(!WriteFile(Arg(argc,argv,"--query-out"),hqo,mainBytes)||!WriteFile(Arg(argc,argv,"--key-out"),hko,mainBytes))throw std::runtime_error("write output failed");std::cout<<"apply_rotary_pos_emb completed: numel="<<t.total<<" blocks="<<t.blockNum<<"\n";
  for(void*p:{dtl,dko,dqo,ds,dc,dk,dq})aclrtFree(p);for(void*p:{hko,hqo,hs,hc,hk,hq})aclrtFreeHost(p);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(device);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"apply_rotary_pos_emb failed: "<<e.what()<<"\n";for(void*p:{dtl,dko,dqo,ds,dc,dk,dq})if(p)aclrtFree(p);for(void*p:{hko,hqo,hs,hc,hk,hq})if(p)aclrtFreeHost(p);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(device);if(init)aclFinalize();return 1;}}
