#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "cummin_tiling.h"

__aicore__ inline float CumminHalfToFloat(half value) {
    const uint16_t h=*reinterpret_cast<uint16_t*>(&value);
    const uint32_t sign=static_cast<uint32_t>(h&0x8000U)<<16;
    const uint32_t exp=(h>>10)&0x1fU; uint32_t mant=h&0x3ffU; uint32_t bits=sign;
    if (exp==0x1fU) { bits|=0x7f800000U|(mant<<13); if(mant) bits|=0x400000U; }
    else if (exp) bits|=((exp+112U)<<23)|(mant<<13);
    else if (mant) { int32_t e=-14; while((mant&0x400U)==0){mant<<=1;--e;} mant&=0x3ffU; bits|=(static_cast<uint32_t>(e+127)<<23)|(mant<<13); }
    return *reinterpret_cast<float*>(&bits);
}
__aicore__ inline float CumminBfloatToFloat(bfloat16_t value) {
    const uint16_t raw=*reinterpret_cast<uint16_t*>(&value); uint32_t bits=static_cast<uint32_t>(raw)<<16;
    return *reinterpret_cast<float*>(&bits);
}
template<typename T> __aicore__ inline bool CumminIsNan(T) { return false; }
template<> __aicore__ inline bool CumminIsNan<float>(float v) {
    const uint32_t bits=*reinterpret_cast<uint32_t*>(&v); return (bits&0x7fffffffU)>0x7f800000U;
}
template<> __aicore__ inline bool CumminIsNan<half>(half v) {
    const uint16_t bits=*reinterpret_cast<uint16_t*>(&v); return (bits&0x7c00U)==0x7c00U&&(bits&0x3ffU)!=0;
}
template<> __aicore__ inline bool CumminIsNan<bfloat16_t>(bfloat16_t v) {
    const uint16_t bits=*reinterpret_cast<uint16_t*>(&v); return (bits&0x7f80U)==0x7f80U&&(bits&0x7fU)!=0;
}
template<typename T> __aicore__ inline bool CumminLess(T a,T b){return a<b;}
template<> __aicore__ inline bool CumminLess<half>(half a,half b){return CumminHalfToFloat(a)<CumminHalfToFloat(b);}
template<> __aicore__ inline bool CumminLess<bfloat16_t>(bfloat16_t a,bfloat16_t b){return CumminBfloatToFloat(a)<CumminBfloatToFloat(b);}

template<typename T>
__aicore__ inline void CumminProcess(GM_ADDR input,GM_ADDR values,GM_ADDR indices,
                                     const __gm__ CumminTilingData* t){
    __gm__ const T* x=reinterpret_cast<__gm__ const T*>(input);
    __gm__ T* y=reinterpret_cast<__gm__ T*>(values);
    __gm__ int64_t* idx=reinterpret_cast<__gm__ int64_t*>(indices);
    const uint64_t block=AscendC::GetBlockIdx();
    for(uint64_t sequence=block;sequence<t->sequenceCount;sequence+=t->blockNum){
        const uint64_t outerIndex=sequence/t->inner, innerIndex=sequence%t->inner;
        const uint64_t base=outerIndex*t->axisLength*t->inner+innerIndex;
        T current=x[base]; int64_t currentIndex=0; y[base]=current; idx[base]=0;
        for(uint64_t k=1;k<t->axisLength;++k){
            const uint64_t pos=base+k*t->inner; const T value=x[pos];
            if(CumminIsNan<T>(value)||(!CumminIsNan<T>(current)&&CumminLess<T>(value,current))){current=value;currentIndex=static_cast<int64_t>(k);}
            y[pos]=current; idx[pos]=currentIndex;
        }
    }
}

template<typename T>
class CumminStrided {
public:
    __aicore__ inline void Init(GM_ADDR input,GM_ADDR values,GM_ADDR indices,
                                const __gm__ CumminTilingData* t){
        t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(input),t->totalLength);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(values),t->totalLength);
        idx_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(indices),t->totalLength);
        pipe_.InitBuffer(inputBuf_,kElems*sizeof(T));pipe_.InitBuffer(valueBuf_,kElems*sizeof(T));
        pipe_.InitBuffer(indexBuf_,kElems*sizeof(int64_t));pipe_.InitBuffer(currentBuf_,kWidth*sizeof(T));
        pipe_.InitBuffer(currentIndexBuf_,kWidth*sizeof(int64_t));
    }
    __aicore__ inline void Process(){
        auto in=inputBuf_.Get<T>();auto out=valueBuf_.Get<T>();auto oi=indexBuf_.Get<int64_t>();
        auto cur=currentBuf_.Get<T>();auto ci=currentIndexBuf_.Get<int64_t>();
        for(uint64_t work=AscendC::GetBlockIdx();work<t_->workCount;work+=t_->blockNum){
            const uint64_t outerIndex=work/t_->groupCount,group=work%t_->groupCount;
            const uint64_t innerStart=group*kWidth;
            const uint32_t width=static_cast<uint32_t>(t_->inner-innerStart<kWidth?t_->inner-innerStart:kWidth);
            const uint32_t valueStride=static_cast<uint32_t>(((width*sizeof(T)+31)/32)*32/sizeof(T));
            const uint32_t indexStride=static_cast<uint32_t>(((width*sizeof(int64_t)+31)/32)*32/sizeof(int64_t));
            const uint64_t outerBase=outerIndex*t_->axisLength*t_->inner+innerStart;
            for(uint64_t axisStart=0;axisStart<t_->axisLength;axisStart+=kAxisTile){
                const uint32_t axisCount=static_cast<uint32_t>(t_->axisLength-axisStart<kAxisTile?t_->axisLength-axisStart:kAxisTile);
                const uint64_t base=outerBase+axisStart*t_->inner;
                AscendC::DataCopyExtParams ip{static_cast<uint16_t>(axisCount),static_cast<uint32_t>(width*sizeof(T)),
                    static_cast<uint32_t>((t_->inner-width)*sizeof(T)),0,0};
                AscendC::DataCopyPad(in,x_[base],ip,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});
                AscendC::PipeBarrier<PIPE_ALL>();
                for(uint32_t a=0;a<axisCount;++a){
                    const uint64_t globalAxis=axisStart+a;
                    for(uint32_t lane=0;lane<width;++lane){
                        const uint32_t valuePos=a*valueStride+lane,indexPos=a*indexStride+lane;
                        const T value=in.GetValue(valuePos);
                        T current;int64_t currentIndex;
                        if(globalAxis==0){current=value;currentIndex=0;}
                        else{current=cur.GetValue(lane);currentIndex=ci.GetValue(lane);
                            if(CumminIsNan<T>(value)||(!CumminIsNan<T>(current)&&CumminLess<T>(value,current))){current=value;currentIndex=static_cast<int64_t>(globalAxis);}}
                        cur.SetValue(lane,current);ci.SetValue(lane,currentIndex);
                        out.SetValue(valuePos,current);oi.SetValue(indexPos,currentIndex);
                    }
                }
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyExtParams vp{static_cast<uint16_t>(axisCount),static_cast<uint32_t>(width*sizeof(T)),0,
                    static_cast<uint32_t>((t_->inner-width)*sizeof(T)),0};
                AscendC::DataCopyPad(y_[base],out,vp);
                AscendC::DataCopyExtParams xp{static_cast<uint16_t>(axisCount),static_cast<uint32_t>(width*sizeof(int64_t)),0,
                    static_cast<uint32_t>((t_->inner-width)*sizeof(int64_t)),0};
                AscendC::DataCopyPad(idx_[base],oi,xp);AscendC::PipeBarrier<PIPE_ALL>();
            }
        }
    }
private:
    static constexpr uint32_t kWidth=32,kAxisTile=128,kElems=kWidth*kAxisTile;
    const __gm__ CumminTilingData* t_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T>x_,y_;AscendC::GlobalTensor<int64_t>idx_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>inputBuf_,valueBuf_,indexBuf_,currentBuf_,currentIndexBuf_;
};

template<typename T>__aicore__ inline void CumminDispatch(GM_ADDR input,GM_ADDR values,GM_ADDR indices,const __gm__ CumminTilingData*t){
    const bool alignedRows=(t->axisLength*sizeof(T))%32==0&&(t->axisLength*sizeof(int64_t))%32==0;
    if(t->inner==1&&alignedRows)CumminProcess<T>(input,values,indices,t);
    else{CumminStrided<T>op;op.Init(input,values,indices,t);op.Process();}
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void cummin_kernel(
    GM_ADDR input,GM_ADDR values,GM_ADDR indices,GM_ADDR tilingAddr){
    const __gm__ CumminTilingData* t=reinterpret_cast<const __gm__ CumminTilingData*>(tilingAddr);
    if(t->dtype==CUMMIN_FLOAT16) CumminDispatch<half>(input,values,indices,t);
    else if(t->dtype==CUMMIN_FLOAT32) CumminDispatch<float>(input,values,indices,t);
    else if(t->dtype==CUMMIN_INT32) CumminDispatch<int32_t>(input,values,indices,t);
    else CumminDispatch<bfloat16_t>(input,values,indices,t);
}
