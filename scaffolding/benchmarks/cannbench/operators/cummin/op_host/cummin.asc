#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "cummin_tiling.h"
#include "../op_kernel/cummin_kernel.asc"
namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int c,char**v,const std::string&n,const std::string&d=""){for(int i=1;i+1<c;++i)if(v[i]==n)return v[i+1];return d;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream ss(s);std::string t;while(std::getline(ss,t,','))o.push_back(std::stoull(t));return o;}
uint32_t DType(const std::string&s){if(s=="float16")return CUMMIN_FLOAT16;if(s=="float32")return CUMMIN_FLOAT32;if(s=="int32")return CUMMIN_INT32;if(s=="bfloat16")return CUMMIN_BFLOAT16;throw std::invalid_argument("dtype");}
size_t Item(uint32_t d){return d==CUMMIN_FLOAT16||d==CUMMIN_BFLOAT16?2:4;}
}
int main(int argc,char**argv){
 int device=0;aclrtStream stream=nullptr;void *hi=nullptr,*hv=nullptr,*hx=nullptr,*di=nullptr,*dv=nullptr,*dx=nullptr,*dt=nullptr;bool ai=false,ds=false;
 try{auto shape=Shape(Arg(argc,argv,"--shape"));auto dtype=DType(Arg(argc,argv,"--dtype"));auto tiling=ComputeCumminTiling(shape,std::stoll(Arg(argc,argv,"--dim")),dtype);size_t xb=tiling.totalLength*Item(dtype),ib=tiling.totalLength*8;device=std::stoi(Arg(argc,argv,"--device","0"));
 Check(aclInit(nullptr),"aclInit");ai=true;Check(aclrtSetDevice(device),"setDevice");ds=true;Check(aclrtCreateStream(&stream),"createStream");
 Check(aclrtMallocHost(&hx,xb),"host input");Check(aclrtMallocHost(&hv,xb),"host values");Check(aclrtMallocHost(&hi,ib),"host indices");
 Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dev input");Check(aclrtMalloc(&dv,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dev values");Check(aclrtMalloc(&di,ib,ACL_MEM_MALLOC_HUGE_FIRST),"dev indices");Check(aclrtMalloc(&dt,sizeof(tiling),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");
 if(!ReadFile(Arg(argc,argv,"--input"),hx,xb))throw std::runtime_error("read input");Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D input");Check(aclrtMemcpy(dt,sizeof(tiling),&tiling,sizeof(tiling),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
 cummin_kernel<<<tiling.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dv),static_cast<uint8_t*>(di),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel");Check(aclrtMemcpy(hv,xb,dv,xb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H values");Check(aclrtMemcpy(hi,ib,di,ib,ACL_MEMCPY_DEVICE_TO_HOST),"D2H indices");
 if(!WriteFile(Arg(argc,argv,"--values"),hv,xb)||!WriteFile(Arg(argc,argv,"--indices"),hi,ib))throw std::runtime_error("write output");std::cout<<"cummin_kernel completed: numel="<<tiling.totalLength<<" sequences="<<tiling.sequenceCount<<" axis="<<tiling.axisLength<<"\n";
 aclrtFree(dt);aclrtFree(di);aclrtFree(dv);aclrtFree(dx);aclrtFreeHost(hi);aclrtFreeHost(hv);aclrtFreeHost(hx);aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"cummin failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(di)aclrtFree(di);if(dv)aclrtFree(dv);if(dx)aclrtFree(dx);if(hi)aclrtFreeHost(hi);if(hv)aclrtFreeHost(hv);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);if(ds)aclrtResetDevice(device);if(ai)aclFinalize();return 1;}
}
