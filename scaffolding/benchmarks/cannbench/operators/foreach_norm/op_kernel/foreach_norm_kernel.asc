#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "adv_api/math/power.h"
#include "foreach_norm_tiling.h"

template <typename T>
class KernelForeachNormPartial {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR partial,
                                const __gm__ ForeachNormTilingData *tiling) {
        tiling_ = tiling;
        blockIdx_ = AscendC::GetBlockIdx();
        const uint64_t offset = static_cast<uint64_t>(blockIdx_) * tiling_->blockLength;
        const uint64_t remain = tiling_->totalLength > offset ? tiling_->totalLength - offset : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x_.SetGlobalBuffer((__gm__ T *)x + offset, length_);
        partial_.SetGlobalBuffer((__gm__ float *)partial, tiling_->blockNum);
        const uint32_t rawBytes = tiling_->tileElements * sizeof(T);
        const uint32_t fpBytes = tiling_->tileElements * sizeof(float);
        pipe_.InitBuffer(xQ_, 1, rawBytes);
        pipe_.InitBuffer(workBuf_, fpBytes);
        pipe_.InitBuffer(reduceBuf_, fpBytes);
        pipe_.InitBuffer(scalarBuf_, 32);
        if constexpr (!std::is_same<T, float>::value) {
            pipe_.InitBuffer(castBuf_, fpBytes);
        }
    }

    __aicore__ inline void Process() {
        float accumulator = tiling_->mode == FOREACH_NORM_INF ? 0.0f : 0.0f;
        for (uint64_t off = 0; off < length_; off += tiling_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < tiling_->tileElements ? (length_ - off) : tiling_->tileElements);
            auto input = xQ_.AllocTensor<T>();
            AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(input, x_[off], copy, pad);
            xQ_.EnQue(input);
            input = xQ_.DeQue<T>();

            auto work = workBuf_.Get<float>();
            auto reduce = reduceBuf_.Get<float>();
            auto scalar = scalarBuf_.Get<float>();
            if constexpr (std::is_same<T, float>::value) {
                AscendC::Abs(work, input, count);
            } else {
                auto cast = castBuf_.Get<float>();
                AscendC::Cast(cast, input, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Abs(work, cast, count);
            }
            AscendC::PipeBarrier<PIPE_V>();

            if (tiling_->mode == FOREACH_NORM_INF) {
                AscendC::ReduceMax(scalar, work, reduce, count);
                AscendC::PipeBarrier<PIPE_ALL>();
                const float value = scalar.GetValue(0);
                accumulator = value > accumulator ? value : accumulator;
            } else if (tiling_->mode == FOREACH_NORM_ZERO) {
                AscendC::CompareScalar(work, work, 0.0f, AscendC::CMPMODE::NE, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(scalar, work, reduce, count);
                AscendC::PipeBarrier<PIPE_ALL>();
                accumulator += scalar.GetValue(0);
            } else {
                const float exponent = tiling_->scalar;
                AscendC::Power<float>(work, work, exponent, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(scalar, work, reduce, count);
                AscendC::PipeBarrier<PIPE_ALL>();
                accumulator += scalar.GetValue(0);
            }
            xQ_.FreeTensor(input);
        }
        auto scalar = scalarBuf_.Get<float>();
        scalar.SetValue(0, accumulator);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams outCopy{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(partial_[blockIdx_], scalar, outCopy);
    }

private:
    AscendC::TPipe pipe_;
    const __gm__ ForeachNormTilingData *tiling_;
    uint32_t blockIdx_;
    uint64_t length_;
    AscendC::GlobalTensor<T> x_;
    AscendC::GlobalTensor<float> partial_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf_, workBuf_, reduceBuf_, scalarBuf_;
};

template <typename T>
class KernelForeachNormFinalize {
public:
    __aicore__ inline void Init(GM_ADDR partial, GM_ADDR y,
                                const __gm__ ForeachNormTilingData *tiling) {
        tiling_ = tiling;
        partial_.SetGlobalBuffer((__gm__ float *)partial, tiling_->blockNum);
        y_.SetGlobalBuffer((__gm__ T *)y, 1);
        pipe_.InitBuffer(partialBuf_, 256);
        pipe_.InitBuffer(reduceBuf_, 256);
        pipe_.InitBuffer(outBuf_, 32);
        if constexpr (!std::is_same<T, float>::value) {
            pipe_.InitBuffer(castBuf_, 32);
        }
    }

    __aicore__ inline void Process() {
        auto values = partialBuf_.Get<float>();
        auto reduce = reduceBuf_.Get<float>();
        auto result = outBuf_.Get<float>();
        AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(tiling_->blockNum * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(values, partial_, copy, pad);
        AscendC::PipeBarrier<PIPE_ALL>();
        if (tiling_->mode == FOREACH_NORM_INF) {
            AscendC::ReduceMax(result, values, reduce, tiling_->blockNum);
        } else {
            AscendC::ReduceSum(result, values, reduce, tiling_->blockNum);
            if (tiling_->mode == FOREACH_NORM_GENERAL) {
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Power<float>(result, result, 1.0f / tiling_->scalar, 1);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams outCopy{1, static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        if constexpr (std::is_same<T, float>::value) {
            AscendC::DataCopyPad(y_, result, outCopy);
        } else {
            auto cast = castBuf_.Get<T>();
            constexpr auto mode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(cast, result, mode, 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(y_, cast, outCopy);
        }
    }

private:
    AscendC::TPipe pipe_;
    const __gm__ ForeachNormTilingData *tiling_;
    AscendC::GlobalTensor<float> partial_;
    AscendC::GlobalTensor<T> y_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf_, reduceBuf_, outBuf_, castBuf_;
};

extern "C" __global__ __aicore__ void foreach_norm_partial_kernel(
    GM_ADDR x, GM_ADDR partial, GM_ADDR tilingAddr) {
    const __gm__ ForeachNormTilingData *t =
        reinterpret_cast<const __gm__ ForeachNormTilingData *>(tilingAddr);
    if (t->dtype == FOREACH_NORM_FLOAT32) {
        KernelForeachNormPartial<float> op; op.Init(x, partial, t); op.Process();
    } else if (t->dtype == FOREACH_NORM_FLOAT16) {
        KernelForeachNormPartial<half> op; op.Init(x, partial, t); op.Process();
    } else {
        KernelForeachNormPartial<bfloat16_t> op; op.Init(x, partial, t); op.Process();
    }
}

extern "C" __global__ __aicore__ void foreach_norm_finalize_kernel(
    GM_ADDR partial, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ ForeachNormTilingData *t =
        reinterpret_cast<const __gm__ ForeachNormTilingData *>(tilingAddr);
    if (t->dtype == FOREACH_NORM_FLOAT32) {
        KernelForeachNormFinalize<float> op; op.Init(partial, y, t); op.Process();
    } else if (t->dtype == FOREACH_NORM_FLOAT16) {
        KernelForeachNormFinalize<half> op; op.Init(partial, y, t); op.Process();
    } else {
        KernelForeachNormFinalize<bfloat16_t> op; op.Init(partial, y, t); op.Process();
    }
}
