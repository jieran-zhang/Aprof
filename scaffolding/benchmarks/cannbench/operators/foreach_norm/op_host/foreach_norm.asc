#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "foreach_norm_tiling.h"
#include "../op_kernel/foreach_norm_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return FOREACH_NORM_FLOAT16;
    if (s == "float32") return FOREACH_NORM_FLOAT32;
    if (s == "bfloat16") return FOREACH_NORM_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + s);
}
std::vector<uint64_t> Lengths(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string item;
    while (std::getline(ss, item, ',')) out.push_back(std::stoull(item));
    if (out.empty()) throw std::invalid_argument("--lengths must not be empty");
    return out;
}
void ReadExact(std::ifstream &f, void *p, size_t n) {
    if (!f.read(reinterpret_cast<char *>(p), n)) throw std::runtime_error("input TensorList file is truncated");
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: foreach_norm --lengths N[,N...] --dtype TYPE --scalar P "
                     "--input FILE --output FILE [--device 2]\n";
        return 2;
    }
    int device = 2;
    aclrtStream stream = nullptr;
    void *dx = nullptr, *dpartial = nullptr, *dy = nullptr, *dt = nullptr;
    try {
        const auto lengths = Lengths(Arg(argc, argv, "--lengths"));
        const std::string dtypeName = Arg(argc, argv, "--dtype");
        const uint32_t dtype = DType(dtypeName);
        const size_t elemBytes = dtype == FOREACH_NORM_FLOAT32 ? 4 : 2;
        const float scalar = std::stof(Arg(argc, argv, "--scalar"));
        device = std::stoi(Arg(argc, argv, "--device", "2"));
        std::ifstream fi(Arg(argc, argv, "--input"), std::ios::binary);
        std::ofstream fo(Arg(argc, argv, "--output"), std::ios::binary | std::ios::trunc);
        if (!fi || !fo) throw std::runtime_error("open TensorList files failed");

        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        const uint64_t maxLength = *std::max_element(lengths.begin(), lengths.end());
        const size_t maxBytes = static_cast<size_t>(maxLength) * elemBytes;
        Check(aclrtMalloc(&dx, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
        Check(aclrtMalloc(&dpartial, static_cast<size_t>(cores) * 32, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc partial");
        Check(aclrtMalloc(&dy, 32, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
        Check(aclrtMalloc(&dt, sizeof(ForeachNormTilingData), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");

        for (uint64_t n : lengths) {
            const size_t bytes = static_cast<size_t>(n) * elemBytes;
            std::vector<uint8_t> input(bytes);
            ReadExact(fi, input.data(), bytes);
            Check(aclrtMemcpy(dx, maxBytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x");
            const auto tiling = ComputeForeachNormTiling(n, dtype, cores, scalar);
            Check(aclrtMemcpy(dt, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
            foreach_norm_partial_kernel<<<tiling.blockNum, nullptr, stream>>>(
                static_cast<uint8_t *>(dx), static_cast<uint8_t *>(dpartial), static_cast<uint8_t *>(dt));
            foreach_norm_finalize_kernel<<<1, nullptr, stream>>>(
                static_cast<uint8_t *>(dpartial), static_cast<uint8_t *>(dy), static_cast<uint8_t *>(dt));
            Check(aclrtSynchronizeStream(stream), "kernel synchronize");
            std::vector<uint8_t> output(elemBytes);
            Check(aclrtMemcpy(output.data(), elemBytes, dy, elemBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
            if (!fo.write(reinterpret_cast<const char *>(output.data()), elemBytes))
                throw std::runtime_error("write output failed");
        }
        std::cout << "foreach_norm completed: tensors=" << lengths.size()
                  << " dtype=" << dtypeName << " scalar=" << scalar << "\n";
        aclrtFree(dt); aclrtFree(dy); aclrtFree(dpartial); aclrtFree(dx);
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "foreach_norm failed: " << e.what() << "\n";
        if (dt) aclrtFree(dt); if (dy) aclrtFree(dy); if (dpartial) aclrtFree(dpartial); if (dx) aclrtFree(dx);
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
