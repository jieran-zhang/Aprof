#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "moe_gating_top_k_softmax_tiling.h"
#include "../op_kernel/moe_gating_top_k_softmax_kernel.asc"

namespace {
void Check(aclError r, const char *what) {
  if (r != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(r));
}
std::string Arg(int n, char **v, const std::string &key, const std::string &def = "") {
  for (int i = 1; i + 1 < n; ++i) if (v[i] == key) return v[i + 1];
  return def;
}
std::vector<uint64_t> Shape(const std::string &s) {
  std::vector<uint64_t> out; std::stringstream ss(s); std::string part;
  while (std::getline(ss, part, ',')) out.push_back(std::stoull(part));
  if (out.size() != 2 && out.size() != 3) throw std::invalid_argument("shape rank must be 2 or 3");
  return out;
}
void DType(const std::string &s, uint32_t &dtype, uint32_t &bytes) {
  if (s == "float16") { dtype = MOE_FP16; bytes = 2; }
  else if (s == "float32") { dtype = MOE_FP32; bytes = 4; }
  else if (s == "bfloat16") { dtype = MOE_BF16; bytes = 2; }
  else throw std::invalid_argument("unsupported dtype: " + s);
}
}

int main(int argc, char **argv) {
  if (argc < 2) {
    std::cerr << "usage: moe_gating_top_k_softmax --shape DIMS --dtype TYPE --k K --input FILE "
                 "[--finished FILE] --values FILE --experts FILE --rows FILE [--device N]\n";
    return 2;
  }
  int dev = 0; bool initialized = false, deviceSet = false; aclrtStream stream = nullptr;
  void *hx = nullptr, *hf = nullptr, *hy = nullptr, *he = nullptr, *hr = nullptr;
  void *dx = nullptr, *df = nullptr, *dy = nullptr, *de = nullptr, *dr = nullptr, *dt = nullptr;
  try {
    auto shape = Shape(Arg(argc, argv, "--shape"));
    uint32_t dtype, itemBytes; DType(Arg(argc, argv, "--dtype"), dtype, itemBytes);
    const uint64_t experts = shape.back(); uint64_t rows = 1;
    for (size_t i = 0; i + 1 < shape.size(); ++i) rows *= shape[i];
    const uint64_t k = std::stoull(Arg(argc, argv, "--k"));
    const std::string finishedPath = Arg(argc, argv, "--finished");
    const bool hasFinished = !finishedPath.empty();
    dev = std::stoi(Arg(argc, argv, "--device", "0"));
    Check(aclInit(nullptr), "aclInit"); initialized = true;
    Check(aclrtSetDevice(dev), "aclrtSetDevice"); deviceSet = true;
    int64_t cores = 1; Check(aclrtGetDeviceInfo(dev, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query cores");
    auto tiling = ComputeMoeGatingTiling(rows, experts, k, dtype, hasFinished, cores);
    const size_t xb = rows * experts * itemBytes, fb = rows, yb = rows * k * itemBytes;
    const size_t ib = rows * k * sizeof(int32_t);
    Check(aclrtCreateStream(&stream), "create stream");
    Check(aclrtMallocHost(&hx, xb), "host input"); Check(aclrtMallocHost(&hy, yb), "host values");
    Check(aclrtMallocHost(&he, ib), "host experts"); Check(aclrtMallocHost(&hr, ib), "host rows");
    if (hasFinished) Check(aclrtMallocHost(&hf, fb), "host finished");
    Check(aclrtMalloc(&dx, xb, ACL_MEM_MALLOC_HUGE_FIRST), "device input");
    Check(aclrtMalloc(&dy, yb, ACL_MEM_MALLOC_HUGE_FIRST), "device values");
    Check(aclrtMalloc(&de, ib, ACL_MEM_MALLOC_HUGE_FIRST), "device experts");
    Check(aclrtMalloc(&dr, ib, ACL_MEM_MALLOC_HUGE_FIRST), "device rows");
    Check(aclrtMalloc(&dt, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "device tiling");
    if (hasFinished) Check(aclrtMalloc(&df, fb, ACL_MEM_MALLOC_HUGE_FIRST), "device finished");
    if (!ReadFile(Arg(argc, argv, "--input"), hx, xb)) throw std::runtime_error("read input failed");
    if (hasFinished && !ReadFile(finishedPath, hf, fb)) throw std::runtime_error("read finished failed");
    Check(aclrtMemcpy(dx, xb, hx, xb, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
    if (hasFinished) Check(aclrtMemcpy(df, fb, hf, fb, ACL_MEMCPY_HOST_TO_DEVICE), "H2D finished");
    Check(aclrtMemcpy(dt, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
    moe_gating_top_k_softmax_kernel<<<tiling.blockNum, nullptr, stream>>>(
        static_cast<uint8_t *>(dx), static_cast<uint8_t *>(df), static_cast<uint8_t *>(dy),
        static_cast<uint8_t *>(de), static_cast<uint8_t *>(dr), static_cast<uint8_t *>(dt));
    Check(aclrtSynchronizeStream(stream), "kernel sync");
    Check(aclrtMemcpy(hy, yb, dy, yb, ACL_MEMCPY_DEVICE_TO_HOST), "D2H values");
    Check(aclrtMemcpy(he, ib, de, ib, ACL_MEMCPY_DEVICE_TO_HOST), "D2H experts");
    Check(aclrtMemcpy(hr, ib, dr, ib, ACL_MEMCPY_DEVICE_TO_HOST), "D2H rows");
    if (!WriteFile(Arg(argc, argv, "--values"), hy, yb) ||
        !WriteFile(Arg(argc, argv, "--experts"), he, ib) ||
        !WriteFile(Arg(argc, argv, "--rows"), hr, ib)) throw std::runtime_error("write output failed");
    std::cout << "moe_gating_top_k_softmax_kernel completed: rows=" << rows << " experts=" << experts
              << " k=" << k << " blocks=" << tiling.blockNum << "\n";
    aclrtFree(dt); dt=nullptr; if(df){aclrtFree(df);df=nullptr;} aclrtFree(dr);dr=nullptr; aclrtFree(de);de=nullptr;
    aclrtFree(dy);dy=nullptr; aclrtFree(dx);dx=nullptr; if(hf){aclrtFreeHost(hf);hf=nullptr;}
    aclrtFreeHost(hr);hr=nullptr; aclrtFreeHost(he);he=nullptr; aclrtFreeHost(hy);hy=nullptr; aclrtFreeHost(hx);hx=nullptr;
    aclrtDestroyStream(stream);stream=nullptr; aclrtResetDevice(dev);deviceSet=false; aclFinalize();initialized=false;
    return 0;
  } catch (const std::exception &e) {
    std::cerr << "moe_gating_top_k_softmax failed: " << e.what() << "\n";
    if(dt)aclrtFree(dt); if(df)aclrtFree(df); if(dr)aclrtFree(dr); if(de)aclrtFree(de); if(dy)aclrtFree(dy); if(dx)aclrtFree(dx);
    if(hf)aclrtFreeHost(hf); if(hr)aclrtFreeHost(hr); if(he)aclrtFreeHost(he); if(hy)aclrtFreeHost(hy); if(hx)aclrtFreeHost(hx);
    if(stream)aclrtDestroyStream(stream); if(deviceSet)aclrtResetDevice(dev); if(initialized)aclFinalize(); return 1;
  }
}
