#include <chrono>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "arg_max_tiling.h"
#include "data_utils.h"
#include "../op_kernel/arg_max_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &text) {
    std::vector<uint64_t> shape;
    std::stringstream stream(text);
    std::string token;
    while (std::getline(stream, token, ',')) shape.push_back(std::stoull(token));
    return shape;
}
uint64_t Numel(const std::vector<uint64_t> &shape) {
    uint64_t n = 1;
    for (uint64_t value : shape) n *= value;
    return n;
}
uint32_t DType(const std::string &name) {
    if (name == "float16") return ARG_MAX_FLOAT16;
    if (name == "float32") return ARG_MAX_FLOAT32;
    if (name == "bfloat16") return ARG_MAX_BFLOAT16;
    if (name == "int32") return ARG_MAX_INT32;
    if (name == "int64") return ARG_MAX_INT64;
    throw std::invalid_argument("unsupported dtype: " + name);
}
size_t ItemSize(uint32_t dtype) {
    if (dtype == ARG_MAX_FLOAT16 || dtype == ARG_MAX_BFLOAT16) return 2;
    if (dtype == ARG_MAX_INT64) return 8;
    return 4;
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: arg_max --shape DIMS --dtype TYPE --dim DIM --keepdim 0|1 --input FILE --output FILE [--device N]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    void *hostInput = nullptr, *hostOutput = nullptr;
    void *devInput = nullptr, *devOutput = nullptr, *devTiling = nullptr;
    try {
        const auto shape = Shape(Arg(argc, argv, "--shape"));
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype"));
        const int64_t dim = std::stoll(Arg(argc, argv, "--dim"));
        const bool keepdim = std::stoi(Arg(argc, argv, "--keepdim", "0")) != 0;
        (void)keepdim;  // Layout is identical; keepdim only changes metadata shape.
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeArgMaxTiling(shape, dim, dtype, cores);
        const size_t inputBytes = Numel(shape) * ItemSize(dtype);
        const size_t outputBytes = tiling.outputLength * sizeof(int64_t);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostInput, inputBytes), "aclrtMallocHost input");
        Check(aclrtMallocHost(&hostOutput, outputBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devInput, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input");
        Check(aclrtMalloc(&devOutput, outputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--input"), hostInput, inputBytes)) throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devInput, inputBytes, hostInput, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        const auto start = std::chrono::steady_clock::now();
        arg_max_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devInput), static_cast<uint8_t *>(devOutput), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        const auto stop = std::chrono::steady_clock::now();
        Check(aclrtMemcpy(hostOutput, outputBytes, devOutput, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOutput, outputBytes)) throw std::runtime_error("write output failed");
        const double elapsedMs = std::chrono::duration<double, std::milli>(stop - start).count();
        std::cout << "arg_max_kernel completed: outputs=" << tiling.outputLength
                  << " reduce=" << tiling.reduceLength << " blocks=" << tiling.blockNum
                  << " elapsed_ms=" << elapsedMs << "\n";
        aclrtFree(devTiling); aclrtFree(devOutput); aclrtFree(devInput);
        aclrtFreeHost(hostOutput); aclrtFreeHost(hostInput); aclrtDestroyStream(stream);
        aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &error) {
        std::cerr << "arg_max failed: " << error.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOutput) aclrtFree(devOutput); if (devInput) aclrtFree(devInput);
        if (hostOutput) aclrtFreeHost(hostOutput); if (hostInput) aclrtFreeHost(hostInput);
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
