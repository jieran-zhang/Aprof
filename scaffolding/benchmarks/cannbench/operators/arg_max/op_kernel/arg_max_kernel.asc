#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "arg_max_tiling.h"

template <typename T>
class ArgMaxContiguous {
public:
    static constexpr uint32_t kTile = 8192;

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                const __gm__ ArgMaxTilingData *tiling) {
        t_ = tiling;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(input));
        out_ = reinterpret_cast<__gm__ int64_t *>(output);
        pipe_.InitBuffer(rawQ_, 1, kTile * sizeof(T));
        pipe_.InitBuffer(intBuf_, kTile * sizeof(int32_t));
        pipe_.InitBuffer(fpBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(workBuf_, 4096);
        pipe_.InitBuffer(dstBuf_, 32);
        pipe_.InitBuffer(nanMaskBuf_, 1024);
    }

    __aicore__ inline void Process() {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        uint64_t end = begin + t_->blockLength;
        if (end > t_->outputLength) end = t_->outputLength;
        for (uint64_t outIndex = begin; outIndex < end; ++outIndex) {
            ReduceOne(outIndex);
        }
    }

private:
    __aicore__ inline void ConvertToFloat(const AscendC::LocalTensor<float> &dst,
                                          const AscendC::LocalTensor<T> &src,
                                          uint32_t alignedCount) {
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(dst, src, 0.0f, alignedCount);
        } else if constexpr (std::is_same<T, int64_t>::value) {
            auto temp = intBuf_.Get<int32_t>();
            AscendC::Cast(temp, src, AscendC::RoundMode::CAST_NONE, alignedCount);
            AscendC::Cast(dst, temp, AscendC::RoundMode::CAST_NONE, alignedCount);
        } else {
            AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, alignedCount);
        }
    }

    __aicore__ inline void ReduceOne(uint64_t outIndex) {
        const uint64_t base = outIndex * t_->reduceLength;
        float best = 0.0f;
        int64_t bestIndex = 0;
        bool initialized = false;
        for (uint64_t off = 0; off < t_->reduceLength; off += kTile) {
            const uint32_t count = static_cast<uint32_t>(
                (t_->reduceLength - off) < kTile ? (t_->reduceLength - off) : kTile);
            const uint32_t alignedCount = ((count + 63U) / 64U) * 64U;
            auto raw = rawQ_.AllocTensor<T>();
            AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, 0};
            AscendC::DataCopyPad(raw, x_[base + off], params, pad);
            rawQ_.EnQue(raw);
            raw = rawQ_.DeQue<T>();
            auto values = fpBuf_.Get<float>();
            ConvertToFloat(values, raw, alignedCount);

            // Detect NaNs before ReduceMax. The first NaN is the torch.argmax
            // result and no later chunk can replace it.
            auto nanMask = nanMaskBuf_.Get<uint8_t>();
            AscendC::Compare(nanMask, values, values, AscendC::CMPMODE::NE, alignedCount);
            int32_t eventVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
            AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVToS);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVToS);
            const uint32_t maskBytes = (count + 7U) / 8U;
            for (uint32_t byteIndex = 0; byteIndex < maskBytes; ++byteIndex) {
                const uint8_t bits = nanMask.GetValue(byteIndex);
                if (bits != 0) {
                    uint32_t bit = 0;
                    while (((bits >> bit) & 1U) == 0U) ++bit;
                    out_[outIndex] = static_cast<int64_t>(off + byteIndex * 8U + bit);
                    rawQ_.FreeTensor(raw);
                    return;
                }
            }

            auto reduced = dstBuf_.Get<float>();
            auto work = workBuf_.Get<float>();
            AscendC::ReduceMax(reduced, values, work, static_cast<int32_t>(count), true);
            eventVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
            AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVToS);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVToS);
            const float candidate = reduced.GetValue(0);
            const float encodedIndex = reduced.GetValue(1);
            const uint32_t localIndex = *reinterpret_cast<const uint32_t *>(&encodedIndex);
            if (!initialized || candidate > best) {
                best = candidate;
                bestIndex = static_cast<int64_t>(off + localIndex);
                initialized = true;
            }
            rawQ_.FreeTensor(raw);
        }
        out_[outIndex] = bestIndex;
    }

    AscendC::TPipe pipe_;
    const __gm__ ArgMaxTilingData *t_;
    AscendC::GlobalTensor<T> x_;
    __gm__ int64_t *out_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> rawQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> intBuf_, fpBuf_, workBuf_, dstBuf_, nanMaskBuf_;
};

template <typename T>
class ArgMaxStrided {
public:
    static constexpr uint32_t kTile = 512;

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                const __gm__ ArgMaxTilingData *tiling) {
        t_ = tiling;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(input));
        out_ = reinterpret_cast<__gm__ int64_t *>(output);
        pipe_.InitBuffer(rawQ_, 1, kTile * sizeof(T));
        pipe_.InitBuffer(intConvertBuf_, kTile * sizeof(int32_t));
        pipe_.InitBuffer(candidateBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(bestBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(candidateIndexBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(bestIndexBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(gtMaskBuf_, 256);
        pipe_.InitBuffer(candidateNanBuf_, 256);
        pipe_.InitBuffer(bestNanBuf_, 256);
        pipe_.InitBuffer(tempMaskBuf_, 256);
        pipe_.InitBuffer(updateMaskBuf_, 256);
    }

    __aicore__ inline void Process() {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        uint64_t end = begin + t_->blockLength;
        if (end > t_->outputLength) end = t_->outputLength;
        uint64_t outIndex = begin;
        while (outIndex < end) {
            const uint64_t innerIndex = outIndex % t_->innerLength;
            uint64_t available = t_->innerLength - innerIndex;
            if (available > end - outIndex) available = end - outIndex;
            const uint32_t count = static_cast<uint32_t>(available < kTile ? available : kTile);
            ReduceTile(outIndex, innerIndex, count);
            outIndex += count;
        }
    }

private:
    __aicore__ inline void ConvertToFloat(const AscendC::LocalTensor<float> &dst,
                                          const AscendC::LocalTensor<T> &src,
                                          uint32_t alignedCount) {
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(dst, src, 0.0f, alignedCount);
        } else if constexpr (std::is_same<T, int64_t>::value) {
            auto temp = intConvertBuf_.Get<int32_t>();
            AscendC::Cast(temp, src, AscendC::RoundMode::CAST_NONE, alignedCount);
            AscendC::Cast(dst, temp, AscendC::RoundMode::CAST_NONE, alignedCount);
        } else {
            AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, alignedCount);
        }
    }

    __aicore__ inline void LoadPlane(const AscendC::LocalTensor<float> &dst,
                                     uint64_t offset, uint32_t count, uint32_t alignedCount) {
        auto raw = rawQ_.AllocTensor<T>();
        AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, 0};
        AscendC::DataCopyPad(raw, x_[offset], params, pad);
        rawQ_.EnQue(raw);
        raw = rawQ_.DeQue<T>();
        ConvertToFloat(dst, raw, alignedCount);
        rawQ_.FreeTensor(raw);
    }

    __aicore__ inline void ReduceTile(uint64_t outIndex, uint64_t innerIndex, uint32_t count) {
        const uint32_t alignedCount = ((count + 63U) / 64U) * 64U;
        const uint64_t outerIndex = outIndex / t_->innerLength;
        const uint64_t base = outerIndex * t_->reduceLength * t_->innerLength + innerIndex;
        auto best = bestBuf_.Get<float>();
        auto candidate = candidateBuf_.Get<float>();
        auto bestIndex = bestIndexBuf_.Get<float>();
        auto candidateIndex = candidateIndexBuf_.Get<float>();
        LoadPlane(best, base, count, alignedCount);
        AscendC::Duplicate(bestIndex, 0.0f, alignedCount);

        auto gtMask = gtMaskBuf_.Get<uint8_t>();
        auto candidateNan = candidateNanBuf_.Get<uint8_t>();
        auto bestNan = bestNanBuf_.Get<uint8_t>();
        auto tempMask = tempMaskBuf_.Get<uint8_t>();
        auto updateMask = updateMaskBuf_.Get<uint8_t>();
        auto gtWords = gtMask.ReinterpretCast<uint16_t>();
        auto candidateNanWords = candidateNan.ReinterpretCast<uint16_t>();
        auto bestNanWords = bestNan.ReinterpretCast<uint16_t>();
        auto tempWords = tempMask.ReinterpretCast<uint16_t>();
        auto updateWords = updateMask.ReinterpretCast<uint16_t>();
        constexpr uint32_t kMaskWords = 128;

        float kValue = 1.0f;
        for (uint64_t k = 1; k < t_->reduceLength; ++k, kValue += 1.0f) {
            LoadPlane(candidate, base + k * t_->innerLength, count, alignedCount);
            AscendC::Compare(gtMask, candidate, best, AscendC::CMPMODE::GT, alignedCount);
            AscendC::Compare(candidateNan, candidate, candidate, AscendC::CMPMODE::NE, alignedCount);
            AscendC::Compare(bestNan, best, best, AscendC::CMPMODE::NE, alignedCount);
            AscendC::Not(tempWords, bestNanWords, kMaskWords);
            AscendC::And(tempWords, candidateNanWords, tempWords, kMaskWords);
            AscendC::Or(updateWords, gtWords, tempWords, kMaskWords);
            AscendC::Select(best, updateMask, candidate, best,
                            AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, alignedCount);
            AscendC::Duplicate(candidateIndex, kValue, alignedCount);
            AscendC::Select(bestIndex, updateMask, candidateIndex, bestIndex,
                            AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, alignedCount);
        }
        const int32_t eventVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
        AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVToS);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVToS);
        for (uint32_t j = 0; j < count; ++j) {
            out_[outIndex + j] = static_cast<int64_t>(bestIndex.GetValue(j));
        }
    }

    AscendC::TPipe pipe_;
    const __gm__ ArgMaxTilingData *t_;
    AscendC::GlobalTensor<T> x_;
    __gm__ int64_t *out_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> rawQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> intConvertBuf_, candidateBuf_, bestBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> candidateIndexBuf_, bestIndexBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gtMaskBuf_, candidateNanBuf_, bestNanBuf_, tempMaskBuf_, updateMaskBuf_;
};

template <typename T>
__aicore__ inline void DispatchArgMax(GM_ADDR input, GM_ADDR output,
                                      const __gm__ ArgMaxTilingData *tiling) {
    if (tiling->innerLength == 1) {
        ArgMaxContiguous<T> op;
        op.Init(input, output, tiling);
        op.Process();
    } else {
        ArgMaxStrided<T> op;
        op.Init(input, output, tiling);
        op.Process();
    }
}

extern "C" __global__ __aicore__ __vector__ void arg_max_kernel(
    GM_ADDR input, GM_ADDR output, GM_ADDR tilingAddr) {
    const __gm__ ArgMaxTilingData *tiling =
        reinterpret_cast<const __gm__ ArgMaxTilingData *>(tilingAddr);
    if (tiling->dtype == ARG_MAX_FLOAT16) DispatchArgMax<half>(input, output, tiling);
    else if (tiling->dtype == ARG_MAX_FLOAT32) DispatchArgMax<float>(input, output, tiling);
    else if (tiling->dtype == ARG_MAX_BFLOAT16) DispatchArgMax<bfloat16_t>(input, output, tiling);
    else if (tiling->dtype == ARG_MAX_INT32) DispatchArgMax<int32_t>(input, output, tiling);
    else DispatchArgMax<int64_t>(input, output, tiling);
}
