#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "top_k_tiling.h"
#include "../op_kernel/top_k_kernel.asc"
namespace{
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&key,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==key)return v[i+1];return d;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream ss(s);std::string z;while(std::getline(ss,z,','))o.push_back(std::stoull(z));return o;}
void Dtype(const std::string&s,uint32_t&d,uint32_t&b){if(s=="int8"){d=TOPK_INT8;b=1;}else if(s=="uint8"){d=TOPK_UINT8;b=1;}else if(s=="int32"){d=TOPK_INT32;b=4;}else if(s=="int64"){d=TOPK_INT64;b=8;}else if(s=="float16"){d=TOPK_FLOAT16;b=2;}else if(s=="float32"){d=TOPK_FLOAT32;b=4;}else if(s=="bfloat16"){d=TOPK_BFLOAT16;b=2;}else throw std::invalid_argument("unsupported dtype: "+s);}
}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: top_k --shape DIMS --dtype TYPE --k K --dim D --largest 0|1 --input FILE --values FILE --indices FILE [--device N]\n";return 2;}
 int dev=0;bool init=false,set=false;aclrtStream stream=nullptr;void *hx=nullptr,*hy=nullptr,*hi=nullptr,*dx=nullptr,*dy=nullptr,*di=nullptr,*dt=nullptr;
 try{auto shape=Shape(Arg(argc,argv,"--shape"));uint32_t dtype,item;Dtype(Arg(argc,argv,"--dtype"),dtype,item);uint32_t k=std::stoul(Arg(argc,argv,"--k"));int64_t dim=std::stoll(Arg(argc,argv,"--dim"));bool largest=std::stoi(Arg(argc,argv,"--largest"))!=0;dev=std::stoi(Arg(argc,argv,"--device","0"));
  Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"aclrtSetDevice");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");auto t=ComputeTopKTiling(shape,dim,k,largest,dtype,item,cores);
  uint64_t inputNumel=t.sequenceCount*t.axis;size_t xb=inputNumel*item,yb=t.outputNumel*item,ib=t.outputNumel*sizeof(int64_t);Check(aclrtCreateStream(&stream),"create stream");
  Check(aclrtMallocHost(&hx,xb),"host input");Check(aclrtMallocHost(&hy,yb),"host values");Check(aclrtMallocHost(&hi,ib),"host indices");Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dev input");Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"dev values");Check(aclrtMalloc(&di,ib,ACL_MEM_MALLOC_HUGE_FIRST),"dev indices");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");
  if(!ReadFile(Arg(argc,argv,"--input"),hx,xb))throw std::runtime_error("read input failed");Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D input");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
  top_k_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(di),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H values");Check(aclrtMemcpy(hi,ib,di,ib,ACL_MEMCPY_DEVICE_TO_HOST),"D2H indices");
  if(!WriteFile(Arg(argc,argv,"--values"),hy,yb)||!WriteFile(Arg(argc,argv,"--indices"),hi,ib))throw std::runtime_error("write output failed");std::cout<<"top_k_kernel completed: sequences="<<t.sequenceCount<<" axis="<<t.axis<<" k="<<t.k<<" blocks="<<t.blockNum<<"\n";
  aclrtFree(dt);dt=nullptr;aclrtFree(di);di=nullptr;aclrtFree(dy);dy=nullptr;aclrtFree(dx);dx=nullptr;aclrtFreeHost(hi);hi=nullptr;aclrtFreeHost(hy);hy=nullptr;aclrtFreeHost(hx);hx=nullptr;aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(dev);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"top_k failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(di)aclrtFree(di);if(dy)aclrtFree(dy);if(dx)aclrtFree(dx);if(hi)aclrtFreeHost(hi);if(hy)aclrtFreeHost(hy);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
