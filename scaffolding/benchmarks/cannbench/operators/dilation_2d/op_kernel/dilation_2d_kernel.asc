#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "dilation_2d_tiling.h"
__aicore__ inline bool DilationNan(half v){uint16_t b=*reinterpret_cast<uint16_t*>(&v);return(b&0x7c00U)==0x7c00U&&(b&0x3ffU);}
__aicore__ inline float DilationFloat(half v){uint16_t h=*reinterpret_cast<uint16_t*>(&v);uint32_t sign=static_cast<uint32_t>(h&0x8000U)<<16,exp=(h>>10)&31U,m=h&1023U,b=sign;if(exp==31)b|=0x7f800000U|(m<<13);else if(exp)b|=(exp+112U)<<23|(m<<13);else if(m){int e=-14;while(!(m&1024U)){m<<=1;--e;}b|=static_cast<uint32_t>(e+127)<<23|((m&1023U)<<13);}return *reinterpret_cast<float*>(&b);}
__aicore__ inline half DilationNegInf(){uint16_t b=0xfc00U;return *reinterpret_cast<half*>(&b);}
__aicore__ inline half DilationFloatToHalf(float value){const uint32_t bits=*reinterpret_cast<uint32_t*>(&value);const uint16_t sign=static_cast<uint16_t>((bits>>16)&0x8000U);const uint32_t exponent=(bits>>23)&0xffU;uint32_t mantissa=bits&0x7fffffU;uint16_t result=sign;if(exponent==0xffU)result=static_cast<uint16_t>(sign|(mantissa==0?0x7c00U:0x7e00U));else{int32_t he=static_cast<int32_t>(exponent)-112;if(he>=31)result=static_cast<uint16_t>(sign|0x7c00U);else if(he<=0){if(he>=-10){mantissa|=0x800000U;uint32_t shift=14-he,rounded=mantissa>>shift,remainder=mantissa&((1U<<shift)-1U),halfway=1U<<(shift-1U);if(remainder>halfway||(remainder==halfway&&(rounded&1U)))++rounded;result=static_cast<uint16_t>(sign|rounded);}}else{uint32_t rounded=mantissa>>13,remainder=mantissa&0x1fffU;if(remainder>0x1000U||(remainder==0x1000U&&(rounded&1U)))++rounded;if(rounded==0x400U){rounded=0;++he;if(he>=31){result=static_cast<uint16_t>(sign|0x7c00U);return *reinterpret_cast<half*>(&result);}}result=static_cast<uint16_t>(sign|(static_cast<uint32_t>(he)<<10)|rounded);}}return *reinterpret_cast<half*>(&result);}
__aicore__ inline half DilationAdd(half a,half b){return DilationFloatToHalf(DilationFloat(a)+DilationFloat(b));}
extern "C" __global__ __aicore__ __attribute__((aiv)) void dilation_2d_kernel(GM_ADDR input,GM_ADDR filter,GM_ADDR output,GM_ADDR tiling){const __gm__ Dilation2DTilingData*t=reinterpret_cast<const __gm__ Dilation2DTilingData*>(tiling);__gm__ half*x=reinterpret_cast<__gm__ half*>(input);__gm__ half*f=reinterpret_cast<__gm__ half*>(filter);__gm__ half*y=reinterpret_cast<__gm__ half*>(output);uint64_t begin=static_cast<uint64_t>(AscendC::GetBlockIdx())*t->blockLength,end=begin+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;
 for(uint64_t linear=begin;linear<end;++linear){uint64_t q=linear;uint32_t c=q%t->c;q/=t->c;uint32_t ox=q%t->outW;q/=t->outW;uint32_t oy=q%t->outH;uint32_t b=q/t->outH;bool have=false;half best=DilationNegInf();
  for(uint32_t fy=0;fy<t->kh;++fy)for(uint32_t fx=0;fx<t->kw;++fx){int64_t iy=static_cast<int64_t>(oy)*t->strideH+fy*t->rateH-t->padTop,ix=static_cast<int64_t>(ox)*t->strideW+fx*t->rateW-t->padLeft;half xv=DilationNegInf();if(iy>=0&&iy<t->h&&ix>=0&&ix<t->w)xv=x[((static_cast<uint64_t>(b)*t->h+iy)*t->w+ix)*t->c+c];half v=DilationAdd(xv,f[(static_cast<uint64_t>(fy)*t->kw+fx)*t->c+c]);if(!have||DilationNan(v)||(!DilationNan(best)&&DilationFloat(v)>DilationFloat(best))){best=v;have=true;}}
  y[linear]=best;}
}
