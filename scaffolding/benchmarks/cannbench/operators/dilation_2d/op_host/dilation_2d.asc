#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "dilation_2d_tiling.h"
#include "../op_kernel/dilation_2d_kernel.asc"
namespace{void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}std::vector<uint32_t>Csv(const std::string&s){std::vector<uint32_t>o;std::stringstream z(s);std::string x;while(std::getline(z,x,','))o.push_back(std::stoul(x));return o;}}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: dilation_2d --x-shape N,H,W,C --filter-shape KH,KW,C --strides 1,H,W,1 --rates 1,H,W,1 --padding SAME|VALID --pads T,B,L,R --input FILE --filter FILE --output FILE [--device N]\n";return 2;}int dev=0;bool init=false,set=false;aclrtStream stream=nullptr;void*hx=nullptr,*hf=nullptr,*hy=nullptr,*dx=nullptr,*df=nullptr,*dy=nullptr,*dt=nullptr;
 try{auto xs=Csv(Arg(argc,argv,"--x-shape")),fs=Csv(Arg(argc,argv,"--filter-shape")),strides=Csv(Arg(argc,argv,"--strides")),rates=Csv(Arg(argc,argv,"--rates")),pads=Csv(Arg(argc,argv,"--pads","0,0,0,0"));if(xs.size()!=4||fs.size()!=3||strides.size()!=4||rates.size()!=4||pads.size()!=4||xs[3]!=fs[2])throw std::invalid_argument("invalid shapes/attributes");bool same=Arg(argc,argv,"--padding","SAME")=="SAME";dev=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"set device");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");auto t=ComputeDilation2DTiling(xs[0],xs[1],xs[2],xs[3],fs[0],fs[1],strides[1],strides[2],rates[1],rates[2],same,pads.data(),cores);size_t xb=static_cast<uint64_t>(xs[0])*xs[1]*xs[2]*xs[3]*2,fb=static_cast<uint64_t>(fs[0])*fs[1]*fs[2]*2,yb=t.outputNumel*2;Check(aclrtCreateStream(&stream),"stream");Check(aclrtMallocHost(&hx,xb),"host input");Check(aclrtMallocHost(&hf,fb),"host filter");Check(aclrtMallocHost(&hy,yb),"host output");Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dev input");Check(aclrtMalloc(&df,fb,ACL_MEM_MALLOC_HUGE_FIRST),"dev filter");Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"dev output");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");if(!ReadFile(Arg(argc,argv,"--input"),hx,xb)||!ReadFile(Arg(argc,argv,"--filter"),hf,fb))throw std::runtime_error("read input failed");Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D input");Check(aclrtMemcpy(df,fb,hf,fb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D filter");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");dilation_2d_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(df),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H output");if(!WriteFile(Arg(argc,argv,"--output"),hy,yb))throw std::runtime_error("write output failed");std::cout<<"dilation_2d_kernel completed: output="<<t.n<<","<<t.outH<<","<<t.outW<<","<<t.c<<" blocks="<<t.blockNum<<"\n";
  aclrtFree(dt);dt=nullptr;aclrtFree(dy);dy=nullptr;aclrtFree(df);df=nullptr;aclrtFree(dx);dx=nullptr;aclrtFreeHost(hy);hy=nullptr;aclrtFreeHost(hf);hf=nullptr;aclrtFreeHost(hx);hx=nullptr;aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(dev);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"dilation_2d failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dy)aclrtFree(dy);if(df)aclrtFree(df);if(dx)aclrtFree(dx);if(hy)aclrtFreeHost(hy);if(hf)aclrtFreeHost(hf);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
