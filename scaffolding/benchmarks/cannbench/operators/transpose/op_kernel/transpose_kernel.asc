#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "transpose_tiling.h"

template <typename Raw>
__aicore__ inline void TransposeScalar(GM_ADDR xAddr, GM_ADDR yAddr, const __gm__ TransposeTilingData *t) {
    __gm__ Raw *x = reinterpret_cast<__gm__ Raw *>(xAddr);
    __gm__ Raw *y = reinterpret_cast<__gm__ Raw *>(yAddr);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->totalLength) end = t->totalLength;
    for (uint64_t linear = begin; linear < end; ++linear) {
        uint64_t rem = linear;
        uint64_t source = 0;
        for (int d = static_cast<int>(t->rank) - 1; d >= 0; --d) {
            const uint64_t coord = rem % t->outputShape[d];
            rem /= t->outputShape[d];
            source += coord * t->inputStride[t->perm[d]];
        }
        y[linear] = x[source];
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void transpose_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ TransposeTilingData *t = reinterpret_cast<const __gm__ TransposeTilingData *>(tilingAddr);
    if (t->itemBytes == 1) TransposeScalar<uint8_t>(x, y, t);
    else if (t->itemBytes == 2) TransposeScalar<uint16_t>(x, y, t);
    else if (t->itemBytes == 4) TransposeScalar<uint32_t>(x, y, t);
    else TransposeScalar<uint64_t>(x, y, t);
}
