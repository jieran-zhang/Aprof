#pragma once
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;
using namespace matmul;

class QuantMatmulCubeKernel {
public:
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t, false>;
    MatmulImpl<AType, BType, CType, BiasType> mm;
    GlobalTensor<int8_t> aGm, bGm;
    GlobalTensor<int32_t> cGm;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,
                                uint64_t aOffset, uint64_t bOffset,
                                uint64_t cOffset, uint64_t aCount,
                                uint64_t bCount, uint64_t cCount) {
        aGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(a) + aOffset, aCount);
        bGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(b) + bOffset, bCount);
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(c) + cOffset, cCount);
    }
    __aicore__ inline void Process() {
        mm.SetTensorA(aGm);
        mm.SetTensorB(bGm);
        mm.IterateAll(cGm);
        mm.End();
    }
};

extern "C" __global__ __aicore__ __attribute__((aic)) void quant_matmul_cube(
    GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR cubeTiling,
    uint64_t aOffset, uint64_t bOffset, uint64_t cOffset,
    uint64_t aCount, uint64_t bCount, uint64_t cCount) {
    AscendC::tiling::TCubeTiling local{};
    const __gm__ int32_t *src = reinterpret_cast<const __gm__ int32_t *>(cubeTiling);
    int32_t *dst = reinterpret_cast<int32_t *>(&local);
    for (uint32_t i = 0; i < sizeof(local) / sizeof(int32_t); ++i) dst[i] = src[i];
    TPipe pipe;
    QuantMatmulCubeKernel op;
    op.mm.SetSubBlockIdx(0);
    op.mm.Init(&local, &pipe);
    op.Init(a, b, c, aOffset, bOffset, cOffset, aCount, bCount, cCount);
    op.Process();
}

union QmBits { float f; uint32_t u; };

__aicore__ inline uint16_t QmFloatToHalf(float x) {
    QmBits z; z.f = x; uint32_t u=z.u, sign=(u>>16)&0x8000U, exp=(u>>23)&255U, frac=u&0x7fffffU;
    if(exp==255U) return uint16_t(sign | (frac ? 0x7e00U : 0x7c00U));
    int32_t he=int32_t(exp)-112;
    if(he>=31) return uint16_t(sign|0x7c00U);
    if(he<=0){
        if(he < -10) return uint16_t(sign);
        uint32_t mant=frac|0x800000U, shift=uint32_t(14-he), out=mant>>shift;
        uint32_t rem=mant&((1U<<shift)-1U), mid=1U<<(shift-1U);
        if(rem>mid || (rem==mid && (out&1U))) ++out;
        return uint16_t(sign|out);
    }
    uint32_t out=frac>>13, rem=frac&0x1fffU;
    if(rem>0x1000U || (rem==0x1000U && (out&1U))) ++out;
    if(out==0x400U){out=0;++he;if(he>=31)return uint16_t(sign|0x7c00U);}
    return uint16_t(sign|(uint32_t(he)<<10)|out);
}

__aicore__ inline uint16_t QmFloatToBf16(float x) {
    QmBits z; z.f=x; uint32_t u=z.u;
    if((u&0x7f800000U)==0x7f800000U && (u&0x007fffffU)) return uint16_t((u>>16)|0x40U);
    uint32_t lsb=(u>>16)&1U; return uint16_t((u+0x7fffU+lsb)>>16);
}

__aicore__ inline float QmBf16ToFloat(uint16_t x) {
    QmBits z; z.u=uint32_t(x)<<16; return z.f;
}

template <bool BF16_OUT, bool BF16_SCALE>
__aicore__ inline void QmDequant(GM_ADDR accum, GM_ADDR scale, GM_ADDR offset,
    GM_ADDR pertoken, GM_ADDR bias, GM_ADDR out, uint64_t total, uint32_t m,
    uint32_t n, uint32_t batches, uint32_t scaleCount, uint32_t offsetCount,
    uint32_t hasOffset, uint32_t hasPertoken, uint32_t biasKind,
    uint32_t biasRank3, uint32_t launchedBlocks) {
    const __gm__ int32_t *acc = reinterpret_cast<const __gm__ int32_t *>(accum);
    const __gm__ float *sf = reinterpret_cast<const __gm__ float *>(scale);
    const __gm__ uint16_t *sb = reinterpret_cast<const __gm__ uint16_t *>(scale);
    const __gm__ float *off = reinterpret_cast<const __gm__ float *>(offset);
    const __gm__ float *pt = reinterpret_cast<const __gm__ float *>(pertoken);
    const __gm__ int32_t *bi = reinterpret_cast<const __gm__ int32_t *>(bias);
    const __gm__ float *bf = reinterpret_cast<const __gm__ float *>(bias);
    const __gm__ uint16_t *b16 = reinterpret_cast<const __gm__ uint16_t *>(bias);
    __gm__ uint16_t *y = reinterpret_cast<__gm__ uint16_t *>(out);
    uint32_t block=GetBlockIdx();
    for(uint64_t idx=block; idx<total; idx+=launchedBlocks){
        uint32_t col=uint32_t(idx%n), row=uint32_t((idx/n)%m), batch=uint32_t(idx/(uint64_t(m)*n));
        float s=BF16_SCALE ? QmBf16ToFloat(sb[scaleCount==1?0:col]) : sf[scaleCount==1?0:col];
        int32_t v=acc[idx];
        if(biasKind==1){uint64_t j=biasRank3?uint64_t(batch)*n+col:col;v+=bi[j];}
        float q=float(v)*s;
        if(hasOffset) q+=off[offsetCount==1?0:col];
        if(hasPertoken) q*=pt[row];
        if(biasKind==2){uint64_t j=biasRank3?uint64_t(batch)*n+col:col;q+=QmBf16ToFloat(b16[j]);}
        else if(biasKind==3){uint64_t j=biasRank3?uint64_t(batch)*n+col:col; q += float(reinterpret_cast<const __gm__ half *>(bias)[j]);}
        else if(biasKind==4){uint64_t j=biasRank3?uint64_t(batch)*n+col:col;q+=bf[j];}
        y[idx]=BF16_OUT?QmFloatToBf16(q):QmFloatToHalf(q);
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void quant_dequant_fp16_f32(
 GM_ADDR a,GM_ADDR s,GM_ADDR o,GM_ADDR p,GM_ADDR b,GM_ADDR y,uint64_t t,uint32_t m,uint32_t n,uint32_t ba,uint32_t sc,uint32_t oc,uint32_t ho,uint32_t hp,uint32_t bk,uint32_t br,uint32_t lb){QmDequant<false,false>(a,s,o,p,b,y,t,m,n,ba,sc,oc,ho,hp,bk,br,lb);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void quant_dequant_bf16_f32(
 GM_ADDR a,GM_ADDR s,GM_ADDR o,GM_ADDR p,GM_ADDR b,GM_ADDR y,uint64_t t,uint32_t m,uint32_t n,uint32_t ba,uint32_t sc,uint32_t oc,uint32_t ho,uint32_t hp,uint32_t bk,uint32_t br,uint32_t lb){QmDequant<true,false>(a,s,o,p,b,y,t,m,n,ba,sc,oc,ho,hp,bk,br,lb);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void quant_dequant_bf16_bf16(
 GM_ADDR a,GM_ADDR s,GM_ADDR o,GM_ADDR p,GM_ADDR b,GM_ADDR y,uint64_t t,uint32_t m,uint32_t n,uint32_t ba,uint32_t sc,uint32_t oc,uint32_t ho,uint32_t hp,uint32_t bk,uint32_t br,uint32_t lb){QmDequant<true,true>(a,s,o,p,b,y,t,m,n,ba,sc,oc,ho,hp,bk,br,lb);}
