#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "moe_finalize_routing_tiling.h"
#include "../op_kernel/moe_finalize_routing_kernel.asc"
namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
uint32_t Dtype(const std::string&s,uint32_t&bytes){if(s=="float16"){bytes=2;return MFR_FLOAT16;}if(s=="float32"){bytes=4;return MFR_FLOAT32;}if(s=="bfloat16"){bytes=2;return MFR_BFLOAT16;}throw std::invalid_argument("unsupported dtype: "+s);}
struct Buffer { void *host=nullptr,*device=nullptr; size_t bytes=0; };
void Load(Buffer&b,const std::string&path,size_t bytes){b.bytes=bytes;Check(aclrtMallocHost(&b.host,bytes),"host alloc");Check(aclrtMalloc(&b.device,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device alloc");if(!ReadFile(path,b.host,bytes))throw std::runtime_error("read failed: "+path);Check(aclrtMemcpy(b.device,bytes,b.host,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}
void Free(Buffer&b){if(b.device)aclrtFree(b.device);if(b.host)aclrtFreeHost(b.host);b={};}
}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: moe_finalize_routing --rows N --hidden H --expanded-rows M --k K --experts E --dtype T --scale-dtype T --mode M --expanded F --mapping F [--skip1 F] [--skip2 F] [--bias F] [--scales F] [--expert-ids F] --output F [--device 0]\n";return 2;}
 int dev=0;bool init=false,set=false;aclrtStream stream=nullptr;void*dt=nullptr;Buffer x,map,s1,s2,bias,scales,experts,out;
 try{uint64_t rows=std::stoull(Arg(argc,argv,"--rows")),hidden=std::stoull(Arg(argc,argv,"--hidden")),expandedRows=std::stoull(Arg(argc,argv,"--expanded-rows"));uint32_t k=std::stoul(Arg(argc,argv,"--k")),expertCount=std::stoul(Arg(argc,argv,"--experts","0")),mode=std::stoul(Arg(argc,argv,"--mode"));uint32_t item,scaleItem;uint32_t dtype=Dtype(Arg(argc,argv,"--dtype"),item),scaleDtype=Dtype(Arg(argc,argv,"--scale-dtype",Arg(argc,argv,"--dtype")),scaleItem);uint64_t nk=rows*k;std::string p1=Arg(argc,argv,"--skip1"),p2=Arg(argc,argv,"--skip2"),pb=Arg(argc,argv,"--bias"),ps=Arg(argc,argv,"--scales"),pe=Arg(argc,argv,"--expert-ids");dev=std::stoi(Arg(argc,argv,"--device","0"));
  Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"aclrtSetDevice");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");auto t=ComputeMoeFinalizeTiling(rows,hidden,nk,expandedRows,k,expertCount,dtype,scaleDtype,mode,!p1.empty(),!p2.empty(),!pb.empty(),!ps.empty(),!pe.empty(),cores);
  Check(aclrtCreateStream(&stream),"create stream");Load(x,Arg(argc,argv,"--expanded"),expandedRows*hidden*item);Load(map,Arg(argc,argv,"--mapping"),nk*4);if(t.hasSkip1)Load(s1,p1,rows*hidden*item);if(t.hasSkip2)Load(s2,p2,rows*hidden*item);if(t.hasBias)Load(bias,pb,uint64_t(expertCount)*hidden*item);if(t.hasScales)Load(scales,ps,nk*scaleItem);if(t.hasExperts)Load(experts,pe,nk*4);out.bytes=rows*hidden*item;Check(aclrtMallocHost(&out.host,out.bytes),"output host");Check(aclrtMalloc(&out.device,out.bytes,ACL_MEM_MALLOC_HUGE_FIRST),"output device");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"tiling device");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");
  moe_finalize_routing_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(x.device),static_cast<uint8_t*>(map.device),static_cast<uint8_t*>(s1.device),static_cast<uint8_t*>(s2.device),static_cast<uint8_t*>(bias.device),static_cast<uint8_t*>(scales.device),static_cast<uint8_t*>(experts.device),static_cast<uint8_t*>(out.device),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(out.host,out.bytes,out.device,out.bytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H output");if(!WriteFile(Arg(argc,argv,"--output"),out.host,out.bytes))throw std::runtime_error("write output failed");std::cout<<"moe_finalize_routing_kernel completed: rows="<<rows<<" hidden="<<hidden<<" k="<<k<<" blocks="<<t.blockNum<<"\n";
  aclrtFree(dt);dt=nullptr;Free(out);Free(experts);Free(scales);Free(bias);Free(s2);Free(s1);Free(map);Free(x);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(dev);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"moe_finalize_routing failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);Free(out);Free(experts);Free(scales);Free(bias);Free(s2);Free(s1);Free(map);Free(x);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
