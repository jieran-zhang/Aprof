#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
using namespace AscendC;
using namespace matmul;

struct GqaTiling { uint64_t B,S,Skv,Nq,Nkv,D,G,rows,totalQ,totalKV,totalScores; uint32_t blocks,dtype,causal; float scale; };

template<class T> __aicore__ inline void ReorderImpl(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,const __gm__ GqaTiling*t){
 GlobalTensor<T>Q,K,V,OQ,OK,OV;Q.SetGlobalBuffer((__gm__ T*)q);K.SetGlobalBuffer((__gm__ T*)k);V.SetGlobalBuffer((__gm__ T*)v);OQ.SetGlobalBuffer((__gm__ T*)qo);OK.SetGlobalBuffer((__gm__ T*)ko);OV.SetGlobalBuffer((__gm__ T*)vo);
 if(GetBlockIdx()!=0)return;uint64_t bid=0,stride=1;
 for(uint64_t x=bid;x<t->totalQ;x+=stride){uint64_t d=x%t->D,z=x/t->D,s=z%t->S;z/=t->S;uint64_t g=z%t->G;z/=t->G;uint64_t h=z%t->Nkv,b=z/t->Nkv;uint64_t hq=h*t->G+g;OQ.SetValue(x,Q.GetValue(((b*t->S+s)*t->Nq+hq)*t->D+d));}
 for(uint64_t x=bid;x<t->totalKV;x+=stride){uint64_t d=x%t->D,z=x/t->D,s=z%t->Skv;z/=t->Skv;uint64_t h=z%t->Nkv,b=z/t->Nkv;uint64_t src=((b*t->Skv+s)*t->Nkv+h)*t->D+d;OK.SetValue(x,K.GetValue(src));OV.SetValue(x,V.GetValue(src));}
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void gqa_reorder(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,GM_ADDR tt){const __gm__ GqaTiling*t=(const __gm__ GqaTiling*)tt;if(t->dtype==0)ReorderImpl<half>(q,k,v,qo,ko,vo,t);else ReorderImpl<bfloat16_t>(q,k,v,qo,ko,vo,t);}

template<class T> class GqaSoftmax { public:
 __aicore__ inline void Init(GM_ADDR x,const __gm__ GqaTiling*t){t_=t;x_.SetGlobalBuffer((__gm__ T*)x);p_.InitBuffer(raw_,t->Skv*sizeof(T));p_.InitBuffer(fp_,t->Skv*sizeof(float));p_.InitBuffer(q_,t->Skv*sizeof(float));p_.InitBuffer(poly_,t->Skv*sizeof(float));p_.InitBuffer(work_,8192);p_.InitBuffer(scalar_,32);}
 __aicore__ inline void SoftExp(const LocalTensor<float>&v,uint32_t n){if(t_->causal){Exp(v,v,n);return;}auto qf=q_.Get<float>();auto qi=qf.ReinterpretCast<int32_t>();Muls(qf,v,1.44269504088896341f,n);Cast(qi,qf,RoundMode::CAST_RINT,n);Cast(qf,qi,RoundMode::CAST_NONE,n);Muls(qf,qf,-0.6931471805599453f,n);Add(v,v,qf,n);Muls(qf,qf,-1.44269504088896341f,n);Muls(qf,qf,8388608.0f,n);Adds(qf,qf,1065353216.0f,n);Cast(qi,qf,RoundMode::CAST_RINT,n);auto pow2=qi.ReinterpretCast<float>();auto p=poly_.Get<float>();Duplicate(p,0.00019852761761285365f,n);Mul(p,p,v,n);Adds(p,p,0.0013930435525253415f,n);Mul(p,p,v,n);Adds(p,p,0.008333360776305199f,n);Mul(p,p,v,n);Adds(p,p,0.041666485369205475f,n);Mul(p,p,v,n);Adds(p,p,0.1666666716337204f,n);Mul(p,p,v,n);Adds(p,p,0.5f,n);Mul(p,p,v,n);Mul(p,p,v,n);Add(p,p,v,n);Adds(p,p,1.0f,n);Mul(v,p,pow2,n);}
 __aicore__ inline void Run(){if(GetBlockIdx()!=0)return;uint64_t bid=0,stride=1;for(uint64_t r=bid;r<t_->rows;r+=stride){auto raw=raw_.Get<T>();DataCopyExtParams cp{1,uint32_t(t_->Skv*sizeof(T)),0,0,0};DataCopyPadExtParams<T>pad{true,0,0,0};DataCopyPad(raw,x_[r*t_->Skv],cp,pad);PipeBarrier<PIPE_ALL>();auto f=fp_.Get<float>();Cast(f,raw,RoundMode::CAST_NONE,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();float scale=t_->scale;Muls(f,f,scale,uint32_t(t_->Skv));constexpr auto mode=std::is_same<T,bfloat16_t>::value?RoundMode::CAST_RINT:RoundMode::CAST_NONE;Cast(raw,f,mode,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();Cast(f,raw,RoundMode::CAST_NONE,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();uint64_t s=r%t_->S;if(t_->causal){uint64_t last=s+(t_->Skv-t_->S);for(uint64_t j=last+1;j<t_->Skv;++j)f.SetValue(j,-3.402823466e38F);}auto w=work_.Get<float>();auto z=scalar_.Get<float>();ReduceMax(z,f,w,uint32_t(t_->Skv),false);PipeBarrier<PIPE_ALL>();float mx=z.GetValue(0);Adds(f,f,-mx,uint32_t(t_->Skv));PipeBarrier<PIPE_V>();if constexpr(std::is_same<T,half>::value)SoftExp(f,uint32_t(t_->Skv));else Exp(f,f,uint32_t(t_->Skv));PipeBarrier<PIPE_V>();ReduceSum(z,f,w,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();Muls(f,f,1.0f/z.GetValue(0),uint32_t(t_->Skv));Cast(raw,f,mode,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();DataCopyPad(x_[r*t_->Skv],raw,cp);PipeBarrier<PIPE_ALL>();}}
 private:TPipe p_;TBuf<TPosition::VECCALC>raw_,fp_,q_,poly_,work_,scalar_;GlobalTensor<T>x_;const __gm__ GqaTiling*t_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void gqa_softmax(GM_ADDR x,GM_ADDR tt){const __gm__ GqaTiling*t=(const __gm__ GqaTiling*)tt;if(t->dtype==0){GqaSoftmax<half>o;o.Init(x,t);o.Run();}else{GqaSoftmax<bfloat16_t>o;o.Init(x,t);o.Run();}}

template<class T,bool BT> class GqaMM {public:using A=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;using B=MatmulType<TPosition::GM,CubeFormat::ND,T,BT>;using C=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;using Bias=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;MatmulImpl<A,B,C,Bias>mm;__aicore__ void Run(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){tiling::TCubeTiling lt{};const __gm__ int32_t*s=(const __gm__ int32_t*)tile;int32_t*d=(int32_t*)&lt;for(uint32_t i=0;i<sizeof(lt)/4;++i)d[i]=s[i];TPipe p;GlobalTensor<T>ag,bg,cg;ag.SetGlobalBuffer((__gm__ T*)a+ao,ac);bg.SetGlobalBuffer((__gm__ T*)b+bo,bc);cg.SetGlobalBuffer((__gm__ T*)c+co,cc);mm.SetSubBlockIdx(0);mm.Init(&lt,&p);mm.SetTensorA(ag);mm.SetTensorB(bg,BT);mm.IterateAll(cg);mm.End();}};
template<class T,bool BT> __aicore__ inline void MM(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){GqaMM<T,BT>o;o.Run(a,b,c,tile,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gqa_qk_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<half,true>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gqa_qk_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<bfloat16_t,true>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gqa_pv_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<half,false>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gqa_pv_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<bfloat16_t,false>(a,b,c,t,ao,bo,co,ac,bc,cc);}

template<class T>__aicore__ inline void ScatterImpl(GM_ADDR in,GM_ADDR out,const __gm__ GqaTiling*t){if(GetBlockIdx()!=0)return;GlobalTensor<T>I,O;I.SetGlobalBuffer((__gm__ T*)in);O.SetGlobalBuffer((__gm__ T*)out);for(uint64_t x=0;x<t->totalQ;++x){uint64_t d=x%t->D,z=x/t->D,s=z%t->S;z/=t->S;uint64_t g=z%t->G;z/=t->G;uint64_t h=z%t->Nkv,b=z/t->Nkv;O.SetValue(((b*t->S+s)*t->Nq+h*t->G+g)*t->D+d,I.GetValue(x));}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void gqa_scatter(GM_ADDR x,GM_ADDR y,GM_ADDR tt){const __gm__ GqaTiling*t=(const __gm__ GqaTiling*)tt;if(t->dtype==0)ScatterImpl<half>(x,y,t);else ScatterImpl<bfloat16_t>(x,y,t);}
