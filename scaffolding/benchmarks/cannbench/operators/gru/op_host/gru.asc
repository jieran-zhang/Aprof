#include <algorithm>
#include <cstdlib>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <utility>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/gru_kernel.asc"
namespace {
void C(aclError e,const char*w){if(e!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(e));}
std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<std::string> Split(const std::string&s){std::vector<std::string>v;std::stringstream q(s);std::string z;while(std::getline(q,z,','))if(!z.empty())v.push_back(z);return v;}
struct Mem {std::vector<void*>d,h;~Mem(){for(void*p:d)aclrtFree(p);for(void*p:h)aclrtFreeHost(p);}void* D(size_t n){void*p=nullptr;C(aclrtMalloc(&p,std::max<size_t>(n,32),ACL_MEM_MALLOC_HUGE_FIRST),"device alloc");d.push_back(p);return p;}void* H(size_t n){void*p=nullptr;C(aclrtMallocHost(&p,std::max<size_t>(n,32)),"host alloc");h.push_back(p);return p;}};
AscendC::tiling::TCubeTiling Tile(int m,int n,int k,uint32_t dtype){using namespace matmul_tiling;PlatformInfo p{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};MatmulApiTiling a(p);auto dt=dtype==1?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16;if(a.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false)||a.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,true)||a.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT)||a.SetBiasType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT)||a.SetShape(m,n,k)||a.SetOrgShape(m,n,k)||a.SetBias(false))throw std::runtime_error("matmul tiling setup");AscendC::tiling::TCubeTiling t{};if(a.GetTiling(t))throw std::runtime_error("matmul tiling");return t;}
void CopyInput(const std::string&p,void*dh,void*dd,size_t n){if(!ReadFile(p,dh,n))throw std::runtime_error("read "+p);C(aclrtMemcpy(dd,n,dh,n,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}
}
int main(int argc,char**argv){bool init=false,set=false;aclrtStream st=nullptr;try{
 GruTiling t{};t.S=std::stoull(A(argc,argv,"--seq"));t.B=std::stoull(A(argc,argv,"--batch"));t.I=std::stoull(A(argc,argv,"--input-size"));t.H=std::stoull(A(argc,argv,"--hidden-size"));t.L=std::stoull(A(argc,argv,"--layers"));t.D=std::stoul(A(argc,argv,"--directions"));t.batchFirst=std::stoul(A(argc,argv,"--batch-first"));t.hasBias=std::stoul(A(argc,argv,"--bias"));t.hasH0=!A(argc,argv,"--h0").empty();std::string ds=A(argc,argv,"--dtype");size_t item;if(ds=="float16"){t.dtype=0;item=2;}else if(ds=="bfloat16"){t.dtype=1;item=2;}else if(ds=="float32"){t.dtype=2;item=4;}else throw std::invalid_argument("dtype");auto wiP=Split(A(argc,argv,"--weight-ih")),whP=Split(A(argc,argv,"--weight-hh")),biP=Split(A(argc,argv,"--bias-ih")),bhP=Split(A(argc,argv,"--bias-hh"));size_t nw=t.L*t.D;if(wiP.size()!=nw||whP.size()!=nw||(t.hasBias&&(biP.size()!=nw||bhP.size()!=nw)))throw std::invalid_argument("tensor-list length");
 int dev=std::stoi(A(argc,argv,"--device","0"));C(aclInit(nullptr),"aclInit");init=true;C(aclrtSetDevice(dev),"set device");set=true;C(aclrtCreateStream(&st),"stream");Mem mem;size_t xN=t.S*t.B*t.I,yN=t.S*t.B*t.D*t.H,hnN=t.L*t.D*t.B*t.H;void*hx=mem.H(xN*item);void*dx=mem.D(xN*item);CopyInput(A(argc,argv,"--x"),hx,dx,xN*item);void*dy=mem.D(yN*item);void*dhn=mem.D(hnN*item);void*hy=mem.H(yN*item);void*hhn=mem.H(hnN*item);void*dh0=mem.D(t.hasH0?hnN*item:32);if(t.hasH0){void*hh0=mem.H(hnN*item);CopyInput(A(argc,argv,"--h0"),hh0,dh0,hnN*item);}
 std::vector<void*>wi(nw),wh(nw),bi(nw),bh(nw);for(size_t idx=0;idx<nw;++idx){size_t layer=idx/t.D;size_t inDim=layer? t.D*t.H:t.I;size_t wn=3*t.H*inDim,hn=3*t.H*t.H;wi[idx]=mem.D(wn*item);wh[idx]=mem.D(hn*item);void*hwi=mem.H(wn*item),*hwh=mem.H(hn*item);CopyInput(wiP[idx],hwi,wi[idx],wn*item);CopyInput(whP[idx],hwh,wh[idx],hn*item);if(t.hasBias){bi[idx]=mem.D(3*t.H*item);bh[idx]=mem.D(3*t.H*item);void*hbi=mem.H(3*t.H*item),*hbh=mem.H(3*t.H*item);CopyInput(biP[idx],hbi,bi[idx],3*t.H*item);CopyInput(bhP[idx],hbh,bh[idx],3*t.H*item);}else{bi[idx]=mem.D(32);bh[idx]=mem.D(32);}}
 void*dt=mem.D(sizeof(t));C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");size_t maxF=std::max<uint64_t>(t.I,t.D*t.H),bufN=t.S*t.B*maxF;void*bufA=mem.D(bufN*item),*bufB=mem.D(bufN*item);gru_canonical<<<1,nullptr,st>>>((uint8_t*)dx,(uint8_t*)bufA,(uint8_t*)dt);void*hidden=mem.D(t.B*t.H*item);void*gi=mem.D(t.B*3*t.H*sizeof(float)),*gh=mem.D(t.B*3*t.H*sizeof(float)),*gti=mem.D(t.B*3*t.H*item),*gth=mem.D(t.B*3*t.H*item);void*dTileX=mem.D(sizeof(AscendC::tiling::TCubeTiling)),*dTileH=mem.D(sizeof(AscendC::tiling::TCubeTiling));
 for(uint64_t layer=0;layer<t.L;++layer){uint64_t inDim=layer?t.D*t.H:t.I;for(uint64_t dir=0;dir<t.D;++dir){C(aclrtSynchronizeStream(st),"direction barrier");uint64_t idx=layer*t.D+dir;gru_init_hidden<<<1,nullptr,st>>>((uint8_t*)dh0,(uint8_t*)hidden,(uint8_t*)dhn,(uint8_t*)dt,idx);AscendC::tiling::TCubeTiling tx{},th{};if(t.dtype<2){tx=Tile(t.B,3*t.H,inDim,t.dtype);th=Tile(t.B,3*t.H,t.H,t.dtype);C(aclrtMemcpy(dTileX,sizeof(tx),&tx,sizeof(tx),ACL_MEMCPY_HOST_TO_DEVICE),"tile x");C(aclrtMemcpy(dTileH,sizeof(th),&th,sizeof(th),ACL_MEMCPY_HOST_TO_DEVICE),"tile h");}for(uint64_t step=0;step<t.S;++step){uint64_t s=dir? t.S-1-step:step;uint64_t ao=s*t.B*inDim;if(t.dtype==0){gru_mm_fp16<<<1,nullptr,st>>>((uint8_t*)bufA,(uint8_t*)wi[idx],(uint8_t*)gi,(uint8_t*)dTileX,ao,t.B*inDim,3*t.H*inDim);gru_mm_fp16<<<1,nullptr,st>>>((uint8_t*)hidden,(uint8_t*)wh[idx],(uint8_t*)gh,(uint8_t*)dTileH,0,t.B*t.H,3*t.H*t.H);}else if(t.dtype==1){gru_mm_bf16<<<1,nullptr,st>>>((uint8_t*)bufA,(uint8_t*)wi[idx],(uint8_t*)gi,(uint8_t*)dTileX,ao,t.B*inDim,3*t.H*inDim);gru_mm_bf16<<<1,nullptr,st>>>((uint8_t*)hidden,(uint8_t*)wh[idx],(uint8_t*)gh,(uint8_t*)dTileH,0,t.B*t.H,3*t.H*t.H);}else{gru_mm_fp32<<<1,nullptr,st>>>((uint8_t*)bufA,(uint8_t*)wi[idx],(uint8_t*)gi,ao,t.B,3*t.H,inDim);gru_mm_fp32<<<1,nullptr,st>>>((uint8_t*)hidden,(uint8_t*)wh[idx],(uint8_t*)gh,0,t.B,3*t.H,t.H);}gru_update<<<1,nullptr,st>>>((uint8_t*)gi,(uint8_t*)gh,(uint8_t*)bi[idx],(uint8_t*)bh[idx],(uint8_t*)hidden,(uint8_t*)bufB,(uint8_t*)dhn,(uint8_t*)dt,s,dir,idx);}}
  std::swap(bufA,bufB);
 }
 gru_final<<<1,nullptr,st>>>((uint8_t*)bufA,(uint8_t*)dy,(uint8_t*)dt);C(aclrtSynchronizeStream(st),"kernel sync");C(aclrtMemcpy(hy,yN*item,dy,yN*item,ACL_MEMCPY_DEVICE_TO_HOST),"y D2H");C(aclrtMemcpy(hhn,hnN*item,dhn,hnN*item,ACL_MEMCPY_DEVICE_TO_HOST),"hn D2H");if(!WriteFile(A(argc,argv,"--y"),hy,yN*item)||!WriteFile(A(argc,argv,"--hn"),hhn,hnN*item))throw std::runtime_error("write outputs");std::cout<<"gru completed S="<<t.S<<" B="<<t.B<<" I="<<t.I<<" H="<<t.H<<" L="<<t.L<<" D="<<t.D<<"\n";aclrtDestroyStream(st);st=nullptr;aclrtResetDevice(dev);set=false;aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"gru failed: "<<e.what()<<"\n";if(st)aclrtDestroyStream(st);if(set)aclrtResetDevice(0);if(init)aclFinalize();return 1;}}
