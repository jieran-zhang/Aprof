#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "scatter_tiling.h"
#include "data_utils.h"
#include "../op_kernel/scatter_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string token;
    while (std::getline(ss, token, ',')) out.push_back(std::stoull(token));
    return out;
}
uint32_t DataType(const std::string &s) {
    if (s == "float16") return SCATTER_FLOAT16;
    if (s == "float32") return SCATTER_FLOAT32;
    if (s == "bfloat16") return SCATTER_BFLOAT16;
    if (s == "int32") return SCATTER_INT32;
    if (s == "int64") return SCATTER_INT64;
    throw std::invalid_argument("unsupported data dtype: " + s);
}
uint32_t IndexType(const std::string &s) {
    if (s == "int32") return SCATTER_INDEX_INT32;
    if (s == "int64") return SCATTER_INDEX_INT64;
    throw std::invalid_argument("unsupported index dtype: " + s);
}
uint32_t Reduce(const std::string &s) {
    if (s == "none" || s == "update") return SCATTER_UPDATE;
    if (s == "add") return SCATTER_ADD;
    if (s == "multiply") return SCATTER_MULTIPLY;
    if (s == "amin") return SCATTER_AMIN;
    if (s == "amax") return SCATTER_AMAX;
    throw std::invalid_argument("unsupported reduction: " + s);
}
size_t ItemSize(uint32_t d) {
    if (d == SCATTER_FLOAT16 || d == SCATTER_BFLOAT16) return 2;
    if (d == SCATTER_INT64) return 8;
    return 4;
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: scatter --data-shape DIMS --index-shape DIMS --data-dtype TYPE "
                     "--index-dtype TYPE --dim N --reduce MODE --data FILE --indices FILE "
                     "--updates FILE --output FILE [--device N]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    void *hostData = nullptr, *hostIndices = nullptr, *hostUpdates = nullptr, *hostOut = nullptr;
    void *devData = nullptr, *devIndices = nullptr, *devUpdates = nullptr, *devOut = nullptr, *devAccum = nullptr,
         *devTiling = nullptr;
    bool aclInitialized = false, deviceSet = false;
    try {
        const auto dataShape = Shape(Arg(argc, argv, "--data-shape"));
        const auto indexShape = Shape(Arg(argc, argv, "--index-shape"));
        const uint32_t dataType = DataType(Arg(argc, argv, "--data-dtype"));
        const uint32_t indexType = IndexType(Arg(argc, argv, "--index-dtype"));
        const uint32_t reduce = Reduce(Arg(argc, argv, "--reduce", "none"));
        const int64_t dim = std::stoll(Arg(argc, argv, "--dim"));
        const auto tiling = ComputeScatterTiling(dataShape, indexShape, dim, dataType, indexType, reduce);
        const size_t dataBytes = tiling.dataLength * ItemSize(dataType);
        const size_t updateBytes = tiling.updateLength * ItemSize(dataType);
        const size_t indexBytes = tiling.updateLength * (indexType == SCATTER_INDEX_INT64 ? 8 : 4);
        const bool useHalfAccumulator = dataType == SCATTER_FLOAT16 &&
                                        (reduce == SCATTER_ADD || reduce == SCATTER_MULTIPLY);
        device = std::stoi(Arg(argc, argv, "--device", "0"));

        Check(aclInit(nullptr), "aclInit"); aclInitialized = true;
        Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceSet = true;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostData, dataBytes), "aclrtMallocHost data");
        Check(aclrtMallocHost(&hostIndices, indexBytes), "aclrtMallocHost indices");
        Check(aclrtMallocHost(&hostUpdates, updateBytes), "aclrtMallocHost updates");
        Check(aclrtMallocHost(&hostOut, dataBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devData, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc data");
        Check(aclrtMalloc(&devIndices, indexBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc indices");
        Check(aclrtMalloc(&devUpdates, updateBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc updates");
        Check(aclrtMalloc(&devOut, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        if (useHalfAccumulator)
            Check(aclrtMalloc(&devAccum, tiling.dataLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc half accumulator");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--data"), hostData, dataBytes)) throw std::runtime_error("read data failed");
        if (!ReadFile(Arg(argc, argv, "--indices"), hostIndices, indexBytes)) throw std::runtime_error("read indices failed");
        if (!ReadFile(Arg(argc, argv, "--updates"), hostUpdates, updateBytes)) throw std::runtime_error("read updates failed");
        Check(aclrtMemcpy(devData, dataBytes, hostData, dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D data");
        Check(aclrtMemcpy(devIndices, indexBytes, hostIndices, indexBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D indices");
        Check(aclrtMemcpy(devUpdates, updateBytes, hostUpdates, updateBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D updates");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        Check(aclrtMemcpy(devOut, dataBytes, devData, dataBytes, ACL_MEMCPY_DEVICE_TO_DEVICE), "D2D output clone");
        if (useHalfAccumulator) {
            scatter_half_to_float_kernel<<<tiling.convertBlockNum, nullptr, stream>>>(
                static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devAccum), static_cast<uint8_t *>(devTiling));
            Check(aclrtSynchronizeStream(stream), "half accumulator initialization synchronize");
        }
        scatter_kernel<<<1, nullptr, stream>>>(
            static_cast<uint8_t *>(devIndices), static_cast<uint8_t *>(devUpdates), static_cast<uint8_t *>(devOut),
            static_cast<uint8_t *>(devAccum), static_cast<uint8_t *>(devTiling));
        if (useHalfAccumulator) {
            Check(aclrtSynchronizeStream(stream), "scatter accumulation synchronize");
            scatter_float_to_half_kernel<<<tiling.convertBlockNum, nullptr, stream>>>(
                static_cast<uint8_t *>(devAccum), static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        }
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOut, dataBytes, devOut, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, dataBytes)) throw std::runtime_error("write output failed");
        std::cout << "scatter_kernel completed: data_numel=" << tiling.dataLength
                  << " updates=" << tiling.updateLength << " dim=" << tiling.dim
                  << " reduction=" << tiling.reduce << "\n";
        aclrtFree(devTiling); if (devAccum) aclrtFree(devAccum); aclrtFree(devOut); aclrtFree(devUpdates);
        aclrtFree(devIndices); aclrtFree(devData);
        aclrtFreeHost(hostOut); aclrtFreeHost(hostUpdates); aclrtFreeHost(hostIndices); aclrtFreeHost(hostData);
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "scatter failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devAccum) aclrtFree(devAccum); if (devOut) aclrtFree(devOut);
        if (devUpdates) aclrtFree(devUpdates);
        if (devIndices) aclrtFree(devIndices); if (devData) aclrtFree(devData);
        if (hostOut) aclrtFreeHost(hostOut); if (hostUpdates) aclrtFreeHost(hostUpdates);
        if (hostIndices) aclrtFreeHost(hostIndices); if (hostData) aclrtFreeHost(hostData);
        if (stream) aclrtDestroyStream(stream); if (deviceSet) aclrtResetDevice(device); if (aclInitialized) aclFinalize();
        return 1;
    }
}
