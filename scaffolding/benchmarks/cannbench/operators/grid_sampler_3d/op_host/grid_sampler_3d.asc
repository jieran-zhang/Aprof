#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "grid_sampler_3d_tiling.h"
#include "data_utils.h"
#include "../op_kernel/grid_sampler_3d_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what)+" failed: "+std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def="") {
    for (int i=1;i+1<argc;++i) if (argv[i]==name) return argv[i+1]; return def;
}
std::vector<uint64_t> Shape(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string token;
    while (std::getline(ss,token,',')) out.push_back(std::stoull(token)); return out;
}
uint64_t Numel(const std::vector<uint64_t> &s) { uint64_t n=1; for(uint64_t v:s)n*=v; return n; }
uint32_t DType(const std::string &s) {
    if(s=="float16")return GRID_FP16; if(s=="float32")return GRID_FP32;
    throw std::invalid_argument("dtype must be float16 or float32");
}
uint32_t Interpolation(const std::string &s) {
    if(s=="bilinear")return GRID_BILINEAR; if(s=="nearest")return GRID_NEAREST;
    throw std::invalid_argument("interpolation must be bilinear or nearest");
}
uint32_t Padding(const std::string &s) {
    if(s=="zeros")return GRID_ZEROS; if(s=="border")return GRID_BORDER;
    if(s=="reflection")return GRID_REFLECTION; throw std::invalid_argument("invalid padding mode");
}
}

int main(int argc,char **argv) {
    if(argc<2){std::cerr<<"usage: grid_sampler_3d --x-shape N,C,D,H,W --grid-shape N,Do,Ho,Wo,3 "
        "--dtype TYPE --interpolation MODE --padding MODE --align-corners 0|1 --x FILE --grid FILE --output FILE [--device N]\n";return 2;}
    int device=0; bool initialized=false,deviceSet=false; aclrtStream stream=nullptr;
    void *hostX=nullptr,*hostGrid=nullptr,*hostOut=nullptr,*devX=nullptr,*devGrid=nullptr,*devOut=nullptr,*devTiling=nullptr;
    try {
        auto xShape=Shape(Arg(argc,argv,"--x-shape")), gridShape=Shape(Arg(argc,argv,"--grid-shape"));
        uint32_t dtype=DType(Arg(argc,argv,"--dtype")); size_t item=dtype==GRID_FP16?2:4;
        uint32_t interp=Interpolation(Arg(argc,argv,"--interpolation","bilinear"));
        uint32_t padding=Padding(Arg(argc,argv,"--padding","zeros"));
        bool align=std::stoi(Arg(argc,argv,"--align-corners","0"))!=0;
        device=std::stoi(Arg(argc,argv,"--device","0"));
        Check(aclInit(nullptr),"aclInit"); initialized=true; Check(aclrtSetDevice(device),"aclrtSetDevice"); deviceSet=true;
        int64_t cores=1; Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query vector cores");
        auto tiling=ComputeGridSampler3DTiling(xShape,gridShape,dtype,interp,padding,align,cores);
        size_t xBytes=Numel(xShape)*item, gridBytes=Numel(gridShape)*item, outBytes=tiling.outputNumel*item;
        Check(aclrtCreateStream(&stream),"aclrtCreateStream");
        auto mallocHost=[&](void **p,size_t n,const char*w){Check(aclrtMallocHost(p,n),w);};
        auto mallocDev=[&](void **p,size_t n,const char*w){Check(aclrtMalloc(p,n,ACL_MEM_MALLOC_HUGE_FIRST),w);};
        mallocHost(&hostX,xBytes,"host x"); mallocHost(&hostGrid,gridBytes,"host grid"); mallocHost(&hostOut,outBytes,"host output");
        mallocDev(&devX,xBytes,"device x"); mallocDev(&devGrid,gridBytes,"device grid"); mallocDev(&devOut,outBytes,"device output");
        mallocDev(&devTiling,sizeof(tiling),"device tiling");
        if(!ReadFile(Arg(argc,argv,"--x"),hostX,xBytes)||!ReadFile(Arg(argc,argv,"--grid"),hostGrid,gridBytes))
            throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devX,xBytes,hostX,xBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x");
        Check(aclrtMemcpy(devGrid,gridBytes,hostGrid,gridBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D grid");
        Check(aclrtMemcpy(devTiling,sizeof(tiling),&tiling,sizeof(tiling),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
        auto start=std::chrono::steady_clock::now();
        grid_sampler_3d_kernel<<<tiling.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(devX),static_cast<uint8_t*>(devGrid),
            static_cast<uint8_t*>(devOut),static_cast<uint8_t*>(devTiling));
        Check(aclrtSynchronizeStream(stream),"kernel synchronize");
        auto stop=std::chrono::steady_clock::now();
        Check(aclrtMemcpy(hostOut,outBytes,devOut,outBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H output");
        if(!WriteFile(Arg(argc,argv,"--output"),hostOut,outBytes))throw std::runtime_error("write output failed");
        double us=std::chrono::duration<double,std::micro>(stop-start).count();
        std::cout<<"grid_sampler_3d_kernel completed: numel="<<tiling.outputNumel<<" blocks="<<tiling.blockNum<<" kernel_us="<<us<<"\n";
        for(void*p:{devTiling,devOut,devGrid,devX})aclrtFree(p);
        for(void*p:{hostOut,hostGrid,hostX})aclrtFreeHost(p);
        aclrtDestroyStream(stream); stream=nullptr; aclrtResetDevice(device);deviceSet=false;aclFinalize();initialized=false;return 0;
    } catch(const std::exception&e) {
        std::cerr<<"grid_sampler_3d failed: "<<e.what()<<"\n";
        if(devTiling)aclrtFree(devTiling);if(devOut)aclrtFree(devOut);if(devGrid)aclrtFree(devGrid);if(devX)aclrtFree(devX);
        if(hostOut)aclrtFreeHost(hostOut);if(hostGrid)aclrtFreeHost(hostGrid);if(hostX)aclrtFreeHost(hostX);
        if(stream)aclrtDestroyStream(stream);if(deviceSet)aclrtResetDevice(device);if(initialized)aclFinalize();return 1;
    }
}
