#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "data_utils.h"
#include "moe_re_routing_tiling.h"
#include "../op_kernel/moe_re_routing_kernel.asc"

namespace {
void Check(aclError r, const char *what) {
    if (r != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(r));
}
std::string Arg(int argc, char **argv, const std::string &key, const std::string &fallback = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == key) return argv[i + 1];
    return fallback;
}
uint32_t TokenDtype(const std::string &s, uint32_t &bytes) {
    if (s == "float16") { bytes = 2; return MRR_FLOAT16; }
    if (s == "bfloat16") { bytes = 2; return MRR_BFLOAT16; }
    if (s == "int8") { bytes = 1; return MRR_INT8; }
    throw std::invalid_argument("unsupported token dtype: " + s);
}
uint32_t CountDtype(const std::string &s, uint32_t &bytes) {
    if (s == "int32") { bytes = 4; return MRR_INT32; }
    if (s == "int64") { bytes = 8; return MRR_INT64; }
    throw std::invalid_argument("unsupported count dtype: " + s);
}
struct Buffer { void *host = nullptr, *device = nullptr; size_t bytes = 0; };
void Load(Buffer &b, const std::string &path, size_t bytes) {
    b.bytes = bytes;
    Check(aclrtMallocHost(&b.host, bytes), "host alloc");
    Check(aclrtMalloc(&b.device, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "device alloc");
    if (!ReadFile(path, b.host, bytes)) throw std::runtime_error("read failed: " + path);
    Check(aclrtMemcpy(b.device, bytes, b.host, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D");
}
void Allocate(Buffer &b, size_t bytes) {
    b.bytes = bytes;
    Check(aclrtMallocHost(&b.host, bytes), "output host alloc");
    Check(aclrtMalloc(&b.device, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "output device alloc");
}
void Free(Buffer &b) {
    if (b.device) aclrtFree(b.device);
    if (b.host) aclrtFreeHost(b.host);
    b = {};
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: moe_re_routing --tokens N --hidden H --ranks N --experts E "
                     "--token-dtype T --count-dtype T --input F --counts F [--scales F] "
                     "--output F --output-scales F --output-index F --output-count F [--device 0]\n";
        return 2;
    }
    bool initialized = false, deviceSet = false;
    int device = 0;
    aclrtStream stream = nullptr;
    void *tilingDevice = nullptr;
    Buffer tokens, counts, scales, output, outputScales, outputIndex, outputCount;
    try {
        uint64_t a = std::stoull(Arg(argc, argv, "--tokens"));
        uint64_t h = std::stoull(Arg(argc, argv, "--hidden"));
        uint32_t n = std::stoul(Arg(argc, argv, "--ranks"));
        uint32_t e = std::stoul(Arg(argc, argv, "--experts"));
        uint32_t tokenBytes, countBytes;
        uint32_t tokenDtype = TokenDtype(Arg(argc, argv, "--token-dtype"), tokenBytes);
        uint32_t countDtype = CountDtype(Arg(argc, argv, "--count-dtype"), countBytes);
        std::string scalesPath = Arg(argc, argv, "--scales");
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); initialized = true;
        Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceSet = true;
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        auto tiling = ComputeMoeReRoutingTiling(a, h, n, e, tokenDtype, countDtype,
                                                !scalesPath.empty(), cores);
        Check(aclrtCreateStream(&stream), "create stream");
        Load(tokens, Arg(argc, argv, "--input"), a * h * tokenBytes);
        Load(counts, Arg(argc, argv, "--counts"), static_cast<uint64_t>(n) * e * countBytes);
        if (!scalesPath.empty()) Load(scales, scalesPath, a * sizeof(float));
        Allocate(output, a * h * tokenBytes);
        Allocate(outputScales, a * sizeof(float));
        Allocate(outputIndex, a * sizeof(int32_t));
        Allocate(outputCount, static_cast<uint64_t>(e) * countBytes);
        Check(aclrtMalloc(&tilingDevice, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "tiling alloc");
        Check(aclrtMemcpy(tilingDevice, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "tiling H2D");
        moe_re_routing_build_kernel<<<1, nullptr, stream>>>(
            static_cast<uint8_t *>(counts.device), static_cast<uint8_t *>(scales.device),
            static_cast<uint8_t *>(outputIndex.device), static_cast<uint8_t *>(outputScales.device),
            static_cast<uint8_t *>(outputCount.device), static_cast<uint8_t *>(tilingDevice));
        moe_re_routing_gather_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(tokens.device), static_cast<uint8_t *>(outputIndex.device),
            static_cast<uint8_t *>(output.device), static_cast<uint8_t *>(tilingDevice));
        Check(aclrtSynchronizeStream(stream), "kernel sync");
        Check(aclrtMemcpy(output.host, output.bytes, output.device, output.bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H tokens");
        Check(aclrtMemcpy(outputScales.host, outputScales.bytes, outputScales.device, outputScales.bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H scales");
        Check(aclrtMemcpy(outputIndex.host, outputIndex.bytes, outputIndex.device, outputIndex.bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H index");
        Check(aclrtMemcpy(outputCount.host, outputCount.bytes, outputCount.device, outputCount.bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H count");
        if (!WriteFile(Arg(argc, argv, "--output"), output.host, output.bytes) ||
            !WriteFile(Arg(argc, argv, "--output-scales"), outputScales.host, outputScales.bytes) ||
            !WriteFile(Arg(argc, argv, "--output-index"), outputIndex.host, outputIndex.bytes) ||
            !WriteFile(Arg(argc, argv, "--output-count"), outputCount.host, outputCount.bytes))
            throw std::runtime_error("write output failed");
        std::cout << "moe_re_routing device kernels completed: tokens=" << a
                  << " hidden=" << h << " ranks=" << n << " experts=" << e
                  << " blocks=" << tiling.blockNum << "\n";
        aclrtFree(tilingDevice); tilingDevice = nullptr;
        Free(outputCount); Free(outputIndex); Free(outputScales); Free(output);
        Free(scales); Free(counts); Free(tokens);
        aclrtDestroyStream(stream); stream = nullptr;
        aclrtResetDevice(device); deviceSet = false;
        aclFinalize(); initialized = false;
        return 0;
    } catch (const std::exception &ex) {
        std::cerr << "moe_re_routing failed: " << ex.what() << "\n";
        if (tilingDevice) aclrtFree(tilingDevice);
        Free(outputCount); Free(outputIndex); Free(outputScales); Free(output);
        Free(scales); Free(counts); Free(tokens);
        if (stream) aclrtDestroyStream(stream);
        if (deviceSet) aclrtResetDevice(device);
        if (initialized) aclFinalize();
        return 1;
    }
}
