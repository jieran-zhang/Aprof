#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "roi_align_tiling.h"
#include "../op_kernel/roi_align_kernel.asc"
namespace{
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int c,char**v,const std::string&n,const std::string&d=""){for(int i=1;i+1<c;++i)if(v[i]==n)return v[i+1];return d;}
std::vector<uint64_t>Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream ss(s);std::string z;while(std::getline(ss,z,','))o.push_back(std::stoull(z));return o;}
uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto v:s)n*=v;return n;}
uint32_t DType(const std::string&s){if(s=="float16")return ROI_ALIGN_FP16;if(s=="float32")return ROI_ALIGN_FP32;throw std::invalid_argument("dtype");}
}
int main(int argc,char**argv){
 if(argc<2){std::cerr<<"usage: roi_align --x-shape B,C,H,W --boxes-shape N,5 --dtype TYPE --output-height N --output-width N --spatial-scale F --sampling-ratio N --aligned 0|1 --x FILE --boxes FILE --output FILE [--device N]\n";return 2;}
 int device=0;bool init=false,set=false;aclrtStream stream=nullptr;void *hx=nullptr,*hb=nullptr,*hy=nullptr,*dx=nullptr,*db=nullptr,*dy=nullptr,*dt=nullptr;
 try{auto xs=Shape(Arg(argc,argv,"--x-shape")),bs=Shape(Arg(argc,argv,"--boxes-shape"));uint32_t dtype=DType(Arg(argc,argv,"--dtype"));size_t item=dtype?4:2;
 device=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(device),"set device");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");
 auto t=ComputeRoiAlignTiling(xs,bs,std::stoull(Arg(argc,argv,"--output-height")),std::stoull(Arg(argc,argv,"--output-width")),std::stof(Arg(argc,argv,"--spatial-scale")),std::stoi(Arg(argc,argv,"--sampling-ratio")),std::stoi(Arg(argc,argv,"--aligned"))!=0,dtype,cores);
 size_t xb=Numel(xs)*item,bb=Numel(bs)*item,yb=t.outputNumel*item;Check(aclrtCreateStream(&stream),"stream");
 for(auto q:{std::pair<void**,size_t>{&hx,xb},{&hb,bb},{&hy,yb}})Check(aclrtMallocHost(q.first,q.second),"host malloc");
 for(auto q:{std::pair<void**,size_t>{&dx,xb},{&db,bb},{&dy,yb},{&dt,sizeof(t)}})Check(aclrtMalloc(q.first,q.second,ACL_MEM_MALLOC_HUGE_FIRST),"device malloc");
 if(!ReadFile(Arg(argc,argv,"--x"),hx,xb)||!ReadFile(Arg(argc,argv,"--boxes"),hb,bb))throw std::runtime_error("read input");
 Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x");Check(aclrtMemcpy(db,bb,hb,bb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D boxes");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
 roi_align_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel");Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");
 if(!WriteFile(Arg(argc,argv,"--output"),hy,yb))throw std::runtime_error("write output");std::cout<<"roi_align_kernel completed: numel="<<t.outputNumel<<" blocks="<<t.blockNum<<"\n";
 for(void*p:{dt,dy,db,dx})aclrtFree(p);for(void*p:{hy,hb,hx})aclrtFreeHost(p);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(device);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"roi_align failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dy)aclrtFree(dy);if(db)aclrtFree(db);if(dx)aclrtFree(dx);if(hy)aclrtFreeHost(hy);if(hb)aclrtFreeHost(hb);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(device);if(init)aclFinalize();return 1;}
}
