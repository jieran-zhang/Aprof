#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "roi_align_tiling.h"

__aicore__ inline float RoiHalfToFloat(half value){
 const uint16_t h=*reinterpret_cast<uint16_t*>(&value);const uint32_t s=static_cast<uint32_t>(h&0x8000U)<<16;
 const uint32_t e=(h>>10)&31U;uint32_t m=h&1023U,b=s;
 if(e==31U){b|=0x7f800000U|(m<<13);if(m)b|=0x00400000U;}
 else if(e)b|=((e+112U)<<23)|(m<<13);
 else if(m){int32_t x=-14;while(!(m&1024U)){m<<=1;--x;}m&=1023U;b|=(static_cast<uint32_t>(x+127)<<23)|(m<<13);}
 return *reinterpret_cast<float*>(&b);
}
__aicore__ inline half RoiFloatToHalf(float value){
 const uint32_t bits=*reinterpret_cast<uint32_t*>(&value);const uint16_t sign=static_cast<uint16_t>((bits>>16)&0x8000U);
 const uint32_t exponent=(bits>>23)&255U;uint32_t mantissa=bits&0x7fffffU;uint16_t result=sign;
 if(exponent==255U)result=static_cast<uint16_t>(sign|(mantissa?0x7e00U:0x7c00U));
 else{int32_t he=static_cast<int32_t>(exponent)-112;if(he>=31)result=static_cast<uint16_t>(sign|0x7c00U);
 else if(he<=0){if(he>=-10){mantissa|=0x800000U;uint32_t sh=static_cast<uint32_t>(14-he),r=mantissa>>sh;
 uint32_t rem=mantissa&((1U<<sh)-1U),halfway=1U<<(sh-1U);if(rem>halfway||(rem==halfway&&(r&1U)))++r;result=static_cast<uint16_t>(sign|r);}}
 else{uint32_t r=mantissa>>13,rem=mantissa&0x1fffU;if(rem>0x1000U||(rem==0x1000U&&(r&1U)))++r;
 if(r==0x400U){r=0;++he;if(he>=31){result=static_cast<uint16_t>(sign|0x7c00U);return *reinterpret_cast<half*>(&result);}}
 result=static_cast<uint16_t>(sign|(static_cast<uint32_t>(he)<<10)|r);}}
 return *reinterpret_cast<half*>(&result);
}
template<class T>__aicore__ inline float RoiToFloat(T v){if constexpr(std::is_same<T,half>::value)return RoiHalfToFloat(v);else return v;}
template<class T>__aicore__ inline T RoiFromFloat(float v){if constexpr(std::is_same<T,half>::value)return RoiFloatToHalf(v);else return v;}
template<class T>__aicore__ inline float RoiRound(float v){
 if constexpr(std::is_same<T,half>::value)return RoiHalfToFloat(RoiFloatToHalf(v));else return v;
}

template<class T>__aicore__ inline float RoiRead(const __gm__ T*x,uint64_t base,int64_t y,int64_t xx,const __gm__ RoiAlignTilingData*t){
 return RoiToFloat<T>(x[base+static_cast<uint64_t>(y)*t->width+static_cast<uint64_t>(xx)]);
}
template<class T>__aicore__ inline float RoiOne(const __gm__ T*x,const __gm__ T*boxes,uint64_t linear,const __gm__ RoiAlignTilingData*t){
 const int64_t ow=static_cast<int64_t>(linear%t->outW);linear/=t->outW;const int64_t oh=static_cast<int64_t>(linear%t->outH);linear/=t->outH;
 const uint64_t channel=linear%t->channels;const uint64_t roi=linear/t->channels;const uint64_t rb=roi*5;
 const int64_t batchIndex=static_cast<int64_t>(RoiToFloat<T>(boxes[rb]));
 const float offset=RoiRound<T>(t->aligned?0.5f:0.0f),scale=RoiRound<T>(t->spatialScale);
 const float startW=RoiRound<T>(RoiRound<T>(RoiToFloat<T>(boxes[rb+1])*scale)-offset);
 const float startH=RoiRound<T>(RoiRound<T>(RoiToFloat<T>(boxes[rb+2])*scale)-offset);
 const float endW=RoiRound<T>(RoiRound<T>(RoiToFloat<T>(boxes[rb+3])*scale)-offset);
 const float endH=RoiRound<T>(RoiRound<T>(RoiToFloat<T>(boxes[rb+4])*scale)-offset);
 float roiW=RoiRound<T>(endW-startW),roiH=RoiRound<T>(endH-startH);if(!t->aligned){if(roiW<1.0f)roiW=1.0f;if(roiH<1.0f)roiH=1.0f;}
 const float binH=RoiRound<T>(roiH/RoiRound<T>(t->outHFloat)),binW=RoiRound<T>(roiW/RoiRound<T>(t->outWFloat));
 int64_t gridH=static_cast<int64_t>(t->samplingRatio),gridW=static_cast<int64_t>(t->samplingRatio);
 if(gridH==0){float gh=RoiRound<T>(roiH/RoiRound<T>(t->outHFloat)),gw=RoiRound<T>(roiW/RoiRound<T>(t->outWFloat));
 gridH=static_cast<int64_t>(gh);if(static_cast<float>(gridH)<gh)++gridH;gridW=static_cast<int64_t>(gw);if(static_cast<float>(gridW)<gw)++gridW;
 if(gridH<1)gridH=1;if(gridW<1)gridW=1;}
 const uint64_t imageBase=(static_cast<uint64_t>(batchIndex)*t->channels+channel)*t->height*t->width;
 float sum=0.0f;
 for(int64_t iy=0;iy<gridH;++iy)for(int64_t ix=0;ix<gridW;++ix){
  float yy=RoiRound<T>(RoiRound<T>(startH+RoiRound<T>(RoiRound<T>(static_cast<float>(oh))*binH))+
   RoiRound<T>(RoiRound<T>(RoiRound<T>(RoiRound<T>(static_cast<float>(iy))+RoiRound<T>(0.5f))*binH)/RoiRound<T>(static_cast<float>(gridH))));
  float xx=RoiRound<T>(RoiRound<T>(startW+RoiRound<T>(RoiRound<T>(static_cast<float>(ow))*binW))+
   RoiRound<T>(RoiRound<T>(RoiRound<T>(RoiRound<T>(static_cast<float>(ix))+RoiRound<T>(0.5f))*binW)/RoiRound<T>(static_cast<float>(gridW))));
  if(yy<0.0f)yy=0.0f;if(xx<0.0f)xx=0.0f;int64_t yl=static_cast<int64_t>(yy),xl=static_cast<int64_t>(xx);
  int64_t yh=yl+1,xh=xl+1;if(yl>=static_cast<int64_t>(t->height)-1){yl=static_cast<int64_t>(t->height)-1;yh=yl;}if(xl>=static_cast<int64_t>(t->width)-1){xl=static_cast<int64_t>(t->width)-1;xh=xl;}
  float ly=RoiRound<T>(yy-RoiRound<T>(static_cast<float>(yl))),lx=RoiRound<T>(xx-RoiRound<T>(static_cast<float>(xl)));
  float hy=RoiRound<T>(RoiRound<T>(1.0f)-ly),hx=RoiRound<T>(RoiRound<T>(1.0f)-lx);
  float v1=RoiRead<T>(x,imageBase,yl,xl,t),v2=RoiRead<T>(x,imageBase,yl,xh,t);
  float v3=RoiRead<T>(x,imageBase,yh,xl,t),v4=RoiRead<T>(x,imageBase,yh,xh,t);
  if constexpr(std::is_same<T,half>::value){
   float z=RoiRound<T>(RoiRound<T>(RoiRound<T>(hy*hx)*v1)+RoiRound<T>(RoiRound<T>(hy*lx)*v2));
   z=RoiRound<T>(z+RoiRound<T>(RoiRound<T>(ly*hx)*v3));z=RoiRound<T>(z+RoiRound<T>(RoiRound<T>(ly*lx)*v4));sum=RoiRound<T>(sum+z);
  }else sum+=(hy*hx)*v1+(hy*lx)*v2+(ly*hx)*v3+(ly*lx)*v4;
 }
 return RoiRound<T>(sum/RoiRound<T>(static_cast<float>(gridH*gridW)));
}
template<class T>__aicore__ inline void RoiProcess(GM_ADDR xa,GM_ADDR ba,GM_ADDR ya,const __gm__ RoiAlignTilingData*t){
 const __gm__ T*x=reinterpret_cast<const __gm__ T*>(xa);const __gm__ T*b=reinterpret_cast<const __gm__ T*>(ba);__gm__ T*y=reinterpret_cast<__gm__ T*>(ya);
 uint64_t begin=static_cast<uint64_t>(AscendC::GetBlockIdx())*t->blockLength,end=begin+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;
 for(uint64_t i=begin;i<end;++i)y[i]=RoiFromFloat<T>(RoiOne<T>(x,b,i,t));
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void roi_align_kernel(GM_ADDR x,GM_ADDR boxes,GM_ADDR y,GM_ADDR ta){
 const __gm__ RoiAlignTilingData*t=reinterpret_cast<const __gm__ RoiAlignTilingData*>(ta);
 if(t->dtype==ROI_ALIGN_FP16)RoiProcess<half>(x,boxes,y,t);else RoiProcess<float>(x,boxes,y,t);
}
