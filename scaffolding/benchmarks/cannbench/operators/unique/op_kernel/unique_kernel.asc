#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "unique_tiling.h"
__aicore__ inline uint64_t UniqueEncodeRaw(uint64_t raw,uint32_t dtype){
 if(dtype==UNIQUE_INT8)return (raw^0x80ULL)&0xffULL;if(dtype==UNIQUE_UINT8)return raw&0xffULL;
 if(dtype==UNIQUE_INT32)return (raw^0x80000000ULL)&0xffffffffULL;if(dtype==UNIQUE_INT64)return raw^0x8000000000000000ULL;
 if(dtype==UNIQUE_FP16||dtype==UNIQUE_BF16){raw&=0xffffULL;if((raw&0x7fffULL)==0)raw=0;return (raw&0x8000ULL)?((~raw)&0xffffULL):(raw^0x8000ULL);}
 raw&=0xffffffffULL;if((raw&0x7fffffffULL)==0)raw=0;return (raw&0x80000000ULL)?((~raw)&0xffffffffULL):(raw^0x80000000ULL);
}
__aicore__ inline uint64_t UniqueDecodeRaw(uint64_t key,uint32_t dtype){
 if(dtype==UNIQUE_INT8)return (key^0x80ULL)&0xffULL;if(dtype==UNIQUE_UINT8)return key&0xffULL;
 if(dtype==UNIQUE_INT32)return (key^0x80000000ULL)&0xffffffffULL;if(dtype==UNIQUE_INT64)return key^0x8000000000000000ULL;
 if(dtype==UNIQUE_FP16||dtype==UNIQUE_BF16)return (key&0x8000ULL)?((key^0x8000ULL)&0xffffULL):((~key)&0xffffULL);
 return (key&0x80000000ULL)?((key^0x80000000ULL)&0xffffffffULL):((~key)&0xffffffffULL);
}
__aicore__ inline uint64_t UniqueLoadRaw(GM_ADDR x,uint64_t i,uint32_t dtype){if(dtype==UNIQUE_INT8||dtype==UNIQUE_UINT8)return reinterpret_cast<const __gm__ uint8_t*>(x)[i];if(dtype==UNIQUE_FP16||dtype==UNIQUE_BF16)return reinterpret_cast<const __gm__ uint16_t*>(x)[i];if(dtype==UNIQUE_FP32||dtype==UNIQUE_INT32)return reinterpret_cast<const __gm__ uint32_t*>(x)[i];return reinterpret_cast<const __gm__ uint64_t*>(x)[i];}
extern "C" __global__ __aicore__ __attribute__((aiv)) void unique_encode_kernel(GM_ADDR x,GM_ADDR keys,GM_ADDR til){const __gm__ UniqueTilingData*t=reinterpret_cast<const __gm__ UniqueTilingData*>(til);__gm__ uint64_t*k=reinterpret_cast<__gm__ uint64_t*>(keys);uint64_t b=AscendC::GetBlockIdx(),s=b*t->blockLength,e=s+t->blockLength;if(e>t->numel)e=t->numel;for(uint64_t i=s;i<e;++i)k[i]=UniqueEncodeRaw(UniqueLoadRaw(x,i,t->dtype),t->dtype);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void unique_radix_kernel(GM_ADDR src,GM_ADDR dst,GM_ADDR histAddr,GM_ADDR til,uint32_t shift){const __gm__ UniqueTilingData*t=reinterpret_cast<const __gm__ UniqueTilingData*>(til);if(AscendC::GetBlockIdx()!=0)return;const __gm__ uint64_t*s=reinterpret_cast<const __gm__ uint64_t*>(src);__gm__ uint64_t*d=reinterpret_cast<__gm__ uint64_t*>(dst);__gm__ uint64_t*h=reinterpret_cast<__gm__ uint64_t*>(histAddr);for(uint32_t i=0;i<512;++i)h[i]=0;for(uint64_t i=0;i<t->numel;++i)h[(s[i]>>shift)&255ULL]++;uint64_t pos=0;for(uint32_t i=0;i<256;++i){h[256+i]=pos;pos+=h[i];}for(uint64_t i=0;i<t->numel;++i){uint64_t v=s[i],b=(v>>shift)&255ULL,p=h[256+b]++;d[p]=v;}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void unique_emit_kernel(GM_ADDR sorted,GM_ADDR uniqueKeys,GM_ADDR y,GM_ADDR countAddr,GM_ADDR til){const __gm__ UniqueTilingData*t=reinterpret_cast<const __gm__ UniqueTilingData*>(til);if(AscendC::GetBlockIdx()!=0)return;const __gm__ uint64_t*s=reinterpret_cast<const __gm__ uint64_t*>(sorted);__gm__ uint64_t*u=reinterpret_cast<__gm__ uint64_t*>(uniqueKeys);uint64_t count=0,prev=0;for(uint64_t i=0;i<t->numel;++i){uint64_t key=s[i];if(i==0||key!=prev){u[count]=key;uint64_t raw=UniqueDecodeRaw(key,t->dtype);if(t->itemSize==1)reinterpret_cast<__gm__ uint8_t*>(y)[count]=uint8_t(raw);else if(t->itemSize==2)reinterpret_cast<__gm__ uint16_t*>(y)[count]=uint16_t(raw);else if(t->itemSize==4)reinterpret_cast<__gm__ uint32_t*>(y)[count]=uint32_t(raw);else reinterpret_cast<__gm__ uint64_t*>(y)[count]=raw;++count;prev=key;}}reinterpret_cast<__gm__ uint64_t*>(countAddr)[0]=count;}
extern "C" __global__ __aicore__ __attribute__((aiv)) void unique_inverse_kernel(GM_ADDR x,GM_ADDR uniqueKeys,GM_ADDR countAddr,GM_ADDR inverse,GM_ADDR til){const __gm__ UniqueTilingData*t=reinterpret_cast<const __gm__ UniqueTilingData*>(til);if(!t->needInverse)return;const __gm__ uint64_t*u=reinterpret_cast<const __gm__ uint64_t*>(uniqueKeys);uint64_t count=reinterpret_cast<const __gm__ uint64_t*>(countAddr)[0];__gm__ int64_t*out=reinterpret_cast<__gm__ int64_t*>(inverse);uint64_t b=AscendC::GetBlockIdx(),s=b*t->blockLength,e=s+t->blockLength;if(e>t->numel)e=t->numel;for(uint64_t i=s;i<e;++i){uint64_t key=UniqueEncodeRaw(UniqueLoadRaw(x,i,t->dtype),t->dtype),lo=0,hi=count;while(lo<hi){uint64_t m=(lo+hi)>>1;if(u[m]<key)lo=m+1;else hi=m;}out[i]=int64_t(lo);}}
