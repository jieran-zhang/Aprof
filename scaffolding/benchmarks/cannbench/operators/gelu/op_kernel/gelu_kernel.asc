#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "gelu_tiling.h"

template <typename T>
class KernelGelu {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const __gm__ GeluTilingData *tiling) {
        tiling_ = tiling;
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * tiling_->blockLength;
        const uint64_t remain = tiling_->totalLength > offset ? tiling_->totalLength - offset : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x_.SetGlobalBuffer((__gm__ T *)x + offset, length_);
        y_.SetGlobalBuffer((__gm__ T *)y + offset, length_);
        const uint32_t rawBytes = tiling_->tileElements * sizeof(T);
        const uint32_t fpBytes = tiling_->tileElements * sizeof(float);
        pipe_.InitBuffer(inQ_, 1, rawBytes);
        pipe_.InitBuffer(outQ_, 1, rawBytes);
        pipe_.InitBuffer(fpIn_, fpBytes);
        pipe_.InitBuffer(fpWork_, fpBytes);
        pipe_.InitBuffer(fpOut_, fpBytes);
        // AscendC::Erfc<float> needs five FP32 live temporary arrays.
        pipe_.InitBuffer(erfTmp_, fpBytes * 5);
        const uint32_t maskBytes = (((tiling_->tileElements + 7U) / 8U + 255U) / 256U) * 256U;
        pipe_.InitBuffer(maskBuf_, maskBytes);
    }

    __aicore__ inline void Process() {
        for (uint64_t off = 0; off < length_; off += tiling_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < tiling_->tileElements ? (length_ - off) : tiling_->tileElements);
            CopyIn(off, count);
            Compute(count);
            CopyOut(off, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t off, uint32_t count) {
        auto in = inQ_.AllocTensor<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, x_[off], p, pad);
        inQ_.EnQue(in);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto in = inQ_.DeQue<T>();
        auto out = outQ_.AllocTensor<T>();
        auto fi = fpIn_.Get<float>();
        auto work = fpWork_.Get<float>();
        auto fo = fpOut_.Get<float>();
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(fi, in, 0.0f, count);
        } else {
            AscendC::Cast(fi, in, AscendC::RoundMode::CAST_NONE, count);
        }

        if (tiling_->mode == GELU_NONE) {
            // Phi(x)=0.5*erfc(-x/sqrt(2)) avoids the catastrophic
            // cancellation of 1+erf(x/sqrt(2)) in the negative tail.
            AscendC::Muls(work, fi, -0.7071067811865475f, count);
            AscendC::Erfc<float, false>(fo, work, erfTmp_.Get<uint8_t>(), count);
            AscendC::Mul(fo, fo, fi, count);
            AscendC::Muls(fo, fo, 0.5f, count);
            // PyTorch's FP32 erf path rounds Phi(x) to zero below this tail
            // boundary. Match that IEEE result, while restoring -Inf*0=NaN.
            auto saved = erfTmp_.Get<float>();
            AscendC::Adds(saved, fo, 0.0f, count);
            AscendC::Duplicate(work, 0.0f, count);
            auto mask = maskBuf_.Get<uint8_t>();
            const uint32_t compareCount = ((count + 63U) / 64U) * 64U;
            AscendC::CompareScalar(mask, fi, -5.5430400f, AscendC::CMPMODE::LT, compareCount);
            AscendC::Select(fo, mask, work, fo,
                AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
            AscendC::CompareScalar(mask, fi, -3.402823466e38f, AscendC::CMPMODE::LT, compareCount);
            AscendC::Select(fo, mask, saved, fo,
                AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        } else {
            // PyTorch's FP32 vector GELU materializes p=0.5*(1+tanh(y)) on a
            // 2^-23 grid. Explicit RINT reproduces that rounding near
            // saturation, where one ulp of tanh otherwise dominates relative
            // error against values close to zero.
            AscendC::Mul(work, fi, fi, count);
            AscendC::Mul(work, work, fi, count);
            AscendC::Muls(work, work, 0.044715f, count);
            AscendC::Add(work, work, fi, count);
            AscendC::Muls(work, work, 0.7978845608028654f, count);
            AscendC::Tanh(fo, work, count);
            AscendC::Adds(fo, fo, 1.0f, count);
            AscendC::Muls(fo, fo, 0.5f, count);
            AscendC::Muls(fo, fo, 8388608.0f, count);
            auto rounded = work.ReinterpretCast<int32_t>();
            AscendC::Cast(rounded, fo, AscendC::RoundMode::CAST_RINT, count);
            AscendC::Cast(fo, rounded, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Muls(fo, fo, 0.00000011920928955078125f, count);
            AscendC::Mul(fo, fo, fi, count);
        }

        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(out, fo, 0.0f, count);
        } else {
            constexpr auto roundMode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(out, fo, roundMode, count);
        }
        outQ_.EnQue(out);
        inQ_.FreeTensor(in);
    }

    __aicore__ inline void CopyOut(uint64_t off, uint32_t count) {
        auto out = outQ_.DeQue<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(y_[off], out, p);
        outQ_.FreeTensor(out);
    }

    AscendC::TPipe pipe_;
    const __gm__ GeluTilingData *tiling_;
    uint64_t length_;
    AscendC::GlobalTensor<T> x_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpIn_, fpWork_, fpOut_, erfTmp_, maskBuf_;
};

extern "C" __global__ __aicore__ void gelu_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ GeluTilingData *t = reinterpret_cast<const __gm__ GeluTilingData *>(tilingAddr);
    if (t->dtype == GELU_FLOAT32) {
        KernelGelu<float> op; op.Init(x, y, t); op.Process();
    } else if (t->dtype == GELU_FLOAT16) {
        KernelGelu<half> op; op.Init(x, y, t); op.Process();
    } else {
        KernelGelu<bfloat16_t> op; op.Init(x, y, t); op.Process();
    }
}
