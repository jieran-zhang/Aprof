#include <algorithm>
#include <cmath>
#include <cstdlib>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/mha_kernel.asc"
namespace {
void C(aclError e,const char*w){if(e!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(e));}
std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<uint64_t> V(const std::string&s){std::vector<uint64_t>v;std::stringstream q(s);std::string z;while(std::getline(q,z,','))v.push_back(std::stoull(z));return v;}
AscendC::tiling::TCubeTiling Tile(int m,int n,int k,bool bf,bool bt){using namespace matmul_tiling;matmul_tiling::PlatformInfo p{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};MatmulApiTiling a(p);auto dt=bf?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16;if(a.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false)||a.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,bt)||a.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt)||a.SetBiasType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt)||a.SetShape(m,n,k)||a.SetOrgShape(m,n,k)||a.SetBias(false)||a.SetFixSplit(-1,-1,std::min(k,128)))throw std::runtime_error("matmul tiling setup");AscendC::tiling::TCubeTiling t{};if(a.GetTiling(t))throw std::runtime_error("matmul tiling");return t;}
}
int main(int argc,char**argv){int dev=0;bool init=false,set=false;aclrtStream st=nullptr;std::vector<void*>ds,hs;try{auto q=V(A(argc,argv,"--query-shape")),k=V(A(argc,argv,"--key-shape"));if(q.size()!=4||k.size()!=4)throw std::invalid_argument("rank");MhaTiling t{};t.B=q[0];t.S=q[1];t.Nq=q[2];t.D=q[3];t.Skv=k[1];t.Nkv=k[2];t.causal=std::stoi(A(argc,argv,"--causal","0"));if(k[0]!=t.B||k[3]!=t.D||t.Nq!=t.Nkv||(t.causal&&t.S>t.Skv))throw std::invalid_argument("shape");t.G=t.Nq/t.Nkv;t.rows=t.B*t.Nkv*t.G*t.S;t.totalQ=t.rows*t.D;t.totalKV=t.B*t.Nkv*t.Skv*t.D;t.totalScores=t.rows*t.Skv;t.blocks=2;std::string dtype=A(argc,argv,"--dtype");bool bf=dtype=="bfloat16";if(!bf&&dtype!="float16")throw std::invalid_argument("dtype");t.dtype=bf;float sc=std::stof(A(argc,argv,"--scale","-1"));t.scale=sc>0?sc:1.0f/std::sqrt(float(t.D));size_t item=2,qb=t.totalQ*item,kvb=t.totalKV*item,sb=t.totalScores*item;dev=std::stoi(A(argc,argv,"--device","0"));C(aclInit(nullptr),"aclInit");init=true;C(aclrtSetDevice(dev),"set device");set=true;C(aclrtCreateStream(&st),"stream");void *hq,*hk,*hv,*hy;for(auto x:{std::pair<void**,size_t>{&hq,qb},{&hk,kvb},{&hv,kvb},{&hy,qb}}){C(aclrtMallocHost(x.first,x.second),"host alloc");hs.push_back(*x.first);}if(!ReadFile(A(argc,argv,"--query"),hq,qb)||!ReadFile(A(argc,argv,"--key"),hk,kvb)||!ReadFile(A(argc,argv,"--value"),hv,kvb))throw std::runtime_error("read");void *dq,*dk,*dv,*dy,*rQ,*rK,*rV,*score,*tmp,*dt,*tile;for(auto x:{std::pair<void**,size_t>{&dq,qb},{&dk,kvb},{&dv,kvb},{&dy,qb},{&rQ,qb},{&rK,kvb},{&rV,kvb},{&score,sb},{&tmp,qb},{&dt,sizeof(t)},{&tile,sizeof(AscendC::tiling::TCubeTiling)}}){C(aclrtMalloc(x.first,x.second,ACL_MEM_MALLOC_HUGE_FIRST),"device alloc");ds.push_back(*x.first);}C(aclrtMemcpy(dq,qb,hq,qb,ACL_MEMCPY_HOST_TO_DEVICE),"q H2D");C(aclrtMemcpy(dk,kvb,hk,kvb,ACL_MEMCPY_HOST_TO_DEVICE),"k H2D");C(aclrtMemcpy(dv,kvb,hv,kvb,ACL_MEMCPY_HOST_TO_DEVICE),"v H2D");C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");mha_reorder<<<1,nullptr,st>>>((uint8_t*)dq,(uint8_t*)dk,(uint8_t*)dv,(uint8_t*)rQ,(uint8_t*)rK,(uint8_t*)rV,(uint8_t*)dt);C(aclrtSynchronizeStream(st),"reorder");int M=int(t.G*t.S);auto tq=Tile(M,int(t.Skv),int(t.D),bf,true);C(aclrtMemcpy(tile,sizeof(tq),&tq,sizeof(tq),ACL_MEMCPY_HOST_TO_DEVICE),"qk tile");for(uint64_t z=0;z<t.B*t.Nkv;++z){uint64_t qo=z*M*t.D,ko=z*t.Skv*t.D,so=z*M*t.Skv;if(bf)mha_qk_bf16<<<1,nullptr,st>>>((uint8_t*)rQ,(uint8_t*)rK,(uint8_t*)score,(uint8_t*)tile,qo,ko,so,uint64_t(M)*t.D,t.Skv*t.D,uint64_t(M)*t.Skv);else mha_qk_fp16<<<1,nullptr,st>>>((uint8_t*)rQ,(uint8_t*)rK,(uint8_t*)score,(uint8_t*)tile,qo,ko,so,uint64_t(M)*t.D,t.Skv*t.D,uint64_t(M)*t.Skv);C(aclrtSynchronizeStream(st),"qk");}uint64_t softmaxRows=std::max<uint64_t>(1,131072/t.Skv);for(uint64_t rs=0;rs<t.rows;rs+=softmaxRows){uint64_t re=std::min<uint64_t>(t.rows,rs+softmaxRows);mha_softmax<<<1,nullptr,st>>>((uint8_t*)score,(uint8_t*)dt,rs,re);C(aclrtSynchronizeStream(st),"softmax");}auto tv=Tile(M,int(t.D),int(t.Skv),bf,false);C(aclrtMemcpy(tile,sizeof(tv),&tv,sizeof(tv),ACL_MEMCPY_HOST_TO_DEVICE),"pv tile");for(uint64_t z=0;z<t.B*t.Nkv;++z){uint64_t so=z*M*t.Skv,vo=z*t.Skv*t.D,oo=z*M*t.D;if(bf)mha_pv_bf16<<<1,nullptr,st>>>((uint8_t*)score,(uint8_t*)rV,(uint8_t*)tmp,(uint8_t*)tile,so,vo,oo,uint64_t(M)*t.Skv,t.Skv*t.D,uint64_t(M)*t.D);else mha_pv_fp16<<<1,nullptr,st>>>((uint8_t*)score,(uint8_t*)rV,(uint8_t*)tmp,(uint8_t*)tile,so,vo,oo,uint64_t(M)*t.Skv,t.Skv*t.D,uint64_t(M)*t.D);C(aclrtSynchronizeStream(st),"pv");}mha_scatter<<<1,nullptr,st>>>((uint8_t*)tmp,(uint8_t*)dy,(uint8_t*)dt);C(aclrtSynchronizeStream(st),"scatter");C(aclrtMemcpy(hy,qb,dy,qb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");if(!WriteFile(A(argc,argv,"--output"),hy,qb))throw std::runtime_error("write");std::cout<<"mha completed B="<<t.B<<" S="<<t.S<<" Skv="<<t.Skv<<" Nq="<<t.Nq<<" Nkv="<<t.Nkv<<" D="<<t.D<<"\n";for(void*p:ds)aclrtFree(p);for(void*p:hs)aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&e){std::cerr<<"mha failed: "<<e.what()<<"\n";for(void*p:ds)aclrtFree(p);for(void*p:hs)aclrtFreeHost(p);if(st)aclrtDestroyStream(st);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
