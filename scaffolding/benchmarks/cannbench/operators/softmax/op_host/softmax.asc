#include <chrono>
#include <cstring>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "softmax_tiling.h"
#include "data_utils.h"
#include "../op_kernel/softmax_kernel.asc"
namespace {
void Check(aclError r,const char *w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int c,char **v,const std::string &n,const std::string &d=""){for(int i=1;i+1<c;++i)if(v[i]==n)return v[i+1];return d;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string x;while(std::getline(q,x,','))o.push_back(std::stoull(x));return o;}
uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto x:s)n*=x;return n;}
uint32_t DType(const std::string&s){if(s=="float16")return SOFTMAX_FLOAT16;if(s=="float32")return SOFTMAX_FLOAT32;if(s=="bfloat16")return SOFTMAX_BFLOAT16;throw std::invalid_argument("unsupported dtype: "+s);}
size_t Item(uint32_t d){return d==SOFTMAX_FLOAT32?4:2;}
}
int main(int argc,char**argv){
 if(argc<2){std::cerr<<"usage: softmax --shape DIMS --dtype TYPE --dim DIM --input FILE --output FILE [--device N]\n";return 2;}
 int device=0;aclrtStream stream=nullptr;void *hx=nullptr,*hy=nullptr,*dx=nullptr,*dy=nullptr,*dt=nullptr;
 try{
  auto shape=Shape(Arg(argc,argv,"--shape"));auto dtype=DType(Arg(argc,argv,"--dtype"));auto dim=std::stoll(Arg(argc,argv,"--dim","-1"));device=std::stoi(Arg(argc,argv,"--device","0"));
  size_t bytes=Numel(shape)*Item(dtype);Check(aclInit(nullptr),"aclInit");Check(aclrtSetDevice(device),"aclrtSetDevice");int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query vector cores");auto t=ComputeSoftmaxTiling(shape,dim,dtype,cores);
  Check(aclrtCreateStream(&stream),"aclrtCreateStream");Check(aclrtMallocHost(&hx,bytes),"host x");Check(aclrtMallocHost(&hy,bytes),"host y");Check(aclrtMalloc(&dx,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device x");Check(aclrtMalloc(&dy,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device y");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");
  if(!ReadFile(Arg(argc,argv,"--input"),hx,bytes))throw std::runtime_error("read input failed");Check(aclrtMemcpy(dx,bytes,hx,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
  auto a=std::chrono::steady_clock::now();softmax_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel synchronize");auto b=std::chrono::steady_clock::now();
  Check(aclrtMemcpy(hy,bytes,dy,bytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");
  const void *writeData=hy;
  if(t.innerLength>1){
   const size_t item=Item(dtype);auto *src=static_cast<const uint8_t*>(hy);auto *dst=static_cast<uint8_t*>(hx);
   for(uint64_t outer=0;outer<t.outerLength;++outer)for(uint64_t inner=0;inner<t.innerLength;++inner)for(uint64_t k=0;k<t.reduceLength;++k){
    const uint64_t srcIndex=(outer*t.innerLength+inner)*t.reduceLength+k;
    const uint64_t dstIndex=outer*t.reduceLength*t.innerLength+k*t.innerLength+inner;
    std::memcpy(dst+dstIndex*item,src+srcIndex*item,item);
   }
   writeData=hx;
  }
  if(!WriteFile(Arg(argc,argv,"--output"),writeData,bytes))throw std::runtime_error("write output failed");
  std::cout<<"softmax_kernel completed: slices="<<t.sliceCount<<" reduce="<<t.reduceLength<<" inner="<<t.innerLength<<" blocks="<<t.blockNum<<" elapsed_ms="<<std::chrono::duration<double,std::milli>(b-a).count()<<"\n";
  aclrtFree(dt);aclrtFree(dy);aclrtFree(dx);aclrtFreeHost(hy);aclrtFreeHost(hx);aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"softmax failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dy)aclrtFree(dy);if(dx)aclrtFree(dx);if(hy)aclrtFreeHost(hy);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 1;}
}
