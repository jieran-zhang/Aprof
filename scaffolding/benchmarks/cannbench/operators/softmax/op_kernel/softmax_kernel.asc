#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "softmax_tiling.h"

template <typename T>
class KernelSoftmax {
public:
    static constexpr uint32_t kMaxReduce = 16384;
    static constexpr uint32_t kGatherBlocks = 512;
    static constexpr uint32_t kBlockBytes = 32;
    static constexpr uint32_t kLanes = kBlockBytes / sizeof(T);
    static constexpr uint32_t kGatherElements = kGatherBlocks * kLanes;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const __gm__ SoftmaxTilingData *t) {
        t_ = t;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y));
        softmaxTiling_.srcM=t->softmaxTiling.srcM; softmaxTiling_.srcK=t->softmaxTiling.srcK;
        softmaxTiling_.srcSize=t->softmaxTiling.srcSize; softmaxTiling_.outMaxM=t->softmaxTiling.outMaxM;
        softmaxTiling_.outMaxK=t->softmaxTiling.outMaxK; softmaxTiling_.outMaxSize=t->softmaxTiling.outMaxSize;
        softmaxTiling_.splitM=t->softmaxTiling.splitM; softmaxTiling_.splitK=t->softmaxTiling.splitK;
        softmaxTiling_.splitSize=t->softmaxTiling.splitSize; softmaxTiling_.reduceM=t->softmaxTiling.reduceM;
        softmaxTiling_.reduceK=t->softmaxTiling.reduceK; softmaxTiling_.reduceSize=t->softmaxTiling.reduceSize;
        softmaxTiling_.rangeM=t->softmaxTiling.rangeM; softmaxTiling_.tailM=t->softmaxTiling.tailM;
        softmaxTiling_.tailSplitSize=t->softmaxTiling.tailSplitSize;
        softmaxTiling_.tailReduceSize=t->softmaxTiling.tailReduceSize;
        pipe_.InitBuffer(rawBuf_, (t->alignedReduce + kGatherElements) * sizeof(T));
        pipe_.InitBuffer(fpBuf_, t->alignedReduce * sizeof(float));
        pipe_.InitBuffer(polyBuf_, t->alignedReduce * sizeof(float));
        pipe_.InitBuffer(outputQ_,1,t->alignedReduce*sizeof(T));
        if constexpr(std::is_same<T,half>::value) {
            const uint32_t maskBytes=((((t->alignedReduce+7U)/8U)+255U)/256U)*256U;
            pipe_.InitBuffer(maskBuf_,maskBytes);
        }
        pipe_.InitBuffer(reduceBuf_,4096); pipe_.InitBuffer(scalarBuf_,32);
    }

    __aicore__ inline void Process() {
        uint64_t begin=static_cast<uint64_t>(AscendC::GetBlockIdx())*t_->blockLength;
        uint64_t end=begin+t_->blockLength; if(end>t_->sliceCount)end=t_->sliceCount;
        for(uint64_t slice=begin;slice<end;++slice) ProcessSlice(slice);
    }

private:
    __aicore__ inline void SleefExp(const AscendC::LocalTensor<float>& values,uint32_t count) {
        // SLEEF expf u10 polynomial used by PyTorch CPU Vectorized<float>.
        AscendC::LocalTensor<float> qFloat;
        if constexpr(std::is_same<T,float>::value) qFloat=fpBuf_.Get<float>();
        else qFloat=rawBuf_.Get<float>();
        auto qInt=qFloat.ReinterpretCast<int32_t>();
        AscendC::Muls(qFloat,values,1.44269504088896341f,count);
        AscendC::Cast(qInt,qFloat,AscendC::RoundMode::CAST_RINT,count);
        AscendC::Cast(qFloat,qInt,AscendC::RoundMode::CAST_NONE,count);
        AscendC::Muls(qFloat,qFloat,-0.6931471805599453f,count);
        AscendC::Add(values,values,qFloat,count); // reduced argument s
        // Reconstruct 2^q as IEEE-754 exponent bits in the reusable raw UB.
        AscendC::Muls(qFloat,qFloat,-1.44269504088896341f,count);
        AscendC::Muls(qFloat,qFloat,8388608.0f,count);
        AscendC::Adds(qFloat,qFloat,1065353216.0f,count);
        AscendC::Cast(qInt,qFloat,AscendC::RoundMode::CAST_RINT,count);
        auto pow2=qInt.ReinterpretCast<float>();
        auto poly=polyBuf_.Get<float>();
        AscendC::Duplicate(poly,0.00019852761761285365f,count);
        AscendC::Mul(poly,poly,values,count); AscendC::Adds(poly,poly,0.0013930435525253415f,count);
        AscendC::Mul(poly,poly,values,count); AscendC::Adds(poly,poly,0.008333360776305199f,count);
        AscendC::Mul(poly,poly,values,count); AscendC::Adds(poly,poly,0.041666485369205475f,count);
        AscendC::Mul(poly,poly,values,count); AscendC::Adds(poly,poly,0.1666666716337204f,count);
        AscendC::Mul(poly,poly,values,count); AscendC::Adds(poly,poly,0.5f,count);
        AscendC::Mul(poly,poly,values,count);
        AscendC::Mul(poly,poly,values,count);
        AscendC::Add(poly,poly,values,count); AscendC::Adds(poly,poly,1.0f,count);
        AscendC::Mul(values,poly,pow2,count);
    }

    __aicore__ inline void Gather(const AscendC::LocalTensor<T>& packed,uint64_t slice) {
        const uint64_t innerIndex=slice%t_->innerLength;
        const uint64_t outerIndex=slice/t_->innerLength;
        if(t_->innerLength==1) {
            AscendC::DataCopyExtParams p{1,static_cast<uint32_t>(t_->reduceLength*sizeof(T)),0,0,0};
            AscendC::DataCopyPadExtParams<T> pad{true,0,0,0};
            AscendC::DataCopyPad(packed,x_[outerIndex*t_->reduceLength],p,pad);
            AscendC::PipeBarrier<PIPE_ALL>();
            return;
        }
        uint64_t groupStart;
        if(t_->innerLength>=kLanes) {
            groupStart=(innerIndex/kLanes)*kLanes;
            if(groupStart+kLanes>t_->innerLength)groupStart=t_->innerLength-kLanes;
        } else groupStart=0;
        const uint32_t lane=static_cast<uint32_t>(innerIndex-groupStart);
        const uint64_t base=outerIndex*t_->reduceLength*t_->innerLength+groupStart;
        auto gather=packed[t_->alignedReduce];
        uint64_t done=0;
        while(done<t_->reduceLength) {
            const uint32_t blocks=static_cast<uint32_t>((t_->reduceLength-done)<kGatherBlocks?(t_->reduceLength-done):kGatherBlocks);
            AscendC::DataCopyExtParams p{static_cast<uint16_t>(blocks),kBlockBytes,
                static_cast<uint32_t>((t_->innerLength-kLanes)*sizeof(T)),0,0};
            AscendC::DataCopyPadExtParams<T> pad{true,0,0,0};
            AscendC::DataCopyPad(gather,x_[base+done*t_->innerLength],p,pad);
            AscendC::PipeBarrier<PIPE_ALL>();
            for(uint32_t b=0;b<blocks;++b) packed.SetValue(done+b,gather.GetValue(b*kLanes+lane));
            AscendC::PipeBarrier<PIPE_ALL>();
            done+=blocks;
        }
    }

    __aicore__ inline void ProcessSlice(uint64_t slice) {
        auto packed=rawBuf_.Get<T>(); Gather(packed,slice);
        AscendC::LocalTensor<float> values;
        if constexpr(std::is_same<T,float>::value) values=packed;
        else { values=fpBuf_.Get<float>(); AscendC::Cast(values,packed,AscendC::RoundMode::CAST_NONE,static_cast<uint32_t>(t_->reduceLength)); }
        auto reduce=reduceBuf_.Get<float>();auto scalar=scalarBuf_.Get<float>();
        const uint32_t count=static_cast<uint32_t>(t_->reduceLength);
        AscendC::ReduceMax(scalar,values,reduce,count,false);AscendC::PipeBarrier<PIPE_ALL>();
        const float maximum=scalar.GetValue(0);
        AscendC::ReduceMin(scalar,values,reduce,count,false);AscendC::PipeBarrier<PIPE_ALL>();
        const float minimum=scalar.GetValue(0);
        AscendC::Adds(values,values,-maximum,count);
        if constexpr(std::is_same<T,half>::value) {
            if(maximum==maximum && minimum==minimum && maximum<3.4028234e+38f &&
               minimum>-3.4028234e+38f && (maximum-minimum)<80.0f) SleefExp(values,count);
            else AscendC::Exp(values,values,count);
        } else AscendC::Exp(values,values,count);
        AscendC::ReduceSum(scalar,values,reduce,count);
        AscendC::PipeBarrier<PIPE_ALL>();
        const float sum=scalar.GetValue(0);
        AscendC::Muls(values,values,1.0f/sum,count);
        if constexpr(!std::is_same<T,float>::value) {
            if constexpr(std::is_same<T,half>::value) {
                auto mask=maskBuf_.Get<uint8_t>();auto zero=polyBuf_.Get<float>();
                const int32_t aligned=static_cast<int32_t>(t_->alignedReduce);
                AscendC::Duplicate(zero,0.0f,aligned);
                AscendC::CompareScalar(mask,values,2.98023223876953125e-8f,
                    AscendC::CMPMODE::LE,aligned);
                AscendC::Select(values,mask,zero,values,
                    AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE,aligned);
            }
        }
        auto out=outputQ_.AllocTensor<T>();
        if constexpr(std::is_same<T,float>::value) {
            AscendC::Adds(out,values,0.0f,count);
        } else {
            constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_RINT:AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(out,values,mode,count);
        }
        outputQ_.EnQue(out);out=outputQ_.DeQue<T>();
        AscendC::DataCopyExtParams p{1,static_cast<uint32_t>(t_->reduceLength*sizeof(T)),0,0,0};
        AscendC::DataCopyPad(y_[slice*t_->reduceLength],out,p);
        outputQ_.FreeTensor(out);
    }

    AscendC::TPipe pipe_; const __gm__ SoftmaxTilingData*t_; SoftMaxTiling softmaxTiling_;
    AscendC::TQue<AscendC::TPosition::VECOUT,1>outputQ_;
    AscendC::GlobalTensor<T>x_,y_; AscendC::TBuf<AscendC::TPosition::VECCALC>rawBuf_,fpBuf_,polyBuf_,reduceBuf_,scalarBuf_,maskBuf_;
};

extern "C" __global__ __aicore__ __vector__ void softmax_kernel(GM_ADDR x,GM_ADDR y,GM_ADDR taddr) {
 const __gm__ SoftmaxTilingData*t=reinterpret_cast<const __gm__ SoftmaxTilingData*>(taddr);
 if(t->dtype==SOFTMAX_FLOAT16){KernelSoftmax<half>o;o.Init(x,y,t);o.Process();}
 else if(t->dtype==SOFTMAX_FLOAT32){KernelSoftmax<float>o;o.Init(x,y,t);o.Process();}
 else{KernelSoftmax<bfloat16_t>o;o.Init(x,y,t);o.Process();}
}
