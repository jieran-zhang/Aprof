#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "engram_gate_fusion_tiling.h"

__aicore__ inline float EngramBf16ToFloat(bfloat16_t v){uint32_t b=uint32_t(*reinterpret_cast<uint16_t*>(&v))<<16;return *reinterpret_cast<float*>(&b);}
__aicore__ inline bfloat16_t EngramFloatToBf16(float v){
 uint32_t b=*reinterpret_cast<uint32_t*>(&v);uint32_t l=(b>>16)&1U;b+=0x7fffU+l;uint16_t r=uint16_t(b>>16);return *reinterpret_cast<bfloat16_t*>(&r);
}

class EngramGateStage {
public:
 __aicore__ inline void Init(GM_ADDR ka,GM_ADDR qa,GM_ADDR va,GM_ADDR w1a,GM_ADDR w2a,GM_ADDR cna,GM_ADDR ga,GM_ADDR xa,const __gm__ EngramGateFusionTilingData*t){
  t_=t;k_=reinterpret_cast<const __gm__ bfloat16_t*>(ka);q_=reinterpret_cast<const __gm__ bfloat16_t*>(qa);v_=reinterpret_cast<const __gm__ bfloat16_t*>(va);
  w1_=reinterpret_cast<const __gm__ float*>(w1a);w2_=reinterpret_cast<const __gm__ float*>(w2a);cn_=reinterpret_cast<const __gm__ float*>(cna);
  gate_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ga),t->outputNumel);x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(xa),t->outputNumel);pipe_.InitBuffer(tmp_,256);pipe_.InitBuffer(gatedBuf_,4096);pipe_.InitBuffer(normBuf_,4096);
 }
 __aicore__ inline void Process(){
  uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->rowBlockLength,end=begin+t_->rowBlockLength;if(end>t_->rows)end=t_->rows;
  auto z=tmp_.Get<float>();
  for(uint64_t row=begin;row<end;++row){uint64_t hc=row%t_->hc;uint64_t bl=row/t_->hc;uint64_t kd=row*t_->hidden,vd=bl*t_->hidden,wd=hc*t_->hidden;
   float sk=0.0f,sq=0.0f,sp=0.0f;
   for(uint64_t d=0;d<t_->hidden;++d){float a=EngramBf16ToFloat(k_[kd+d]),b=EngramBf16ToFloat(q_[kd+d]);sk+=a*a;sq+=b*b;sp+=(a*w1_[wd+d])*(b*w2_[wd+d]);}
   z.SetValue(0,sk*t_->invHidden+t_->eps);z.SetValue(1,sq*t_->invHidden+t_->eps);for(uint32_t i=2;i<8;++i)z.SetValue(i,1.0f);
   AscendC::PipeBarrier<PIPE_ALL>();AscendC::Sqrt(z,z,8);AscendC::PipeBarrier<PIPE_ALL>();
   float raw=sp/(z.GetValue(0)*z.GetValue(1))*t_->invSqrtHidden;float ab=raw<0.0f?-raw:raw;if(ab<1.0e-6f)ab=1.0e-6f;
   z.SetValue(0,ab);for(uint32_t i=1;i<8;++i)z.SetValue(i,1.0f);AscendC::PipeBarrier<PIPE_ALL>();AscendC::Sqrt(z,z,8);AscendC::PipeBarrier<PIPE_ALL>();
   float signedRoot=raw<0.0f?-z.GetValue(0):(raw>0.0f?z.GetValue(0):0.0f);z.SetValue(0,-signedRoot);for(uint32_t i=1;i<8;++i)z.SetValue(i,0.0f);
   AscendC::PipeBarrier<PIPE_ALL>();AscendC::Exp(z,z,8);AscendC::PipeBarrier<PIPE_ALL>();float gate=1.0f/(1.0f+z.GetValue(0));
   float sv=0.0f;for(uint64_t d=0;d<t_->hidden;++d){float x=gate*EngramBf16ToFloat(v_[vd+d]);sv+=x*x;}
   z.SetValue(0,sv*t_->invHidden+t_->eps);for(uint32_t i=1;i<8;++i)z.SetValue(i,1.0f);AscendC::PipeBarrier<PIPE_ALL>();AscendC::Sqrt(z,z,8);AscendC::PipeBarrier<PIPE_ALL>();float inv=1.0f/z.GetValue(0);
   auto gatedLocal=gatedBuf_.Get<float>();auto normLocal=normBuf_.Get<float>();for(uint64_t d=0;d<t_->hidden;++d){float gated=gate*EngramBf16ToFloat(v_[vd+d]);gatedLocal.SetValue(d,gated);normLocal.SetValue(d,gated*inv*cn_[wd+d]);}
   AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,uint32_t(t_->hidden*4),0,0,0};AscendC::DataCopyPad(gate_[kd],gatedLocal,cp);AscendC::DataCopyPad(x_[kd],normLocal,cp);AscendC::PipeBarrier<PIPE_ALL>();
  }
 }
private:const __gm__ EngramGateFusionTilingData*t_;const __gm__ bfloat16_t*k_;const __gm__ bfloat16_t*q_;const __gm__ bfloat16_t*v_;const __gm__ float*w1_;const __gm__ float*w2_;const __gm__ float*cn_;AscendC::GlobalTensor<float>gate_,x_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>tmp_,gatedBuf_,normBuf_;
};

class EngramConvStage {
public:
 __aicore__ inline void Init(GM_ADDR va,GM_ADDR cwa,GM_ADDR sta,GM_ADDR ga,GM_ADDR xa,GM_ADDR oa,GM_ADDR soa,const __gm__ EngramGateFusionTilingData*t){
  t_=t;v_=reinterpret_cast<const __gm__ bfloat16_t*>(va);cw_=reinterpret_cast<const __gm__ float*>(cwa);state_=reinterpret_cast<const __gm__ bfloat16_t*>(sta);
  gate_=reinterpret_cast<const __gm__ float*>(ga);x_=reinterpret_cast<const __gm__ float*>(xa);out_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oa),t->outputNumel);stateOut_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(soa),t->batch*t->hc*t->hidden*t->stateLen);pipe_.InitBuffer(tmp_,256);pipe_.InitBuffer(outputBuf_,2048);pipe_.InitBuffer(stateBuf_,2048);
 }
 __aicore__ inline float History(uint64_t b,uint64_t c,int64_t pos){
  if(pos>=0)return x_[((b*t_->length+uint64_t(pos))*t_->hc+(c/t_->hidden))*t_->hidden+(c%t_->hidden)];
  if(!t_->hasState)return 0.0f;int64_t s=int64_t(t_->stateLen)+pos;return s>=0?EngramBf16ToFloat(state_[(b*t_->hc*t_->hidden+c)*t_->stateLen+uint64_t(s)]):0.0f;
 }
 __aicore__ inline void Process(){
  uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->outputBlockLength,end=begin+t_->outputBlockLength;if(end>t_->outputNumel)end=t_->outputNumel;auto z=tmp_.Get<float>();
  auto outputLocal=outputBuf_.Get<bfloat16_t>();for(uint64_t base=begin;base<end;base+=1024){uint32_t count=uint32_t(end-base<1024?end-base:1024);for(uint32_t ii=0;ii<count;++ii){uint64_t off=base+ii,d=off%t_->hidden;uint64_t row=off/t_->hidden,hc=row%t_->hc,bl=row/t_->hc,l=bl%t_->length,b=bl/t_->length,c=hc*t_->hidden+d;
   float conv=0.0f;for(uint64_t kk=0;kk<t_->kernel;++kk){int64_t pos=int64_t(l)-int64_t((t_->kernel-1-kk)*t_->dilation);conv+=cw_[c*t_->kernel+kk]*History(b,c,pos);}
   z.SetValue(0,-conv);for(uint32_t i=1;i<8;++i)z.SetValue(i,0.0f);AscendC::PipeBarrier<PIPE_ALL>();AscendC::Exp(z,z,8);AscendC::PipeBarrier<PIPE_ALL>();float silu=conv/(1.0f+z.GetValue(0));outputLocal.SetValue(ii,EngramFloatToBf16(gate_[off]+silu));}
   AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(out_[base],outputLocal,cp);AscendC::PipeBarrier<PIPE_ALL>();}
  uint64_t stateNum=t_->batch*t_->hc*t_->hidden*t_->stateLen;uint64_t stateBlock=((stateNum+t_->blockNum-1)/t_->blockNum+15)/16*16;uint64_t sb=uint64_t(AscendC::GetBlockIdx())*stateBlock,se=sb+stateBlock;if(se>stateNum)se=stateNum;
  auto stateLocal=stateBuf_.Get<bfloat16_t>();for(uint64_t base=sb;base<se;base+=1024){uint32_t count=uint32_t(se-base<1024?se-base:1024);for(uint32_t i=0;i<count;++i){uint64_t off=base+i,s=off%t_->stateLen,q=off/t_->stateLen,c=q%(t_->hc*t_->hidden),b=q/(t_->hc*t_->hidden);int64_t pos=int64_t(t_->length)+int64_t(s)-int64_t(t_->stateLen);stateLocal.SetValue(i,EngramFloatToBf16(History(b,c,pos)));}AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(stateOut_[base],stateLocal,cp);AscendC::PipeBarrier<PIPE_ALL>();}
 }
private:const __gm__ EngramGateFusionTilingData*t_;const __gm__ bfloat16_t*v_;const __gm__ float*cw_;const __gm__ bfloat16_t*state_;const __gm__ float*gate_;const __gm__ float*x_;AscendC::GlobalTensor<bfloat16_t>out_,stateOut_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>tmp_,outputBuf_,stateBuf_;
};

extern "C" __global__ __aicore__ __attribute__((aiv)) void engram_gate_stage(GM_ADDR k,GM_ADDR q,GM_ADDR v,GM_ADDR w1,GM_ADDR w2,GM_ADDR cn,GM_ADDR gate,GM_ADDR x,GM_ADDR til){EngramGateStage op;op.Init(k,q,v,w1,w2,cn,gate,x,reinterpret_cast<const __gm__ EngramGateFusionTilingData*>(til));op.Process();}
extern "C" __global__ __aicore__ __attribute__((aiv)) void engram_conv_stage(GM_ADDR v,GM_ADDR cw,GM_ADDR state,GM_ADDR gate,GM_ADDR x,GM_ADDR out,GM_ADDR stateOut,GM_ADDR til){EngramConvStage op;op.Init(v,cw,state,gate,x,out,stateOut,reinterpret_cast<const __gm__ EngramGateFusionTilingData*>(til));op.Process();}
