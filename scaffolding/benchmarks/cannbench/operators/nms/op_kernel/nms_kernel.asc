#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "nms_tiling.h"

__aicore__ inline bool NmsIsNan(float v){uint32_t b=*reinterpret_cast<uint32_t*>(&v);return (b&0x7fffffffU)>0x7f800000U;}
__aicore__ inline float NmsMaximum(float a,float b){if(NmsIsNan(a))return a;if(NmsIsNan(b))return b;return a>b?a:b;}
__aicore__ inline float NmsMinimum(float a,float b){if(NmsIsNan(a))return a;if(NmsIsNan(b))return b;return a<b?a:b;}
__aicore__ inline float NmsClampZero(float v){if(NmsIsNan(v))return v;return v>0.0f?v:0.0f;}

class NmsDevice {
public:
 __aicore__ inline void Init(GM_ADDR boxes,GM_ADDR scores,GM_ADDR keep,GM_ADDR count,const __gm__ NmsTilingData*t){
  boxes_=reinterpret_cast<__gm__ float*>(boxes);scores_=reinterpret_cast<__gm__ float*>(scores);keep_=reinterpret_cast<__gm__ int64_t*>(keep);count_=reinterpret_cast<__gm__ int64_t*>(count);t_=t;pipe_.InitBuffer(stateBuf_,8192);
 }
 __aicore__ inline float Area(uint32_t i){const uint64_t p=static_cast<uint64_t>(i)*4;return(boxes_[p+2]-boxes_[p])*(boxes_[p+3]-boxes_[p+1]);}
 __aicore__ inline float IoU(uint32_t a,uint32_t b){const uint64_t p=static_cast<uint64_t>(a)*4,q=static_cast<uint64_t>(b)*4;
  const float xx1=NmsMaximum(boxes_[p],boxes_[q]),yy1=NmsMaximum(boxes_[p+1],boxes_[q+1]);
  const float xx2=NmsMinimum(boxes_[p+2],boxes_[q+2]),yy2=NmsMinimum(boxes_[p+3],boxes_[q+3]);
  const float inter=NmsClampZero(xx2-xx1)*NmsClampZero(yy2-yy1);return inter/(Area(a)+Area(b)-inter+1.0e-6f);
 }
 __aicore__ inline void Process(){auto state=stateBuf_.Get<uint8_t>();for(uint32_t i=0;i<t_->n;++i)state.SetValue(i,0);uint32_t kept=0;
  for(uint32_t round=0;round<t_->n;++round){bool found=false;uint32_t best=0;float bestScore=0.0f;
   for(uint32_t i=0;i<t_->n;++i)if(state.GetValue(i)==0){float s=scores_[i];if(!found||s>bestScore){found=true;best=i;bestScore=s;}}
   if(!found)break;keep_[kept++]=best;state.SetValue(best,1);
   for(uint32_t j=0;j<t_->n;++j)if(state.GetValue(j)==0){float iou=IoU(best,j);if(!(iou<=t_->iouThreshold))state.SetValue(j,1);}
  }
  count_[0]=static_cast<int64_t>(kept);
 }
private:__gm__ float*boxes_;__gm__ float*scores_;__gm__ int64_t*keep_;__gm__ int64_t*count_;const __gm__ NmsTilingData*t_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>stateBuf_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void nms_kernel(GM_ADDR boxes,GM_ADDR scores,GM_ADDR keep,GM_ADDR count,GM_ADDR tiling){if(AscendC::GetBlockIdx()!=0)return;const __gm__ NmsTilingData*t=reinterpret_cast<const __gm__ NmsTilingData*>(tiling);NmsDevice op;op.Init(boxes,scores,keep,count,t);op.Process();}
