#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "data_utils.h"
#include "nms_tiling.h"
#include "../op_kernel/nms_kernel.asc"
namespace{void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: nms --n N --threshold T --boxes FILE --scores FILE --output FILE [--device N]\n";return 2;}int dev=0;bool init=false,set=false;aclrtStream stream=nullptr;void *hb=nullptr,*hs=nullptr,*ho=nullptr,*hc=nullptr,*db=nullptr,*ds=nullptr,*dout=nullptr,*dc=nullptr,*dt=nullptr;
 try{uint64_t n=std::stoull(Arg(argc,argv,"--n"));float threshold=std::stof(Arg(argc,argv,"--threshold"));dev=std::stoi(Arg(argc,argv,"--device","0"));auto t=ComputeNmsTiling(n,threshold);size_t bb=n*4*sizeof(float),sb=n*sizeof(float),ob=n*sizeof(int64_t);
  Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"set device");set=true;Check(aclrtCreateStream(&stream),"stream");Check(aclrtMallocHost(&hb,bb),"host boxes");Check(aclrtMallocHost(&hs,sb),"host scores");Check(aclrtMallocHost(&ho,ob),"host output");Check(aclrtMallocHost(&hc,sizeof(int64_t)),"host count");Check(aclrtMalloc(&db,bb,ACL_MEM_MALLOC_HUGE_FIRST),"dev boxes");Check(aclrtMalloc(&ds,sb,ACL_MEM_MALLOC_HUGE_FIRST),"dev scores");Check(aclrtMalloc(&dout,ob,ACL_MEM_MALLOC_HUGE_FIRST),"dev output");Check(aclrtMalloc(&dc,sizeof(int64_t),ACL_MEM_MALLOC_HUGE_FIRST),"dev count");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");
  if(!ReadFile(Arg(argc,argv,"--boxes"),hb,bb)||!ReadFile(Arg(argc,argv,"--scores"),hs,sb))throw std::runtime_error("read input failed");Check(aclrtMemcpy(db,bb,hb,bb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D boxes");Check(aclrtMemcpy(ds,sb,hs,sb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D scores");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");nms_kernel<<<1,nullptr,stream>>>(static_cast<uint8_t*>(db),static_cast<uint8_t*>(ds),static_cast<uint8_t*>(dout),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(hc,sizeof(int64_t),dc,sizeof(int64_t),ACL_MEMCPY_DEVICE_TO_HOST),"D2H count");int64_t count=*static_cast<int64_t*>(hc);if(count<0||count>static_cast<int64_t>(n))throw std::runtime_error("invalid device output count");Check(aclrtMemcpy(ho,count*sizeof(int64_t),dout,count*sizeof(int64_t),ACL_MEMCPY_DEVICE_TO_HOST),"D2H output");if(!WriteFile(Arg(argc,argv,"--output"),ho,count*sizeof(int64_t)))throw std::runtime_error("write output failed");std::cout<<"nms_kernel completed: n="<<n<<" kept="<<count<<"\n";
  aclrtFree(dt);dt=nullptr;aclrtFree(dc);dc=nullptr;aclrtFree(dout);dout=nullptr;aclrtFree(ds);ds=nullptr;aclrtFree(db);db=nullptr;aclrtFreeHost(hc);hc=nullptr;aclrtFreeHost(ho);ho=nullptr;aclrtFreeHost(hs);hs=nullptr;aclrtFreeHost(hb);hb=nullptr;aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(dev);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"nms failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dc)aclrtFree(dc);if(dout)aclrtFree(dout);if(ds)aclrtFree(ds);if(db)aclrtFree(db);if(hc)aclrtFreeHost(hc);if(ho)aclrtFreeHost(ho);if(hs)aclrtFreeHost(hs);if(hb)aclrtFreeHost(hb);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
