#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "mish_tiling.h"

template <typename T>
class KernelMish {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const __gm__ MishTilingData *tiling) {
        tiling_ = tiling;
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * tiling_->blockLength;
        const uint64_t remain = tiling_->totalLength > offset ? tiling_->totalLength - offset : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x_.SetGlobalBuffer((__gm__ T *)x + offset, length_);
        y_.SetGlobalBuffer((__gm__ T *)y + offset, length_);
        const uint32_t rawBytes = tiling_->tileElements * sizeof(T);
        const uint32_t fpBytes = tiling_->tileElements * sizeof(float);
        pipe_.InitBuffer(inQ_, 1, rawBytes);
        pipe_.InitBuffer(outQ_, 1, rawBytes);
        pipe_.InitBuffer(fpIn_, fpBytes);
        pipe_.InitBuffer(fpWork_, fpBytes);
        pipe_.InitBuffer(fpOut_, fpBytes);
        const uint32_t maskBytes = (((tiling_->tileElements + 7U) / 8U + 255U) / 256U) * 256U;
        pipe_.InitBuffer(maskBuf_, maskBytes);
    }

    __aicore__ inline void Process() {
        for (uint64_t off = 0; off < length_; off += tiling_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < tiling_->tileElements ? (length_ - off) : tiling_->tileElements);
            CopyIn(off, count);
            Compute(count);
            CopyOut(off, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t off, uint32_t count) {
        auto in = inQ_.AllocTensor<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, x_[off], p, pad);
        inQ_.EnQue(in);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto in = inQ_.DeQue<T>();
        auto out = outQ_.AllocTensor<T>();
        auto fi = fpIn_.Get<float>();
        auto work = fpWork_.Get<float>();
        auto fo = fpOut_.Get<float>();
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(fi, in, 0.0f, count);
        } else {
            AscendC::Cast(fi, in, AscendC::RoundMode::CAST_NONE, count);
        }

        // Stable softplus(x) = max(x, 0) + log(1 + exp(-abs(x))).
        AscendC::Abs(work, fi, count);
        AscendC::Muls(work, work, -1.0f, count);
        AscendC::Exp(work, work, count);
        AscendC::Adds(work, work, 1.0f, count);
        AscendC::Ln(work, work, count);
        AscendC::Maxs(fo, fi, 0.0f, count);
        AscendC::Add(fo, fo, work, count);
        // log(1 + z) loses z once z is below one FP32 ulp.  In the negative
        // tail softplus(x) is accurately exp(x), so select that equivalent
        // expression before applying tanh.  CompareScalar requires a count
        // aligned to 256 bytes for FP32.
        AscendC::Exp(work, fi, count);
        auto mask = maskBuf_.Get<uint8_t>();
        const uint32_t compareCount = ((count + 63U) / 64U) * 64U;
        AscendC::CompareScalar(mask, fi, -8.0f, AscendC::CMPMODE::LT, compareCount);
        AscendC::Select(fo, mask, work, fo,
            AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::Tanh(fo, fo, count);
        // Tanh's vector approximation flushes very small positive inputs;
        // tanh(exp(x)) == exp(x) to FP32 precision in this selected tail.
        AscendC::Select(fo, mask, work, fo,
            AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::Mul(fo, fo, fi, count);

        if constexpr (std::is_same<T, float>::value) {
            AscendC::Adds(out, fo, 0.0f, count);
        } else {
            constexpr auto mode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(out, fo, mode, count);
        }
        outQ_.EnQue(out);
        inQ_.FreeTensor(in);
    }

    __aicore__ inline void CopyOut(uint64_t off, uint32_t count) {
        auto out = outQ_.DeQue<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(y_[off], out, p);
        outQ_.FreeTensor(out);
    }

    AscendC::TPipe pipe_;
    const __gm__ MishTilingData *tiling_;
    uint64_t length_;
    AscendC::GlobalTensor<T> x_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpIn_, fpWork_, fpOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskBuf_;
};

extern "C" __global__ __aicore__ void mish_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ MishTilingData *t = reinterpret_cast<const __gm__ MishTilingData *>(tilingAddr);
    if (t->dtype == MISH_FLOAT32) {
        KernelMish<float> op; op.Init(x, y, t); op.Process();
    } else if (t->dtype == MISH_FLOAT16) {
        KernelMish<half> op; op.Init(x, y, t); op.Process();
    } else {
        KernelMish<bfloat16_t> op; op.Init(x, y, t); op.Process();
    }
}
