#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "strided_slice_tiling.h"

template <typename Raw>
__aicore__ inline void StridedSliceCopy(GM_ADDR xAddr, GM_ADDR yAddr,
                                        const __gm__ StridedSliceTilingData *t) {
    __gm__ Raw *x = reinterpret_cast<__gm__ Raw *>(xAddr);
    __gm__ Raw *y = reinterpret_cast<__gm__ Raw *>(yAddr);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t finish = begin + t->blockLength;
    if (finish > t->totalLength) finish = t->totalLength;
    for (uint64_t linear = begin; linear < finish; ++linear) {
        uint64_t rem = linear;
        uint64_t source = t->sourceBase;
        for (int d = static_cast<int>(t->outputRank) - 1; d >= 0; --d) {
            const uint64_t coord = rem % t->outputShape[d];
            rem /= t->outputShape[d];
            source += coord * t->sourceStep[d];
        }
        y[linear] = x[source];
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void strided_slice_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ StridedSliceTilingData *t =
        reinterpret_cast<const __gm__ StridedSliceTilingData *>(tilingAddr);
    if (t->itemBytes == 1) StridedSliceCopy<uint8_t>(x, y, t);
    else if (t->itemBytes == 2) StridedSliceCopy<uint16_t>(x, y, t);
    else if (t->itemBytes == 4) StridedSliceCopy<uint32_t>(x, y, t);
    else StridedSliceCopy<uint64_t>(x, y, t);
}
