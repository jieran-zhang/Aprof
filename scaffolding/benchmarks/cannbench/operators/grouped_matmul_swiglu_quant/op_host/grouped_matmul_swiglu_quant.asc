#include <algorithm>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/grouped_matmul_swiglu_quant_kernel.asc"
namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<int64_t> Ints(const std::string&s){std::vector<int64_t>v;std::stringstream q(s);std::string z;while(std::getline(q,z,','))v.push_back(std::stoll(z));return v;}
AscendC::tiling::TCubeTiling MakeTiling(int m,int n,int k){matmul_tiling::PlatformInfo p{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};matmul_tiling::MatmulApiTiling a(p);using matmul_tiling::TPosition;using matmul_tiling::CubeFormat;using matmul_tiling::DataType;if(a.SetAType(TPosition::GM,CubeFormat::ND,DataType::DT_INT8,false)||a.SetBType(TPosition::GM,CubeFormat::ND,DataType::DT_INT8,false)||a.SetCType(TPosition::GM,CubeFormat::ND,DataType::DT_INT32)||a.SetBiasType(TPosition::GM,CubeFormat::ND,DataType::DT_INT32)||a.SetShape(m,n,k)||a.SetOrgShape(m,n,k)||a.SetBias(false)||a.SetFixSplit(-1,-1,std::min(k,256)))throw std::runtime_error("matmul tiling setup");AscendC::tiling::TCubeTiling t{};if(a.GetTiling(t))throw std::runtime_error("matmul tiling");return t;}
struct Buf{void*h=nullptr,*d=nullptr;size_t n=0;};
}
int main(int argc,char**argv){bool init=false,set=false;aclrtStream stream=nullptr;std::vector<Buf>b;int dev=0;try{uint32_t m=std::stoul(Arg(argc,argv,"--m")),k=std::stoul(Arg(argc,argv,"--k")),n=std::stoul(Arg(argc,argv,"--n")),e=std::stoul(Arg(argc,argv,"--experts"));auto ends=Ints(Arg(argc,argv,"--group-list"));if(!m||!k||!n||(n&1)||ends.size()!=e||ends.back()!=m||!std::is_sorted(ends.begin(),ends.end()))throw std::invalid_argument("invalid shape/group-list");
 auto add=[&](size_t bytes,const std::string&path,bool input){Buf z;z.n=std::max<size_t>(bytes,1);Check(aclrtMallocHost(&z.h,z.n),"host alloc");Check(aclrtMalloc(&z.d,z.n,ACL_MEM_MALLOC_HUGE_FIRST),"device alloc");if(input){if(!ReadFile(path,z.h,bytes))throw std::runtime_error("read "+path);Check(aclrtMemcpy(z.d,z.n,z.h,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}b.push_back(z);return b.size()-1;};dev=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"set device");set=true;Check(aclrtCreateStream(&stream),"stream");int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");uint32_t blocks=uint32_t(std::min<int64_t>(m,cores));
 auto ix=add(uint64_t(m)*k,Arg(argc,argv,"--x"),true),iw=add(uint64_t(e)*k*n,Arg(argc,argv,"--weight"),true),iws=add(uint64_t(e)*n*4,Arg(argc,argv,"--weight-scale"),true),ixs=add(uint64_t(m)*4,Arg(argc,argv,"--x-scale"),true),ia=add(uint64_t(m)*n*4,"",false),iy=add(uint64_t(m)*(n/2),"",false),is=add(uint64_t(m)*4,"",false),it=add(sizeof(AscendC::tiling::TCubeTiling),"",false);
 uint64_t start=0;for(uint32_t g=0;g<e;++g){uint64_t stop=ends[g],gm=stop-start;if(!gm){start=stop;continue;}auto t=MakeTiling(gm,n,k);Check(aclrtMemcpy(b[it].d,b[it].n,&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");gmsq_cube<<<1,nullptr,stream>>>((uint8_t*)b[ix].d,(uint8_t*)b[iw].d,(uint8_t*)b[ia].d,(uint8_t*)b[it].d,start*k,uint64_t(g)*k*n,start*n,gm*k,uint64_t(k)*n,gm*n);Check(aclrtSynchronizeStream(stream),"cube sync");uint32_t br=uint32_t((gm+blocks-1)/blocks);gmsq_post<<<blocks,nullptr,stream>>>((uint8_t*)b[ia].d,(uint8_t*)b[iws].d+uint64_t(g)*n*4,(uint8_t*)b[ixs].d,(uint8_t*)b[iy].d,(uint8_t*)b[is].d,start,uint32_t(gm),n,br);Check(aclrtSynchronizeStream(stream),"post sync");start=stop;}
 Check(aclrtMemcpy(b[iy].h,b[iy].n,b[iy].d,b[iy].n,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");Check(aclrtMemcpy(b[is].h,b[is].n,b[is].d,b[is].n,ACL_MEMCPY_DEVICE_TO_HOST),"D2H scale");if(!WriteFile(Arg(argc,argv,"--output"),b[iy].h,b[iy].n)||!WriteFile(Arg(argc,argv,"--scale-output"),b[is].h,b[is].n))throw std::runtime_error("write output");std::cout<<"grouped_matmul_swiglu_quant completed M="<<m<<" K="<<k<<" N="<<n<<" E="<<e<<"\n";for(auto&z:b){aclrtFree(z.d);aclrtFreeHost(z.h);}aclrtDestroyStream(stream);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&x){std::cerr<<"grouped_matmul_swiglu_quant failed: "<<x.what()<<"\n";for(auto&z:b){if(z.d)aclrtFree(z.d);if(z.h)aclrtFreeHost(z.h);}if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
