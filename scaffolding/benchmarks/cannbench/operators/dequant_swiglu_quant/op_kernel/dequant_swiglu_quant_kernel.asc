#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "dequant_swiglu_quant_tiling.h"

template<typename T> __aicore__ inline float DsqToFloat(T v) {
  if constexpr(std::is_same<T,int32_t>::value) return static_cast<float>(v);
  uint16_t r=*reinterpret_cast<uint16_t*>(&v); uint32_t bits=0;
  if constexpr(std::is_same<T,bfloat16_t>::value) bits=uint32_t(r)<<16;
  else { uint32_t sign=uint32_t(r&0x8000U)<<16, exp=(r>>10)&31U, m=r&1023U; bits=sign;
    if(exp==31U){bits|=0x7f800000U|(m<<13);if(m)bits|=0x400000U;}
    else if(exp)bits|=((exp+112U)<<23)|(m<<13);
    else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}m&=1023U;bits|=(uint32_t(e+127)<<23)|(m<<13);}}
  return *reinterpret_cast<float*>(&bits);
}
__aicore__ inline int32_t DsqRoundEven(float v) {
  int32_t n=static_cast<int32_t>(v); float f=v-static_cast<float>(n);
  if(f>0.5f || (f==0.5f && (n&1))) ++n;
  if(f<-0.5f || (f==-0.5f && (n&1))) --n;
  return n;
}
template<typename T> class DequantSwigluKernel { public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR ws, GM_ADDR as, GM_ADDR qs, GM_ADDR y, GM_ADDR scale,
                              const __gm__ DequantSwigluTilingData *t) {
    t_=t;x_=reinterpret_cast<const __gm__ T*>(x);ws_=reinterpret_cast<const __gm__ float*>(ws);
    as_=reinterpret_cast<const __gm__ float*>(as);qs_=reinterpret_cast<const __gm__ float*>(qs);
    y_=reinterpret_cast<__gm__ int8_t*>(y);scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale),t->rows);
    uint32_t aligned=((t->half+7)/8)*8; pipe_.InitBuffer(a_,aligned*4);pipe_.InitBuffer(b_,aligned*4);pipe_.InitBuffer(scaleLocal_,32);
  }
  __aicore__ inline void Process(){
    uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->blockRows,end=begin+t_->blockRows;if(end>t_->rows)end=t_->rows;
    auto a=a_.Get<float>();auto b=b_.Get<float>();auto scaleLocal=scaleLocal_.Get<float>();const uint32_t h=t_->half;
    for(uint64_t r=begin;r<end;++r){const uint64_t base=r*uint64_t(h)*2;const float actScale=std::is_same<T,int32_t>::value?as_[r]:1.0f;
      for(uint32_t j=0;j<h;++j){float av=DsqToFloat<T>(x_[base+j]),bv=DsqToFloat<T>(x_[base+h+j]);
        if constexpr(std::is_same<T,int32_t>::value){av=av*ws_[j]*actScale;bv=bv*ws_[h+j]*actScale;}
        a.SetValue(j,av);b.SetValue(j,bv);}
      AscendC::PipeBarrier<PIPE_ALL>();
      if(t_->activateLeft){for(uint32_t j=0;j<h;++j)a.SetValue(j,-a.GetValue(j));AscendC::PipeBarrier<PIPE_ALL>();AscendC::Exp(a,a,h);}
      else {for(uint32_t j=0;j<h;++j)b.SetValue(j,-b.GetValue(j));AscendC::PipeBarrier<PIPE_ALL>();AscendC::Exp(b,b,h);}
      AscendC::PipeBarrier<PIPE_ALL>();float maxAbs=0.0f;
      for(uint32_t j=0;j<h;++j){float out;if(t_->activateLeft){float orig=DsqToFloat<T>(x_[base+j]);if constexpr(std::is_same<T,int32_t>::value)orig=orig*ws_[j]*actScale;out=(orig/(1.0f+a.GetValue(j)))*b.GetValue(j);}else{float orig=DsqToFloat<T>(x_[base+h+j]);if constexpr(std::is_same<T,int32_t>::value)orig=orig*ws_[h+j]*actScale;out=(orig/(1.0f+b.GetValue(j)))*a.GetValue(j);}if(t_->hasQuantScale)out*=qs_[j];a.SetValue(j,out);float ab=out<0?-out:out;if(ab>maxAbs)maxAbs=ab;}
      float s=maxAbs/127.0f;if(s<1.0e-12f)s=1.0e-12f;scaleLocal.SetValue(0,s);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams scaleCp{1,4,0,0,0};AscendC::DataCopyPad(scale_[r],scaleLocal,scaleCp);
      for(uint32_t j=0;j<h;++j){int32_t q=DsqRoundEven(a.GetValue(j)/s);if(q>127)q=127;if(q<-128)q=-128;y_[r*uint64_t(h)+j]=static_cast<int8_t>(q);}
    }
  }
 private: const __gm__ DequantSwigluTilingData*t_;const __gm__ T*x_;const __gm__ float*ws_;const __gm__ float*as_;const __gm__ float*qs_;__gm__ int8_t*y_;AscendC::GlobalTensor<float>scale_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>a_,b_,scaleLocal_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void dequant_swiglu_quant_kernel(GM_ADDR x,GM_ADDR ws,GM_ADDR as,GM_ADDR qs,GM_ADDR y,GM_ADDR scale,GM_ADDR til){const __gm__ DequantSwigluTilingData*t=reinterpret_cast<const __gm__ DequantSwigluTilingData*>(til);if(t->dtype==DSQ_INT32){DequantSwigluKernel<int32_t>op;op.Init(x,ws,as,qs,y,scale,t);op.Process();}else if(t->dtype==DSQ_BF16){DequantSwigluKernel<bfloat16_t>op;op.Init(x,ws,as,qs,y,scale,t);op.Process();}else{DequantSwigluKernel<half>op;op.Init(x,ws,as,qs,y,scale,t);op.Process();}}
