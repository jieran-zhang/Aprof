#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "rms_norm_tiling.h"

template <typename T>
class KernelRmsNorm {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR gamma, GM_ADDR y,
                                const __gm__ RmsNormTilingData *t) {
        t_ = t;
        const uint64_t rowBegin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->rowsPerBlock;
        rowBegin_ = rowBegin;
        const uint64_t remain = t_->rows > rowBegin ? t_->rows - rowBegin : 0;
        rowCount_ = remain < t_->rowsPerBlock ? remain : t_->rowsPerBlock;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), t_->rows * t_->hidden);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), t_->hidden);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), t_->rows * t_->hidden);
        const uint32_t rawBytes = t_->hidden * sizeof(T);
        const uint32_t fpBytes = t_->hidden * sizeof(float);
        pipe_.InitBuffer(gammaBuf_, rawBytes);
        pipe_.InitBuffer(xQ_, 1, rawBytes);
        pipe_.InitBuffer(yQ_, 1, rawBytes);
        pipe_.InitBuffer(reduceBuf_, fpBytes);
        pipe_.InitBuffer(sumBuf_, 64);
        pipe_.InitBuffer(invBuf_, 32);
        if constexpr (!std::is_same<T, float>::value) {
            pipe_.InitBuffer(xCastBuf_, fpBytes);
            pipe_.InitBuffer(gammaCastBuf_, fpBytes);
            pipe_.InitBuffer(yCastBuf_, fpBytes);
        }
        gammaRaw_ = gammaBuf_.Get<T>();
        AscendC::DataCopyExtParams cp{1, rawBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(gammaRaw_, gamma_, cp, pad);
        AscendC::PipeBarrier<PIPE_MTE2>();
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (std::is_same<T, float>::value) {
            gammaFp_ = gammaRaw_.template ReinterpretCast<float>();
        } else {
            gammaFp_ = gammaCastBuf_.Get<float>();
            const int32_t count = static_cast<int32_t>(t_->hidden);
            AscendC::Cast(gammaFp_, gammaRaw_, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void Process() {
        for (uint64_t local = 0; local < rowCount_; ++local) ProcessRow(rowBegin_ + local);
    }

private:
    __aicore__ inline void ProcessRow(uint64_t row) {
        const uint64_t offset = row * t_->hidden;
        const int32_t count = static_cast<int32_t>(t_->hidden);
        auto xRaw = xQ_.AllocTensor<T>();
        AscendC::DataCopyExtParams cp{1, t_->hidden * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(xRaw, x_[offset], cp, pad);
        xQ_.EnQue(xRaw);
        xRaw = xQ_.DeQue<T>();
        auto yRaw = yQ_.AllocTensor<T>();
        AscendC::LocalTensor<float> xFp;
        AscendC::LocalTensor<float> yFp;
        if constexpr (std::is_same<T, float>::value) {
            xFp = xRaw.template ReinterpretCast<float>();
            yFp = yRaw.template ReinterpretCast<float>();
        } else {
            xFp = xCastBuf_.Get<float>();
            yFp = yCastBuf_.Get<float>();
            AscendC::Cast(xFp, xRaw, AscendC::RoundMode::CAST_NONE, t_->hidden);
            AscendC::PipeBarrier<PIPE_V>();
        }
        auto scratch = reduceBuf_.Get<float>();
        auto sum = sumBuf_.Get<float>();
        auto inv = invBuf_.Get<float>();
        AscendC::Mul(yFp, xFp, xFp, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float>(sum, yFp, scratch, count);
        AscendC::PipeBarrier<PIPE_V>();
        const float meanPlusEps = sum.GetValue(0) * t_->invHidden + t_->epsilon;
        AscendC::Duplicate(sum, meanPlusEps, 1);
        AscendC::Rsqrt(inv, sum, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        float invRms = inv.GetValue(0);
        // AscendC::Rsqrt is an approximation.  Refine in FP32 so near-zero
        // half outputs do not cross a quantization boundary versus golden.
        // Newton is valid only for positive finite mean. Keep the original
        // Rsqrt seed for Inf/NaN/zero: Inf*0 inside Newton would create NaN.
        if (meanPlusEps > 0.0f && meanPlusEps <= 0x1.fffffep127f) {
            invRms = invRms * (1.5f - 0.5f * meanPlusEps * invRms * invRms);
            invRms = invRms * (1.5f - 0.5f * meanPlusEps * invRms * invRms);
        }
        AscendC::Muls(yFp, xFp, invRms, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(yFp, yFp, gammaFp_, count);
        AscendC::PipeBarrier<PIPE_V>();
        if constexpr (!std::is_same<T, float>::value) {
            constexpr auto mode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_ROUND : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(yRaw, yFp, mode, count);
            AscendC::PipeBarrier<PIPE_V>();
        }
        yQ_.EnQue(yRaw); xQ_.FreeTensor(xRaw);
        yRaw = yQ_.DeQue<T>();
        AscendC::DataCopyPad(y_[offset], yRaw, cp);
        yQ_.FreeTensor(yRaw);
    }

    AscendC::TPipe pipe_;
    const __gm__ RmsNormTilingData *t_;
    uint64_t rowBegin_, rowCount_;
    AscendC::GlobalTensor<T> x_, gamma_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaBuf_, reduceBuf_, sumBuf_, invBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xCastBuf_, gammaCastBuf_, yCastBuf_;
    AscendC::LocalTensor<T> gammaRaw_;
    AscendC::LocalTensor<float> gammaFp_;
};

// New algorithm region: independent hidden=2 rows batched in one vector tile.
// PairReduceSum never mixes rows. FP32 arithmetic and two Rsqrt refinements stay.
template <typename T>
class KernelRmsNormPairRows {
public:
    static constexpr uint32_t kRows = 256;
    static constexpr uint32_t kElements = 2 * kRows;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR gamma, GM_ADDR y,
                               const __gm__ RmsNormTilingData* t) {
        t_ = t; x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        g_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        pipe_.InitBuffer(xQ_, 1, kElements * sizeof(T));
        pipe_.InitBuffer(yQ_, 1, kElements * sizeof(T));
        pipe_.InitBuffer(xFpBuf_, kElements * sizeof(float));
        pipe_.InitBuffer(squareBuf_, kElements * sizeof(float));
        pipe_.InitBuffer(sumBuf_, kRows * sizeof(float));
        pipe_.InitBuffer(invBuf_, kRows * sizeof(float));
        pipe_.InitBuffer(refineBuf_, kRows * sizeof(float));
        pipe_.InitBuffer(expandedBuf_, kElements * sizeof(float));
        pipe_.InitBuffer(gammaBuf_, kElements * sizeof(float));
        pipe_.InitBuffer(indexBuf_, kElements * sizeof(uint32_t));
        pipe_.InitBuffer(gammaRawBuf_, 32); pipe_.InitBuffer(gammaFpBuf_, 32);
        auto raw = gammaRawBuf_.Get<T>();
        AscendC::DataCopyExtParams cp{1, 2 * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, 0};
        AscendC::DataCopyPad(raw, g_, cp, pad); AscendC::PipeBarrier<PIPE_ALL>();
        auto gammaFp = gammaFpBuf_.Get<float>();
        if constexpr (std::is_same<T, float>::value) AscendC::DataCopy(gammaFp, raw, 8);
        else AscendC::Cast(gammaFp, raw, AscendC::RoundMode::CAST_NONE, 2);
        const int32_t vs = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
        AscendC::SetFlag<AscendC::HardEvent::V_S>(vs); AscendC::WaitFlag<AscendC::HardEvent::V_S>(vs);
        const float g0 = gammaFp.GetValue(0), g1 = gammaFp.GetValue(1);
        auto expandedGamma = gammaBuf_.Get<float>(); auto indices = indexBuf_.Get<uint32_t>();
        for (uint32_t j = 0; j < kElements; ++j) {
            expandedGamma.SetValue(j, (j & 1) ? g1 : g0);
            indices.SetValue(j, (j / 2) * sizeof(float));
        }
        const int32_t sv = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::S_V));
        AscendC::SetFlag<AscendC::HardEvent::S_V>(sv); AscendC::WaitFlag<AscendC::HardEvent::S_V>(sv);
    }
    __aicore__ inline void Process() {
        uint64_t row = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->rowsPerBlock;
        uint64_t end = row + t_->rowsPerBlock; if (end > t_->rows) end = t_->rows;
        for (; row < end; row += kRows) {
            const uint32_t rows = static_cast<uint32_t>(end - row < kRows ? end - row : kRows);
            const uint32_t count = 2 * rows;
            const uint32_t paddedRows = ((rows + 63) / 64) * 64; // CompareScalar FP32 count must be a multiple of64
            const uint32_t paddedElements = 2 * paddedRows;
            auto raw = xQ_.AllocTensor<T>();
            AscendC::DataCopyExtParams cp{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, 0};
            AscendC::DataCopyPad(raw, x_[2 * row], cp, pad); xQ_.EnQue(raw); raw = xQ_.DeQue<T>();
            auto xf = xFpBuf_.Get<float>(); auto square = squareBuf_.Get<float>();
            auto mean = sumBuf_.Get<float>(); auto inv = invBuf_.Get<float>(); auto tmp = refineBuf_.Get<float>();
            AscendC::Duplicate(xf, 0.0f, paddedElements); AscendC::PipeBarrier<PIPE_V>();
            if constexpr (std::is_same<T, float>::value) AscendC::DataCopy(xf, raw, ((count + 7) / 8) * 8);
            else AscendC::Cast(xf, raw, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(square, xf, xf, paddedElements); AscendC::PipeBarrier<PIPE_V>();
            AscendC::PairReduceSum(mean, square, paddedElements / 64, 64, 1, 1, 8);
            AscendC::PipeBarrier<PIPE_V>(); AscendC::Muls(mean, mean, 0.5f, paddedRows);
            const float epsilon = t_->epsilon;
            AscendC::PipeBarrier<PIPE_V>(); AscendC::Adds(mean, mean, epsilon, paddedRows);
            AscendC::PipeBarrier<PIPE_V>(); AscendC::Rsqrt(inv, mean, paddedRows); AscendC::PipeBarrier<PIPE_V>();
            // Squared inputs are dead after PairReduceSum. Reuse that buffer
            // to keep the original Rsqrt seed, without another UB allocation.
            AscendC::DataCopy(square, inv, paddedRows);
            auto expanded = expandedBuf_.Get<float>();
            auto positiveMask = expanded.template ReinterpretCast<uint8_t>();
            auto finiteMask = positiveMask[256];
            // The expanded-result buffer is not live until Gather below.
            // Each mask is32B for <=256 rows; windows are256B apart.
            AscendC::Duplicate(positiveMask.template ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0), 16);
            AscendC::Duplicate(finiteMask.template ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0), 16);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::CompareScalar(positiveMask, mean, 0.0f, AscendC::CMPMODE::GT, paddedRows);
            AscendC::CompareScalar(finiteMask, mean, 0x1.fffffep127f, AscendC::CMPMODE::LE, paddedRows);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::And(positiveMask.template ReinterpretCast<uint16_t>(),
                         positiveMask.template ReinterpretCast<uint16_t>(),
                         finiteMask.template ReinterpretCast<uint16_t>(), 16);
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t refinement = 0; refinement < 2; ++refinement) {
                AscendC::Muls(tmp, mean, 0.5f, paddedRows); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(tmp, tmp, inv, paddedRows); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(tmp, tmp, inv, paddedRows); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(tmp, tmp, -1.0f, paddedRows); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(tmp, tmp, 1.5f, paddedRows); AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(inv, inv, tmp, paddedRows); AscendC::PipeBarrier<PIPE_V>();
            }
            // Distinct destination avoids Select source/destination overlap.
            // Positive finite rows retain exactly the prior two-step result;
            // other rows recover Rsqrt's seed before x*inverse*gamma.
            AscendC::Select(tmp, positiveMask, inv, square,
                            AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, paddedRows);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Gather(expanded, tmp, indexBuf_.Get<uint32_t>(), 0, paddedElements);
            AscendC::PipeBarrier<PIPE_V>(); AscendC::Mul(square, xf, expanded, count);
            AscendC::PipeBarrier<PIPE_V>(); AscendC::Mul(square, square, gammaBuf_.Get<float>(), count);
            AscendC::PipeBarrier<PIPE_V>(); auto out = yQ_.AllocTensor<T>();
            if constexpr (std::is_same<T, float>::value) AscendC::DataCopy(out, square, paddedElements);
            else {
                constexpr auto mode = std::is_same<T, bfloat16_t>::value ? AscendC::RoundMode::CAST_ROUND : AscendC::RoundMode::CAST_NONE;
                AscendC::Cast(out, square, mode, count);
            }
            yQ_.EnQue(out); xQ_.FreeTensor(raw); out = yQ_.DeQue<T>();
            AscendC::DataCopyPad(y_[2 * row], out, cp); yQ_.FreeTensor(out);
        }
    }
private:
    AscendC::TPipe pipe_; const __gm__ RmsNormTilingData* t_;
    AscendC::GlobalTensor<T> x_, g_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN,1> xQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFpBuf_,squareBuf_,sumBuf_,invBuf_,refineBuf_,expandedBuf_,gammaBuf_,indexBuf_,gammaRawBuf_,gammaFpBuf_;
};
__aicore__ inline void RmsNormBaselineDtype(GM_ADDR x,GM_ADDR gamma,GM_ADDR y,GM_ADDR tilingAddr) {
    const auto* t = reinterpret_cast<const __gm__ RmsNormTilingData*>(tilingAddr);
    if (t->dtype == RMS_FLOAT16) { KernelRmsNorm<half> op; op.Init(x,gamma,y,t); op.Process(); }
    else if (t->dtype == RMS_FLOAT32) { KernelRmsNorm<float> op; op.Init(x,gamma,y,t); op.Process(); }
    else { KernelRmsNorm<bfloat16_t> op; op.Init(x,gamma,y,t); op.Process(); }
}
extern "C" __global__ __aicore__ void rms_norm_pair_rows(GM_ADDR x,GM_ADDR gamma,GM_ADDR y,GM_ADDR tilingAddr) {
    const auto* t = reinterpret_cast<const __gm__ RmsNormTilingData*>(tilingAddr);
    if (t->dtype == RMS_FLOAT16) { KernelRmsNormPairRows<half> op; op.Init(x,gamma,y,t); op.Process(); }
    else if (t->dtype == RMS_FLOAT32) { KernelRmsNormPairRows<float> op; op.Init(x,gamma,y,t); op.Process(); }
    else { KernelRmsNormPairRows<bfloat16_t> op; op.Init(x,gamma,y,t); op.Process(); }
}
extern "C" __global__ __aicore__ void rms_norm_short_rows(GM_ADDR x,GM_ADDR gamma,GM_ADDR y,GM_ADDR tilingAddr) { RmsNormBaselineDtype(x,gamma,y,tilingAddr); }
extern "C" __global__ __aicore__ void rms_norm_full_row(GM_ADDR x,GM_ADDR gamma,GM_ADDR y,GM_ADDR tilingAddr) { RmsNormBaselineDtype(x,gamma,y,tilingAddr); }
extern "C" __global__ __aicore__ void rms_norm_generic(GM_ADDR x,GM_ADDR gamma,GM_ADDR y,GM_ADDR tilingAddr) { RmsNormBaselineDtype(x,gamma,y,tilingAddr); }
