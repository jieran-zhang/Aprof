{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/shared-context-report.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "shared_context_paired_v1"
    },
    "analysis_version": {
      "const": "shared_context_analysis_v1"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessions_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "measurement_quality": {
      "type": "object",
      "properties": {
        "structurally_complete": {
          "const": true
        },
        "observed_checks_pass": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "enum": [
                  "within_process_cv",
                  "aa_equivalence"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "exceeds_0.05",
                  "observed_bias",
                  "precision_insufficient"
                ]
              }
            },
            "required": [
              "check",
              "location",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "method_qualification": {
          "enum": [
            "evaluated_here",
            "external_scope_required"
          ]
        },
        "routine_controls_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "structurally_complete",
        "observed_checks_pass",
        "failures",
        "method_qualification",
        "routine_controls_complete"
      ],
      "additionalProperties": false
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "qualification",
              "before",
              "reverse",
              "ab",
              "after"
            ]
          },
          "replicate_id": {
            "type": "integer"
          },
          "block_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "buffer_config": {
            "enum": [
              "normal",
              "swapped"
            ]
          },
          "load_order": {
            "enum": [
              "AB",
              "BA"
            ]
          },
          "first_order": {
            "enum": [
              "AB",
              "BA"
            ]
          },
          "started_at": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "A": {
            "$ref": "#/$defs/series"
          },
          "B": {
            "$ref": "#/$defs/series"
          },
          "pair_logs": {
            "type": "array",
