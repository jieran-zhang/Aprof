            }
          },
          "mean_log": {
            "type": "number"
          },
          "speedup": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pair_log_sd": {
            "type": "number"
          },
          "pair_log_slope": {
            "type": "number"
          },
          "order_log_means": {
            "type": "object",
            "properties": {
              "AB": {
                "type": "number"
              },
              "BA": {
                "type": "number"
              }
            },
            "required": [
              "AB",
              "BA"
            ],
            "additionalProperties": false
