{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aprof:diagnosis-problem-expansion-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "aprof.diagnosis-problem-expansion-request/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "knowledge_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graph_version": {
      "type": "string",
      "pattern": "^v[0-9]{4}$"
    },
    "source_context_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "retrieval_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "trigger": {
            "enum": [
              "observation_match",
              "alternative_mechanism",
              "unexplained_observation",
              "scope_check",
              "followup_check"
            ]
          },
          "related_problem_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "unexplained_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "problem_id",
          "reason",
          "trigger",
          "related_problem_ids",
          "unexplained_observations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "context_hash",
    "knowledge_hash",
    "graph_version",
    "source_context_ref",
    "retrieval_hash",
    "selections"
  ],
  "additionalProperties": false
}
