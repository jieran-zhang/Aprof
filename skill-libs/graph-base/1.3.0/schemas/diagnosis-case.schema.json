{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aprof:diagnosis-case",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "aprof.diagnosis-case/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_status": {
      "enum": [
        "paper",
        "source_review",
        "validated_case"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_implementation_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workload_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "parent_implementation_hash",
        "workload_hash",
        "target_ids",
        "stage"
      ],
      "additionalProperties": false
    },
    "context_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "excerpt_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "original_path",
          "revision",
          "lines",
          "sha256",
          "excerpt_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidate_explanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selected_action_instances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "accepted",
            "rejected",
            "inconclusive"
          ]
        },
        "timing_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "correctness_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanism_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "timing_ref",
        "correctness_ref",
        "mechanism_refs",
        "limitations"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "source_statement",
              "code_fact",
              "mechanism_inference",
              "case_support",
              "legacy_seed"
            ]
          },
          "source_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "review_status": {
            "enum": [
              "reviewed",
              "gap"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "case_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "text",
          "basis",
          "source_indexes",
          "review_status",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "pending",
            "reviewed",
            "rejected"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "reviewer",
        "independent",
        "decision",
        "notes"
      ],
      "additionalProperties": false
    },
    "handoff_refs": {
      "type": "object",
      "properties": {
        "C1": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "C2": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "C3": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "C1",
        "C2",
        "C3"
      ],
      "additionalProperties": false
    },
    "routing_config_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "review_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "execution_kind": {
      "enum": [
        "hardware",
        "synthetic",
        "not_run"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "evidence_status",
    "task_id",
    "scope",
    "context_ref",
    "reasoning_ref",
    "sources",
    "observations",
    "candidate_explanations",
    "selected_action_instances",
    "outcome",
    "claims",
    "review"
  ],
  "additionalProperties": false
}
