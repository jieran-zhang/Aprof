{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aprof:diagnosis-problem-expansion",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "aprof.diagnosis-problem-expansion/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "knowledge_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graph_version": {
      "type": "string",
      "pattern": "^v[0-9]{4}$"
    },
    "source_context_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "retrieval_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "aprof:diagnosis-problem-expansion-request",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "aprof.diagnosis-problem-expansion-request/v1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "context_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "knowledge_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graph_version": {
          "type": "string",
          "pattern": "^v[0-9]{4}$"
        },
        "source_context_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "retrieval_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problem_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "trigger": {
                "enum": [
                  "observation_match",
                  "alternative_mechanism",
                  "unexplained_observation",
                  "scope_check",
                  "followup_check"
                ]
              },
              "related_problem_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "unexplained_observations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "problem_id",
              "reason",
              "trigger",
              "related_problem_ids",
              "unexplained_observations"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "context_hash",
        "knowledge_hash",
        "graph_version",
        "source_context_ref",
        "retrieval_hash",
        "selections"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "trigger": {
            "enum": [
              "observation_match",
              "alternative_mechanism",
              "unexplained_observation",
              "scope_check",
              "followup_check"
            ]
          },
          "related_problem_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "unexplained_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "workloads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dtypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "platforms",
              "workloads",
              "dtypes"
            ],
            "additionalProperties": false
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "tensor",
                    "task",
                    "stage",
                    "workload",
                    "implementation",
                    "object"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "kind",
                "description",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "analysis": {
            "type": "object",
            "properties": {
              "mechanism_chain": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "objects_and_stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "predictions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "supporting_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "counter_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "problem_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "distinction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "check": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "problem_id",
                    "distinction",
                    "check"
                  ],
                  "additionalProperties": false
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "intervention": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requirements": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "costs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "action_id",
                    "intervention",
                    "requirements",
                    "costs"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "mechanism_chain",
              "objects_and_stages",
              "predictions",
              "supporting_checks",
              "counter_checks",
              "limits",
              "alternatives",
              "actions"
            ],
            "additionalProperties": false
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "source_statement",
                    "code_fact",
                    "mechanism_inference",
                    "case_support",
                    "legacy_seed"
                  ]
                },
                "source_indexes": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "review_status": {
                  "enum": [
                    "reviewed",
                    "gap"
                  ]
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "case_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "text",
                "basis",
                "source_indexes",
                "review_status",
                "limitations"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "reviewed_with_limits",
                  "gap"
                ]
              },
              "source_credibility": {
                "type": "string",
                "minLength": 1
              },
              "discriminating_power": {
                "type": "string",
                "minLength": 1
              },
              "observed_frequency": {
                "type": "string",
                "minLength": 1
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "state",
              "source_credibility",
              "discriminating_power",
              "observed_frequency",
              "gaps"
            ],
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "original_path": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "excerpt_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "original_path",
                "revision",
                "lines",
                "sha256",
                "excerpt_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "template_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "scope_status": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          }
        },
        "required": [
          "problem_id",
          "reason",
          "trigger",
          "related_problem_ids",
          "unexplained_observations",
          "title",
          "mechanism",
          "scope",
          "slots",
          "analysis",
          "claims",
          "review",
          "sources",
          "body",
          "source_path",
          "source_hash",
          "template_hash",
          "body_sha256",
          "scope_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "context_hash",
    "knowledge_hash",
    "graph_version",
    "source_context_ref",
    "retrieval_hash",
    "request_hash",
    "request",
    "entries",
    "limitations"
  ],
  "additionalProperties": false
}
