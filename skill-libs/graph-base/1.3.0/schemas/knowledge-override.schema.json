{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aprof:knowledge-override:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "aprof.knowledge-override/v1"
    },
    "base_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "base_hash",
    "version",
    "parameters"
  ],
  "additionalProperties": false
}
