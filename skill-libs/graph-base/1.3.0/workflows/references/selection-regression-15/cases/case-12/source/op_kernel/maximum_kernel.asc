#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "maximum_tiling.h"

template <typename T>
class KernelMaximumSame {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                const __gm__ MaximumTilingData *t) {
        t_ = t;
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        const uint64_t remain = t_->totalLength > offset ? t_->totalLength - offset : 0;
        length_ = remain < t_->blockLength ? remain : t_->blockLength;
        x1_.SetGlobalBuffer((__gm__ T *)x1 + offset, length_);
        x2_.SetGlobalBuffer((__gm__ T *)x2 + offset, length_);
        y_.SetGlobalBuffer((__gm__ T *)y + offset, length_);
        const uint32_t count = t_->tileElements;
        pipe_.InitBuffer(x1Q_, 1, count * sizeof(T));
        pipe_.InitBuffer(x2Q_, 1, count * sizeof(T));
        pipe_.InitBuffer(yQ_, 1, count * sizeof(T));
        if constexpr (std::is_same<T, bfloat16_t>::value || std::is_same<T, int8_t>::value) {
            pipe_.InitBuffer(tmp1_, count * sizeof(float));
            pipe_.InitBuffer(tmp2_, count * sizeof(float));
            pipe_.InitBuffer(tmpOut_, count * sizeof(float));
            if constexpr (std::is_same<T, int8_t>::value)
                pipe_.InitBuffer(tmpHalf_, count * sizeof(half));
        }
    }

    __aicore__ inline void Process() {
        for (uint64_t off = 0; off < length_; off += t_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < t_->tileElements ? length_ - off : t_->tileElements);
            auto a = x1Q_.AllocTensor<T>();
            auto b = x2Q_.AllocTensor<T>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(a, x1_[off], p, pad);
            AscendC::DataCopyPad(b, x2_[off], p, pad);
            x1Q_.EnQue(a); x2Q_.EnQue(b);
            a = x1Q_.DeQue<T>(); b = x2Q_.DeQue<T>();
            auto out = yQ_.AllocTensor<T>();
            if constexpr (std::is_same<T, bfloat16_t>::value) {
                auto af = tmp1_.Get<float>(); auto bf = tmp2_.Get<float>(); auto of = tmpOut_.Get<float>();
                AscendC::Cast(af, a, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Cast(bf, b, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Max(of, af, bf, count);
                AscendC::Cast(out, of, AscendC::RoundMode::CAST_RINT, count);
            } else if constexpr (std::is_same<T, int8_t>::value) {
                auto ah = tmpHalf_.Get<half>(); auto af = tmp1_.Get<float>();
                auto bf = tmp2_.Get<float>(); auto of = tmpOut_.Get<float>();
                AscendC::Cast(ah, a, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Cast(af, ah, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Cast(ah, b, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Cast(bf, ah, AscendC::RoundMode::CAST_NONE, count);
                AscendC::Max(of, af, bf, count);
                AscendC::Cast(ah, of, AscendC::RoundMode::CAST_RINT, count);
                AscendC::Cast(out, ah, AscendC::RoundMode::CAST_RINT, count);
            } else {
                AscendC::Max(out, a, b, count);
            }
            yQ_.EnQue(out); x2Q_.FreeTensor(b); x1Q_.FreeTensor(a);
            out = yQ_.DeQue<T>();
            AscendC::DataCopyPad(y_[off], out, p);
            yQ_.FreeTensor(out);
        }
    }
private:
    AscendC::TPipe pipe_;
    const __gm__ MaximumTilingData *t_;
    uint64_t length_;
    AscendC::GlobalTensor<T> x1_, x2_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> x1Q_, x2Q_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, tmp2_, tmpOut_, tmpHalf_;
};

// FP16 broadcast cases are processed as contiguous innermost-axis segments.
// This keeps all half comparisons in the vector unit; dav-2201 does not allow
// half scalar arithmetic in an aicore function.
class KernelMaximumHalfLastAxisBroadcast {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                const __gm__ MaximumTilingData *t) {
        t_ = t;
        begin_ = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        end_ = begin_ + t_->blockLength;
        if (end_ > t_->totalLength) end_ = t_->totalLength;
        row_ = t_->outShape[t_->rank - 1];
        x1_.SetGlobalBuffer((__gm__ half *)x1, t_->totalLength);
        x2_.SetGlobalBuffer((__gm__ half *)x2, row_);
        y_.SetGlobalBuffer((__gm__ half *)y, t_->totalLength);
        const uint32_t count = t_->tileElements;
        pipe_.InitBuffer(x1Q_, 1, count * sizeof(half));
        pipe_.InitBuffer(x2Q_, 1, count * sizeof(half));
        pipe_.InitBuffer(yQ_, 1, count * sizeof(half));
    }
    __aicore__ inline void Process() {
        for (uint64_t off = begin_; off < end_;) {
            uint64_t count64 = end_ - off;
            if (count64 > t_->tileElements) count64 = t_->tileElements;
            const uint64_t rowRemain = row_ - (off % row_);
            if (count64 > rowRemain) count64 = rowRemain;
            const uint32_t count = static_cast<uint32_t>(count64);
            auto a = x1Q_.AllocTensor<half>(); auto b = x2Q_.AllocTensor<half>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<half> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(a, x1_[off], p, pad);
            AscendC::DataCopyPad(b, x2_[off % row_], p, pad);
            x1Q_.EnQue(a); x2Q_.EnQue(b); a = x1Q_.DeQue<half>(); b = x2Q_.DeQue<half>();
            auto out = yQ_.AllocTensor<half>(); AscendC::Max(out, a, b, count); yQ_.EnQue(out);
            x2Q_.FreeTensor(b); x1Q_.FreeTensor(a); out = yQ_.DeQue<half>();
            AscendC::DataCopyPad(y_[off], out, p); yQ_.FreeTensor(out); off += count;
        }
    }
private:
    AscendC::TPipe pipe_; const __gm__ MaximumTilingData *t_;
    uint64_t begin_, end_, row_;
    AscendC::GlobalTensor<half> x1_, x2_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> x1Q_, x2Q_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
};

template <typename T>
__aicore__ inline void MaximumScalar(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                     const __gm__ MaximumTilingData *t) {
    __gm__ T *a = reinterpret_cast<__gm__ T *>(x1);
    __gm__ T *b = reinterpret_cast<__gm__ T *>(x2);
    __gm__ T *out = reinterpret_cast<__gm__ T *>(y);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->totalLength) end = t->totalLength;
    for (uint64_t linear = begin; linear < end; ++linear) {
        uint64_t rem = linear, ai = 0, bi = 0;
        for (int dim = static_cast<int>(t->rank) - 1; dim >= 0; --dim) {
            const uint64_t coord = rem % t->outShape[dim];
            rem /= t->outShape[dim];
            ai += coord * t->x1Stride[dim];
            bi += coord * t->x2Stride[dim];
        }
        const T av = a[ai], bv = b[bi];
        if constexpr (std::is_same<T, half>::value || std::is_same<T, bfloat16_t>::value) {
            const float af = AscendC::ScalarCast<T, float, AscendC::RoundMode::CAST_NONE>(av);
            const float bf = AscendC::ScalarCast<T, float, AscendC::RoundMode::CAST_NONE>(bv);
            out[linear] = af > bf ? av : bv;
        } else {
            out[linear] = av > bv ? av : bv;
        }
    }
}

template <typename T>
__aicore__ inline void DispatchMaximum(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                       const __gm__ MaximumTilingData *t) {
    if constexpr (std::is_same<T, int64_t>::value) {
        MaximumScalar<T>(x1, x2, y, t);
    } else if constexpr (std::is_same<T, half>::value) {
        if (t->sameShape) {
            KernelMaximumSame<T> op; op.Init(x1, x2, y, t); op.Process();
        } else {
            KernelMaximumHalfLastAxisBroadcast op; op.Init(x1, x2, y, t); op.Process();
        }
    } else {
        if (t->sameShape) {
            KernelMaximumSame<T> op; op.Init(x1, x2, y, t); op.Process();
        } else {
            MaximumScalar<T>(x1, x2, y, t);
        }
    }
}

extern "C" __global__ __aicore__ void maximum_kernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ MaximumTilingData *t =
        reinterpret_cast<const __gm__ MaximumTilingData *>(tilingAddr);
    if (t->dtype == MAX_FLOAT16) DispatchMaximum<half>(x1, x2, y, t);
    else if (t->dtype == MAX_FLOAT32) DispatchMaximum<float>(x1, x2, y, t);
    else if (t->dtype == MAX_BFLOAT16) DispatchMaximum<bfloat16_t>(x1, x2, y, t);
    else if (t->dtype == MAX_INT8) DispatchMaximum<int8_t>(x1, x2, y, t);
    else if (t->dtype == MAX_INT32) DispatchMaximum<int32_t>(x1, x2, y, t);
    else DispatchMaximum<int64_t>(x1, x2, y, t);
}
