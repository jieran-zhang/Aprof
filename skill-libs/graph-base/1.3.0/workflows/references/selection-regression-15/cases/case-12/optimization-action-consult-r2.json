    {
      "id": "implementation.memory-transfer.strided-pad",
      "version": "1.2.0",
      "path": [
        "implementation.root",
        "implementation.memory-transfer",
        "implementation.memory-transfer.strided-pad"
      ],
      "score": 5,
      "missing": [
        "constraint.capacity",
        "constraint.output_ownership",
        "constraint.plan_freedom",
        "constraint.semantic_equivalence",
