  "matches": [
    {
      "id": "planning.layout.transpose",
      "version": "1.2.0",
      "path": [
        "planning.root",
        "planning.layout",
        "planning.layout.transpose"
      ],
      "score": 6,
      "missing": [
        "constraint.capacity",
        "constraint.layout_semantics",
