#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "exp_tiling.h"
#include "data_utils.h"
#include "../op_kernel/exp_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return EXP_FLOAT16;
    if (s == "float32") return EXP_FLOAT32;
    if (s == "bfloat16") return EXP_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + s);
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: exp --numel N --dtype float16|float32|bfloat16 --input FILE --output FILE "
                     "[--base X] [--scale X] [--shift X] [--device N]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    void *hostIn = nullptr, *hostOut = nullptr, *devIn = nullptr, *devOut = nullptr, *devTiling = nullptr;
    try {
        const uint64_t n = std::stoull(Arg(argc, argv, "--numel"));
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype"));
        const size_t bytes = n * (dtype == EXP_FLOAT32 ? 4 : 2);
        const float base = std::stof(Arg(argc, argv, "--base", "-1"));
        const float scale = std::stof(Arg(argc, argv, "--scale", "1"));
        const float shift = std::stof(Arg(argc, argv, "--shift", "0"));
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeExpTiling(n, dtype, cores, base, scale, shift);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostIn, bytes), "aclrtMallocHost input");
        Check(aclrtMallocHost(&hostOut, bytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devIn, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc input");
        Check(aclrtMalloc(&devOut, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--input"), hostIn, bytes)) throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devIn, bytes, hostIn, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D input");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        exp_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devIn), static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOut, bytes, devOut, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, bytes)) throw std::runtime_error("write output failed");
        std::cout << "exp_kernel completed: numel=" << n << " blocks=" << tiling.blockNum
                  << " tile=" << tiling.tileElements << "\n";
        aclrtFree(devTiling); aclrtFree(devOut); aclrtFree(devIn);
        aclrtFreeHost(hostOut); aclrtFreeHost(hostIn); aclrtDestroyStream(stream);
        aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "exp failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOut) aclrtFree(devOut); if (devIn) aclrtFree(devIn);
        if (hostOut) aclrtFreeHost(hostOut); if (hostIn) aclrtFreeHost(hostIn);
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
