#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "masked_scale_tiling.h"

template <typename T>
__aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
                                AscendC::LocalTensor<T> src, uint32_t count) {
    if constexpr (std::is_same<T, float>::value) {
        AscendC::Muls(dst, src, 1.0f, count);
    } else {
        AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
    }
}

template <typename T>
__aicore__ inline void FromFloat(AscendC::LocalTensor<T> dst,
                                  AscendC::LocalTensor<float> src, uint32_t count) {
    if constexpr (std::is_same<T, float>::value) {
        AscendC::Muls(dst, src, 1.0f, count);
    } else {
        constexpr auto mode = std::is_same<T, bfloat16_t>::value
            ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
        AscendC::Cast(dst, src, mode, count);
    }
}

template <typename X, typename M>
class KernelMaskedScale {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR mask, GM_ADDR y,
                                const __gm__ MaskedScaleTilingData *tiling) {
        tiling_ = tiling;
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * tiling_->blockLength;
        const uint64_t remain = tiling_->totalLength > offset ? tiling_->totalLength - offset : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x_.SetGlobalBuffer((__gm__ X *)x + offset, length_);
        mask_.SetGlobalBuffer((__gm__ M *)mask + offset, length_);
        y_.SetGlobalBuffer((__gm__ X *)y + offset, length_);
        const uint32_t count = tiling_->tileElements;
        pipe_.InitBuffer(xQ_, 1, count * sizeof(X));
        pipe_.InitBuffer(maskQ_, 1, count * sizeof(M));
        pipe_.InitBuffer(yQ_, 1, count * sizeof(X));
        pipe_.InitBuffer(xFp_, count * sizeof(float));
        pipe_.InitBuffer(maskFp_, count * sizeof(float));
        pipe_.InitBuffer(outFp_, count * sizeof(float));
        if constexpr (std::is_same<M, int8_t>::value || std::is_same<M, uint8_t>::value) {
            pipe_.InitBuffer(maskHalf_, count * sizeof(half));
        }
    }

    __aicore__ inline void Process() {
        for (uint64_t off = 0; off < length_; off += tiling_->tileElements) {
            const uint32_t count = static_cast<uint32_t>(
                (length_ - off) < tiling_->tileElements ? (length_ - off) : tiling_->tileElements);
            CopyIn(off, count);
            Compute(count);
            CopyOut(off, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t off, uint32_t count) {
        auto xLocal = xQ_.AllocTensor<X>();
        auto maskLocal = maskQ_.AllocTensor<M>();
        AscendC::DataCopyExtParams xp{1, static_cast<uint32_t>(count * sizeof(X)), 0, 0, 0};
        AscendC::DataCopyExtParams mp{1, static_cast<uint32_t>(count * sizeof(M)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<X> xpad{false, 0, 0, 0};
        AscendC::DataCopyPadExtParams<M> mpad{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, x_[off], xp, xpad);
        AscendC::DataCopyPad(maskLocal, mask_[off], mp, mpad);
        xQ_.EnQue(xLocal);
        maskQ_.EnQue(maskLocal);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto xLocal = xQ_.DeQue<X>();
        auto maskLocal = maskQ_.DeQue<M>();
        auto yLocal = yQ_.AllocTensor<X>();
        auto xf = xFp_.Get<float>();
        auto mf = maskFp_.Get<float>();
        auto of = outFp_.Get<float>();
        ToFloat<X>(xf, xLocal, count);
        if constexpr (std::is_same<M, int8_t>::value || std::is_same<M, uint8_t>::value) {
            auto mh = maskHalf_.Get<half>();
            AscendC::Cast(mh, maskLocal, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(mf, mh, AscendC::RoundMode::CAST_NONE, count);
        } else {
            ToFloat<M>(mf, maskLocal, count);
        }
        AscendC::Mul(of, xf, mf, count);
        const float scale = tiling_->scale;
        AscendC::Muls(of, of, scale, count);
        FromFloat<X>(yLocal, of, count);
        yQ_.EnQue(yLocal);
        maskQ_.FreeTensor(maskLocal);
        xQ_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint64_t off, uint32_t count) {
        auto yLocal = yQ_.DeQue<X>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(X)), 0, 0, 0};
        AscendC::DataCopyPad(y_[off], yLocal, p);
        yQ_.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe_;
    const __gm__ MaskedScaleTilingData *tiling_;
    uint64_t length_;
    AscendC::GlobalTensor<X> x_, y_;
    AscendC::GlobalTensor<M> mask_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQ_, maskQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFp_, maskFp_, outFp_, maskHalf_;
};

template <typename X>
__aicore__ inline void DispatchMask(GM_ADDR x, GM_ADDR mask, GM_ADDR y,
                                    const __gm__ MaskedScaleTilingData *t) {
    if (t->maskDtype == MS_FLOAT16) {
        KernelMaskedScale<X, half> op; op.Init(x, mask, y, t); op.Process();
    } else if (t->maskDtype == MS_FLOAT32) {
        KernelMaskedScale<X, float> op; op.Init(x, mask, y, t); op.Process();
    } else if (t->maskDtype == MS_BFLOAT16) {
        KernelMaskedScale<X, bfloat16_t> op; op.Init(x, mask, y, t); op.Process();
    } else if (t->maskDtype == MS_INT8) {
        KernelMaskedScale<X, int8_t> op; op.Init(x, mask, y, t); op.Process();
    } else {
        KernelMaskedScale<X, uint8_t> op; op.Init(x, mask, y, t); op.Process();
    }
}

extern "C" __global__ __aicore__ void masked_scale_kernel(
    GM_ADDR x, GM_ADDR mask, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ MaskedScaleTilingData *t =
        reinterpret_cast<const __gm__ MaskedScaleTilingData *>(tilingAddr);
    if (t->xDtype == MS_FLOAT32) DispatchMask<float>(x, mask, y, t);
    else if (t->xDtype == MS_FLOAT16) DispatchMask<half>(x, mask, y, t);
    else DispatchMask<bfloat16_t>(x, mask, y, t);
}
