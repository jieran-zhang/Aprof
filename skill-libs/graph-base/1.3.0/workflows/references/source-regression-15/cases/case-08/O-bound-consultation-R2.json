    {
      "id": "implementation.scalar-control.hot_loop_address",
      "version": "1.1.0",
      "path": [
        "implementation.root",
        "implementation.scalar-control",
        "implementation.scalar-control.hot_loop_address"
      ],
      "score": 5,
      "missing": [
        "constraint.capacity",
