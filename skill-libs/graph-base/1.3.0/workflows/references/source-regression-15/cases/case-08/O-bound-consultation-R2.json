  "matches": [
    {
      "id": "implementation.scalar-control.constant_lifetime",
      "version": "1.0.0",
      "path": [
        "implementation.root",
        "implementation.scalar-control",
        "implementation.scalar-control.constant_lifetime"
      ],
      "score": 5,
      "missing": [
        "constraint.capacity",
        "constraint.invariant_scope",
        "constraint.plan_freedom",
        "constraint.static_layout_lifetime",
