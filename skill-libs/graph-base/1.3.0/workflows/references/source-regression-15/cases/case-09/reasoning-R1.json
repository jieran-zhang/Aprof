  "candidates": [
    {
      "hypothesis_id": "hypothesis.primary",
      "problem_id": "problem.dynamic_shape_mismatch",
      "mechanism": "所有mode固定T1024；两Raw队列加fi/work/fo三个FP32区、Erfc5*T FP32 scratch以及mask无条件分配。显式UB=(2*b+32)*T+Align256(ceil(T/8))，尚不含API/编译保留；tanh不访问erfTmp/mask。none仍有Erfc和尾部特殊修正；tanh有2^-23网格RINT转换，不是无意义cast。",
      "targets": [
        "target"
      ],
      "scope": {
        "task_id": "case-09",
        "parent_implementation_hash": "sha256:b2c9b3ea4781ff18a6402f812403fdebf79af1237b7191a0e296abb3f1c6ae72",
        "workload_hash": "sha256:961666f1fa7f7dd4332574c57b81ec380143d61cb9e3d2f41dd7e34a70afebd8",
