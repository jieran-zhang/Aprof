        for(uint32_t c=0;c<cp_;++c)AscendC::Arange(transpose[c*batch_],static_cast<int32_t>(c*4),static_cast<int32_t>(cp_*4),static_cast<int32_t>(batch_));
        AscendC::PipeBarrier<PIPE_ALL>();const uint64_t sa=(t_->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        const uint64_t per=(t_->spatialOut+batch_-1)/batch_;
        for(uint64_t tile=AscendC::GetBlockIdx();tile<t_->n*per;tile+=AscendC::GetBlockNum()){
            const uint64_t n=tile/per,point=tile%per*batch_,gp=n*t_->spatialOut+point;const uint32_t count=static_cast<uint32_t>(t_->spatialOut-point<batch_?t_->spatialOut-point:batch_),nv=count*cp_;
            AscendC::DataCopyExtParams gc{8,count*4,static_cast<uint32_t>((t_->geometryLength-count)*4),(gTile_*4-(count*4+31)/32*32)/32,0};AscendC::DataCopyPadExtParams<uint32_t> ip{false,0,0,0};AscendC::DataCopyPad(geoIndex,geometryIndex_[gp],gc,ip);gc.blockCount=8;AscendC::DataCopyPadExtParams<float> fp{true,0,static_cast<uint8_t>((count+7)/8*8-count),0.0f};AscendC::DataCopyPad(geoWeight,geometryWeight_[gp],gc,fp);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SetMaskNorm();AscendC::ResetMask();for(uint32_t k=0;k<8;++k)AscendC::Brcb(weights[k*wb_],geoWeight[k*gTile_],static_cast<uint8_t>((count+7)/8),{1,8});AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t p=0;p<count;++p){const uint32_t low=geoIndex.GetValue(p),high=geoIndex.GetValue(7*gTile_+p);const uint64_t rowStride=t_->w>=2?(t_->w-2)*2*cp_*sizeof(T):0;AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};
                if(low<i_*sizeof(T) && high<i_*sizeof(T) && t_->w>=2 && rowStride<=0xffffffffULL){AscendC::DataCopyExtParams cp{2,4*cp_*static_cast<uint32_t>(sizeof(T)),static_cast<uint32_t>(rowStride),0,0};AscendC::DataCopyPad(raw[p*8*cp_],x_[(n*(i_+1)+low/sizeof(T))*2*cp_],cp,pad);}
                else{AscendC::DataCopyExtParams cp{1,cp_*static_cast<uint32_t>(sizeof(T)),0,0,0};for(uint32_t k=0;k<8;++k){const uint32_t off=geoIndex.GetValue(k*gTile_+p),slot=2*(k&3)+(k>>2);AscendC::DataCopyPad(raw[(p*8+slot)*cp_],x_[(n*(i_+1)+off/sizeof(T))*2*cp_],cp,pad);}}
            }
