            const uint32_t bytes=count*sizeof(T),aligned=(bytes+31)/32*32;AscendC::DataCopyExtParams oc{static_cast<uint16_t>(t_->c),bytes,(batch_*static_cast<uint32_t>(sizeof(T))-aligned)/32,static_cast<uint32_t>((sa-count)*sizeof(T)),0};AscendC::DataCopyPad(y_[n*t_->c*sa+point],out,oc);AscendC::PipeBarrier<PIPE_ALL>();
