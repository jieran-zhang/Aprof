template <typename T> class GridUnpackChannels {
public:
    __aicore__ inline void Init(GM_ADDR work,GM_ADDR y,const __gm__ GridSampler3DTilingData *t) {
        t_=t;cp_=static_cast<uint32_t>((t->c+15)/16*16);const uint64_t i=t->d*t->h*t->w;
        src_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+t->n*(i+1)*cp_,t->n*t->spatialOut*cp_);dst_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->outputNumel);
        maxRow_=std::is_same<T,half>::value?64:96;tile_=128;while(tile_*2<=2048 && tile_*2*(maxRow_+16*sizeof(T)+64)<=196352-8192)tile_*=2;
        pipe_.InitBuffer(raw_,tile_*maxRow_);pipe_.InitBuffer(out_,16*tile_*sizeof(T));pipe_.InitBuffer(idx_,16*tile_*4);
    }
    __aicore__ inline void Process() {
        auto raw=raw_.template Get<T>();auto out=out_.template Get<T>();auto idx=idx_.template Get<int32_t>();
        uint64_t linear=AscendC::GetBlockIdx()*t_->blockLength,end=linear+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        while(linear<end) {
            const uint64_t nc=linear/t_->spatialOut,spatial=linear%t_->spatialOut,n=nc/t_->c,c=nc%t_->c;
            uint32_t channels=1;
            if(spatial==0){uint64_t full=(end-linear)/t_->spatialOut;if(full>t_->c-c)full=t_->c-c;if(full>16)full=16;if(full>=2)channels=static_cast<uint32_t>(full);}
            uint64_t window=t_->spatialOut-spatial;if(window>end-linear)window=end-linear;
            if(channels>1)window=t_->spatialOut;
            const uint32_t firstByte=static_cast<uint32_t>(c*sizeof(T)/32*32),relative=static_cast<uint32_t>(c*sizeof(T))-firstByte;
            const uint32_t rowBytes=(relative+channels*sizeof(T)+31)/32*32;
            for(uint32_t cc=0;cc<channels;++cc)AscendC::Arange(idx[cc*tile_],static_cast<int32_t>(relative+cc*sizeof(T)),static_cast<int32_t>(rowBytes),static_cast<int32_t>(tile_));
            AscendC::PipeBarrier<PIPE_ALL>();
            for(uint64_t p=0;p<window;p+=tile_) {
                const uint32_t count=static_cast<uint32_t>(window-p<tile_?window-p:tile_);
                if(count<tile_){AscendC::Duplicate(raw,static_cast<T>(0),tile_*maxRow_/sizeof(T));AscendC::PipeBarrier<PIPE_ALL>();}
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(count),rowBytes,cp_*static_cast<uint32_t>(sizeof(T))-rowBytes,0,0};AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};
                AscendC::DataCopyPad(raw,src_[(n*t_->spatialOut+spatial+p)*cp_+firstByte/sizeof(T)],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
                if constexpr(std::is_same<T,half>::value)AscendC::Gather(out.template ReinterpretCast<uint16_t>(),raw.template ReinterpretCast<uint16_t>(),idx.template ReinterpretCast<uint32_t>(),0U,channels*tile_);
                else AscendC::Gather(out.template ReinterpretCast<uint32_t>(),raw.template ReinterpretCast<uint32_t>(),idx.template ReinterpretCast<uint32_t>(),0U,channels*tile_);
                AscendC::PipeBarrier<PIPE_ALL>();
                const uint32_t alignedBytes=(count*sizeof(T)+31)/32*32;
                AscendC::DataCopyExtParams op{static_cast<uint16_t>(channels),count*static_cast<uint32_t>(sizeof(T)),(tile_*static_cast<uint32_t>(sizeof(T))-alignedBytes)/32,static_cast<uint32_t>((t_->spatialOut-count)*sizeof(T)),0};
                AscendC::DataCopyPad(dst_[linear+p],out,op);AscendC::PipeBarrier<PIPE_ALL>();
            }
            linear+=channels*window;
        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint32_t cp_,tile_,maxRow_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> src_,dst_;
    AscendC::TBuf<AscendC::TPosition::VECIN> raw_;AscendC::TBuf<AscendC::TPosition::VECOUT> out_;AscendC::TBuf<AscendC::TPosition::VECCALC> idx_;
};

