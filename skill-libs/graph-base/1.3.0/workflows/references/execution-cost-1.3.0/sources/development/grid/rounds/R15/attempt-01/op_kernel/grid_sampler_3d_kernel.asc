template <typename T> class GridUnpackPadded {
public:
    __aicore__ inline void Init(GM_ADDR work,const __gm__ GridSampler3DTilingData *t) {
        t_=t;cp_=static_cast<uint32_t>((t->c+15)/16*16);sa_=(t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        p_=512;while(cp_*p_*(2*sizeof(T)+4)>196352-8192)p_/=2;
        const uint64_t xp=t->n*(t->d*t->h*t->w+1)*cp_,yp=t->n*t->spatialOut*cp_;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+xp,yp);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+xp+yp,t->n*t->c*sa_);
        pipe_.InitBuffer(raw_,cp_*p_*sizeof(T));pipe_.InitBuffer(index_,cp_*p_*4);pipe_.InitBuffer(out_,cp_*p_*sizeof(T));
    }
    __aicore__ inline void Process() {
        auto raw=raw_.template Get<T>();auto idx=index_.template Get<int32_t>();auto out=out_.template Get<T>();
        for(uint32_t c=0;c<cp_;++c)AscendC::Arange(idx[c*p_],static_cast<int32_t>(c*sizeof(T)),static_cast<int32_t>(cp_*sizeof(T)),static_cast<int32_t>(p_));
        AscendC::PipeBarrier<PIPE_ALL>();const uint64_t per=(t_->spatialOut+p_-1)/p_;
        for(uint64_t tile=AscendC::GetBlockIdx();tile<t_->n*per;tile+=AscendC::GetBlockNum()){
            const uint64_t n=tile/per,point=tile%per*p_;const uint32_t count=static_cast<uint32_t>(t_->spatialOut-point<p_?t_->spatialOut-point:p_);
            if(count!=p_){AscendC::Duplicate(raw,static_cast<T>(0),cp_*p_);AscendC::PipeBarrier<PIPE_ALL>();}
            AscendC::DataCopyExtParams cp{1,count*cp_*static_cast<uint32_t>(sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};AscendC::DataCopyPad(raw,x_[(n*t_->spatialOut+point)*cp_],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr(std::is_same<T,half>::value)AscendC::Gather(out.template ReinterpretCast<uint16_t>(),raw.template ReinterpretCast<uint16_t>(),idx.template ReinterpretCast<uint32_t>(),0U,cp_*p_);
            else AscendC::Gather(out.template ReinterpretCast<uint32_t>(),raw.template ReinterpretCast<uint32_t>(),idx.template ReinterpretCast<uint32_t>(),0U,cp_*p_);
            AscendC::PipeBarrier<PIPE_ALL>();const uint32_t len=count*sizeof(T),aligned=(len+31)/32*32;
            AscendC::DataCopyExtParams op{static_cast<uint16_t>(t_->c),len,(p_*static_cast<uint32_t>(sizeof(T))-aligned)/32,static_cast<uint32_t>((sa_-count)*sizeof(T)),0};AscendC::DataCopyPad(y_[(n*t_->c)*sa_+point],out,op);AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint32_t cp_,p_;uint64_t sa_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;
    AscendC::TBuf<AscendC::TPosition::VECIN> raw_;AscendC::TBuf<AscendC::TPosition::VECCALC> index_;AscendC::TBuf<AscendC::TPosition::VECOUT> out_;
};
template <typename T> class GridCompactOutput {
public:
    __aicore__ inline void Init(GM_ADDR work,GM_ADDR y,const __gm__ GridSampler3DTilingData *t,bool small=false) {
        t_=t;const uint64_t cp=(t->c+15)/16*16;sa_=(t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        const uint64_t off=small?0:(t->interpolation==GRID_BILINEAR?2:1)*t->n*(t->d*t->h*t->w+1)*cp;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+off,t->n*t->c*sa_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->outputNumel);
        pipe_.InitBuffer(raw_,K*sizeof(T));pipe_.InitBuffer(out_,K*sizeof(T));
    }
    __aicore__ inline void Process() {
        auto raw=raw_.template Get<T>();auto out=out_.template Get<T>();uint64_t linear=AscendC::GetBlockIdx()*t_->blockLength,end=linear+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        while(linear<end){const uint64_t nc=linear/t_->spatialOut,point=linear%t_->spatialOut;uint32_t count=static_cast<uint32_t>(end-linear<K?end-linear:K);if(count>t_->spatialOut-point)count=static_cast<uint32_t>(t_->spatialOut-point);
            const uint32_t aligned=(count*sizeof(T)+31)/32*32;AscendC::DataCopyExtParams cp{1,count*static_cast<uint32_t>(sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> pad{true,0,static_cast<uint8_t>(aligned/sizeof(T)-count),static_cast<T>(0)};AscendC::DataCopyPad(raw,x_[nc*sa_+point],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(out,raw,aligned/sizeof(T));AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(y_[linear],out,cp);AscendC::PipeBarrier<PIPE_ALL>();linear+=count;
        }
    }
private:
    static constexpr uint32_t K=8192;const __gm__ GridSampler3DTilingData *t_;uint64_t sa_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::TBuf<AscendC::TPosition::VECIN> raw_;AscendC::TBuf<AscendC::TPosition::VECOUT> out_;
};
