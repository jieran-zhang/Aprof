template <typename T> class GridSampleChannels {
public:
    __aicore__ inline void Init(GM_ADDR grid,GM_ADDR work,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t){
        t_=t;cp_=static_cast<uint32_t>((t->c+15)/16*16);i_=t->d*t->h*t->w;batch_=cp_<64?192:64;constexpr uint32_t width=std::is_same<T,half>::value?34:48;
        while(batch_*cp_*width+8*batch_*8*4+16*((batch_+63)/64*64)*4>196352-8192)batch_-=64/sizeof(T);gTile_=(batch_+63)/64*64;v_=batch_*cp_;wb_=batch_*8;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work),2*t->n*(i_+1)*cp_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+2*t->n*(i_+1)*cp_,t->n*t->c*((t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T))));
