#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "index/arithprogression.h"
#include "grid_sampler_3d_tiling.h"

template <typename T>
__aicore__ inline float GridToFloat(T value) {
    if constexpr (std::is_same<T, half>::value) {
        const uint16_t raw = *reinterpret_cast<uint16_t *>(&value);
        const uint32_t sign = static_cast<uint32_t>(raw & 0x8000U) << 16;
        const uint32_t exp = (raw >> 10) & 0x1fU;
        uint32_t mantissa = raw & 0x3ffU;
        uint32_t bits = sign;
        if (exp == 0x1fU) {
            bits |= 0x7f800000U | (mantissa << 13);
            if (mantissa) bits |= 0x400000U;
        } else if (exp) {
            bits |= ((exp + 112U) << 23) | (mantissa << 13);
        } else if (mantissa) {
            int32_t e = -14;
            while ((mantissa & 0x400U) == 0) { mantissa <<= 1; --e; }
            mantissa &= 0x3ffU;
            bits |= (static_cast<uint32_t>(e + 127) << 23) | (mantissa << 13);
        }
        return *reinterpret_cast<float *>(&bits);
    } else return value;
}

template <typename T>
__aicore__ inline T GridFromFloat(float value) {
    if constexpr (std::is_same<T, half>::value)
        return AscendC::ScalarCast<float, half, AscendC::RoundMode::CAST_RINT>(value);
    else
        return value;
}

__aicore__ inline float GridClamp(float value, float low, float high) {
    if (value < low) return low;
    if (value > high) return high;
    return value;
}

__aicore__ inline int64_t GridFloor(float value) {
    int64_t out = static_cast<int64_t>(value);
    if (static_cast<float>(out) > value) --out;
    return out;
}

__aicore__ inline int64_t GridRoundEven(float value) {
    const int64_t low = GridFloor(value);
    const float fraction = value - static_cast<float>(low);
    if (fraction < 0.5f) return low;
    if (fraction > 0.5f) return low + 1;
    return (low & 1LL) == 0 ? low : low + 1;
}

__aicore__ inline float GridReflect(float value, uint64_t size, float sizeFloat, uint32_t alignCorners) {
    if (size <= 1) return 0.0f;
    const float low = alignCorners ? 0.0f : -0.5f;
    const float high = alignCorners ? sizeFloat - 1.0f : sizeFloat - 0.5f;
    const float span = high - low;
    float distance = value - low;
    if (distance < 0.0f) distance = -distance;
    int64_t flips = static_cast<int64_t>(distance / span);
    float extra = distance - static_cast<float>(flips) * span;
    float reflected = (flips & 1LL) == 0 ? extra + low : high - extra;
    return GridClamp(reflected, 0.0f, sizeFloat - 1.0f);
}

__aicore__ inline float GridUnnormalize(float coord, float size, uint32_t alignCorners) {
    if (alignCorners) return ((coord + 1.0f) * (size - 1.0f)) * 0.5f;
    return ((coord + 1.0f) * size - 1.0f) * 0.5f;
}

__aicore__ inline float GridApplyPadding(float coord, uint64_t size, float sizeFloat,
                                         uint32_t padding, uint32_t alignCorners) {
    if (padding == GRID_BORDER)
        return GridClamp(coord, 0.0f, sizeFloat - 1.0f);
    if (padding == GRID_REFLECTION)
        return GridReflect(coord, size, sizeFloat, alignCorners);
    return coord;
}

template <typename T>
__aicore__ inline float GridRead(const __gm__ T *x, uint64_t base,
                                 int64_t z, int64_t y, int64_t xx,
                                 const __gm__ GridSampler3DTilingData *t) {
    if (z < 0 || y < 0 || xx < 0 || static_cast<uint64_t>(z) >= t->d ||
        static_cast<uint64_t>(y) >= t->h || static_cast<uint64_t>(xx) >= t->w)
        return 0.0f;
    const uint64_t offset = base + (static_cast<uint64_t>(z) * t->h +
        static_cast<uint64_t>(y)) * t->w + static_cast<uint64_t>(xx);
    return GridToFloat<T>(x[offset]);
}

template <typename T>
__aicore__ inline float GridSampler3DOne(const __gm__ T *x, const __gm__ T *grid,
                                          uint64_t linear,
                                          const __gm__ GridSampler3DTilingData *t) {
        const uint64_t inputSpatial = t->d * t->h * t->w;
        const uint64_t spatial = linear % t->spatialOut;
        const uint64_t nc = linear / t->spatialOut;
        const uint64_t channel = nc % t->c;
        const uint64_t batch = nc / t->c;
        const uint64_t gridBase = (batch * t->spatialOut + spatial) * 3;
        float ix = GridUnnormalize(GridToFloat<T>(grid[gridBase]), t->wFloat, t->alignCorners);
        float iy = GridUnnormalize(GridToFloat<T>(grid[gridBase + 1]), t->hFloat, t->alignCorners);
        float iz = GridUnnormalize(GridToFloat<T>(grid[gridBase + 2]), t->dFloat, t->alignCorners);
        ix = GridApplyPadding(ix, t->w, t->wFloat, t->padding, t->alignCorners);
        iy = GridApplyPadding(iy, t->h, t->hFloat, t->padding, t->alignCorners);
        iz = GridApplyPadding(iz, t->d, t->dFloat, t->padding, t->alignCorners);
        const uint64_t xBase = (batch * t->c + channel) * inputSpatial;
        float result = 0.0f;
        if (t->interpolation == GRID_NEAREST) {
            const int64_t xn = GridRoundEven(ix), yn = GridRoundEven(iy), zn = GridRoundEven(iz);
            result = GridRead<T>(x, xBase, zn, yn, xn, t);
        } else {
            const int64_t x0 = GridFloor(ix), y0 = GridFloor(iy), z0 = GridFloor(iz);
            const int64_t x1 = x0 + 1, y1 = y0 + 1, z1 = z0 + 1;
            const float dx = ix - static_cast<float>(x0);
            const float dy = iy - static_cast<float>(y0);
            const float dz = iz - static_cast<float>(z0);
            const float wx0 = 1.0f - dx, wy0 = 1.0f - dy, wz0 = 1.0f - dz;
            result += GridRead<T>(x, xBase, z0, y0, x0, t) * wx0 * wy0 * wz0;
            result += GridRead<T>(x, xBase, z0, y0, x1, t) * dx  * wy0 * wz0;
            result += GridRead<T>(x, xBase, z0, y1, x0, t) * wx0 * dy  * wz0;
            result += GridRead<T>(x, xBase, z0, y1, x1, t) * dx  * dy  * wz0;
            result += GridRead<T>(x, xBase, z1, y0, x0, t) * wx0 * wy0 * dz;
            result += GridRead<T>(x, xBase, z1, y0, x1, t) * dx  * wy0 * dz;
            result += GridRead<T>(x, xBase, z1, y1, x0, t) * wx0 * dy  * dz;
            result += GridRead<T>(x, xBase, z1, y1, x1, t) * dx  * dy  * dz;
        }
        return result;
}

template <typename T>
__aicore__ inline void GridSampler3DScalar(GM_ADDR xAddr, GM_ADDR gridAddr, GM_ADDR yAddr,
                                            const __gm__ GridSampler3DTilingData *t) {
    const __gm__ T *x = reinterpret_cast<const __gm__ T *>(xAddr);
    const __gm__ T *grid = reinterpret_cast<const __gm__ T *>(gridAddr);
    __gm__ T *out = reinterpret_cast<__gm__ T *>(yAddr);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->outputNumel) end = t->outputNumel;
    for (uint64_t linear = begin; linear < end; ++linear) {
        out[linear] = GridFromFloat<T>(GridSampler3DOne<T>(x, grid, linear, t));
    }
}

class GridSampler3DHalf {
public:
    __aicore__ inline void Init(GM_ADDR xAddr, GM_ADDR gridAddr, GM_ADDR yAddr,
                                const __gm__ GridSampler3DTilingData *t) {
        t_ = t;
        x_ = reinterpret_cast<const __gm__ half *>(xAddr);
        grid_ = reinterpret_cast<const __gm__ half *>(gridAddr);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yAddr), t->outputNumel);
        pipe_.InitBuffer(fpBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(rawBuf_, kTile * sizeof(half));
    }
    __aicore__ inline void Process() {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        uint64_t end = begin + t_->blockLength;
        if (end > t_->outputNumel) end = t_->outputNumel;
        auto fp = fpBuf_.Get<float>();
        auto raw = rawBuf_.Get<half>();
        for (uint64_t offset = begin; offset < end; offset += kTile) {
            const uint32_t count = static_cast<uint32_t>(end - offset < kTile ? end - offset : kTile);
            for (uint32_t i = 0; i < count; ++i)
                fp.SetValue(i, GridSampler3DOne<half>(x_, grid_, offset + i, t_));
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(raw, fp, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams copy{1, count * static_cast<uint32_t>(sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPad(y_[offset], raw, copy);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    static constexpr uint32_t kTile = 1024;
    const __gm__ GridSampler3DTilingData *t_;
    const __gm__ half *x_;
    const __gm__ half *grid_;
    AscendC::GlobalTensor<half> y_;
    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> rawBuf_;
};


// Derived geometry reuse is a task-authorized, unadmitted experiment.
template <typename T>
__aicore__ inline uint32_t GridOffsetBytes(int64_t z, int64_t y, int64_t x,
                                           const __gm__ GridSampler3DTilingData *t) {
    const uint64_t spatial=t->d*t->h*t->w;
    if (z<0 || y<0 || x<0 || static_cast<uint64_t>(z)>=t->d ||
        static_cast<uint64_t>(y)>=t->h || static_cast<uint64_t>(x)>=t->w)
        return static_cast<uint32_t>(spatial*sizeof(T));
    return static_cast<uint32_t>(((z*t->h+y)*t->w+x)*sizeof(T));
}

#define GRID_FMA_INLINE __aicore__ inline
#include "grid_fma32_integer.h"

// src is immutable. firstMask and temp are dead buffer leases, not live indices/values.
// Every actual bit is compressed with int32 EQ; padding bits are explicitly removed.
__aicore__ inline bool GridAnyCompare32(AscendC::LocalTensor<float> src,AscendC::LocalTensor<uint32_t> firstMask,AscendC::LocalTensor<uint32_t> temp,uint32_t count,bool negative){
    const uint32_t words=(count+31)/32,wordCount=(words+63)/64*64,sourceCount=(count+63)/64*64,tail=count&31U;
    AscendC::Duplicate(firstMask,0U,wordCount);AscendC::Duplicate(temp,0xffffffffU,64);AscendC::PipeBarrier<PIPE_V>();
    AscendC::CompareScalar(firstMask.template ReinterpretCast<uint8_t>(),src,negative?-0x1p124f:0x1p124f,negative?AscendC::CMPMODE::LE:AscendC::CMPMODE::GE,sourceCount);AscendC::PipeBarrier<PIPE_ALL>();
    if(tail){firstMask.SetValue(words-1,firstMask.GetValue(words-1)&((1U<<tail)-1));AscendC::PipeBarrier<PIPE_ALL>();}
    AscendC::CompareScalar(temp.template ReinterpretCast<uint8_t>(),firstMask.template ReinterpretCast<int32_t>(),0,AscendC::CMPMODE::EQ,wordCount);AscendC::PipeBarrier<PIPE_V>();
    const uint32_t full=words/32,left=words&31U;
    if(full)AscendC::CompareScalar(temp[64].template ReinterpretCast<uint8_t>(),temp.template ReinterpretCast<int32_t>(),-1,AscendC::CMPMODE::EQ,64);
    AscendC::PipeBarrier<PIPE_ALL>();
    if(full){const uint32_t mask=full==32?0xffffffffU:(1U<<full)-1;if((temp.GetValue(64)&mask)!=mask)return true;}
    if(left){const uint32_t mask=(1U<<left)-1;if((temp.GetValue(full)&mask)!=mask)return true;}
    return false;
}
__aicore__ inline bool GridNeedsFma32(AscendC::LocalTensor<float> src,AscendC::LocalTensor<uint32_t> firstMask,AscendC::LocalTensor<uint32_t> temp,uint32_t count){
    return GridAnyCompare32(src,firstMask,temp,count,false)||GridAnyCompare32(src,firstMask,temp,count,true);
}
__aicore__ inline void GridSoftwareWeighted(AscendC::LocalTensor<float> values,AscendC::LocalTensor<float> coeff,AscendC::LocalTensor<float> acc,uint32_t group,uint32_t neighbors,uint32_t stride,uint32_t count){
    AscendC::PipeBarrier<PIPE_ALL>();auto vb=values.template ReinterpretCast<uint32_t>();auto wb=coeff.template ReinterpretCast<uint32_t>();auto ab=acc.template ReinterpretCast<uint32_t>();
    for(uint32_t p=0;p<count;++p){uint32_t sum=ab.GetValue(p);for(uint32_t k=0;k<neighbors;++k)sum=GridFma32Bits(vb.GetValue(k*stride+p),wb.GetValue((group+k)*stride+p),sum);ab.SetValue(p,sum);}AscendC::PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void GridFormEightWeights(AscendC::LocalTensor<float> coeff,AscendC::LocalTensor<float> axes,uint32_t stride,uint32_t count){
    for(uint32_t k=0;k<8;++k)AscendC::Mul(coeff[k*stride],axes[(k&1)*stride],axes[(2+((k>>1)&1))*stride],count);
    AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t k=0;k<8;++k)AscendC::Mul(coeff[k*stride],coeff[k*stride],axes[(4+(k>>2))*stride],count);
    AscendC::PipeBarrier<PIPE_V>();
}
__aicore__ inline void GridApplyWeightedFour(AscendC::LocalTensor<float> values,AscendC::LocalTensor<float> coeff,AscendC::LocalTensor<float> acc,uint32_t group,uint32_t stride,uint32_t count,bool software=false){
    if(software){GridSoftwareWeighted(values,coeff,acc,group,4,stride,count);return;}
    for(uint32_t j=0;j<4;++j)AscendC::Mul(values[j*stride],values[j*stride],coeff[(group+j)*stride],count);
    AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t j=0;j<4;++j){AscendC::Add(acc,acc,values[j*stride],count);AscendC::PipeBarrier<PIPE_V>();}
}

template <typename T>
__aicore__ inline void GridGeometryRange(const __gm__ T *grid, __gm__ uint32_t *geometry,
                                      const __gm__ GridSampler3DTilingData *t,uint64_t begin,uint64_t end) {
    const uint64_t stride=t->geometryLength;
    __gm__ float *weights=t->interpolation==GRID_NEAREST?nullptr:reinterpret_cast<__gm__ float *>(geometry+8*stride);
    for(uint64_t p=begin;p<end;++p) {
        float ix=GridUnnormalize(GridToFloat<T>(grid[3*p]),t->wFloat,t->alignCorners);
        float iy=GridUnnormalize(GridToFloat<T>(grid[3*p+1]),t->hFloat,t->alignCorners);
        float iz=GridUnnormalize(GridToFloat<T>(grid[3*p+2]),t->dFloat,t->alignCorners);
        ix=GridApplyPadding(ix,t->w,t->wFloat,t->padding,t->alignCorners);
        iy=GridApplyPadding(iy,t->h,t->hFloat,t->padding,t->alignCorners);
        iz=GridApplyPadding(iz,t->d,t->dFloat,t->padding,t->alignCorners);
        if(t->interpolation==GRID_NEAREST) {
            geometry[p]=GridOffsetBytes<T>(GridRoundEven(iz),GridRoundEven(iy),GridRoundEven(ix),t);
        } else {
            const int64_t x0=GridFloor(ix), y0=GridFloor(iy), z0=GridFloor(iz);
            const float dx=ix-static_cast<float>(x0),dy=iy-static_cast<float>(y0),dz=iz-static_cast<float>(z0);
            geometry[p]=GridOffsetBytes<T>(z0,y0,x0,t);
            geometry[stride+p]=GridOffsetBytes<T>(z0,y0,x0+1,t);
            geometry[2*stride+p]=GridOffsetBytes<T>(z0,y0+1,x0,t);
            geometry[3*stride+p]=GridOffsetBytes<T>(z0,y0+1,x0+1,t);
            geometry[4*stride+p]=GridOffsetBytes<T>(z0+1,y0,x0,t);
            geometry[5*stride+p]=GridOffsetBytes<T>(z0+1,y0,x0+1,t);
            geometry[6*stride+p]=GridOffsetBytes<T>(z0+1,y0+1,x0,t);
            geometry[7*stride+p]=GridOffsetBytes<T>(z0+1,y0+1,x0+1,t);
            for(uint32_t k=0;k<8;++k){const float wx=(k&1)?dx:1.0f-dx,wy=(k&2)?dy:1.0f-dy,wz=(k&4)?dz:1.0f-dz;const float xy=wx*wy;weights[k*stride+p]=xy*wz;}
        }
    }
}

template <typename T>
__aicore__ inline void GridGeometry(const __gm__ T *grid,__gm__ uint32_t *geometry,const __gm__ GridSampler3DTilingData *t) {
    const uint64_t begin=AscendC::GetBlockIdx()*t->geometryBlockLength;
    uint64_t end=begin+t->geometryBlockLength;if(end>t->n*t->spatialOut)end=t->n*t->spatialOut;
    GridGeometryRange<T>(grid,geometry,t,begin,end);
}
template <typename T,uint32_t Tile>
class GridGeometryVector {
public:
    __aicore__ inline void Init(GM_ADDR grid,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t) {
        t_=t;grid_=reinterpret_cast<const __gm__ T *>(grid);geometry_=reinterpret_cast<__gm__ uint32_t *>(geometry);
        gridGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(grid),3*t->n*t->spatialOut);
        idxGm_.SetGlobalBuffer(geometry_,(t->interpolation==GRID_NEAREST?1:8)*t->geometryLength);
        if(t->interpolation!=GRID_NEAREST)wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry_)+8*t->geometryLength,8*t->geometryLength);
        pipe_.InitBuffer(rawBuf_,3*kTile*sizeof(T));pipe_.InitBuffer(flatBuf_,3*kTile*4);
        pipe_.InitBuffer(coordBuf_,3*kTile*4);pipe_.InitBuffer(floorBuf_,3*kTile*4);
        pipe_.InitBuffer(floorIntBuf_,3*kTile*4);pipe_.InitBuffer(laneBuf_,3*kTile*4);
        pipe_.InitBuffer(weightBuf_,14*kTile*4);pipe_.InitBuffer(indexBuf_,8*kTile*4);
        pipe_.InitBuffer(tempBuf_,4*kTile*4);pipe_.InitBuffer(maskBuf_,22*32);
        pipe_.InitBuffer(candidateBuf_,8*kTile*4);pipe_.InitBuffer(selectedBuf_,8*kTile*4);
    }
    __aicore__ inline void Process() {
        auto raw=rawBuf_.template Get<T>();auto flat=flatBuf_.template Get<float>();
        auto coord=coordBuf_.template Get<float>();auto floor=floorBuf_.template Get<float>();
        auto fi=floorIntBuf_.template Get<int32_t>();auto lane=laneBuf_.template Get<int32_t>();
        auto weights=weightBuf_.template Get<float>();auto coeff=weights[6*kTile];auto indices=indexBuf_.template Get<uint32_t>();
        auto temp=tempBuf_.template Get<float>();auto masks=maskBuf_.template Get<uint8_t>();
        auto candidates=candidateBuf_.template Get<float>();auto selected=selectedBuf_.template Get<float>();
        for(uint32_t a=0;a<3;++a)AscendC::Arange(lane[a*kTile],static_cast<int32_t>(4*a),12,static_cast<int32_t>(kTile));
        AscendC::PipeBarrier<PIPE_ALL>();
        const uint64_t begin=AscendC::GetBlockIdx()*t_->geometryBlockLength;
        uint64_t end=begin+t_->geometryBlockLength;if(end>t_->n*t_->spatialOut)end=t_->n*t_->spatialOut;
        const bool nearest=t_->interpolation==GRID_NEAREST;const uint32_t neighbors=nearest?1:8;
        const uint64_t stride=t_->geometryLength;
        for(uint64_t p=begin;p<end;p+=kTile) {
            const uint32_t count=static_cast<uint32_t>(end-p<kTile?end-p:kTile);
            const uint32_t nr=3*count, align=32/sizeof(T), padded=(nr+align-1)/align*align;
            if(padded<3*kTile)AscendC::Duplicate(raw[padded],static_cast<T>(0),3*kTile-padded);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams rc{1,nr*static_cast<uint32_t>(sizeof(T)),0,0,0};
            AscendC::DataCopyPadExtParams<T> pad{true,0,static_cast<uint8_t>(padded-nr),static_cast<T>(0)};
            AscendC::DataCopyPad(raw,gridGm_[3*p],rc,pad);AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr(std::is_same<T,half>::value)AscendC::Cast(flat,raw,AscendC::RoundMode::CAST_NONE,3*kTile);
            else AscendC::DataCopy(flat,raw,3*kTile);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::CompareScalar(masks,flat,-1.0f,AscendC::CMPMODE::GE,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::CompareScalar(masks[3*32],flat,1.0f,AscendC::CMPMODE::LE,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::And(masks[6*32].template ReinterpretCast<uint16_t>(),masks.template ReinterpretCast<uint16_t>(),masks[3*32].template ReinterpretCast<uint16_t>(),3*kTile/16);AscendC::PipeBarrier<PIPE_ALL>();
            bool regular=true;
            auto guard=masks[6*32].template ReinterpretCast<uint32_t>();
            for(uint32_t j=0;j<3*kTile/32;++j)if(guard.GetValue(j)!=0xffffffffU){regular=false;break;}
            if(!regular) { GridGeometryRange<T>(grid_,geometry_,t_,p,p+count);continue; }
            for(uint32_t a=0;a<3;++a)AscendC::Gather(coord[a*kTile],flat,lane[a*kTile].template ReinterpretCast<uint32_t>(),0U,kTile);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(coord,coord,1.0f,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t a=0;a<3;++a){const float dim=a==0?t_->wFloat:(a==1?t_->hFloat:t_->dFloat);AscendC::Muls(coord[a*kTile],coord[a*kTile],t_->alignCorners?dim-1.0f:dim,kTile);}AscendC::PipeBarrier<PIPE_V>();
            if(!t_->alignCorners){AscendC::Adds(coord,coord,-1.0f,3*kTile);AscendC::PipeBarrier<PIPE_V>();}
            AscendC::Muls(coord,coord,0.5f,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            if(t_->padding==GRID_REFLECTION && !t_->alignCorners){AscendC::Adds(coord,coord,0.5f,3*kTile);AscendC::PipeBarrier<PIPE_V>();AscendC::Adds(coord,coord,-0.5f,3*kTile);AscendC::PipeBarrier<PIPE_V>();}
            if(t_->padding!=GRID_ZEROS){AscendC::Maxs(coord,coord,0.0f,3*kTile);AscendC::PipeBarrier<PIPE_V>();for(uint32_t a=0;a<3;++a){const float dim=a==0?t_->wFloat:(a==1?t_->hFloat:t_->dFloat);AscendC::Mins(coord[a*kTile],coord[a*kTile],dim-1.0f,kTile);}AscendC::PipeBarrier<PIPE_V>();}
            AscendC::Cast(fi,coord,nearest?AscendC::RoundMode::CAST_RINT:AscendC::RoundMode::CAST_FLOOR,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(floor,fi,AscendC::RoundMode::CAST_NONE,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            if(nearest){for(uint32_t a=0;a<3;++a){const float dim=a==0?t_->wFloat:(a==1?t_->hFloat:t_->dFloat);AscendC::CompareScalar(masks[2*a*32],floor[a*kTile],dim,AscendC::CMPMODE::LT,kTile);}AscendC::PipeBarrier<PIPE_V>();}
            else {
                for(uint32_t a=0;a<3;++a)AscendC::Sub(weights[(2*a+1)*kTile],coord[a*kTile],floor[a*kTile],kTile);AscendC::PipeBarrier<PIPE_V>();
                for(uint32_t a=0;a<3;++a)AscendC::Muls(weights[2*a*kTile],weights[(2*a+1)*kTile],-1.0f,kTile);AscendC::PipeBarrier<PIPE_V>();
                for(uint32_t a=0;a<3;++a)AscendC::Adds(weights[2*a*kTile],weights[2*a*kTile],1.0f,kTile);AscendC::PipeBarrier<PIPE_V>();
                for(uint32_t a=0;a<3;++a){const float dim=a==0?t_->wFloat:(a==1?t_->hFloat:t_->dFloat);AscendC::CompareScalar(masks[2*a*32],floor[a*kTile],0.0f,AscendC::CMPMODE::GE,kTile);AscendC::CompareScalar(masks[(2*a+1)*32],floor[a*kTile],dim-1.0f,AscendC::CMPMODE::LT,kTile);}AscendC::PipeBarrier<PIPE_V>();
            }
            if(!nearest)GridFormEightWeights(coeff,weights,kTile,kTile);
            const float hf=t_->hFloat,wf=t_->wFloat,df=t_->dFloat;
            constexpr float itemBytes=std::is_same<T,half>::value?2.0f:4.0f;
            AscendC::Muls(temp,floor[2*kTile],hf,kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(temp,temp,floor[kTile],kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temp,temp,wf,kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(temp,temp,floor,kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(temp,temp,itemBytes,kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Duplicate(temp[3*kTile],df*hf*wf*itemBytes,kTile);AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t k=0;k<neighbors;++k){const uint64_t delta=(k&1)+((k>>1)&1)*t_->w+((k>>2)&1)*t_->h*t_->w;AscendC::Adds(candidates[k*kTile],temp,static_cast<float>(static_cast<int64_t>(delta*sizeof(T))),kTile);}AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t k=0;k<neighbors;++k){const uint32_t xm=nearest?0:(k&1),ym=nearest?2:2+((k>>1)&1);AscendC::And(masks[(6+k)*32].template ReinterpretCast<uint16_t>(),masks[xm*32].template ReinterpretCast<uint16_t>(),masks[ym*32].template ReinterpretCast<uint16_t>(),kTile/16);}AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t k=0;k<neighbors;++k){const uint32_t zm=nearest?4:4+((k>>2)&1);AscendC::And(masks[(14+k)*32].template ReinterpretCast<uint16_t>(),masks[(6+k)*32].template ReinterpretCast<uint16_t>(),masks[zm*32].template ReinterpretCast<uint16_t>(),kTile/16);}AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t k=0;k<neighbors;++k){AscendC::Select(selected[k*kTile],masks[(14+k)*32],candidates[k*kTile],temp[3*kTile],AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE,kTile);AscendC::PipeBarrier<PIPE_V>();}
            AscendC::Cast(indices.template ReinterpretCast<int32_t>(),selected,AscendC::RoundMode::CAST_RINT,neighbors*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams oc{1,count*4U,0,0,0};
            if(stride*4<=0xffffffffULL){const uint32_t ubStride=(kTile*4-(count*4+31)/32*32)/32;oc.blockCount=static_cast<uint16_t>(neighbors);oc.srcStride=ubStride;oc.dstStride=static_cast<uint32_t>((stride-count)*4);AscendC::DataCopyPad(idxGm_[p],indices,oc);if(!nearest){oc.blockCount=8;AscendC::DataCopyPad(wGm_[p],coeff,oc);}}
            else{for(uint32_t k=0;k<neighbors;++k)AscendC::DataCopyPad(idxGm_[k*stride+p],indices[k*kTile],oc);if(!nearest)for(uint32_t k=0;k<8;++k)AscendC::DataCopyPad(wGm_[k*stride+p],coeff[k*kTile],oc);}
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    static constexpr uint32_t kTile=Tile;
    const __gm__ GridSampler3DTilingData *t_;const __gm__ T *grid_;__gm__ uint32_t *geometry_;
    AscendC::TPipe pipe_;AscendC::GlobalTensor<T> gridGm_;AscendC::GlobalTensor<uint32_t> idxGm_;AscendC::GlobalTensor<float> wGm_;
    AscendC::TBuf<AscendC::TPosition::VECIN> rawBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> weightBuf_,indexBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> flatBuf_,coordBuf_,floorBuf_,floorIntBuf_,laneBuf_,tempBuf_,maskBuf_,candidateBuf_,selectedBuf_;
};

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_geometry(
    GM_ADDR grid, GM_ADDR geometry, GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    const uint64_t item=t->dtype==GRID_FP16?2:4;
    const bool vector=t->geometryBlockLength>=16 &&
        t->d*t->h*t->w*item<(1ULL<<23) && (t->h*t->w+t->w+1)*item<(1ULL<<23);
    if(t->dtype==GRID_FP16) {
        if(vector){if(t->geometryBlockLength<=64){GridGeometryVector<half,64> op;op.Init(grid,geometry,t);op.Process();}else if(t->geometryBlockLength<=128){GridGeometryVector<half,128> op;op.Init(grid,geometry,t);op.Process();}else if(t->geometryBlockLength<=192){GridGeometryVector<half,192> op;op.Init(grid,geometry,t);op.Process();}else{GridGeometryVector<half,256> op;op.Init(grid,geometry,t);op.Process();}}
        else GridGeometry(reinterpret_cast<const __gm__ half *>(grid),reinterpret_cast<__gm__ uint32_t *>(geometry),t);
    } else {
        if(vector){if(t->geometryBlockLength<=64){GridGeometryVector<float,64> op;op.Init(grid,geometry,t);op.Process();}else if(t->geometryBlockLength<=128){GridGeometryVector<float,128> op;op.Init(grid,geometry,t);op.Process();}else if(t->geometryBlockLength<=192){GridGeometryVector<float,192> op;op.Init(grid,geometry,t);op.Process();}else{GridGeometryVector<float,256> op;op.Init(grid,geometry,t);op.Process();}}
        else GridGeometry(reinterpret_cast<const __gm__ float *>(grid),reinterpret_cast<__gm__ uint32_t *>(geometry),t);
    }
}

__aicore__ inline void GridTrilinearBatched(AscendC::LocalTensor<float> values,AscendC::LocalTensor<float> weights,AscendC::LocalTensor<float> acc,uint32_t stride,uint32_t count) {
    AscendC::Duplicate(acc,0.0f,count);AscendC::PipeBarrier<PIPE_V>();
    AscendC::SetMaskCount();AscendC::SetVectorMask<float,AscendC::MaskMode::COUNTER>(static_cast<int32_t>(count));
    for(uint32_t k=0;k<8;++k)AscendC::Mul<float,false>(values[k*stride],values[k*stride],weights[(k&1)*stride],AscendC::MASK_PLACEHOLDER,1,{1,1,1,8,8,8});
    AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t k=0;k<8;++k)AscendC::Mul<float,false>(values[k*stride],values[k*stride],weights[(2+((k>>1)&1))*stride],AscendC::MASK_PLACEHOLDER,1,{1,1,1,8,8,8});
    AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t k=0;k<8;++k)AscendC::Mul<float,false>(values[k*stride],values[k*stride],weights[(4+(k>>2))*stride],AscendC::MASK_PLACEHOLDER,1,{1,1,1,8,8,8});
    AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t k=0;k<8;++k){AscendC::Add<float,false>(acc,acc,values[k*stride],AscendC::MASK_PLACEHOLDER,1,{1,1,1,8,8,8});AscendC::PipeBarrier<PIPE_V>();}
    AscendC::SetMaskNorm();AscendC::ResetMask();
}

template <typename T> class GridSampler3DBatched {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR grid,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t) {
        t_=t;input_=t->d*t->h*t->w;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*input_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->outputNumel);
        idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),8*t->geometryLength);w_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry)+8*t->geometryLength,6*t->geometryLength);
        const uint32_t cb=((static_cast<uint32_t>(input_)+15)/16*16+16)*sizeof(T);
        constexpr uint32_t width=std::is_same<T,half>::value?110:92;
        tile_=(196352U-8192U-cb)/(128U*width)*128U;if(tile_>4096)tile_=4096;
        pipe_.InitBuffer(cache_,cb);pipe_.InitBuffer(index_,8*tile_*4);pipe_.InitBuffer(weight_,6*tile_*4);pipe_.InitBuffer(value_,8*tile_*4);pipe_.InitBuffer(acc_,tile_*4);
        if constexpr(std::is_same<T,half>::value){pipe_.InitBuffer(raw_,8*tile_*2);pipe_.InitBuffer(out_,tile_*2);}
    }
    __aicore__ inline void Process() {
        auto cache=cache_.template Get<T>();auto idx=index_.template Get<uint32_t>();auto weights=weight_.template Get<float>();auto values=value_.template Get<float>();auto acc=acc_.template Get<float>();
        const uint64_t begin=AscendC::GetBlockIdx()*t_->blockLength;uint64_t end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;uint64_t cached=~0ULL;
        for(uint64_t linear=begin;linear<end;) {
            const uint64_t nc=linear/t_->spatialOut,sp=linear%t_->spatialOut,point=(nc/t_->c)*t_->spatialOut+sp;uint32_t count=static_cast<uint32_t>(end-linear<tile_?end-linear:tile_);if(count>t_->spatialOut-sp)count=static_cast<uint32_t>(t_->spatialOut-sp);
            const uint32_t aligned=(count*4+31)/32*32;
            AscendC::DataCopyExtParams cp{8,count*4,static_cast<uint32_t>((t_->geometryLength-count)*4),(tile_*4-aligned)/32,0};AscendC::DataCopyPadExtParams<uint32_t> ip{false,0,0,0};AscendC::DataCopyPad(idx,idx_[point],cp,ip);
            cp.blockCount=6;AscendC::DataCopyPadExtParams<float> fp{false,0,0,0.0f};AscendC::DataCopyPad(weights,w_[point],cp,fp);
            if(cached!=nc){AscendC::DataCopyExtParams xp{1,static_cast<uint32_t>(input_*sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};AscendC::DataCopyPad(cache,x_[nc*input_],xp,pad);AscendC::PipeBarrier<PIPE_ALL>();cache.SetValue(static_cast<uint32_t>(input_),static_cast<T>(0));cached=nc;}
            AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr(std::is_same<T,half>::value){
                auto raw=raw_.template Get<half>();if(count!=tile_){AscendC::Duplicate(raw,static_cast<half>(0),8*tile_);AscendC::PipeBarrier<PIPE_V>();}
                for(uint32_t k=0;k<8;++k)AscendC::Gather(raw[k*tile_],cache,idx[k*tile_],0U,count);
                AscendC::PipeBarrier<PIPE_V>();AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,8*tile_);AscendC::PipeBarrier<PIPE_V>();
            }else{
                for(uint32_t k=0;k<8;++k)AscendC::Gather(values[k*tile_],cache,idx[k*tile_],0U,count);AscendC::PipeBarrier<PIPE_V>();
            }
            GridTrilinearBatched(values,weights,acc,tile_,count);
            if constexpr(std::is_same<T,half>::value){auto out=out_.template Get<half>();AscendC::Cast(out,acc,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams op{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[linear],out,op);}
            else {AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams op{1,count*4U,0,0,0};AscendC::DataCopyPad(y_[linear],acc,op);}
            AscendC::PipeBarrier<PIPE_ALL>();linear+=count;
        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint64_t input_;uint32_t tile_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::GlobalTensor<uint32_t> idx_;AscendC::GlobalTensor<float> w_;
    AscendC::TBuf<AscendC::TPosition::VECIN> cache_,index_,weight_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> value_,raw_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> acc_,out_;
};

__aicore__ inline uint32_t GridFullBatchTile(uint64_t input,uint32_t item){
    const uint32_t cache=item==4?(static_cast<uint32_t>(input)+64)/64*64*4:((static_cast<uint32_t>(input)+15)/16*16+16)*item,width=item==2?118:100;
    uint32_t tile=(188160-cache)/(128*width)*128;if(tile>1920)tile=1920;
    while(tile){const uint32_t before=cache+(68+(item==2?18:0))*tile,acc=cache+64*tile,gap=(acc+256-before)&511U;if(cache+width*tile+gap<=188160)break;tile-=128;}
    return tile;
}
__aicore__ inline void GridApplyWeightedEight(AscendC::LocalTensor<float> values,AscendC::LocalTensor<float> coeff,AscendC::LocalTensor<float> acc,uint32_t tile,uint32_t count,bool software=false){
    if(software){GridSoftwareWeighted(values,coeff,acc,0,8,tile,count);return;}
    AscendC::Mul(values,values,coeff,8*tile);AscendC::PipeBarrier<PIPE_V>();
    for(uint32_t k=0;k<8;++k){AscendC::Add(acc,acc,values[k*tile],count);AscendC::PipeBarrier<PIPE_V>();}
}

template <typename T> class GridSampler3DWeighted {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t){
        t_=t;input_=t->d*t->h*t->w;const uint32_t cb=std::is_same<T,float>::value?(static_cast<uint32_t>(input_)+64)/64*64*4:((static_cast<uint32_t>(input_)+15)/16*16+16)*sizeof(T);constexpr uint32_t width=std::is_same<T,half>::value?94:84;
        tile_=(196352U-8192U-cb)/(128U*width)*128U;if(tile_>1920)tile_=1920;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*input_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->outputNumel);idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),8*t->geometryLength);w_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry)+8*t->geometryLength,8*t->geometryLength);
        pipe_.InitBuffer(cache_,cb);pipe_.InitBuffer(index_,8*tile_*4);pipe_.InitBuffer(weight_,8*tile_*4);pipe_.InitBuffer(value_,4*tile_*4);pipe_.InitBuffer(acc_,tile_*4);if constexpr(std::is_same<T,half>::value){pipe_.InitBuffer(raw_,4*tile_*2);pipe_.InitBuffer(out_,tile_*2);}
    }
    __aicore__ inline void Process(){
        auto cache=cache_.template Get<T>();auto idx=index_.template Get<uint32_t>();auto coeff=weight_.template Get<float>();auto values=value_.template Get<float>();auto acc=acc_.template Get<float>();
        const uint64_t begin=AscendC::GetBlockIdx()*t_->blockLength;uint64_t end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;uint64_t cached=~0ULL;bool software=false;
        for(uint64_t linear=begin;linear<end;){const uint64_t nc=linear/t_->spatialOut,sp=linear%t_->spatialOut,gp=(nc/t_->c)*t_->spatialOut+sp;uint32_t count=static_cast<uint32_t>(end-linear<tile_?end-linear:tile_);if(count>t_->spatialOut-sp)count=static_cast<uint32_t>(t_->spatialOut-sp);
            if constexpr(std::is_same<T,float>::value){if(cached!=nc){AscendC::DataCopyExtParams xc{1,static_cast<uint32_t>(input_*sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> xp{false,0,0,static_cast<T>(0)};if constexpr(std::is_same<T,float>::value){AscendC::Duplicate(cache,0.0f,(static_cast<uint32_t>(input_)+64)/64*64);AscendC::PipeBarrier<PIPE_ALL>();}AscendC::DataCopyPad(cache,x_[nc*input_],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();cache.SetValue(static_cast<uint32_t>(input_),static_cast<T>(0));AscendC::PipeBarrier<PIPE_ALL>();if constexpr(std::is_same<T,float>::value)software=GridNeedsFma32(cache.template ReinterpretCast<float>(),idx,acc.template ReinterpretCast<uint32_t>(),static_cast<uint32_t>(input_));cached=nc;}}
            if(count!=tile_){AscendC::Duplicate(idx,static_cast<uint32_t>(input_*sizeof(T)),8*tile_);AscendC::PipeBarrier<PIPE_ALL>();}
            AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};AscendC::DataCopyPadExtParams<uint32_t> ip{true,0,static_cast<uint8_t>((count+7)/8*8-count),static_cast<uint32_t>(input_*sizeof(T))};AscendC::DataCopyPadExtParams<float> fp{false,0,0,0.0f};
            if(t_->geometryLength*4<=0xffffffffULL){cp.blockCount=8;cp.srcStride=static_cast<uint32_t>((t_->geometryLength-count)*4);cp.dstStride=(tile_*4-(count*4+31)/32*32)/32;AscendC::DataCopyPad(idx,idx_[gp],cp,ip);AscendC::DataCopyPad(coeff,w_[gp],cp,fp);}
            else{for(uint32_t k=0;k<8;++k){AscendC::DataCopyPad(idx[k*tile_],idx_[k*t_->geometryLength+gp],cp,ip);AscendC::DataCopyPad(coeff[k*tile_],w_[k*t_->geometryLength+gp],cp,fp);}}
            if constexpr(std::is_same<T,half>::value){if(cached!=nc){AscendC::DataCopyExtParams xc{1,static_cast<uint32_t>(input_*sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> xp{false,0,0,static_cast<T>(0)};if constexpr(std::is_same<T,float>::value){AscendC::Duplicate(cache,0.0f,(static_cast<uint32_t>(input_)+64)/64*64);AscendC::PipeBarrier<PIPE_ALL>();}AscendC::DataCopyPad(cache,x_[nc*input_],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();cache.SetValue(static_cast<uint32_t>(input_),static_cast<T>(0));cached=nc;}}
            AscendC::PipeBarrier<PIPE_ALL>();AscendC::Duplicate(acc,0.0f,count);AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t group=0;group<8;group+=4){
                if constexpr(std::is_same<T,half>::value){auto raw=raw_.template Get<half>();AscendC::Gather(raw,cache,idx[group*tile_],0U,4*tile_);AscendC::PipeBarrier<PIPE_V>();AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,4*tile_);AscendC::PipeBarrier<PIPE_V>();}
                else{AscendC::Gather(values,cache,idx[group*tile_],0U,4*tile_);AscendC::PipeBarrier<PIPE_V>();}
                GridApplyWeightedFour(values,coeff,acc,group,tile_,count,software);
            }
            if constexpr(std::is_same<T,half>::value){auto out=out_.template Get<half>();AscendC::Cast(out,acc,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[linear],out,oc);}
            else{AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*4U,0,0,0};AscendC::DataCopyPad(y_[linear],acc,oc);}AscendC::PipeBarrier<PIPE_ALL>();linear+=count;
        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint64_t input_;uint32_t tile_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::GlobalTensor<uint32_t> idx_;AscendC::GlobalTensor<float> w_;
    AscendC::TBuf<AscendC::TPosition::VECIN> cache_,index_,weight_;AscendC::TBuf<AscendC::TPosition::VECCALC> value_,raw_;AscendC::TBuf<AscendC::TPosition::VECOUT> acc_,out_;
};

template <typename T> class GridSampler3DGrouped {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t){
        t_=t;input_=t->d*t->h*t->w;const uint32_t cb=std::is_same<T,float>::value?(static_cast<uint32_t>(input_)+64)/64*64*4:((static_cast<uint32_t>(input_)+15)/16*16+16)*sizeof(T);constexpr uint32_t width=std::is_same<T,half>::value?94:84;
        tile_=(196352U-8192U-cb)/(128U*width)*128U;if(tile_>1920)tile_=1920;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*input_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->n*t->c*((t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T))));idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),8*t->geometryLength);w_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry)+8*t->geometryLength,8*t->geometryLength);
        pipe_.InitBuffer(cache_,cb);pipe_.InitBuffer(index_,8*tile_*4);pipe_.InitBuffer(weight_,8*tile_*4);pipe_.InitBuffer(value_,4*tile_*4);pipe_.InitBuffer(acc_,tile_*4);if constexpr(std::is_same<T,half>::value){pipe_.InitBuffer(raw_,4*tile_*2);pipe_.InitBuffer(out_,tile_*2);}
    }
    __aicore__ inline void Process(){
        auto cache=cache_.template Get<T>();auto idx=index_.template Get<uint32_t>();auto coeff=weight_.template Get<float>();auto values=value_.template Get<float>();auto acc=acc_.template Get<float>();
        const uint64_t sa=(t_->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        const uint64_t per=(t_->spatialOut+tile_-1)/tile_,groups=(t_->c+7)/8;
        for(uint64_t task=AscendC::GetBlockIdx();task<t_->n*groups*per;task+=AscendC::GetBlockNum()){
            const uint64_t ng=task/per,n=ng/groups,channel=ng%groups*8,sp=task%per*tile_,gp=n*t_->spatialOut+sp;
            const uint32_t count=static_cast<uint32_t>(t_->spatialOut-sp<tile_?t_->spatialOut-sp:tile_);
            if(count!=tile_){AscendC::Duplicate(idx,static_cast<uint32_t>(input_*sizeof(T)),8*tile_);AscendC::PipeBarrier<PIPE_ALL>();}
            AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};AscendC::DataCopyPadExtParams<uint32_t> ip{true,0,static_cast<uint8_t>((count+7)/8*8-count),static_cast<uint32_t>(input_*sizeof(T))};AscendC::DataCopyPadExtParams<float> fp{false,0,0,0.0f};
            if(t_->geometryLength*4<=0xffffffffULL){cp.blockCount=8;cp.srcStride=static_cast<uint32_t>((t_->geometryLength-count)*4);cp.dstStride=(tile_*4-(count*4+31)/32*32)/32;AscendC::DataCopyPad(idx,idx_[gp],cp,ip);AscendC::DataCopyPad(coeff,w_[gp],cp,fp);}
            else{for(uint32_t k=0;k<8;++k){AscendC::DataCopyPad(idx[k*tile_],idx_[k*t_->geometryLength+gp],cp,ip);AscendC::DataCopyPad(coeff[k*tile_],w_[k*t_->geometryLength+gp],cp,fp);}}
            AscendC::PipeBarrier<PIPE_ALL>();
            for(uint64_t c=channel;c<t_->c && c<channel+8;++c){const uint64_t nc=n*t_->c+c;
            AscendC::DataCopyExtParams xc{1,static_cast<uint32_t>(input_*sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> xp{false,0,0,static_cast<T>(0)};if constexpr(std::is_same<T,float>::value){AscendC::Duplicate(cache,0.0f,(static_cast<uint32_t>(input_)+64)/64*64);AscendC::PipeBarrier<PIPE_ALL>();}AscendC::DataCopyPad(cache,x_[nc*input_],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();cache.SetValue(static_cast<uint32_t>(input_),static_cast<T>(0));
            AscendC::PipeBarrier<PIPE_ALL>();bool software=false;if constexpr(std::is_same<T,float>::value)software=GridNeedsFma32(cache.template ReinterpretCast<float>(),values.template ReinterpretCast<uint32_t>(),acc.template ReinterpretCast<uint32_t>(),static_cast<uint32_t>(input_));AscendC::Duplicate(acc,0.0f,count);AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t group=0;group<8;group+=4){
                if constexpr(std::is_same<T,half>::value){auto raw=raw_.template Get<half>();AscendC::Gather(raw,cache,idx[group*tile_],0U,4*tile_);AscendC::PipeBarrier<PIPE_V>();AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,4*tile_);AscendC::PipeBarrier<PIPE_V>();}
                else{AscendC::Gather(values,cache,idx[group*tile_],0U,4*tile_);AscendC::PipeBarrier<PIPE_V>();}
                GridApplyWeightedFour(values,coeff,acc,group,tile_,count,software);
            }
            if constexpr(std::is_same<T,half>::value){auto out=out_.template Get<half>();AscendC::Cast(out,acc,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[nc*sa+sp],out,oc);}
            else{AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*4U,0,0,0};AscendC::DataCopyPad(y_[nc*sa+sp],acc,oc);}AscendC::PipeBarrier<PIPE_ALL>();
