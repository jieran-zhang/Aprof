        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint32_t cp_,p_,pitch_,factor_;bool pair_;uint64_t i_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::TBuf<AscendC::TPosition::VECIN> raw_;AscendC::TBuf<AscendC::TPosition::VECCALC> index_;AscendC::TBuf<AscendC::TPosition::VECOUT> out_;
