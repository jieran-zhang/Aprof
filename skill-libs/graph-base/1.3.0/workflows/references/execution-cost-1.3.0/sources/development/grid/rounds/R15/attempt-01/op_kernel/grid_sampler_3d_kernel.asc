            else{AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(y_[n*t_->c*sa+point],values,oc);}AscendC::PipeBarrier<PIPE_ALL>();

        }
    }
    __aicore__ inline void Apply(AscendC::LocalTensor<float> values,AscendC::LocalTensor<float> weights,AscendC::LocalTensor<float> acc,uint32_t group,uint32_t count){
        AscendC::SetMaskNorm();AscendC::BinaryRepeatParams mp{1,1,0,static_cast<uint8_t>(cp_/8),static_cast<uint8_t>(cp_/8),1},ap{1,1,1,static_cast<uint8_t>(cp_/8),static_cast<uint8_t>(cp_/8),static_cast<uint8_t>(cp_/8)};
        for(uint32_t j=0;j<2;++j)for(uint32_t c=0;c<cp_;c+=64){const uint64_t mask=cp_-c<64?cp_-c:64;AscendC::Mul<float>(values[j*v_+c],values[j*v_+c],weights[(group+j)*wb_],mask,static_cast<uint8_t>(count),mp);}AscendC::PipeBarrier<PIPE_V>();
        for(uint32_t j=0;j<2;++j){for(uint32_t c=0;c<cp_;c+=64){const uint64_t mask=cp_-c<64?cp_-c:64;AscendC::Add<float>(acc[c],acc[c],values[j*v_+c],mask,static_cast<uint8_t>(count),ap);}AscendC::PipeBarrier<PIPE_V>();}AscendC::SetMaskNorm();AscendC::ResetMask();
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint64_t i_;uint32_t cp_,batch_,v_,wb_,gTile_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::GlobalTensor<uint32_t> geometryIndex_;AscendC::GlobalTensor<float> geometryWeight_;
    AscendC::TBuf<AscendC::TPosition::VECIN> raw_,geometry_;AscendC::TBuf<AscendC::TPosition::VECCALC> weights_,transpose_;AscendC::TBuf<AscendC::TPosition::VECOUT> values_,acc_,out_;
};

template <typename T> class GridNearestChannels {
public:
    __aicore__ inline void Init(GM_ADDR work,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t){
        t_=t;cp_=static_cast<uint32_t>((t->c+15)/16*16);i_=t->d*t->h*t->w;batch_=1024;
        while(batch_*(cp_*(2*sizeof(T)+4)+32+4)>196352-8192 || batch_*cp_>static_cast<uint32_t>(255*256/sizeof(T)))batch_-=64/sizeof(T);
        pitch_=cp_*sizeof(T)+32;v_=cp_*batch_;const uint64_t sa=(t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work),t->n*(i_+1)*cp_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work)+t->n*(i_+1)*cp_,t->n*t->c*sa);geometry_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),t->geometryLength);
        pipe_.InitBuffer(raw_,batch_*pitch_);pipe_.InitBuffer(out_,v_*sizeof(T));pipe_.InitBuffer(index_,v_*4);pipe_.InitBuffer(geo_,batch_*4);
    }
    __aicore__ inline void Process(){
        auto raw=raw_.template Get<T>();auto out=out_.template Get<T>();auto index=index_.template Get<int32_t>();auto geo=geo_.template Get<uint32_t>();
        AscendC::Duplicate(raw,static_cast<T>(0),batch_*pitch_/sizeof(T));
        for(uint32_t c=0;c<cp_;++c)AscendC::Arange(index[c*batch_],static_cast<int32_t>(c*sizeof(T)),static_cast<int32_t>(pitch_),static_cast<int32_t>(batch_));AscendC::PipeBarrier<PIPE_ALL>();
        const uint64_t per=(t_->spatialOut+batch_-1)/batch_,sa=(t_->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        for(uint64_t task=AscendC::GetBlockIdx();task<t_->n*per;task+=AscendC::GetBlockNum()){
