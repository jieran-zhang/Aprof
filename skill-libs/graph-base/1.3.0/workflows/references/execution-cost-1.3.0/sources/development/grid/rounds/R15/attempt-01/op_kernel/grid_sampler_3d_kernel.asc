        for(uint64_t tile=AscendC::GetBlockIdx();tile<t_->n*per;tile+=AscendC::GetBlockNum()){const uint64_t n=tile/per,point=tile%per*p_;const uint32_t count=static_cast<uint32_t>(i_-point<p_?i_-point:p_);const uint32_t aligned=(count*sizeof(T)+31)/32*32;
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(t_->c),count*static_cast<uint32_t>(sizeof(T)),static_cast<uint32_t>((i_-count)*sizeof(T)),(pitch_-aligned)/32,0};AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};AscendC::DataCopyPad(raw,x_[n*t_->c*i_+point],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
