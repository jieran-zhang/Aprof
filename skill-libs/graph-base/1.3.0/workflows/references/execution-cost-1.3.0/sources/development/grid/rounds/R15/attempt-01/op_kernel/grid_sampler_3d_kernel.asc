template <typename T> class GridSampler3DGroupedFullBatch {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t){
        t_=t;input_=t->d*t->h*t->w;const uint32_t cb=std::is_same<T,float>::value?(static_cast<uint32_t>(input_)+64)/64*64*4:((static_cast<uint32_t>(input_)+15)/16*16+16)*sizeof(T);constexpr uint32_t width=std::is_same<T,half>::value?118:100;
        tile_=GridFullBatchTile(input_,sizeof(T));
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*input_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->n*t->c*((t->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T))));idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),8*t->geometryLength);w_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry)+8*t->geometryLength,8*t->geometryLength);
        pipe_.InitBuffer(cache_,cb);pipe_.InitBuffer(index_,8*tile_*4);pipe_.InitBuffer(weight_,8*tile_*4);pipe_.InitBuffer(acc_,tile_*4);if constexpr(std::is_same<T,half>::value){pipe_.InitBuffer(raw_,8*tile_*2);pipe_.InitBuffer(out_,tile_*2);}const uint32_t before=cb+(68+(std::is_same<T,half>::value?18:0))*tile_,accBase=cb+64*tile_,gap=(accBase+256-before)&511U;if(gap)pipe_.InitBuffer(padding_,gap);pipe_.InitBuffer(value_,8*tile_*4);
    }
    __aicore__ inline void Process(){
        auto cache=cache_.template Get<T>();auto idx=index_.template Get<uint32_t>();auto coeff=weight_.template Get<float>();auto values=value_.template Get<float>();auto acc=acc_.template Get<float>();
        const uint64_t sa=(t_->spatialOut+64/sizeof(T)-1)/(64/sizeof(T))*(64/sizeof(T));
        const uint64_t per=(t_->spatialOut+tile_-1)/tile_,groups=(t_->c+7)/8;
        for(uint64_t task=AscendC::GetBlockIdx();task<t_->n*groups*per;task+=AscendC::GetBlockNum()){
            const uint64_t ng=task/per,n=ng/groups,channel=ng%groups*8,sp=task%per*tile_,gp=n*t_->spatialOut+sp;
            const uint32_t count=static_cast<uint32_t>(t_->spatialOut-sp<tile_?t_->spatialOut-sp:tile_);
            if(count!=tile_){AscendC::Duplicate(idx,static_cast<uint32_t>(input_*sizeof(T)),8*tile_);AscendC::Duplicate(coeff,0.0f,8*tile_);AscendC::PipeBarrier<PIPE_ALL>();}
            AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};AscendC::DataCopyPadExtParams<uint32_t> ip{true,0,static_cast<uint8_t>((count+7)/8*8-count),static_cast<uint32_t>(input_*sizeof(T))};AscendC::DataCopyPadExtParams<float> fp{false,0,0,0.0f};
            if(t_->geometryLength*4<=0xffffffffULL){cp.blockCount=8;cp.srcStride=static_cast<uint32_t>((t_->geometryLength-count)*4);cp.dstStride=(tile_*4-(count*4+31)/32*32)/32;AscendC::DataCopyPad(idx,idx_[gp],cp,ip);AscendC::DataCopyPad(coeff,w_[gp],cp,fp);}
            else{for(uint32_t k=0;k<8;++k){AscendC::DataCopyPad(idx[k*tile_],idx_[k*t_->geometryLength+gp],cp,ip);AscendC::DataCopyPad(coeff[k*tile_],w_[k*t_->geometryLength+gp],cp,fp);}}
            AscendC::PipeBarrier<PIPE_ALL>();
            for(uint64_t c=channel;c<t_->c && c<channel+8;++c){const uint64_t nc=n*t_->c+c;
            AscendC::DataCopyExtParams xc{1,static_cast<uint32_t>(input_*sizeof(T)),0,0,0};AscendC::DataCopyPadExtParams<T> xp{false,0,0,static_cast<T>(0)};if constexpr(std::is_same<T,float>::value){AscendC::Duplicate(cache,0.0f,(static_cast<uint32_t>(input_)+64)/64*64);AscendC::PipeBarrier<PIPE_ALL>();}AscendC::DataCopyPad(cache,x_[nc*input_],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();cache.SetValue(static_cast<uint32_t>(input_),static_cast<T>(0));
            AscendC::PipeBarrier<PIPE_ALL>();bool software=false;if constexpr(std::is_same<T,float>::value)software=GridNeedsFma32(cache.template ReinterpretCast<float>(),values.template ReinterpretCast<uint32_t>(),acc.template ReinterpretCast<uint32_t>(),static_cast<uint32_t>(input_));AscendC::Duplicate(acc,0.0f,count);AscendC::PipeBarrier<PIPE_V>();
            if constexpr(std::is_same<T,half>::value){auto raw=raw_.template Get<half>();AscendC::Gather(raw,cache,idx,0U,8*tile_);AscendC::PipeBarrier<PIPE_V>();AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,8*tile_);AscendC::PipeBarrier<PIPE_V>();}
            else{AscendC::Gather(values,cache,idx,0U,8*tile_);AscendC::PipeBarrier<PIPE_V>();}
            GridApplyWeightedEight(values,coeff,acc,tile_,count,software);
            if constexpr(std::is_same<T,half>::value){auto out=out_.template Get<half>();AscendC::Cast(out,acc,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[nc*sa+sp],out,oc);}
            else{AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams oc{1,count*4U,0,0,0};AscendC::DataCopyPad(y_[nc*sa+sp],acc,oc);}AscendC::PipeBarrier<PIPE_ALL>();
            }
        }
    }
private:
    const __gm__ GridSampler3DTilingData *t_;uint64_t input_;uint32_t tile_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T> x_,y_;AscendC::GlobalTensor<uint32_t> idx_;AscendC::GlobalTensor<float> w_;
    AscendC::TBuf<AscendC::TPosition::VECIN> cache_,index_,weight_;AscendC::TBuf<AscendC::TPosition::VECCALC> value_,raw_,padding_;AscendC::TBuf<AscendC::TPosition::VECOUT> acc_,out_;
};

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_grouped_small(GM_ADDR x,GM_ADDR ypad,GM_ADDR geometry,GM_ADDR tiling){
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tiling);const uint64_t input=t->d*t->h*t->w;const uint32_t item=t->dtype==GRID_FP16?2:4,cb=item==4?(static_cast<uint32_t>(input)+64)/64*64*4:((static_cast<uint32_t>(input)+15)/16*16+16)*item;
    uint32_t oldTile=(188160-cb)/(128*(item==2?94:84))*128;if(oldTile>1920)oldTile=1920;const uint32_t fullTile=GridFullBatchTile(input,item);
    const bool full=fullTile && (t->spatialOut+fullTile-1)/fullTile<=(t->spatialOut+oldTile-1)/oldTile;
    if(t->dtype==GRID_FP16){if(full){GridSampler3DGroupedFullBatch<half> op;op.Init(x,ypad,geometry,t);op.Process();}else{GridSampler3DGrouped<half> op;op.Init(x,ypad,geometry,t);op.Process();}}
    else{if(full){GridSampler3DGroupedFullBatch<float> op;op.Init(x,ypad,geometry,t);op.Process();}else{GridSampler3DGrouped<float> op;op.Init(x,ypad,geometry,t);op.Process();}}
}

template <typename T>
class GridSampler3DVector {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR grid, GM_ADDR y, GM_ADDR geometry,
                                  const __gm__ GridSampler3DTilingData *t) {
        t_=t;x_=reinterpret_cast<const __gm__ T *>(x);grid_=reinterpret_cast<const __gm__ T *>(grid);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y),t->outputNumel);
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*t->d*t->h*t->w);
        idxGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),(t->interpolation==GRID_NEAREST?1:8)*t->geometryLength);
        if(t->interpolation!=GRID_NEAREST)
            wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(geometry)+8*t->geometryLength,6*t->geometryLength);
        const uint64_t inputSpatial=t->d*t->h*t->w;
        const uint32_t sourceElements=static_cast<uint32_t>(inputSpatial<kCache?inputSpatial:kCache);
        const uint32_t cacheBytes=((sourceElements+15)/16*16+16)*sizeof(T);
        tile_=((196352U-8192U-cacheBytes)/(128U*(64U+2U*sizeof(T))))*128U;if(tile_>4096U)tile_=4096U;
        const uint32_t kTile=tile_;
        pipe_.InitBuffer(idxBuf_,8*kTile*sizeof(uint32_t));
        pipe_.InitBuffer(wBuf_,6*kTile*sizeof(float));
        pipe_.InitBuffer(valueBuf_,kTile*sizeof(float));
        pipe_.InitBuffer(rawBuf_,kTile*sizeof(T));
        pipe_.InitBuffer(outBuf_,kTile*sizeof(float));
        pipe_.InitBuffer(outRawBuf_,kTile*sizeof(T));
        pipe_.InitBuffer(cacheBuf_,cacheBytes);
    }

    __aicore__ inline void Process() {
        const uint32_t kTile=tile_;
        auto idx=idxBuf_.Get<uint32_t>();auto weights=wBuf_.Get<float>();
        auto values=valueBuf_.Get<float>();auto raw=rawBuf_.Get<T>();
        auto acc=outBuf_.Get<float>();auto out=outRawBuf_.Get<T>();auto cache=cacheBuf_.Get<T>();
        const uint64_t inputSpatial=t_->d*t_->h*t_->w, stride=t_->geometryLength;
        const uint32_t sentinel=static_cast<uint32_t>(inputSpatial*sizeof(T));
        const uint32_t neighbors=t_->interpolation==GRID_NEAREST?1:8;
        uint64_t cachedNc=~0ULL;
        const uint64_t begin=AscendC::GetBlockIdx()*t_->blockLength;
        uint64_t end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        for(uint64_t linear=begin;linear<end;) {
            const uint64_t spatial=linear%t_->spatialOut, nc=linear/t_->spatialOut;
            uint32_t count=static_cast<uint32_t>(end-linear<kTile?end-linear:kTile);
            if(count>t_->spatialOut-spatial)count=static_cast<uint32_t>(t_->spatialOut-spatial);
            if(inputSpatial*sizeof(T)>0xffffffffULL) {
                for(uint32_t i=0;i<count;++i)acc.SetValue(i,GridSampler3DOne<T>(x_,grid_,linear+i,t_));
                AscendC::PipeBarrier<PIPE_ALL>();
            } else {
                const uint64_t point=(nc/t_->c)*t_->spatialOut+spatial, xBase=nc*inputSpatial;
                AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};
                AscendC::DataCopyPadExtParams<uint32_t> ip{false,0,0,0};
                AscendC::DataCopyPadExtParams<float> fp{false,0,0,0.0f};
                if(neighbors==8 && stride*4<=0xffffffffULL){cp.blockCount=8;cp.srcStride=static_cast<uint32_t>((stride-count)*4);cp.dstStride=(kTile*4-(count*4+31)/32*32)/32;AscendC::DataCopyPad(idx,idxGm_[point],cp,ip);cp.blockCount=6;AscendC::DataCopyPad(weights,wGm_[point],cp,fp);}
                else{for(uint32_t k=0;k<neighbors;++k)AscendC::DataCopyPad(idx[k*kTile],idxGm_[k*stride+point],cp,ip);if(neighbors==8)for(uint32_t k=0;k<6;++k)AscendC::DataCopyPad(weights[k*kTile],wGm_[k*stride+point],cp,fp);}
                if(inputSpatial<=kCache) {
                    if(cachedNc!=nc) {
                    AscendC::DataCopyExtParams xp{1,static_cast<uint32_t>(inputSpatial*sizeof(T)),0,0,0};
                    AscendC::DataCopyPadExtParams<T> pad{false,0,0,static_cast<T>(0)};
                    AscendC::DataCopyPad(cache,xGm_[xBase],xp,pad);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    cache.SetValue(static_cast<uint32_t>(inputSpatial),static_cast<T>(0));
                    AscendC::PipeBarrier<PIPE_ALL>();
                    cachedNc=nc;
                    } else AscendC::PipeBarrier<PIPE_ALL>();
                } else AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::Duplicate(acc,0.0f,count);AscendC::PipeBarrier<PIPE_V>();
                for(uint32_t k=0;k<neighbors;++k) {
                    if(inputSpatial<=kCache) {
                        if constexpr(std::is_same<T,half>::value) {
                            AscendC::Gather(raw,cache,idx[k*kTile],0U,count);AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,count);
                        } else AscendC::Gather(values,cache,idx[k*kTile],0U,count);
                        AscendC::PipeBarrier<PIPE_V>();
                    } else {
                        for(uint32_t i=0;i<count;++i) {
                            const uint32_t offset=idx.GetValue(k*kTile+i);
                            if constexpr(std::is_same<T,half>::value)
                                raw.SetValue(i,offset==sentinel?static_cast<T>(0):x_[xBase+offset/sizeof(T)]);
                            else values.SetValue(i,offset==sentinel?0.0f:x_[xBase+offset/sizeof(T)]);
                        }
                        AscendC::PipeBarrier<PIPE_ALL>();
                        if constexpr(std::is_same<T,half>::value) {
                            AscendC::Cast(values,raw,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_V>();
                        }
                    }
                    if(neighbors==8) {
                        AscendC::Mul(values,values,weights[(k&1)*kTile],count);AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(values,values,weights[(2+((k>>1)&1))*kTile],count);AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(values,values,weights[(4+((k>>2)&1))*kTile],count);AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Add(acc,acc,values,count);AscendC::PipeBarrier<PIPE_V>();
                }
            }
            if constexpr(std::is_same<T,half>::value) {
                AscendC::Cast(out,acc,AscendC::RoundMode::CAST_NONE,count);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[linear],out,cp);
            } else {
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};AscendC::DataCopyPad(y_[linear],acc,cp);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            linear+=count;
        }
    }
private:
    static constexpr uint32_t kCache=131072/sizeof(T);
    uint32_t tile_;
    const __gm__ GridSampler3DTilingData *t_;
    const __gm__ T *x_,*grid_;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_,y_;
    AscendC::GlobalTensor<uint32_t> idxGm_;
    AscendC::GlobalTensor<float> wGm_;
    AscendC::TBuf<AscendC::TPosition::VECIN> idxBuf_,wBuf_,cacheBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> valueBuf_,rawBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outRawBuf_;
};

__aicore__ inline uint16_t GridNearestHalfBitsAt(const __gm__ uint16_t *x,uint64_t base,uint32_t offset,uint32_t sentinel) {
    if(offset==sentinel)return 0;
    uint16_t value=x[base+offset/2];
    if((value&0x7fffU)>0x7c00U)value|=0x0200U;
    return value;
}
__aicore__ inline void GridNearestDirectHalf(GM_ADDR xAddr,GM_ADDR yAddr,GM_ADDR geometryAddr,
                                            const __gm__ GridSampler3DTilingData *t) {
    auto x=reinterpret_cast<const __gm__ uint16_t *>(xAddr);auto y=reinterpret_cast<__gm__ uint16_t *>(yAddr);
    auto geometry=reinterpret_cast<const __gm__ uint32_t *>(geometryAddr);
    const uint64_t inputSpatial=t->d*t->h*t->w;
    const uint32_t sentinel=static_cast<uint32_t>(inputSpatial*2);
    uint64_t linear=AscendC::GetBlockIdx()*t->blockLength,end=linear+t->blockLength;
    if(end>t->outputNumel)end=t->outputNumel;
    uint64_t nc=linear/t->spatialOut,spatial=linear%t->spatialOut;
    while(linear<end) {
        uint64_t count=t->spatialOut-spatial;if(count>end-linear)count=end-linear;
        const uint64_t point=(nc/t->c)*t->spatialOut+spatial,base=nc*inputSpatial;
        for(uint64_t j=0;j<count;++j)y[linear+j]=GridNearestHalfBitsAt(x,base,geometry[point+j],sentinel);
        linear+=count;++nc;spatial=0;
    }
}

template <typename U>
__aicore__ inline void GridNearestDirectBits(GM_ADDR xAddr,GM_ADDR yAddr,GM_ADDR geometryAddr,
                                             const __gm__ GridSampler3DTilingData *t) {
    const auto x=reinterpret_cast<const __gm__ U *>(xAddr);auto y=reinterpret_cast<__gm__ U *>(yAddr);
    const auto geometry=reinterpret_cast<const __gm__ uint32_t *>(geometryAddr);
    const uint64_t inputSpatial=t->d*t->h*t->w;
    const uint32_t sentinel=static_cast<uint32_t>(inputSpatial*sizeof(U));
    uint64_t linear=AscendC::GetBlockIdx()*t->blockLength,end=linear+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;
    uint64_t nc=linear/t->spatialOut,spatial=linear%t->spatialOut;
    while(linear<end) {
        uint64_t count=t->spatialOut-spatial;if(count>end-linear)count=end-linear;
        const uint64_t point=(nc/t->c)*t->spatialOut+spatial,base=nc*inputSpatial;
        for(uint64_t i=0;i<count;++i) {
            const uint32_t offset=geometry[point+i];y[linear+i]=offset==sentinel?0:x[base+offset/sizeof(U)];
        }
        linear+=count;++nc;spatial=0;
    }
}
template <typename U>
class GridNearestCachedBits {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t) {
        t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ U *>(x),t->n*t->c*t->d*t->h*t->w);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ U *>(y),t->outputNumel);
        idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),t->geometryLength);
        pipe_.InitBuffer(cacheBuf_,(kCache+16)*sizeof(U));pipe_.InitBuffer(idxBuf_,kTile*4);pipe_.InitBuffer(outBuf_,kTile*sizeof(U));
    }
    __aicore__ inline void Process() {
        const uint64_t inputSpatial=t_->d*t_->h*t_->w;
        auto cache=cacheBuf_.template Get<U>();auto idx=idxBuf_.template Get<uint32_t>();auto out=outBuf_.template Get<U>();
        uint64_t linear=AscendC::GetBlockIdx()*t_->blockLength,end=linear+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        uint64_t nc=linear/t_->spatialOut,spatial=linear%t_->spatialOut,cached=~0ULL;
        while(linear<end) {
            uint32_t count=static_cast<uint32_t>(end-linear<kTile?end-linear:kTile);
            if(count>t_->spatialOut-spatial)count=static_cast<uint32_t>(t_->spatialOut-spatial);
            const uint64_t point=(nc/t_->c)*t_->spatialOut+spatial;
            AscendC::DataCopyExtParams ic{1,count*4U,0,0,0};AscendC::DataCopyPadExtParams<uint32_t> ip{false,0,0,0};
            AscendC::DataCopyPad(idx,idx_[point],ic,ip);
            if(cached!=nc) {
                AscendC::DataCopyExtParams xc{1,static_cast<uint32_t>(inputSpatial*sizeof(U)),0,0,0};AscendC::DataCopyPadExtParams<U> xp{false,0,0,0};
                AscendC::DataCopyPad(cache,x_[nc*inputSpatial],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();
                cache.SetValue(static_cast<uint32_t>(inputSpatial),0);AscendC::PipeBarrier<PIPE_ALL>();cached=nc;
            } else AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Gather(out,cache,idx,0U,count);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams oc{1,count*static_cast<uint32_t>(sizeof(U)),0,0,0};AscendC::DataCopyPad(y_[linear],out,oc);AscendC::PipeBarrier<PIPE_ALL>();
            linear+=count;spatial+=count;if(spatial==t_->spatialOut){++nc;spatial=0;}
        }
    }
private:
    static constexpr uint32_t kTile=4096,kCache=131072/sizeof(U);
    const __gm__ GridSampler3DTilingData *t_;AscendC::TPipe pipe_;
    AscendC::GlobalTensor<U> x_,y_;AscendC::GlobalTensor<uint32_t> idx_;
    AscendC::TBuf<AscendC::TPosition::VECIN> cacheBuf_,idxBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
};

class GridNearestHalfSlab {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,GM_ADDR geometry,const __gm__ GridSampler3DTilingData *t) {
        t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x),t->n*t->c*t->d*t->h*t->w);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y),t->outputNumel);
        idx_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(geometry),t->geometryLength);
        pipe_.InitBuffer(cacheBuf_,(kCache+16)*2);pipe_.InitBuffer(idxBuf_,kTile*4);pipe_.InitBuffer(offsetBuf_,kTile*4);
        pipe_.InitBuffer(valueBuf_,kTile*2);pipe_.InitBuffer(priorBuf_,kTile*2);pipe_.InitBuffer(outBuf_,kTile*2);pipe_.InitBuffer(maskBuf_,3*kMask);
    }
    __aicore__ inline void Process() {
        const uint64_t inputSpatial=t_->d*t_->h*t_->w;
        auto cache=cacheBuf_.Get<half>();auto idx=idxBuf_.Get<uint32_t>();auto offset=offsetBuf_.Get<float>();
        auto value=valueBuf_.Get<half>();auto prior=priorBuf_.Get<half>();auto out=outBuf_.Get<half>();auto mask=maskBuf_.Get<uint8_t>();
        uint64_t linear=AscendC::GetBlockIdx()*t_->blockLength,end=linear+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        uint64_t nc=linear/t_->spatialOut,spatial=linear%t_->spatialOut;
        while(linear<end) {
            uint64_t window=t_->spatialOut-spatial;if(window>end-linear)window=end-linear;
            const uint64_t point=(nc/t_->c)*t_->spatialOut+spatial;
            for(uint64_t slab=0;slab<inputSpatial;slab+=kCache) {
                const uint32_t slabCount=static_cast<uint32_t>(inputSpatial-slab<kCache?inputSpatial-slab:kCache);
                const float slabBeginBytes=static_cast<float>(static_cast<int32_t>(slab*2));
                const float slabSizeBytes=static_cast<float>(static_cast<int32_t>(slabCount*2));
                AscendC::DataCopyExtParams xc{1,slabCount*2U,0,0,0};AscendC::DataCopyPadExtParams<half> xp{false,0,0,static_cast<half>(0)};
                AscendC::DataCopyPad(cache,x_[nc*inputSpatial+slab],xc,xp);AscendC::PipeBarrier<PIPE_ALL>();
                cache.ReinterpretCast<uint16_t>().SetValue(slabCount,0);AscendC::PipeBarrier<PIPE_ALL>();
                for(uint64_t p=0;p<window;p+=kTile) {
                    const uint32_t count=static_cast<uint32_t>(window-p<kTile?window-p:kTile);
                    const uint32_t padded=(count+7)/8*8,compared=(count+63)/64*64;
                    if(compared>padded)AscendC::Duplicate(idx.ReinterpretCast<float>()[padded],0.0f,compared-padded);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    AscendC::DataCopyExtParams ic{1,count*4U,0,0,0};AscendC::DataCopyPadExtParams<uint32_t> ip{true,0,static_cast<uint8_t>(padded-count),0};
                    AscendC::DataCopyPad(idx,idx_[point+p],ic,ip);
                    if(slab) {
                        AscendC::DataCopyExtParams yc{1,count*2U,0,0,0};AscendC::DataCopyPadExtParams<half> yp{false,0,0,static_cast<half>(0)};
                        AscendC::DataCopyPad(prior,y_[linear+p],yc,yp);
                    } else AscendC::Duplicate(prior,static_cast<half>(0),count);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    AscendC::Cast(offset,idx.ReinterpretCast<int32_t>(),AscendC::RoundMode::CAST_NONE,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(offset,offset,-slabBeginBytes,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::CompareScalar(mask,offset,0.0f,AscendC::CMPMODE::GE,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::CompareScalar(mask[kMask],offset,slabSizeBytes,AscendC::CMPMODE::LT,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::And(mask[2*kMask].ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),mask[kMask].ReinterpretCast<uint16_t>(),compared/16);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Maxs(offset,offset,0.0f,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mins(offset,offset,slabSizeBytes,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(idx.ReinterpretCast<int32_t>(),offset,AscendC::RoundMode::CAST_RINT,compared);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Gather(value.ReinterpretCast<uint16_t>(),cache.ReinterpretCast<uint16_t>(),idx,0U,count);AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Select(out,mask[2*kMask],value,prior,AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE,count);AscendC::PipeBarrier<PIPE_ALL>();
                    AscendC::DataCopyExtParams oc{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[linear+p],out,oc);AscendC::PipeBarrier<PIPE_ALL>();
                }
            }
            linear+=window;++nc;spatial=0;
        }
    }
private:
    static constexpr uint32_t kCache=65536,kTile=3584,kMask=kTile/8;
    const __gm__ GridSampler3DTilingData *t_;AscendC::TPipe pipe_;
    AscendC::GlobalTensor<half> x_,y_;AscendC::GlobalTensor<uint32_t> idx_;
    AscendC::TBuf<AscendC::TPosition::VECIN> cacheBuf_,idxBuf_,priorBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> offsetBuf_,valueBuf_,maskBuf_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_nearest_slab_bitcheck(
    GM_ADDR x,GM_ADDR idx,GM_ADDR y,GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    GridNearestHalfSlab op;op.Init(x,y,idx,t);op.Process();
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_kernel(
    GM_ADDR x, GM_ADDR grid, GM_ADDR y, GM_ADDR tilingAddr, GM_ADDR geometry) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    const uint64_t inputSpatial=t->d*t->h*t->w;
    const uint64_t inputBytes=inputSpatial*(t->dtype==GRID_FP16?2:4);
    if(t->interpolation==GRID_NEAREST && inputBytes<=131072) {
        if(t->dtype==GRID_FP16){GridNearestCachedBits<uint16_t> op;op.Init(x,y,geometry,t);op.Process();}
        else {GridNearestCachedBits<uint32_t> op;op.Init(x,y,geometry,t);op.Process();}
        return;
    }
    if(t->dtype==GRID_FP16 && t->interpolation==GRID_NEAREST && inputBytes>131072 && inputBytes<=524288 && inputSpatial<=2*t->spatialOut) {
        GridNearestHalfSlab op;op.Init(x,y,geometry,t);op.Process();return;
    }
    const uint64_t planeBytes=inputSpatial*2;
    if(t->dtype==GRID_FP16 && t->interpolation==GRID_NEAREST && planeBytes>131072 && planeBytes<0xffffffffULL) {
        GridNearestDirectHalf(x,y,geometry,t);return;
    }
    if(t->interpolation==GRID_BILINEAR){
        if(inputBytes<=131072){if(t->dtype==GRID_FP16){GridSampler3DFullBatch<half> op;op.Init(x,y,geometry,t);op.Process();}else{GridSampler3DFullBatch<float> op;op.Init(x,y,geometry,t);op.Process();}}
        else if(t->dtype==GRID_FP16){GridSampler3DHalf op;op.Init(x,grid,y,t);op.Process();}else GridSampler3DScalar<float>(x,grid,y,t);
        return;
    }
    if(t->dtype==GRID_FP16) { GridSampler3DVector<half> op;op.Init(x,grid,y,geometry,t);op.Process(); }
    else { GridSampler3DVector<float> op;op.Init(x,grid,y,geometry,t);op.Process(); }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_original(
    GM_ADDR x, GM_ADDR grid, GM_ADDR y, GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    if(t->dtype==GRID_FP16) { GridSampler3DHalf op;op.Init(x,grid,y,t);op.Process(); }
    else GridSampler3DScalar<float>(x,grid,y,t);
}

template <typename T>
__aicore__ inline void GridCoordinatesRange(const __gm__ T *grid,__gm__ float *out,
                                           const __gm__ GridSampler3DTilingData *t,uint64_t begin,uint64_t end) {
    for(uint64_t p=begin;p<end;++p) {
        float ix=GridUnnormalize(GridToFloat<T>(grid[3*p]),t->wFloat,t->alignCorners);
        float iy=GridUnnormalize(GridToFloat<T>(grid[3*p+1]),t->hFloat,t->alignCorners);
        float iz=GridUnnormalize(GridToFloat<T>(grid[3*p+2]),t->dFloat,t->alignCorners);
        out[3*p]=GridApplyPadding(ix,t->w,t->wFloat,t->padding,t->alignCorners);
        out[3*p+1]=GridApplyPadding(iy,t->h,t->hFloat,t->padding,t->alignCorners);
        out[3*p+2]=GridApplyPadding(iz,t->d,t->dFloat,t->padding,t->alignCorners);
    }
}
class GridCoordinateVector {
public:
    __aicore__ inline void Init(GM_ADDR grid,GM_ADDR output,const __gm__ GridSampler3DTilingData *t) {
        t_=t;grid_=reinterpret_cast<const __gm__ float *>(grid);output_=reinterpret_cast<__gm__ float *>(output);
        gridGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(grid),3*t->n*t->spatialOut);
        outGm_.SetGlobalBuffer(output_,3*t->geometryLength);
        pipe_.InitBuffer(rawBuf_,3*kTile*4);pipe_.InitBuffer(flatBuf_,3*kTile*4);
        pipe_.InitBuffer(coordBuf_,3*kTile*4);pipe_.InitBuffer(laneBuf_,3*kTile*4);
        pipe_.InitBuffer(outIndexBuf_,3*kTile*4);pipe_.InitBuffer(outBuf_,3*kTile*4);pipe_.InitBuffer(maskBuf_,12*32);
    }
    __aicore__ inline void Process() {
        auto raw=rawBuf_.Get<float>();auto flat=flatBuf_.Get<float>();auto coord=coordBuf_.Get<float>();
        auto lane=laneBuf_.Get<int32_t>();auto outIndex=outIndexBuf_.Get<uint32_t>();auto out=outBuf_.Get<float>();auto mask=maskBuf_.Get<uint8_t>();
        const uint64_t begin=AscendC::GetBlockIdx()*t_->geometryBlockLength;uint64_t end=begin+t_->geometryBlockLength;
        if(end>t_->n*t_->spatialOut)end=t_->n*t_->spatialOut;
        if(t_->padding==GRID_REFLECTION || t_->geometryBlockLength<64){GridCoordinatesRange<float>(grid_,output_,t_,begin,end);return;}
        for(uint32_t a=0;a<3;++a)AscendC::Arange(lane[a*kTile],static_cast<int32_t>(4*a),12,static_cast<int32_t>(kTile));
        for(uint32_t i=0;i<kTile;++i)for(uint32_t a=0;a<3;++a)outIndex.SetValue(3*i+a,(a*kTile+i)*4);
        AscendC::PipeBarrier<PIPE_ALL>();
        for(uint64_t p=begin;p<end;p+=kTile) {
            const uint32_t count=static_cast<uint32_t>(end-p<kTile?end-p:kTile),nr=3*count,padded=(nr+7)/8*8;
            if(padded<3*kTile)AscendC::Duplicate(raw[padded],0.0f,3*kTile-padded);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams cp{1,nr*4U,0,0,0};AscendC::DataCopyPadExtParams<float> pad{true,0,static_cast<uint8_t>(padded-nr),0.0f};
            AscendC::DataCopyPad(raw,gridGm_[3*p],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopy(flat,raw,3*kTile);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::CompareScalar(mask,flat,-1.0f,AscendC::CMPMODE::GE,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::CompareScalar(mask[3*32],flat,1.0f,AscendC::CMPMODE::LE,3*kTile);AscendC::PipeBarrier<PIPE_V>();
            AscendC::And(mask[6*32].ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),mask[3*32].ReinterpretCast<uint16_t>(),3*kTile/16);AscendC::PipeBarrier<PIPE_ALL>();
            bool regular=true;auto guard=mask[6*32].ReinterpretCast<uint32_t>();
            for(uint32_t i=0;i<3*kTile/32;++i)if(guard.GetValue(i)!=0xffffffffU){regular=false;break;}
            if(!regular){GridCoordinatesRange<float>(grid_,output_,t_,p,p+count);continue;}
            for(uint32_t a=0;a<3;++a)AscendC::Gather(coord[a*kTile],flat,lane[a*kTile].ReinterpretCast<uint32_t>(),0U,kTile);
            AscendC::PipeBarrier<PIPE_V>();
            for(uint32_t a=0;a<3;++a) {
                const float dim=a==0?t_->wFloat:(a==1?t_->hFloat:t_->dFloat);auto c=coord[a*kTile];
                AscendC::Adds(c,c,1.0f,kTile);AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(c,c,t_->alignCorners?dim-1.0f:dim,kTile);AscendC::PipeBarrier<PIPE_V>();
                if(!t_->alignCorners){AscendC::Adds(c,c,-1.0f,kTile);AscendC::PipeBarrier<PIPE_V>();}
                AscendC::Muls(c,c,0.5f,kTile);AscendC::PipeBarrier<PIPE_V>();
                if(t_->padding==GRID_BORDER){AscendC::Maxs(c,c,0.0f,kTile);AscendC::PipeBarrier<PIPE_V>();AscendC::Mins(c,c,dim-1.0f,kTile);AscendC::PipeBarrier<PIPE_V>();}
            }
            AscendC::Gather(out,coord,outIndex,0U,3*kTile);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(outGm_[3*p],out,cp);AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    static constexpr uint32_t kTile=256;
    const __gm__ GridSampler3DTilingData *t_;const __gm__ float *grid_;__gm__ float *output_;
    AscendC::TPipe pipe_;AscendC::GlobalTensor<float> gridGm_,outGm_;
    AscendC::TBuf<AscendC::TPosition::VECIN> rawBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> flatBuf_,coordBuf_,laneBuf_,outIndexBuf_,maskBuf_;
};
__aicore__ inline float GridCompactFloatValue(const __gm__ float *x,const __gm__ float *coords,
                                              uint64_t point,uint64_t xBase,const __gm__ GridSampler3DTilingData *t) {
    const float ix=coords[3*point],iy=coords[3*point+1],iz=coords[3*point+2];
    const int64_t x0=GridFloor(ix),y0=GridFloor(iy),z0=GridFloor(iz),x1=x0+1,y1=y0+1,z1=z0+1;
    const float dx=ix-static_cast<float>(x0),dy=iy-static_cast<float>(y0),dz=iz-static_cast<float>(z0);
    const float wx0=1.0f-dx,wy0=1.0f-dy,wz0=1.0f-dz;float result=0.0f;
    result+=GridRead<float>(x,xBase,z0,y0,x0,t)*wx0*wy0*wz0;
    result+=GridRead<float>(x,xBase,z0,y0,x1,t)*dx *wy0*wz0;
    result+=GridRead<float>(x,xBase,z0,y1,x0,t)*wx0*dy *wz0;
    result+=GridRead<float>(x,xBase,z0,y1,x1,t)*dx *dy *wz0;
    result+=GridRead<float>(x,xBase,z1,y0,x0,t)*wx0*wy0*dz;
    result+=GridRead<float>(x,xBase,z1,y0,x1,t)*dx *wy0*dz;
    result+=GridRead<float>(x,xBase,z1,y1,x0,t)*wx0*dy *dz;
    result+=GridRead<float>(x,xBase,z1,y1,x1,t)*dx *dy *dz;
    return result;
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_compact_geometry(GM_ADDR grid,GM_ADDR coords,GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);GridCoordinateVector op;op.Init(grid,coords,t);op.Process();
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_compact_consume(GM_ADDR input,GM_ADDR coords,GM_ADDR output,GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    auto x=reinterpret_cast<const __gm__ float *>(input);auto geometry=reinterpret_cast<const __gm__ float *>(coords);auto y=reinterpret_cast<__gm__ float *>(output);
    const uint64_t inputSpatial=t->d*t->h*t->w;
    uint64_t linear=AscendC::GetBlockIdx()*t->blockLength,end=linear+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;
    uint64_t nc=linear/t->spatialOut,spatial=linear%t->spatialOut;
    while(linear<end) {
        uint64_t count=t->spatialOut-spatial;if(count>end-linear)count=end-linear;
        const uint64_t point=(nc/t->c)*t->spatialOut+spatial,base=nc*inputSpatial;
        for(uint64_t i=0;i<count;++i)y[linear+i]=GridCompactFloatValue(x,geometry,point+i,base,t);
        linear+=count;++nc;spatial=0;
    }
}

// Workspace Xfloat occupies4*n*c*inputSpatial bytes; geometry follows64B-aligned Xfloat.
__aicore__ inline uint64_t GridLargeHalfXElements(const __gm__ GridSampler3DTilingData *t) {
    const uint64_t n=t->n*t->c*t->d*t->h*t->w;return (n+15)/16*16;
}
class GridPrepareLargeHalf {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR grid,GM_ADDR work,const __gm__ GridSampler3DTilingData *t) {
        t_=t;grid_=reinterpret_cast<const __gm__ half *>(grid);work_=reinterpret_cast<__gm__ float *>(work);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x),t->n*t->c*t->d*t->h*t->w);
        xf_.SetGlobalBuffer(work_,GridLargeHalfXElements(t));
        pipe_.InitBuffer(rawBuf_,kTile*2);pipe_.InitBuffer(fpBuf_,kTile*4);
    }
    __aicore__ inline void Process() {
        const uint64_t total=t_->n*t_->c*t_->d*t_->h*t_->w;
        const uint64_t block=(total+t_->blockNum-1)/t_->blockNum;
        const uint64_t length=(block+15)/16*16,begin=AscendC::GetBlockIdx()*length;
        uint64_t end=begin+length;if(end>total)end=total;
        auto raw=rawBuf_.Get<half>();auto fp=fpBuf_.Get<float>();
        for(uint64_t p=begin;p<end;p+=kTile) {
            const uint32_t count=static_cast<uint32_t>(end-p<kTile?end-p:kTile);
            AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPadExtParams<half> pad{false,0,0,static_cast<half>(0)};
            AscendC::DataCopyPad(raw,x_[p],cp,pad);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(fp,raw,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams out{1,count*4U,0,0,0};AscendC::DataCopyPad(xf_[p],fp,out);AscendC::PipeBarrier<PIPE_ALL>();
        }
        auto geometry=reinterpret_cast<__gm__ uint32_t *>(work_+GridLargeHalfXElements(t_));
        const uint64_t gb=AscendC::GetBlockIdx()*t_->geometryBlockLength;
        uint64_t ge=gb+t_->geometryBlockLength;if(ge>t_->n*t_->spatialOut)ge=t_->n*t_->spatialOut;
        if(t_->interpolation==GRID_NEAREST)GridGeometryRange<half>(grid_,geometry,t_,gb,ge);
        else {
            auto coords=reinterpret_cast<__gm__ float *>(geometry);const uint64_t stride=t_->geometryLength;
            for(uint64_t p=gb;p<ge;++p) {
                float ix=GridUnnormalize(GridToFloat<half>(grid_[3*p]),t_->wFloat,t_->alignCorners);
                float iy=GridUnnormalize(GridToFloat<half>(grid_[3*p+1]),t_->hFloat,t_->alignCorners);
                float iz=GridUnnormalize(GridToFloat<half>(grid_[3*p+2]),t_->dFloat,t_->alignCorners);
                coords[3*p]=GridApplyPadding(ix,t_->w,t_->wFloat,t_->padding,t_->alignCorners);
                coords[3*p+1]=GridApplyPadding(iy,t_->h,t_->hFloat,t_->padding,t_->alignCorners);
                coords[3*p+2]=GridApplyPadding(iz,t_->d,t_->dFloat,t_->padding,t_->alignCorners);
            }
        }
    }
private:
    static constexpr uint32_t kTile=8192;
    const __gm__ GridSampler3DTilingData *t_;const __gm__ half *grid_;__gm__ float *work_;
    AscendC::GlobalTensor<half> x_;AscendC::GlobalTensor<float> xf_;AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECIN> rawBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> fpBuf_;
};
class GridConsumeLargeHalf {
public:
    __aicore__ inline void Init(GM_ADDR work,GM_ADDR y,const __gm__ GridSampler3DTilingData *t) {
        t_=t;x_=reinterpret_cast<const __gm__ float *>(work);geometry_=reinterpret_cast<const __gm__ uint32_t *>(x_+GridLargeHalfXElements(t));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y),t->outputNumel);
        pipe_.InitBuffer(fpBuf_,kTile*4);pipe_.InitBuffer(rawBuf_,kTile*2);
    }
    __aicore__ inline void Process() {
        const uint64_t begin=AscendC::GetBlockIdx()*t_->blockLength;uint64_t end=begin+t_->blockLength;
        if(end>t_->outputNumel)end=t_->outputNumel;
        auto fp=fpBuf_.Get<float>();auto raw=rawBuf_.Get<half>();
        const auto coords=reinterpret_cast<const __gm__ float *>(geometry_);const uint64_t inputSpatial=t_->d*t_->h*t_->w;
        uint64_t linear=begin,nc=linear/t_->spatialOut,spatial=linear%t_->spatialOut;
        while(linear<end) {
            uint64_t window=t_->spatialOut-spatial;if(window>end-linear)window=end-linear;
            const uint64_t point=(nc/t_->c)*t_->spatialOut+spatial,base=nc*inputSpatial;
            for(uint64_t p=0;p<window;p+=kTile) {
                const uint32_t count=static_cast<uint32_t>(window-p<kTile?window-p:kTile);
                for(uint32_t i=0;i<count;++i)fp.SetValue(i,GridCompactFloatValue(x_,coords,point+p+i,base,t_));
                AscendC::PipeBarrier<PIPE_ALL>();AscendC::Cast(raw,fp,AscendC::RoundMode::CAST_NONE,count);AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[linear+p],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();
            }
            linear+=window;++nc;spatial=0;
        }
    }
private:
    static constexpr uint32_t kTile=1024;
    const __gm__ GridSampler3DTilingData *t_;const __gm__ float *x_;const __gm__ uint32_t *geometry_;
    AscendC::TPipe pipe_;AscendC::GlobalTensor<half> y_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpBuf_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> rawBuf_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_prepare_large_half(
    GM_ADDR x,GM_ADDR grid,GM_ADDR work,GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    GridPrepareLargeHalf op;op.Init(x,grid,work,t);op.Process();
}
extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_consume_large_half(
    GM_ADDR work,GM_ADDR y,GM_ADDR tilingAddr) {
    auto t=reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    GridConsumeLargeHalf op;op.Init(work,y,t);op.Process();
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_conversion_bitcheck(GM_ADDR input,GM_ADDR output) {
    constexpr uint32_t total=65536,tile=8192;
    AscendC::TPipe pipe;AscendC::TBuf<AscendC::TPosition::VECIN> rawBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> fpBuf;
    pipe.InitBuffer(rawBuf,tile*2);pipe.InitBuffer(fpBuf,tile*4);
    auto raw=rawBuf.Get<half>();auto fp=fpBuf.Get<float>();
    AscendC::GlobalTensor<half> src;src.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(input),total);
    AscendC::GlobalTensor<float> dst;dst.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(output),total*2);
    auto scalar=reinterpret_cast<__gm__ float *>(output)+total;
    const auto original=reinterpret_cast<const __gm__ half *>(input);
    const auto inputBits=reinterpret_cast<const __gm__ uint16_t *>(input);
    auto direct=reinterpret_cast<__gm__ uint16_t *>(reinterpret_cast<__gm__ float *>(output)+total*2);
    AscendC::GlobalTensor<half> originalHalf;originalHalf.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(direct+total+1),total);
    for(uint32_t p=0;p<total;p+=tile) {
        AscendC::DataCopy(raw,src[p],tile);AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(fp,raw,AscendC::RoundMode::CAST_NONE,tile);AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(dst[p],fp,tile);AscendC::PipeBarrier<PIPE_ALL>();
        for(uint32_t i=0;i<tile;++i) {
            const float value=GridToFloat<half>(original[p+i]);scalar[p+i]=value;
            fp.SetValue(i,value);
            direct[p+i]=GridNearestHalfBitsAt(inputBits,0,(p+i)*2,total*2);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(raw,fp,AscendC::RoundMode::CAST_NONE,tile);AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams originalCopy{1,tile*2U,0,0,0};AscendC::DataCopyPad(originalHalf[p],raw,originalCopy);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
    direct[total]=GridNearestHalfBitsAt(inputBits,0,total*2,total*2);
}

// R6 task-local layout pipeline. GM and local offsets below are elements unless explicitly byte-named.
template <typename T> class GridPackChannels {
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR work,const __gm__ GridSampler3DTilingData *t){t_=t;cp_=static_cast<uint32_t>((t->c+15)/16*16);i_=t->d*t->h*t->w;pair_=t->interpolation==GRID_BILINEAR;factor_=pair_?2:1;p_=512;while(cp_*(p_*(2*sizeof(T)+4)+32)>196352-8192)p_/=2;if(pair_){p_=static_cast<uint32_t>(((188160U/cp_-32)/(2*sizeof(T)+4))/32*32);while(p_*cp_>255U*256U/sizeof(T))p_-=32;}pitch_=p_*sizeof(T)+32;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x),t->n*t->c*i_);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(work),factor_*t->n*(i_+1)*cp_);pipe_.InitBuffer(raw_,cp_*pitch_);pipe_.InitBuffer(index_,cp_*p_*4);pipe_.InitBuffer(out_,cp_*p_*sizeof(T));}
    __aicore__ inline void Process(){auto raw=raw_.template Get<T>();auto idx=index_.template Get<int32_t>();auto out=out_.template Get<T>();
        if((cp_&(cp_-1))==0){uint32_t lg=0;while((1U<<lg)<cp_)++lg;const uint32_t chunk=static_cast<uint32_t>(cp_*p_*sizeof(T)/4);auto pos=out.template ReinterpretCast<int32_t>();auto part=raw.template ReinterpretCast<int32_t>();
            for(uint32_t q=0;q<cp_*p_;q+=chunk){const uint32_t len=cp_*p_-q<chunk?cp_*p_-q:chunk;AscendC::Arange(idx[q],static_cast<int32_t>(q),1,static_cast<int32_t>(len));AscendC::PipeBarrier<PIPE_V>();AscendC::ShiftRight(pos,idx[q],static_cast<int32_t>(lg),len);AscendC::PipeBarrier<PIPE_V>();AscendC::ShiftLeft(part,pos,static_cast<int32_t>(lg),len);AscendC::PipeBarrier<PIPE_V>();AscendC::Sub(idx[q],idx[q],part,len);AscendC::PipeBarrier<PIPE_V>();AscendC::Muls(idx[q],idx[q],static_cast<int32_t>(pitch_),len);AscendC::Muls(pos,pos,static_cast<int32_t>(sizeof(T)),len);AscendC::PipeBarrier<PIPE_V>();AscendC::Add(idx[q],idx[q],pos,len);AscendC::PipeBarrier<PIPE_ALL>();}
        }else{for(uint32_t p=0;p<p_;++p)AscendC::Arange(idx[p*cp_],static_cast<int32_t>(p*sizeof(T)),static_cast<int32_t>(pitch_),static_cast<int32_t>(cp_));AscendC::PipeBarrier<PIPE_ALL>();}
