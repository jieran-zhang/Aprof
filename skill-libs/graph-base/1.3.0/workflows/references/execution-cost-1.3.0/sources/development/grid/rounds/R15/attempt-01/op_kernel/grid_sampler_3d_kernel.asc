                if(topStart<count){const uint32_t topCount=count-topStart;AscendC::Duplicate(out,static_cast<T>(0),topCount*cp_);AscendC::PipeBarrier<PIPE_ALL>();op.blockCount=static_cast<uint16_t>(topCount);AscendC::DataCopyPad(y_[(n*(i_+1)+point+topStart)*2*cp_+cp_],out,op);AscendC::PipeBarrier<PIPE_ALL>();}
            }else{AscendC::DataCopyExtParams op{1,count*cp_*static_cast<uint32_t>(sizeof(T)),0,0,0};AscendC::DataCopyPad(y_[(n*(i_+1)+point)*cp_],out,op);AscendC::PipeBarrier<PIPE_ALL>();}
