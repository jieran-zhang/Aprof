        auto raw=raw_.template Get<T>();auto values=values_.template Get<float>();auto weights=weights_.template Get<float>();auto acc=acc_.template Get<float>();auto geo=geometry_.template Get<uint32_t>();auto geoIndex=geo[8*gTile_];auto geoWeight=geo.template ReinterpretCast<float>();
