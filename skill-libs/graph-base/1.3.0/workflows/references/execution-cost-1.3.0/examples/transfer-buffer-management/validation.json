dispatch_domain": "unchanged", "fusion_boundary": "unchanged", "ownership": "unchanged", "reduction": "unchanged", "synchronization": "unchanged", "task_partition": "unchanged", "workspace_ownership": "unchanged"}, "dispatch_plan": {"architecture_profile_ref": "sha256:87082e55668791c6e1ece6f0924d46940af2f57870fc1390d9c39ea6d8e4377c", "dispatch_id": "paper-dispatch", "entries": [], "fallback": {"conditions": [], "group_id": "all", "kernel_entry": "paper_kernel", "required_capabilities": [], "tiling_key": 0}, "operator": "paper", "parallel_plan_ref": "sha256:232a17844234be865b7fae7a60ec489a0a13f7e25bd74601a8e2e5492958bd5c", "schema_version": "1.0.0", "source_hash": "sha256:701f8d79965f522624573312de80b6eaa677216d562ed2f60f59bd31bdae80b5"}, "implementation_freedom": {"dimensions": ["local_transfer", "buffer_event_management"], "parameter_domains": [{"maximum": 1024, "minimum": 32, "name": "tile"}], "reason": "Paper parent already permits local transfer and buffer_event_management while preserving all complete plan contracts."}, "parallel_plan": {"architecture_profile_ref": "sha256:87082e55668791c6e1ece6f0924d46940af2f57870fc1390d9c39ea6d8e4377c", "groups": [{"algorithm": "paper-current", "alternatives": [], "group_id": "all", "memory_requirements": {"UB": 4096}, "ownership": "disjoint output", "reduction": "none", "required_capabilities": [], "selection_evidence": ["sha256:f16d05ec6b29248d2c61adb1e9263f78e4f7bace1b955014a2d17872cfe4064d"], "synchronization": "same dependencies", "task_partition": "one paper task", "workspace_bytes": 0, "workspace_formula": "0"}], "operator": "paper", "plan_id": "paper-plan", "precision_invariants": ["same visible rounding"], "schema_version": "1.0.0", "semantic_invariants": ["output identity"], "source_hash": "sha256:701f8d79965f522624573312de80b6eaa677216d562ed2f60f59bd31bdae80b5"}, "scope": {"parent_implementation_hash": "sha256:701f8d79965f522624573312de80b6eaa677216d562ed2f60f59bd31bdae80b5", "stage": "kernel.main", "target_ids": ["tensor.x"], "task_id": "paper-task", "workload_hash": "sha256:1366ba10ac5245ad764571e9f921b41a046f8f7b67aa27e9e2b0d475fbcd6435"}}, "scope": {"parent_implementation_hash": "sha256:701f8d79965f522624573312de80b6eaa677216d562ed2f60f59bd31bdae80b5", "stage": "kernel.main", "target_ids": ["tensor.x"], "task_id": "paper-task", "workload_hash": "sha256:1366ba10ac5245ad764571e9f921b41a046f8f7b67aa27e9e2b0d475fbcd6435"}, "targets": {"implementation": "implementation.implementation", "stage": "kernel.main", "target": "tensor.x", "workload": "workload.workload"}, "template_hash": "sha256:eec8e2e49fa90290685f24038881b474a6a2e5e3747656e05f8269f19789f64a"}, {"action_id": "action.simplify_buffer_event_management", "actual_changes": [{"description": "CPU paper declaration: apply action.simplify_buffer_event_management within the existing parent freedom.", "intended_effect": "Reduce the specified source work; net performance unmeasured.", "limitations": ["未声称任意C++语义证明或性能收益"], "source_locator": "lines:1", "target_id": "tensor.x"}], "actual_parameters": {"tile": 64}, "instance_hash": "sha256:825560bcca592adba86da8b2b7691ac18d39cae4b29d764d3b5b5fc25b0b2b63", "instance_id": "action-instance.one.second", "optimization": {"entry_ids": ["implementation.pipeline-sync.vector-static-lease"], "mode": "CHANGE"}, "optimization_snapshots": [{"body": "# 普通Vector静态buffer租约与事件闭环\n\n## 对象与准入\n\n用于同核普通Vector的固定地址/固定槽布局，把反复动态分配、队列状态或事件领取管理改为初始化一次的TBuf或公共LocalTensor静态视图，并保留全部数据完成依赖。对象是管理表达，不是取消真实同步、跨核发布或把少queue/API当作速度证明。TQue、TBuf加事件与静态Tensor都可合法；按动态shape/feature、地址、存活、目标SDK与实际成本选择，不固定TQue优先。\n\n`LocalTensor<T>(TPosition::VECCALC, offsetBytes, sizeElements)`只构造视图，不替调用者分配/检查内存。先列 `[offsetBytes,offsetBytes+A(sizeElements*sizeof(T)))` 的全量租约表，包含所有输入/输出/临时区、ping/pong、padding和API workspace；核验同一物理存储区、地址单位、对齐、上界以及全部dtype/主尾/feature路径。复用区间必须由最后读完成→下次写开始连接；动态tile或分支无法证明时保留受管理方案。不能与TPipe分配器在同一地址域各自声称所有权。\n\n## 单槽到多槽的完整协议\n\n每个槽维护INPUT_FREE、INPUT_READY、OUTPUT_FREE、OUTPUT_READY四类逻辑边：\n\n| 边 | 源完成后发布 | 下一消费者等待 | 保证 |\n|---|---|---|---|\n| 输入可覆盖 | V_MTE2 | 下轮MTE2 | 上轮Vector已读完输入 |\n| 输入已就绪 | MTE2_V | 本轮Vector | DMA写入完成 |\n| 输出可覆盖 | MTE3_V | 下轮Vector | 上轮DMA已读完输出 |\n| 输出已就绪 | V_MTE3 | 本轮MTE3 | Vector写入完成 |\n\n首次使用输入/输出槽时，空闲token由初始化发布一次或用已证明的首轮免等分支；不对尚未产生的token Wait。每轮先等输入可覆盖、发CopyIn，再发布并等待输入就绪；等输出可覆盖后计算，计算结束发布输入可覆盖与输出就绪；搬出结束发布输出可覆盖。使用s=i%q独立事件对每槽记账；同一event/ID未被Wait消费前不得再次Set，不能用会丢代次的重复Set代替计数器。无任务路径不等待未发布事件；尾tile沿原合法DataCopyPad/有效长度与mask，不能直接套主块DataCopy。\n\n循环结束按“已发布且尚未消费的token”排空，不能按槽是否做过工作推断状态。若初始化为全部q槽各发布输入/输出空闲token，即使0个tile或只有1个tile，未用槽的初始化token也必须各Wait一次；已用槽最后的输入可覆盖与输出可覆盖token也须消费。若采用按需初始化或首轮免等，只排空真正发布且未消费的token，从未发布者不可Wait。完成所有最后读依赖、消费遗留token后才释放事件、返回或转交arena，确保重复调用不会对旧token再次Set。固定Add双缓冲源码用两个事件ID初始化空闲token、按奇偶选择槽、最后四次Wait完成回收；这是同核依赖例子，不是FA的跨AIC/AIV workspace槽协议。\n\n## API/平台与事件所有权\n\n固定LocalTensor构造表支持A2/A3的C++ Tensor范式；SetFlag/WaitFlag(ISASI)在A2/A3支持但不保证跨硬件版本兼容。HardEvent方向和ID必须完全配对，Set不阻塞源流水，Wait消费并清零标志。静态范式开发者管理ID，文档建议0–5，6/7暂不直接用；TPipe/TQue范式必须通过AllocEventID或FetchEventID取得，不能把静态ID硬塞进受管理事件池。与库算子混用时还须证明事件/地址不冲突；需要兼容抽象时按目标SDK评估TQueSync。跨核同步仍用原合法CrossCore协议，本配方不适用跨核slot发布。\n\n## 性能选择、验证与回退\n\n预算原动态管理次数、Scalar控制/地址工作与新增分支/初始化/收尾次数、真实UB分配、事件占用及失去的overlap。管理API减少只证明源码表达变化；编译器内联/消除、静态状态增加、保守等待和tile改变均可能抵消。可以整体比较保持同一数学、owner与完成关系的管理实现，再在有决策价值时做归因消融，不要求每次只改一行或一个因素。\n\n检查0/1/q−1/q/q+1/多轮tile、主尾、奇偶末轮、全部feature/dtype、重复调用、事件占用冲突、并发live区间和退出drain。CPU状态模拟只检验配对/租约，目标SDK编译、NPU异步行为与性能未验证；不能从样例收益推目标阈值。失败恢复原TQue/TBuf协议和独立区，再定位地址、首次token、代次与最后读完成。", "evidence_status": "mechanism_inference_from_reviewed_source_not_benchmarked", "id": "implementation.pipeline-sync.vector-static-lease", "kind": "recipe", "learning": {}, "parent": "implementation.pipeline-sync", "references": ["implementation.pipeline-sync.pipeline", "implementation.buffer-lifetime.reuse"], "schema_version": "aprof.knowledge-record/v1", "scope": {"dtypes": ["all"], "platforms": ["all"], "workloads": ["all"]}, "seed_reason": "固定五仓库来源审读；通用方法为条件化机制推导，未做目标硬件验证。", "source_hash": "sha256:9851adb8e9528306c2227f3ce49ddd9c255a35355d0