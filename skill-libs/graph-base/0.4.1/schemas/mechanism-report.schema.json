{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/mechanism-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_basis": {
      "enum": [
        "user",
        "heuristic",
        "manual",
        "measured"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "number"
          },
          "candidate": {
            "type": "number"
          },
          "expected_direction": {
            "enum": [
              "increase",
              "decrease"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "baseline_profile_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "candidate_profile_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "baseline",
          "candidate",
          "expected_direction",
          "unit",
          "baseline_profile_hash",
          "candidate_profile_hash"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "hypothesis_basis",
    "metrics"
  ]
}
