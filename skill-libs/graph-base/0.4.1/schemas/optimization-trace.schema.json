{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/optimization-trace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "validation"
          ]
        },
        "parent_attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_parent_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "session_id",
        "attempt_id",
        "candidate_id",
        "operator",
        "split",
        "parent_attempt_id",
        "source_parent_hash"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "graph_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill_manifest_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_source_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_source_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dependencies",
        "graph_hash",
        "skill_manifest_hash",
        "prompt_hash",
        "producer_hash",
        "harness_hash",
        "baseline_source_hash",
        "candidate_source_hash",
        "patch_hash"
      ]
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "content_hash",
              "purpose"
            ]
          }
        }
      },
      "required": [
        "manifest_hash",
        "loaded"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "shapes": {
          "type": "object"
        },
        "dtypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attributes": {
          "type": "object"
        },
        "accuracy_contract": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "manifest_hash",
        "case_ids",
        "shapes",
        "dtypes",
        "layouts",
        "attributes",
        "accuracy_contract",
        "hardware_fingerprint"
      ]
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessment_basis": {
          "enum": [
            "measured",
            "inferred",
            "heuristic",
            "manual"
          ]
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "contradicting_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "symptoms",
        "mechanisms",
        "assessment_basis",
        "supporting_evidence",
        "contradicting_evidence",
        "missing_evidence",
        "source_anchors"
      ]
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "producer_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "producer_hash"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "intent",
        "rationale",
        "expected_effects",
        "handler",
        "parameters",
        "alternatives"
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "graph",
            "exploration"
          ]
        },
        "route": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "graph_version": {
                  "type": "string",
                  "minLength": 1
                },
                "policy_version": {
                  "type": "string",
                  "minLength": 1
                },
                "selected_edge_id": {
                  "type": "string",
                  "minLength": 1
                },
                "behavior_probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "selection_mode": {
                  "enum": [
                    "argmax",
                    "sample"
                  ]
                },
                "selection_seed": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "selected_mechanism_id": {
                  "type": "string",
                  "minLength": 1
                },
                "mechanism_derivation": {
                  "const": "fixed_supports_refutes_tri_state_v1"
                },
                "mechanism_scores": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "edge_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "logit": {
                        "type": "number"
                      },
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "allowed": {
                        "type": "boolean"
                      },
                      "mask_reasons": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "edge_id",
                      "source_id",
                      "target_id",
                      "logit",
                      "probability",
                      "allowed",
                      "mask_reasons"
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "graph_version",
                "policy_version",
                "selected_edge_id",
                "behavior_probability",
                "selection_mode",
                "selection_seed",
                "selected_mechanism_id",
                "mechanism_derivation",
                "mechanism_scores",
                "candidates"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_gap": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "route",
        "coverage_gap"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "correctness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "interrupted"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "reason",
            "artifact_refs"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "timing_case_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "static_review",
        "build",
        "correctness",
        "runtime",
        "timing",
        "profile",
        "case_count",
        "passed_count",
        "timing_case_ids"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "minLength": 1
        },
        "first_failed_stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "speedup": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "speedup_lcb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_regression": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "machine_outcome_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "exploration_outcome_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "graph_policy_eligible": {
          "type": "boolean"
        },
        "attempt_evidence_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verdict",
        "first_failed_stage",
        "speedup",
        "speedup_lcb",
        "max_regression",
        "machine_outcome_ref",
        "episode_ref",
        "exploration_outcome_ref",
        "graph_policy_eligible",
        "attempt_evidence_hash"
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "refuted",
            "inconclusive"
          ]
        },
        "effective_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ineffective_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "effective_conditions",
        "ineffective_conditions",
        "counterexamples",
        "limitations",
        "next_step",
        "evidence_refs"
      ]
    },
    "null_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "identity",
    "provenance",
    "knowledge",
    "workload",
    "diagnosis",
    "intervention",
    "routing",
    "validation",
    "result",
    "lesson",
    "null_reasons"
  ]
}
