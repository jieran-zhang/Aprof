{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aprof:diagnosis-region",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "aprof.diagnosis-region/v1"
    },
    "owner": {
      "const": "diagnosis"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{4}$"
    }
  },
  "required": [
    "schema_version",
    "owner",
    "version"
  ],
  "additionalProperties": false
}
