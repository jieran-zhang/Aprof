{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/unified-timing-declaration-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "correctness_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "reuse_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_ab_gap_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_age_seconds",
        "max_ab_gap_seconds"
      ]
    },
    "stability_policy": {
      "const": "bounded_outlier_v2"
    },
    "baseline_trust": {
      "type": "object",
      "required": [
        "status",
        "source_sha256",
        "binary_sha256",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assumed"
        },
        "basis": {
          "const": "user_provided_baseline"
        },
        "source_sha256": {
          "type": "string"
        },
        "binary_sha256": {
          "type": "string"
        }
      }
    },
    "stability_protocol": {
      "const": "median_stability_exploration_v2"
    },
    "replication_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retests": {
          "type": "integer",
          "minimum": 0
        },
        "estimator": {
          "const": "last_executed_window"
        }
      },
      "required": [
        "max_retests",
        "estimator"
      ]
    }
  },
  "required": [
    "schema_version",
    "operator",
    "created_at",
    "case_ids",
    "correctness_case_ids",
    "reuse_policy",
    "stability_policy",
    "stability_protocol",
    "replication_policy"
  ]
}
