{
  "$id": "https://aprof.local/schemas/dispatch-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture_profile_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "dispatch_id": {
      "minLength": 1,
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "pattern": "^(dtype|layout|numel|shape\\.[0-9]+|attributes\\.[A-Za-z][A-Za-z0-9_]*)$",
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "le",
                    "gt",
                    "ge",
                    "in"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    {
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  ]
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "group_id": {
            "minLength": 1,
            "type": "string"
          },
          "kernel_entry": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "required_capabilities": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "tiling_key": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "group_id",
          "tiling_key",
          "kernel_entry",
          "conditions",
          "required_capabilities"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fallback": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "pattern": "^(dtype|layout|numel|shape\\.[0-9]+|attributes\\.[A-Za-z][A-Za-z0-9_]*)$",
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "le",
                  "gt",
                  "ge",
                  "in"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                ]
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "group_id": {
          "minLength": 1,
          "type": "string"
        },
        "kernel_entry": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "tiling_key": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "tiling_key",
        "kernel_entry",
        "conditions",
        "required_capabilities"
      ],
      "type": "object"
    },
    "implementation_source_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "operator": {
      "minLength": 1,
      "type": "string"
    },
    "parallel_plan_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_basis_source_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dispatch_id",
    "operator",
    "source_hash",
    "architecture_profile_ref",
    "parallel_plan_ref",
    "entries",
    "fallback"
  ],
  "type": "object"
}
