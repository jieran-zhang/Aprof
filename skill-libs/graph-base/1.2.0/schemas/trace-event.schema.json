{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprof.local/schemas/trace-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "task_started",
        "knowledge_loaded",
        "baseline_validated",
        "profile_collected",
        "diagnosis_recorded",
        "candidate_proposed",
        "stage_completed",
        "next_step_decided",
        "attempt_finished",
        "task_finished",
        "execution_interrupted"
      ]
    },
    "payload": {},
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "task_id",
    "session_id",
    "attempt_id",
    "candidate_id",
    "sequence",
    "timestamp",
    "event_type",
    "payload",
    "artifact_refs",
    "previous_event_hash",
    "event_hash"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task_started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operator": {
                "type": "string",
                "minLength": 1
              },
              "split": {
                "enum": [
                  "train",
                  "validation"
                ]
              },
              "knowledge_manifest_hash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "baseline_source_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "candidate_limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "build_limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "timing_limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "full_profile_limit": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "candidate_limit",
                  "build_limit",
                  "timing_limit",
                  "full_profile_limit"
                ]
              }
            },
            "required": [
              "operator",
              "split",
              "knowledge_manifest_hash",
              "baseline_source_hash",
              "budget"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "knowledge_loaded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "content_hash",
                    "purpose"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "entries"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "baseline_validated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "interrupted"
                ]
              },
              "case_count": {
                "type": "integer",
                "minimum": 0
              },
              "passed_count": {
                "type": "integer",
                "minimum": 0
              },
              "execution": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "argv": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "cwd": {
                        "type": "string",
                        "minLength": 1
                      },
                      "host": {
                        "type": "string",
                        "minLength": 1
                      },
                      "device": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "finished_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "exit_status": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "log_ref": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reason": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "argv",
                      "cwd",
                      "host",
                      "device",
                      "started_at",
                      "finished_at",
                      "exit_status",
                      "log_ref",
                      "reason"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "case_count",
              "passed_count",
              "execution",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "profile_collected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "interrupted"
                ]
              },
              "profile_hash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "device": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "started_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "finished_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "exit_status": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "log_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "argv",
                  "cwd",
                  "host",
                  "device",
                  "started_at",
                  "finished_at",
                  "exit_status",
                  "log_ref",
                  "reason"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stage",
              "status",
              "profile_hash",
              "execution",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "diagnosis_recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symptoms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mechanisms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assessment_basis": {
                "enum": [
                  "measured",
                  "inferred",
                  "heuristic",
                  "manual"
                ]
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "uniqueItems": true
              },
              "contradicting_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "uniqueItems": true
              },
              "missing_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "symptoms",
              "mechanisms",
              "assessment_basis",
              "supporting_evidence",
              "contradicting_evidence",
              "missing_evidence",
              "source_anchors"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "candidate_proposed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "graph",
                  "exploration"
                ]
              },
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "source_parent_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "patch_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "handler_id": {
                "type": "string",
                "minLength": 1
              },
              "handler_version": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object"
              },
              "expected_effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "coverage_gap": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "mode",
              "hypothesis",
              "source_parent_hash",
              "patch_hash",
              "handler_id",
              "handler_version",
              "parameters",
              "expected_effects",
              "alternatives",
              "coverage_gap"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "stage_completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "interrupted"
                ]
              },
              "execution": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "argv": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "cwd": {
                        "type": "string",
                        "minLength": 1
                      },
                      "host": {
                        "type": "string",
                        "minLength": 1
                      },
                      "device": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "finished_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "exit_status": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "log_ref": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reason": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "argv",
                      "cwd",
                      "host",
                      "device",
                      "started_at",
                      "finished_at",
                      "exit_status",
                      "log_ref",
                      "reason"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "stage",
              "status",
              "execution",
              "reason",
              "artifact_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "next_step_decided"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "action",
              "reason",
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "attempt_finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "type": "string",
                "minLength": 1
              },
              "summary_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "verdict",
              "summary_ref",
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task_finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "blocked",
                  "interrupted"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "attempt_count": {
                "type": "integer",
                "minimum": 0
              },
              "summary_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "reason",
              "attempt_count",
              "summary_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "execution_interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "execution": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "argv": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "cwd": {
                        "type": "string",
                        "minLength": 1
                      },
                      "host": {
                        "type": "string",
                        "minLength": 1
                      },
                      "device": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "finished_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "exit_status": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "log_ref": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reason": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "argv",
                      "cwd",
                      "host",
                      "device",
                      "started_at",
                      "finished_at",
                      "exit_status",
                      "log_ref",
                      "reason"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stage",
              "reason",
              "execution"
            ]
          }
        }
      }
    }
  ]
}
