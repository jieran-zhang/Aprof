#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "dynamic_quant_tiling.h"
#include "data_utils.h"
#include "../op_kernel/dynamic_quant_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &text) {
    std::vector<uint64_t> shape; std::stringstream stream(text); std::string token;
    while (std::getline(stream, token, ',')) shape.push_back(std::stoull(token));
    return shape;
}
uint64_t Numel(const std::vector<uint64_t> &shape) {
    uint64_t n = 1; for (uint64_t dim : shape) n *= dim; return n;
}
uint32_t DType(const std::string &name) {
    if (name == "float16") return DYNAMIC_QUANT_FLOAT16;
    if (name == "bfloat16") return DYNAMIC_QUANT_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + name);
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: dynamic_quant --shape DIMS --dtype float16|bfloat16 --input FILE --y FILE --scale FILE [--device N]\n";
        return 2;
    }
    int device = 0; aclrtStream stream = nullptr;
    void *hostX = nullptr, *hostY = nullptr, *hostScale = nullptr;
    void *devX = nullptr, *devY = nullptr, *devScale = nullptr, *devTiling = nullptr;
    try {
        const auto shape = Shape(Arg(argc, argv, "--shape"));
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype"));
        const uint64_t numel = Numel(shape);
        const size_t xBytes = numel * 2, yBytes = numel;
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeDynamicQuantTiling(shape, dtype, cores);
        const size_t scaleBytes = tiling.tokenCount * sizeof(float);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostX, xBytes), "aclrtMallocHost x");
        Check(aclrtMallocHost(&hostY, yBytes), "aclrtMallocHost y");
        Check(aclrtMallocHost(&hostScale, scaleBytes), "aclrtMallocHost scale");
        Check(aclrtMalloc(&devX, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
        Check(aclrtMalloc(&devY, yBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
        Check(aclrtMalloc(&devScale, scaleBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc scale");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--input"), hostX, xBytes)) throw std::runtime_error("read input failed");
        Check(aclrtMemcpy(devX, xBytes, hostX, xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        const auto start = std::chrono::steady_clock::now();
        dynamic_quant_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devX), static_cast<uint8_t *>(devY),
            static_cast<uint8_t *>(devScale), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        const auto stop = std::chrono::steady_clock::now();
        Check(aclrtMemcpy(hostY, yBytes, devY, yBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H y");
        Check(aclrtMemcpy(hostScale, scaleBytes, devScale, scaleBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H scale");
        if (!WriteFile(Arg(argc, argv, "--y"), hostY, yBytes)) throw std::runtime_error("write y failed");
        if (!WriteFile(Arg(argc, argv, "--scale"), hostScale, scaleBytes)) throw std::runtime_error("write scale failed");
        const double ms = std::chrono::duration<double, std::milli>(stop - start).count();
        std::cout << "dynamic_quant_kernel completed: tokens=" << tiling.tokenCount
                  << " row=" << tiling.rowLength << " blocks=" << tiling.blockNum
                  << " elapsed_ms=" << ms << "\n";
        aclrtFree(devTiling); aclrtFree(devScale); aclrtFree(devY); aclrtFree(devX);
        aclrtFreeHost(hostScale); aclrtFreeHost(hostY); aclrtFreeHost(hostX);
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return 0;
    } catch (const std::exception &error) {
        std::cerr << "dynamic_quant failed: " << error.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devScale) aclrtFree(devScale);
        if (devY) aclrtFree(devY); if (devX) aclrtFree(devX);
        if (hostScale) aclrtFreeHost(hostScale); if (hostY) aclrtFreeHost(hostY); if (hostX) aclrtFreeHost(hostX);
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return 1;
    }
}
