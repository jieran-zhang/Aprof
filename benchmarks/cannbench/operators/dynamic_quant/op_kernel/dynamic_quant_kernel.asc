#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "dynamic_quant_tiling.h"

template <typename T>
class KernelDynamicQuant {
public:
    static constexpr uint32_t kMaxRow = 16384;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR scale,
                                const __gm__ DynamicQuantTilingData *tiling) {
        t_ = tiling;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(y));
        scale_ = reinterpret_cast<__gm__ float *>(scale);
        pipe_.InitBuffer(inputQ_, 1, kMaxRow * sizeof(T));
        pipe_.InitBuffer(outputQ_, 1, kMaxRow * sizeof(int8_t));
        pipe_.InitBuffer(floatBuf_, kMaxRow * sizeof(float));
        pipe_.InitBuffer(reduceWorkBuf_, 4096);
        pipe_.InitBuffer(reduceOutBuf_, 32);
        pipe_.InitBuffer(nanMaskBuf_, 2048);
    }

    __aicore__ inline void Process() {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        uint64_t end = begin + t_->blockLength;
        if (end > t_->tokenCount) end = t_->tokenCount;
        for (uint64_t token = begin; token < end; ++token) ProcessToken(token);
    }

private:
    __aicore__ inline void ProcessToken(uint64_t token) {
        const uint32_t count = static_cast<uint32_t>(t_->rowLength);
        const uint32_t alignedCount = ((count + 63U) / 64U) * 64U;
        const uint64_t offset = token * t_->rowLength;
        auto raw = inputQ_.AllocTensor<T>();
        AscendC::DataCopyExtParams copyIn{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, 0};
        AscendC::DataCopyPad(raw, x_[offset], copyIn, pad);
        inputQ_.EnQue(raw);
        raw = inputQ_.DeQue<T>();

        auto values = floatBuf_.Get<float>();
        AscendC::Duplicate(values, 0.0f, alignedCount);
        AscendC::Cast(values, raw, AscendC::RoundMode::CAST_NONE, count);

        // torch.max(abs(x)) propagates NaN. Scan the packed comparison mask so
        // this remains explicit instead of depending on vcmax NaN behavior.
        auto nanMask = nanMaskBuf_.Get<uint8_t>();
        AscendC::Compare(nanMask, values, values, AscendC::CMPMODE::NE, alignedCount);
        int32_t eventVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
        AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVToS);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVToS);
        bool hasNan = false;
        float nanValue = 0.0f;
        const uint32_t maskBytes = (count + 7U) / 8U;
        for (uint32_t byteIndex = 0; byteIndex < maskBytes && !hasNan; ++byteIndex) {
            const uint8_t bits = nanMask.GetValue(byteIndex);
            if (bits != 0) {
                uint32_t bit = 0;
                while (((bits >> bit) & 1U) == 0U) ++bit;
                nanValue = values.GetValue(byteIndex * 8U + bit);
                hasNan = true;
            }
        }

        float absMax;
        if (hasNan) {
            absMax = nanValue;
        } else {
            AscendC::Abs(values, values, count);
            auto reduced = reduceOutBuf_.Get<float>();
            auto work = reduceWorkBuf_.Get<float>();
            AscendC::ReduceMax(reduced, values, work, static_cast<int32_t>(count), false);
            eventVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
            AscendC::SetFlag<AscendC::HardEvent::V_S>(eventVToS);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventVToS);
            absMax = reduced.GetValue(0);
        }
        float clamped = absMax;
        if (!hasNan && clamped < 1.0e-12f) clamped = 1.0e-12f;
        const float scaleValue = clamped / 127.0f;
        scale_[token] = scaleValue;

        // Restore the signed input and quantize. AscendQuant implements
        // half-to-even rounding and saturating int8 conversion. It internally
        // uses the documented FP16 quantization path, for which the task allows
        // an absolute output difference of one.
        AscendC::Duplicate(values, 0.0f, alignedCount);
        AscendC::Cast(values, raw, AscendC::RoundMode::CAST_NONE, count);
        const float inverseScale = 127.0f / clamped;
        auto out = outputQ_.AllocTensor<int8_t>();
        AscendC::AscendQuant<float>(out, values, inverseScale, 0.0f, alignedCount);
        outputQ_.EnQue(out);
        out = outputQ_.DeQue<int8_t>();
        AscendC::DataCopyExtParams copyOut{1, count, 0, 0, 0};
        AscendC::DataCopyPad(y_[offset], out, copyOut);
        outputQ_.FreeTensor(out);
        inputQ_.FreeTensor(raw);
    }

    AscendC::TPipe pipe_;
    const __gm__ DynamicQuantTilingData *t_;
    AscendC::GlobalTensor<T> x_;
    AscendC::GlobalTensor<int8_t> y_;
    __gm__ float *scale_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatBuf_, reduceWorkBuf_, reduceOutBuf_, nanMaskBuf_;
};

extern "C" __global__ __aicore__ __vector__ void dynamic_quant_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR scale, GM_ADDR tilingAddr) {
    const __gm__ DynamicQuantTilingData *tiling =
        reinterpret_cast<const __gm__ DynamicQuantTilingData *>(tilingAddr);
    if (tiling->dtype == DYNAMIC_QUANT_FLOAT16) {
        KernelDynamicQuant<half> op; op.Init(x, y, scale, tiling); op.Process();
    } else {
        KernelDynamicQuant<bfloat16_t> op; op.Init(x, y, scale, tiling); op.Process();
    }
}
