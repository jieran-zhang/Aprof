#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/weight_quant_batch_matmul_kernel.asc"
namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
AscendC::tiling::TCubeTiling MakeTiling(int m,int n,int k,bool bf16){
 matmul_tiling::PlatformInfo platform{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};matmul_tiling::MatmulApiTiling api(platform);using matmul_tiling::TPosition;using matmul_tiling::CubeFormat;using matmul_tiling::DataType;auto dt=bf16?DataType::DT_BF16:DataType::DT_FLOAT16;
 if(api.SetAType(TPosition::GM,CubeFormat::ND,dt,false)||api.SetBType(TPosition::GM,CubeFormat::ND,dt,false)||api.SetCType(TPosition::GM,CubeFormat::ND,DataType::DT_FLOAT)||api.SetBiasType(TPosition::GM,CubeFormat::ND,DataType::DT_FLOAT)||api.SetShape(m,n,k)||api.SetOrgShape(m,n,k)||api.SetBias(false)||api.SetFixSplit(-1,-1,std::min(k,256)))throw std::runtime_error("matmul tiling setup failed");AscendC::tiling::TCubeTiling t{};if(api.GetTiling(t))throw std::runtime_error("matmul GetTiling failed");return t;
}
struct Buf{void*h=nullptr,*d=nullptr;size_t n=0;};
}
int main(int argc,char**argv){bool init=false,selected=false;int dev=0;aclrtStream stream=nullptr;std::vector<Buf> bufs;
 try{uint32_t m=std::stoul(Arg(argc,argv,"--m")),k=std::stoul(Arg(argc,argv,"--k")),n=std::stoul(Arg(argc,argv,"--n"));std::string dtype=Arg(argc,argv,"--dtype"),op=Arg(argc,argv,"--offset","-"),bp=Arg(argc,argv,"--bias","-");bool bf16=dtype=="bfloat16",ho=op!="-",hb=bp!="-";if(dtype!="float16"&&!bf16)throw std::invalid_argument("dtype");
  uint64_t xc=uint64_t(m)*k,wc=uint64_t(k)*n,yc=uint64_t(m)*n;auto add=[&](size_t bytes,const std::string&path,bool input){Buf z;z.n=std::max<size_t>(bytes,1);Check(aclrtMallocHost(&z.h,z.n),"host malloc");Check(aclrtMalloc(&z.d,z.n,ACL_MEM_MALLOC_HUGE_FIRST),"device malloc");if(input){if(!ReadFile(path,z.h,bytes))throw std::runtime_error("read "+path);Check(aclrtMemcpy(z.d,z.n,z.h,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}bufs.push_back(z);return bufs.size()-1;};
  dev=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"set device");selected=true;Check(aclrtCreateStream(&stream),"stream");uint32_t blocks=1,logical=1;
  auto ix=add(xc*2,Arg(argc,argv,"--x"),true),iw=add(wc,Arg(argc,argv,"--weight"),true),is=add(n*2,Arg(argc,argv,"--scale"),true),io=add(ho?n*2:1,op,ho),ib=add(hb?n*(bf16?4:2):1,bp,hb),idq=add(wc*2,"",false),imat=add(yc*4,"",false),iy=add(yc*2,"",false),it=add(sizeof(AscendC::tiling::TCubeTiling),"",false);
  auto tile=MakeTiling(m,n,k,bf16);Check(aclrtMemcpy(bufs[it].d,bufs[it].n,&tile,sizeof(tile),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");if(bf16)wq_dequant_bf16<<<blocks,nullptr,stream>>>((uint8_t*)bufs[iw].d,(uint8_t*)bufs[is].d,(uint8_t*)bufs[io].d,(uint8_t*)bufs[idq].d,wc,n,ho,logical);else wq_dequant_fp16<<<blocks,nullptr,stream>>>((uint8_t*)bufs[iw].d,(uint8_t*)bufs[is].d,(uint8_t*)bufs[io].d,(uint8_t*)bufs[idq].d,wc,n,ho,logical);Check(aclrtSynchronizeStream(stream),"dequant sync");
  std::string dumpDq=Arg(argc,argv,"--dump-dq");if(!dumpDq.empty()){Check(aclrtMemcpy(bufs[idq].h,bufs[idq].n,bufs[idq].d,wc*2,ACL_MEMCPY_DEVICE_TO_HOST),"D2H dq");if(!WriteFile(dumpDq,bufs[idq].h,wc*2))throw std::runtime_error("write dq");}
  if(bf16)wq_matmul_bf16<<<tile.usedCoreNum,nullptr,stream>>>((uint8_t*)bufs[ix].d,(uint8_t*)bufs[idq].d,(uint8_t*)bufs[imat].d,(uint8_t*)bufs[it].d);else wq_matmul_fp16<<<tile.usedCoreNum,nullptr,stream>>>((uint8_t*)bufs[ix].d,(uint8_t*)bufs[idq].d,(uint8_t*)bufs[imat].d,(uint8_t*)bufs[it].d);Check(aclrtSynchronizeStream(stream),"matmul sync");
  if(bf16)wq_post_bf16<<<blocks,nullptr,stream>>>((uint8_t*)bufs[ix].d,(uint8_t*)bufs[idq].d,(uint8_t*)bufs[imat].d,(uint8_t*)bufs[ib].d,(uint8_t*)bufs[iy].d,yc,k,n,hb,logical);else wq_post_fp16<<<blocks,nullptr,stream>>>((uint8_t*)bufs[ix].d,(uint8_t*)bufs[idq].d,(uint8_t*)bufs[imat].d,(uint8_t*)bufs[ib].d,(uint8_t*)bufs[iy].d,yc,k,n,hb,logical);Check(aclrtSynchronizeStream(stream),"post sync");Check(aclrtMemcpy(bufs[iy].h,bufs[iy].n,bufs[iy].d,yc*2,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");if(!WriteFile(Arg(argc,argv,"--output"),bufs[iy].h,yc*2))throw std::runtime_error("write output");std::cout<<"weight_quant_batch_matmul completed M="<<m<<" K="<<k<<" N="<<n<<" dtype="<<dtype<<" cube_cores="<<tile.usedCoreNum<<"\n";
  for(auto&z:bufs){if(z.d)aclrtFree(z.d);if(z.h)aclrtFreeHost(z.h);}aclrtDestroyStream(stream);aclrtResetDevice(dev);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"weight_quant_batch_matmul failed: "<<e.what()<<"\n";for(auto&z:bufs){if(z.d)aclrtFree(z.d);if(z.h)aclrtFreeHost(z.h);}if(stream)aclrtDestroyStream(stream);if(selected)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
