#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "group_norm_tiling.h"
#include "../op_kernel/group_norm_kernel.asc"
namespace{void C(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+": "+std::to_string(r));}std::string A(int c,char**v,const std::string&n,const std::string&d=""){for(int i=1;i+1<c;++i)if(v[i]==n)return v[i+1];return d;}std::vector<uint64_t>S(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string z;while(std::getline(q,z,','))o.push_back(std::stoull(z));return o;}uint32_t D(const std::string&s){if(s=="float16")return GN_FLOAT16;if(s=="float32")return GN_FLOAT32;if(s=="bfloat16")return GN_BFLOAT16;throw std::invalid_argument("dtype");}size_t I(uint32_t d){return d==GN_FLOAT32?4:2;}}
int main(int ac,char**av){int dev=0;aclrtStream st=nullptr;void *hx=nullptr,*hg=nullptr,*hb=nullptr,*hy=nullptr,*dx=nullptr,*dg=nullptr,*db=nullptr,*dy=nullptr,*dt=nullptr;bool ai=false,ds=false;try{auto sh=S(A(ac,av,"--shape"));auto d=D(A(ac,av,"--dtype"));auto t=ComputeGroupNormTiling(sh,std::stoul(A(ac,av,"--groups")),d,std::stof(A(ac,av,"--epsilon")));size_t xb=t.totalLength*I(d),pb=t.C*I(d);dev=std::stoi(A(ac,av,"--device","0"));C(aclInit(nullptr),"init");ai=true;C(aclrtSetDevice(dev),"device");ds=true;C(aclrtCreateStream(&st),"stream");C(aclrtMallocHost(&hx,xb),"hx");C(aclrtMallocHost(&hg,pb),"hg");C(aclrtMallocHost(&hb,pb),"hb");C(aclrtMallocHost(&hy,xb),"hy");C(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dx");C(aclrtMalloc(&dg,pb,ACL_MEM_MALLOC_HUGE_FIRST),"dg");C(aclrtMalloc(&db,pb,ACL_MEM_MALLOC_HUGE_FIRST),"db");C(aclrtMalloc(&dy,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dy");C(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dt");if(!ReadFile(A(ac,av,"--x"),hx,xb)||!ReadFile(A(ac,av,"--gamma"),hg,pb)||!ReadFile(A(ac,av,"--beta"),hb,pb))throw std::runtime_error("read");C(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"x");C(aclrtMemcpy(dg,pb,hg,pb,ACL_MEMCPY_HOST_TO_DEVICE),"g");C(aclrtMemcpy(db,pb,hb,pb,ACL_MEMCPY_HOST_TO_DEVICE),"b");C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"t");group_norm_kernel<<<t.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dg),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));C(aclrtSynchronizeStream(st),"kernel");C(aclrtMemcpy(hy,xb,dy,xb,ACL_MEMCPY_DEVICE_TO_HOST),"out");if(!WriteFile(A(ac,av,"--output"),hy,xb))throw std::runtime_error("write");std::cout<<"group_norm completed numel="<<t.totalLength<<" groups="<<t.groupCount<<" group_elements="<<t.groupElements<<"\n";aclrtFree(dt);aclrtFree(dy);aclrtFree(db);aclrtFree(dg);aclrtFree(dx);aclrtFreeHost(hy);aclrtFreeHost(hb);aclrtFreeHost(hg);aclrtFreeHost(hx);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&e){std::cerr<<"group_norm failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dy)aclrtFree(dy);if(db)aclrtFree(db);if(dg)aclrtFree(dg);if(dx)aclrtFree(dx);if(hy)aclrtFreeHost(hy);if(hb)aclrtFreeHost(hb);if(hg)aclrtFreeHost(hg);if(hx)aclrtFreeHost(hx);if(st)aclrtDestroyStream(st);if(ds)aclrtResetDevice(dev);if(ai)aclFinalize();return 1;}}
