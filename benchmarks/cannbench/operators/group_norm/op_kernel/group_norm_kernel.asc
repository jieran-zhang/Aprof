#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "group_norm_tiling.h"
__aicore__ inline float GnHalf(half v){uint16_t h=*reinterpret_cast<uint16_t*>(&v);uint32_t s=static_cast<uint32_t>(h&0x8000U)<<16,e=(h>>10)&31,m=h&1023,b=s;if(e==31){b|=0x7f800000U|(m<<13);if(m)b|=0x400000U;}else if(e)b|=((e+112)<<23)|(m<<13);else if(m){int x=-14;while(!(m&1024)){m<<=1;--x;}m&=1023;b|=(static_cast<uint32_t>(x+127)<<23)|(m<<13);}return *reinterpret_cast<float*>(&b);}
__aicore__ inline float GnBf(bfloat16_t v){uint16_t h=*reinterpret_cast<uint16_t*>(&v);uint32_t b=static_cast<uint32_t>(h)<<16;return *reinterpret_cast<float*>(&b);}
template<typename T>__aicore__ inline float GnFloat(T v){return static_cast<float>(v);}template<>__aicore__ inline float GnFloat<half>(half v){return GnHalf(v);}template<>__aicore__ inline float GnFloat<bfloat16_t>(bfloat16_t v){return GnBf(v);}
template<typename T>class KernelGroupNorm{public:
 __aicore__ inline void Init(GM_ADDR x,GM_ADDR gamma,GM_ADDR beta,GM_ADDR y,const __gm__ GroupNormTilingData*t){t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x),t->totalLength);g_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma),t->C);b_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(beta),t->C);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y),t->totalLength);uint32_t raw=t->tileElements*sizeof(T),fp=t->tileElements*sizeof(float);pipe_.InitBuffer(xQ_,1,raw);pipe_.InitBuffer(yQ_,1,raw);pipe_.InitBuffer(xFpBuf_,fp);pipe_.InitBuffer(yFpBuf_,fp);pipe_.InitBuffer(reduceBuf_,fp);pipe_.InitBuffer(sumBuf_,64);pipe_.InitBuffer(scalarBuf_,32);pipe_.InitBuffer(invBuf_,32);}
 __aicore__ inline void Process(){for(uint64_t q=AscendC::GetBlockIdx();q<t_->groupCount;q+=t_->blockNum)One(q);}
private:
 __aicore__ inline void One(uint64_t q){uint64_t base=q*t_->groupElements;float total=0,totalSq=0;auto reduced=sumBuf_.Get<float>();auto scratch=reduceBuf_.Get<float>();
  for(uint64_t off=0;off<t_->groupElements;off+=t_->tileElements){uint32_t n=static_cast<uint32_t>(t_->groupElements-off<t_->tileElements?t_->groupElements-off:t_->tileElements);auto xr=xQ_.AllocTensor<T>();AscendC::DataCopyExtParams cp{1,n*static_cast<uint32_t>(sizeof(T)),0,0,0};AscendC::DataCopyPad(xr,x_[base+off],cp,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});xQ_.EnQue(xr);xr=xQ_.DeQue<T>();auto xf=xFpBuf_.Get<float>();auto sq=yFpBuf_.Get<float>();if constexpr(std::is_same<T,float>::value){auto raw=xr.template ReinterpretCast<float>();AscendC::Adds(xf,raw,0.0f,n);AscendC::PipeBarrier<PIPE_V>();}else{AscendC::Cast(xf,xr,AscendC::RoundMode::CAST_NONE,n);AscendC::PipeBarrier<PIPE_V>();}AscendC::ReduceSum<float>(reduced,xf,scratch,n);AscendC::PipeBarrier<PIPE_V>();total+=reduced.GetValue(0);AscendC::Mul(sq,xf,xf,n);AscendC::PipeBarrier<PIPE_V>();AscendC::ReduceSum<float>(reduced,sq,scratch,n);AscendC::PipeBarrier<PIPE_V>();totalSq+=reduced.GetValue(0);xQ_.FreeTensor(xr);}
  float mean=total*t_->invGroupElements;float variance=totalSq*t_->invGroupElements-mean*mean;if(variance<0)variance=0;float ve=variance+t_->epsilon;auto s=scalarBuf_.Get<float>();auto inv=invBuf_.Get<float>();s.SetValue(0,ve);AscendC::PipeBarrier<PIPE_ALL>();AscendC::Rsqrt(inv,s,1);AscendC::PipeBarrier<PIPE_ALL>();float r=inv.GetValue(0);r=r*(1.5f-0.5f*ve*r*r);r=r*(1.5f-0.5f*ve*r*r);uint32_t group=static_cast<uint32_t>(q%t_->numGroups);
  for(uint64_t off=0;off<t_->groupElements;off+=t_->tileElements){uint32_t n=static_cast<uint32_t>(t_->groupElements-off<t_->tileElements?t_->groupElements-off:t_->tileElements);auto xr=xQ_.AllocTensor<T>();AscendC::DataCopyExtParams cp{1,n*static_cast<uint32_t>(sizeof(T)),0,0,0};AscendC::DataCopyPad(xr,x_[base+off],cp,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});xQ_.EnQue(xr);xr=xQ_.DeQue<T>();auto yr=yQ_.AllocTensor<T>();auto xf=xFpBuf_.Get<float>();auto yf=yFpBuf_.Get<float>();if constexpr(std::is_same<T,float>::value){auto raw=xr.template ReinterpretCast<float>();AscendC::Adds(xf,raw,0.0f,n);AscendC::PipeBarrier<PIPE_V>();}else{AscendC::Cast(xf,xr,AscendC::RoundMode::CAST_NONE,n);AscendC::PipeBarrier<PIPE_V>();}uint32_t i=0;while(i<n){uint64_t p=off+i;uint32_t ch=group*t_->channelsPerGroup+static_cast<uint32_t>(p/t_->spatial);uint32_t inChannel=static_cast<uint32_t>(p%t_->spatial);uint32_t segment=static_cast<uint32_t>(t_->spatial-inChannel);if(segment>n-i)segment=n-i;uint32_t end=i+segment;float ga=GnFloat<T>(g_.GetValue(ch)),be=GnFloat<T>(b_.GetValue(ch));float scale=r*ga,bias=be-mean*scale;while(i<end&&(i&7U)){yf.SetValue(i,xf.GetValue(i)*scale+bias);++i;}uint32_t vectorCount=((end-i)/8U)*8U;if(vectorCount){AscendC::Muls(yf[i],xf[i],scale,vectorCount);AscendC::PipeBarrier<PIPE_V>();AscendC::Adds(yf[i],yf[i],bias,vectorCount);AscendC::PipeBarrier<PIPE_V>();i+=vectorCount;}while(i<end){yf.SetValue(i,xf.GetValue(i)*scale+bias);++i;}}AscendC::PipeBarrier<PIPE_ALL>();if constexpr(std::is_same<T,float>::value){auto rawOut=yr.template ReinterpretCast<float>();AscendC::Adds(rawOut,yf,0.0f,n);AscendC::PipeBarrier<PIPE_V>();}else{constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(yr,yf,mode,n);AscendC::PipeBarrier<PIPE_V>();}yQ_.EnQue(yr);xQ_.FreeTensor(xr);yr=yQ_.DeQue<T>();AscendC::DataCopyPad(y_[base+off],yr,cp);yQ_.FreeTensor(yr);}}
 const __gm__ GroupNormTilingData*t_;AscendC::TPipe pipe_;AscendC::GlobalTensor<T>x_,g_,b_,y_;AscendC::TQue<AscendC::TPosition::VECIN,1>xQ_;AscendC::TQue<AscendC::TPosition::VECOUT,1>yQ_;AscendC::TBuf<AscendC::TPosition::VECCALC>xFpBuf_,yFpBuf_,reduceBuf_,sumBuf_,scalarBuf_,invBuf_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void group_norm_kernel(GM_ADDR x,GM_ADDR g,GM_ADDR b,GM_ADDR y,GM_ADDR taddr){const __gm__ GroupNormTilingData*t=reinterpret_cast<const __gm__ GroupNormTilingData*>(taddr);if(t->dtype==GN_FLOAT16){KernelGroupNorm<half>o;o.Init(x,g,b,y,t);o.Process();}else if(t->dtype==GN_FLOAT32){KernelGroupNorm<float>o;o.Init(x,g,b,y,t);o.Process();}else{KernelGroupNorm<bfloat16_t>o;o.Init(x,g,b,y,t);o.Process();}}
