#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
using namespace AscendC;
using namespace matmul;

__aicore__ inline float MhaBfToFloat(bfloat16_t v){uint32_t b=uint32_t(*reinterpret_cast<uint16_t*>(&v))<<16;return *reinterpret_cast<float*>(&b);}

struct MhaTiling { uint64_t B,S,Skv,Nq,Nkv,D,G,rows,totalQ,totalKV,totalScores; uint32_t blocks,dtype,causal; float scale; };

template<class T> __aicore__ inline void ReorderImpl(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,const __gm__ MhaTiling*t){
 const __gm__ T*Q=(const __gm__ T*)q;const __gm__ T*K=(const __gm__ T*)k;const __gm__ T*V=(const __gm__ T*)v;__gm__ T*OQ=(__gm__ T*)qo;__gm__ T*OK=(__gm__ T*)ko;__gm__ T*OV=(__gm__ T*)vo;
 uint64_t bid=GetBlockIdx(),stride=1U;
 for(uint64_t x=bid;x<t->totalQ;x+=stride){uint64_t d=x%t->D,z=x/t->D,s=z%t->S;z/=t->S;uint64_t g=z%t->G;z/=t->G;uint64_t h=z%t->Nkv,b=z/t->Nkv;uint64_t hq=h*t->G+g;OQ[x]=Q[((b*t->S+s)*t->Nq+hq)*t->D+d];}
 for(uint64_t x=bid;x<t->totalKV;x+=stride){uint64_t d=x%t->D,z=x/t->D,s=z%t->Skv;z/=t->Skv;uint64_t h=z%t->Nkv,b=z/t->Nkv;uint64_t src=((b*t->Skv+s)*t->Nkv+h)*t->D+d;OK[x]=K[src];OV[x]=V[src];}
}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_reorder(GM_ADDR q,GM_ADDR k,GM_ADDR v,GM_ADDR qo,GM_ADDR ko,GM_ADDR vo,GM_ADDR tt){const __gm__ MhaTiling*t=(const __gm__ MhaTiling*)tt;if(t->dtype==0)ReorderImpl<half>(q,k,v,qo,ko,vo,t);else ReorderImpl<bfloat16_t>(q,k,v,qo,ko,vo,t);}

template<class T> class MhaSoftmax { public:
 __aicore__ inline void Init(GM_ADDR x,const __gm__ MhaTiling*t){t_=t;x_.SetGlobalBuffer((__gm__ T*)x);p_.InitBuffer(raw_,t->Skv*sizeof(T));p_.InitBuffer(fp_,t->Skv*sizeof(float));p_.InitBuffer(work_,8192);p_.InitBuffer(scalar_,32);}
 __aicore__ inline void Run(uint64_t begin,uint64_t end){for(uint64_t r=begin;r<end;++r){auto raw=raw_.Get<T>();DataCopyExtParams cp{1,uint32_t(t_->Skv*sizeof(T)),0,0,0};DataCopyPadExtParams<T>pad{true,0,0,0};DataCopyPad(raw,x_[r*t_->Skv],cp,pad);PipeBarrier<PIPE_ALL>();auto f=fp_.Get<float>();if constexpr(std::is_same<T,bfloat16_t>::value){for(uint64_t j=0;j<t_->Skv;++j)f.SetValue(j,MhaBfToFloat(raw.GetValue(j)));}else Cast(f,raw,RoundMode::CAST_NONE,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();float scale=t_->scale;Muls(f,f,scale,uint32_t(t_->Skv));PipeBarrier<PIPE_V>();uint64_t s=r%t_->S;if(t_->causal){uint64_t last=s+(t_->Skv-t_->S);for(uint64_t j=last+1;j<t_->Skv;++j)f.SetValue(j,-3.402823466e38F);}auto w=work_.Get<float>();auto z=scalar_.Get<float>();ReduceMax(z,f,w,uint32_t(t_->Skv),false);PipeBarrier<PIPE_ALL>();float mx=z.GetValue(0);Adds(f,f,-mx,uint32_t(t_->Skv));PipeBarrier<PIPE_V>();Exp(f,f,uint32_t(t_->Skv));PipeBarrier<PIPE_V>();ReduceSum(z,f,w,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();Muls(f,f,1.0f/z.GetValue(0),uint32_t(t_->Skv));constexpr auto mode=std::is_same<T,bfloat16_t>::value?RoundMode::CAST_RINT:RoundMode::CAST_NONE;Cast(raw,f,mode,uint32_t(t_->Skv));PipeBarrier<PIPE_ALL>();DataCopyPad(x_[r*t_->Skv],raw,cp);PipeBarrier<PIPE_ALL>();}}
 private:TPipe p_;TBuf<TPosition::VECCALC>raw_,fp_,work_,scalar_;GlobalTensor<T>x_;const __gm__ MhaTiling*t_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void mha_softmax(GM_ADDR x,GM_ADDR tt,uint64_t begin,uint64_t end){if(GetSubBlockIdx()!=0)return;const __gm__ MhaTiling*t=(const __gm__ MhaTiling*)tt;if(t->dtype==0){MhaSoftmax<half>o;o.Init(x,t);o.Run(begin,end);}else{MhaSoftmax<bfloat16_t>o;o.Init(x,t);o.Run(begin,end);}}

template<class T,bool BT> class MhaMM {public:using A=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;using B=MatmulType<TPosition::GM,CubeFormat::ND,T,BT>;using C=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;using Bias=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;MatmulImpl<A,B,C,Bias>mm;__aicore__ void Run(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){tiling::TCubeTiling lt{};const __gm__ int32_t*s=(const __gm__ int32_t*)tile;int32_t*d=(int32_t*)&lt;for(uint32_t i=0;i<sizeof(lt)/4;++i)d[i]=s[i];TPipe p;GlobalTensor<T>ag,bg,cg;ag.SetGlobalBuffer((__gm__ T*)a+ao,ac);bg.SetGlobalBuffer((__gm__ T*)b+bo,bc);cg.SetGlobalBuffer((__gm__ T*)c+co,cc);mm.SetSubBlockIdx(0);mm.Init(&lt,&p);mm.SetTensorA(ag);mm.SetTensorB(bg,BT);mm.IterateAll(cg);mm.End();}};
template<class T,bool BT> __aicore__ inline void MM(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MhaMM<T,BT>o;o.Run(a,b,c,tile,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_qk_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<half,true>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_qk_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<bfloat16_t,true>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_pv_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<half,false>(a,b,c,t,ao,bo,co,ac,bc,cc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_pv_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){MM<bfloat16_t,false>(a,b,c,t,ao,bo,co,ac,bc,cc);}

template<class T>__aicore__ inline void ScatterImpl(GM_ADDR in,GM_ADDR out,const __gm__ MhaTiling*t){const __gm__ T*I=(const __gm__ T*)in;__gm__ T*O=(__gm__ T*)out;for(uint64_t x=GetBlockIdx();x<t->totalQ;x+=1U){uint64_t d=x%t->D,z=x/t->D,s=z%t->S;z/=t->S;uint64_t g=z%t->G;z/=t->G;uint64_t h=z%t->Nkv,b=z/t->Nkv;O[((b*t->S+s)*t->Nq+h*t->G+g)*t->D+d]=I[x];}}
extern "C" __global__ __aicore__ __attribute__((aic)) void mha_scatter(GM_ADDR x,GM_ADDR y,GM_ADDR tt){if(GetSubBlockIdx()!=0)return;const __gm__ MhaTiling*t=(const __gm__ MhaTiling*)tt;if(t->dtype==0)ScatterImpl<half>(x,y,t);else ScatterImpl<bfloat16_t>(x,y,t);}
