#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <utility>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "engram_gate_fusion_tiling.h"
#include "../op_kernel/engram_gate_fusion_kernel.asc"
namespace{
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;if(s.empty())return o;std::stringstream ss(s);std::string z;while(std::getline(ss,z,','))o.push_back(std::stoull(z));return o;}
struct Buffer{void*h=nullptr,*d=nullptr;size_t bytes=0;std::string path;};
}
int main(int argc,char**argv){
 if(argc<2){std::cerr<<"usage: engram_gate_fusion --keys-shape ... --state-shape none|... --keys FILE ... --output FILE --state-output FILE [--device 0]\n";return 2;}
 int device=0;bool initialized=false,set=false;aclrtStream stream=nullptr;std::vector<Buffer> in;void *ho=nullptr,*hsout=nullptr,*do_=nullptr,*dsout=nullptr,*dgate=nullptr,*dxnorm=nullptr,*dt=nullptr;
 try{
  auto ks=Shape(Arg(argc,argv,"--keys-shape")),hs=Shape(Arg(argc,argv,"--hidden-shape")),vs=Shape(Arg(argc,argv,"--value-shape"));
  auto n1s=Shape(Arg(argc,argv,"--norm1-shape")),n2s=Shape(Arg(argc,argv,"--norm2-shape")),cns=Shape(Arg(argc,argv,"--conv-norm-shape")),cws=Shape(Arg(argc,argv,"--conv-weight-shape"));
  std::string stateShape=Arg(argc,argv,"--state-shape","none");bool hasState=stateShape!="none";auto ss=hasState?Shape(stateShape):std::vector<uint64_t>{};device=std::stoi(Arg(argc,argv,"--device","0"));
  Check(aclInit(nullptr),"aclInit");initialized=true;Check(aclrtSetDevice(device),"aclrtSetDevice");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");
  auto t=ComputeEngramGateFusionTiling(ks,hs,vs,n1s,n2s,cns,cws,ss,hasState,std::stoull(Arg(argc,argv,"--hc-mult")),std::stoull(Arg(argc,argv,"--hidden-size")),std::stoull(Arg(argc,argv,"--kernel-size")),std::stoull(Arg(argc,argv,"--dilation")),std::stof(Arg(argc,argv,"--norm-eps")),cores);
  in={ {nullptr,nullptr,EngramNumel(ks)*2,Arg(argc,argv,"--keys")},{nullptr,nullptr,EngramNumel(hs)*2,Arg(argc,argv,"--hidden")},{nullptr,nullptr,EngramNumel(vs)*2,Arg(argc,argv,"--value")},
       {nullptr,nullptr,EngramNumel(n1s)*4,Arg(argc,argv,"--norm1")},{nullptr,nullptr,EngramNumel(n2s)*4,Arg(argc,argv,"--norm2")},{nullptr,nullptr,EngramNumel(cns)*4,Arg(argc,argv,"--conv-norm")},{nullptr,nullptr,EngramNumel(cws)*4,Arg(argc,argv,"--conv-weight")},
       {nullptr,nullptr,hasState?EngramNumel(ss)*2:size_t(32),hasState?Arg(argc,argv,"--state"):std::string()} };
  Check(aclrtCreateStream(&stream),"create stream");
  for(auto&b:in){Check(aclrtMallocHost(&b.h,b.bytes),"host input malloc");Check(aclrtMalloc(&b.d,b.bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device input malloc");if(!b.path.empty()&&!ReadFile(b.path,b.h,b.bytes))throw std::runtime_error("read input failed: "+b.path);Check(aclrtMemcpy(b.d,b.bytes,b.h,b.bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D input");}
  size_t ob=t.outputNumel*2,sob=t.batch*t.hc*t.hidden*t.stateLen*2,gb=t.outputNumel*4,xb=t.outputNumel*4;
  Check(aclrtMallocHost(&ho,ob),"host output");Check(aclrtMallocHost(&hsout,sob),"host state output");Check(aclrtMalloc(&do_,ob,ACL_MEM_MALLOC_HUGE_FIRST),"device output");Check(aclrtMalloc(&dsout,sob,ACL_MEM_MALLOC_HUGE_FIRST),"device state output");Check(aclrtMalloc(&dgate,gb,ACL_MEM_MALLOC_HUGE_FIRST),"device gate scratch");Check(aclrtMalloc(&dxnorm,xb,ACL_MEM_MALLOC_HUGE_FIRST),"device norm scratch");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
  engram_gate_stage<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(in[0].d),static_cast<uint8_t*>(in[1].d),static_cast<uint8_t*>(in[2].d),static_cast<uint8_t*>(in[3].d),static_cast<uint8_t*>(in[4].d),static_cast<uint8_t*>(in[5].d),static_cast<uint8_t*>(dgate),static_cast<uint8_t*>(dxnorm),static_cast<uint8_t*>(dt));
  engram_conv_stage<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(in[2].d),static_cast<uint8_t*>(in[6].d),static_cast<uint8_t*>(in[7].d),static_cast<uint8_t*>(dgate),static_cast<uint8_t*>(dxnorm),static_cast<uint8_t*>(do_),static_cast<uint8_t*>(dsout),static_cast<uint8_t*>(dt));
  Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(ho,ob,do_,ob,ACL_MEMCPY_DEVICE_TO_HOST),"D2H output");Check(aclrtMemcpy(hsout,sob,dsout,sob,ACL_MEMCPY_DEVICE_TO_HOST),"D2H state output");
  if(!WriteFile(Arg(argc,argv,"--output"),ho,ob)||!WriteFile(Arg(argc,argv,"--state-output"),hsout,sob))throw std::runtime_error("write output failed");
  std::cout<<"engram_gate_fusion kernels completed: rows="<<t.rows<<" output_numel="<<t.outputNumel<<" blocks="<<t.blockNum<<"\n";
  for(void*p:{dt,dxnorm,dgate,dsout,do_})aclrtFree(p);for(auto&b:in){aclrtFree(b.d);aclrtFreeHost(b.h);}aclrtFreeHost(hsout);aclrtFreeHost(ho);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(device);set=false;aclFinalize();initialized=false;return 0;
 }catch(const std::exception&e){std::cerr<<"engram_gate_fusion failed: "<<e.what()<<"\n";for(void*p:{dt,dxnorm,dgate,dsout,do_})if(p)aclrtFree(p);for(auto&b:in){if(b.d)aclrtFree(b.d);if(b.h)aclrtFreeHost(b.h);}if(hsout)aclrtFreeHost(hsout);if(ho)aclrtFreeHost(ho);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(device);if(initialized)aclFinalize();return 1;}
}
