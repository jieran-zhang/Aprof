#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "data_utils.h"
#include "dequant_swiglu_quant_tiling.h"
#include "../op_kernel/dequant_swiglu_quant_kernel.asc"
namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
bool Flag(int n,char**v,const std::string&k){for(int i=1;i<n;++i)if(v[i]==k)return true;return false;}
void CopyIn(const std::string&p,size_t bytes,void*&h,void*&d){Check(aclrtMallocHost(&h,bytes),"host alloc");if(!ReadFile(p,h,bytes))throw std::runtime_error("read failed: "+p);Check(aclrtMalloc(&d,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device alloc");Check(aclrtMemcpy(d,bytes,h,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}
}
int main(int argc,char**argv){
 int dev=0;bool initialized=false,deviceSet=false;aclrtStream stream=nullptr;void *hx=nullptr,*hws=nullptr,*has=nullptr,*hqs=nullptr,*hy=nullptr,*hs=nullptr;void *dx=nullptr,*dws=nullptr,*das=nullptr,*dqs=nullptr,*dy=nullptr,*ds=nullptr,*dt=nullptr;
 try{uint64_t rows=std::stoull(Arg(argc,argv,"--rows"));uint32_t half=std::stoul(Arg(argc,argv,"--half"));std::string dtype=Arg(argc,argv,"--dtype");uint32_t dtp,itemBytes;if(dtype=="float16"){dtp=DSQ_FP16;itemBytes=2;}else if(dtype=="bfloat16"){dtp=DSQ_BF16;itemBytes=2;}else if(dtype=="int32"){dtp=DSQ_INT32;itemBytes=4;}else throw std::invalid_argument("bad dtype");
  const std::string wsPath=Arg(argc,argv,"--weight-scale"),asPath=Arg(argc,argv,"--activation-scale"),qsPath=Arg(argc,argv,"--quant-scale");dev=std::stoi(Arg(argc,argv,"--device","0"));
  Check(aclInit(nullptr),"aclInit");initialized=true;Check(aclrtSetDevice(dev),"set device");deviceSet=true;Check(aclrtCreateStream(&stream),"create stream");int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query cores");auto t=ComputeDequantSwigluTiling(rows,half,dtp,!qsPath.empty(),Flag(argc,argv,"--activate-left"),cores);
  CopyIn(Arg(argc,argv,"--input"),rows*uint64_t(half)*2*itemBytes,hx,dx);if(dtp==DSQ_INT32){CopyIn(wsPath,uint64_t(half)*2*4,hws,dws);CopyIn(asPath,rows*4,has,das);}if(!qsPath.empty())CopyIn(qsPath,uint64_t(half)*4,hqs,dqs);
  size_t yb=rows*uint64_t(half),sb=rows*4;Check(aclrtMallocHost(&hy,yb),"host y");Check(aclrtMallocHost(&hs,sb),"host scale");Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"device y");Check(aclrtMalloc(&ds,sb,ACL_MEM_MALLOC_HUGE_FIRST),"device scale");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");
  dequant_swiglu_quant_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dws),static_cast<uint8_t*>(das),static_cast<uint8_t*>(dqs),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(ds),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");Check(aclrtMemcpy(hs,sb,ds,sb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H scale");if(!WriteFile(Arg(argc,argv,"--output"),hy,yb)||!WriteFile(Arg(argc,argv,"--scale-output"),hs,sb))throw std::runtime_error("write output failed");std::cout<<"dequant_swiglu_quant_kernel completed rows="<<rows<<" half="<<half<<" blocks="<<t.blockNum<<"\n";
  auto fd=[](void*&p){if(p){aclrtFree(p);p=nullptr;}};auto fh=[](void*&p){if(p){aclrtFreeHost(p);p=nullptr;}};fd(dt);fd(ds);fd(dy);fd(dqs);fd(das);fd(dws);fd(dx);fh(hs);fh(hy);fh(hqs);fh(has);fh(hws);fh(hx);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(dev);deviceSet=false;aclFinalize();initialized=false;return 0;
 }catch(const std::exception&e){std::cerr<<"dequant_swiglu_quant failed: "<<e.what()<<"\n";for(void*p:{dt,ds,dy,dqs,das,dws,dx})if(p)aclrtFree(p);for(void*p:{hs,hy,hqs,has,hws,hx})if(p)aclrtFreeHost(p);if(stream)aclrtDestroyStream(stream);if(deviceSet)aclrtResetDevice(dev);if(initialized)aclFinalize();return 1;}
}
