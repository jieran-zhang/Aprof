#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
using namespace AscendC;
using namespace matmul;

struct GruTiling { uint64_t S,B,I,H,D,L; uint32_t dtype,batchFirst,hasBias,hasH0; };

__aicore__ inline float GruBfToFloat(bfloat16_t v){uint32_t b=uint32_t(*reinterpret_cast<uint16_t*>(&v))<<16;return *reinterpret_cast<float*>(&b);}
__aicore__ inline bfloat16_t GruFloatToBf(float v){uint32_t b=*reinterpret_cast<uint32_t*>(&v);uint32_t l=(b>>16)&1U;b+=0x7fffU+l;uint16_t q=uint16_t(b>>16);return *reinterpret_cast<bfloat16_t*>(&q);}
template<class T> __aicore__ inline float GruToFloat(T v){if constexpr(std::is_same<T,bfloat16_t>::value)return GruBfToFloat(v);else return float(v);}
template<class T> __aicore__ inline T GruFromFloat(float v){if constexpr(std::is_same<T,bfloat16_t>::value)return GruFloatToBf(v);else return T(v);}

template<class T> __aicore__ inline void CanonicalImpl(GM_ADDR x,GM_ADDR y,const __gm__ GruTiling*t){const __gm__ T*X=(const __gm__ T*)x;__gm__ T*Y=(__gm__ T*)y;uint64_t n=t->S*t->B*t->I;for(uint64_t p=GetBlockIdx();p<n;p+=1U){uint64_t k=p%t->I,q=p/t->I,b=q%t->B,s=q/t->B;uint64_t src=t->batchFirst?((b*t->S+s)*t->I+k):p;Y[p]=X[src];}}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_canonical(GM_ADDR x,GM_ADDR y,GM_ADDR tt){if(GetSubBlockIdx()!=0)return;auto*t=(const __gm__ GruTiling*)tt;if(t->dtype==0)CanonicalImpl<half>(x,y,t);else if(t->dtype==1)CanonicalImpl<bfloat16_t>(x,y,t);else CanonicalImpl<float>(x,y,t);}

template<class T> __aicore__ inline void InitHiddenImpl(GM_ADDR h0,GM_ADDR h,GM_ADDR hn,const __gm__ GruTiling*t,uint64_t idx){const __gm__ T*H0=(const __gm__ T*)h0;__gm__ T*H=(__gm__ T*)h;__gm__ T*HN=(__gm__ T*)hn;uint64_t n=t->B*t->H;for(uint64_t p=GetBlockIdx();p<n;p+=1U){T v=t->hasH0?H0[idx*n+p]:GruFromFloat<T>(0);H[p]=v;HN[idx*n+p]=v;}}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_init_hidden(GM_ADDR h0,GM_ADDR h,GM_ADDR hn,GM_ADDR tt,uint64_t idx){if(GetSubBlockIdx()!=0)return;auto*t=(const __gm__ GruTiling*)tt;if(t->dtype==0)InitHiddenImpl<half>(h0,h,hn,t,idx);else if(t->dtype==1)InitHiddenImpl<bfloat16_t>(h0,h,hn,t,idx);else InitHiddenImpl<float>(h0,h,hn,t,idx);}

template<class T> class GruMM {public:using A=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;using B=MatmulType<TPosition::GM,CubeFormat::ND,T,true>;using C=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;using Bias=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;MatmulImpl<A,B,C,Bias>mm;__aicore__ void Run(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t ac,uint64_t bc){tiling::TCubeTiling lt{};const __gm__ int32_t*s=(const __gm__ int32_t*)tile;int32_t*d=(int32_t*)&lt;for(uint32_t i=0;i<sizeof(lt)/4;++i)d[i]=s[i];TPipe p;GlobalTensor<T>ag,bg;GlobalTensor<float>cg;ag.SetGlobalBuffer((__gm__ T*)a+ao,ac);bg.SetGlobalBuffer((__gm__ T*)b,bc);cg.SetGlobalBuffer((__gm__ float*)c);mm.SetSubBlockIdx(0);mm.Init(&lt,&p);mm.SetTensorA(ag);mm.SetTensorB(bg,true);mm.IterateAll(cg);mm.End();}};
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_mm_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t ac,uint64_t bc){GruMM<half>o;o.Run(a,b,c,tile,ao,ac,bc);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_mm_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR tile,uint64_t ao,uint64_t ac,uint64_t bc){GruMM<bfloat16_t>o;o.Run(a,b,c,tile,ao,ac,bc);}

template<class T> __aicore__ inline void GateToFloat(GM_ADDR x,GM_ADDR y,uint64_t n){const __gm__ T*X=(const __gm__ T*)x;__gm__ float*Y=(__gm__ float*)y;for(uint64_t p=GetBlockIdx();p<n;p+=1U)Y[p]=GruToFloat(X[p]);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_gate_fp16(GM_ADDR x,GM_ADDR y,uint64_t n){if(GetSubBlockIdx()!=0)return;GateToFloat<half>(x,y,n);}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_gate_bf16(GM_ADDR x,GM_ADDR y,uint64_t n){if(GetSubBlockIdx()!=0)return;GateToFloat<bfloat16_t>(x,y,n);}

__aicore__ inline void GruMMFloat(GM_ADDR a,GM_ADDR b,GM_ADDR c,uint64_t ao,uint64_t M,uint64_t N,uint64_t K){const __gm__ float*A=(const __gm__ float*)a+ao;const __gm__ float*B=(const __gm__ float*)b;__gm__ float*C=(__gm__ float*)c;for(uint64_t p=GetBlockIdx();p<M*N;p+=1U){uint64_t m=p/N,n=p%N;float z=0;for(uint64_t k=0;k<K;++k)z+=A[m*K+k]*B[n*K+k];C[p]=z;}}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_mm_fp32(GM_ADDR a,GM_ADDR b,GM_ADDR c,uint64_t ao,uint64_t M,uint64_t N,uint64_t K){if(GetSubBlockIdx()!=0)return;GruMMFloat(a,b,c,ao,M,N,K);}

template<class T> class GruUpdate {public:
 __aicore__ inline void Run(GM_ADDR gi,GM_ADDR gh,GM_ADDR bi,GM_ADDR bh,GM_ADDR hidden,GM_ADDR out,GM_ADDR hn,const __gm__ GruTiling*t,uint64_t s,uint64_t dir,uint64_t idx){const __gm__ float*I=(const __gm__ float*)gi;const __gm__ float*G=(const __gm__ float*)gh;const __gm__ T*BI=(const __gm__ T*)bi;const __gm__ T*BH=(const __gm__ T*)bh;__gm__ T*H=(__gm__ T*)hidden;__gm__ T*O=(__gm__ T*)out;__gm__ T*N=(__gm__ T*)hn;uint32_t n=t->B*t->H;p.InitBuffer(rb,n*sizeof(float));p.InitBuffer(zb,n*sizeof(float));p.InitBuffer(nb,n*sizeof(float));auto r=rb.Get<float>();auto z=zb.Get<float>();auto nv=nb.Get<float>();for(uint32_t q=0;q<n;++q){uint64_t b=q/t->H,h=q%t->H;float bir=t->hasBias?GruToFloat(BI[h]):0,biz=t->hasBias?GruToFloat(BI[t->H+h]):0,bin=t->hasBias?GruToFloat(BI[2*t->H+h]):0;float bhr=t->hasBias?GruToFloat(BH[h]):0,bhz=t->hasBias?GruToFloat(BH[t->H+h]):0;r.SetValue(q,I[b*3*t->H+h]+G[b*3*t->H+h]+bir+bhr);z.SetValue(q,I[b*3*t->H+t->H+h]+G[b*3*t->H+t->H+h]+biz+bhz);nv.SetValue(q,I[b*3*t->H+2*t->H+h]+bin);}PipeBarrier<PIPE_ALL>();Muls(r,r,-1.0f,n);Muls(z,z,-1.0f,n);PipeBarrier<PIPE_V>();Exp(r,r,n);Exp(z,z,n);PipeBarrier<PIPE_V>();Adds(r,r,1.0f,n);Adds(z,z,1.0f,n);PipeBarrier<PIPE_V>();Reciprocal(r,r,n);Reciprocal(z,z,n);PipeBarrier<PIPE_ALL>();for(uint32_t q=0;q<n;++q){uint64_t b=q/t->H,h=q%t->H;float bhn=t->hasBias?GruToFloat(BH[2*t->H+h]):0;nv.SetValue(q,nv.GetValue(q)+r.GetValue(q)*(G[b*3*t->H+2*t->H+h]+bhn));}PipeBarrier<PIPE_ALL>();Tanh(nv,nv,n);PipeBarrier<PIPE_ALL>();for(uint32_t q=0;q<n;++q){uint64_t b=q/t->H,h=q%t->H;float zz=z.GetValue(q),old=GruToFloat(H[q]);T v=GruFromFloat<T>((1.0f-zz)*nv.GetValue(q)+zz*old);H[q]=v;N[idx*n+q]=v;O[((s*t->B+b)*(t->D*t->H))+dir*t->H+h]=v;}}
 private:TPipe p;TBuf<TPosition::VECCALC>rb,zb,nb;
};
template<class T> __aicore__ inline void UpdateImpl(GM_ADDR gi,GM_ADDR gh,GM_ADDR bi,GM_ADDR bh,GM_ADDR hidden,GM_ADDR out,GM_ADDR hn,const __gm__ GruTiling*t,uint64_t s,uint64_t dir,uint64_t idx){GruUpdate<T>o;o.Run(gi,gh,bi,bh,hidden,out,hn,t,s,dir,idx);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void gru_update(GM_ADDR gi,GM_ADDR gh,GM_ADDR bi,GM_ADDR bh,GM_ADDR hidden,GM_ADDR out,GM_ADDR hn,GM_ADDR tt,uint64_t s,uint64_t dir,uint64_t idx){if(GetSubBlockIdx()!=0)return;auto*t=(const __gm__ GruTiling*)tt;if(t->dtype==0)UpdateImpl<half>(gi,gh,bi,bh,hidden,out,hn,t,s,dir,idx);else if(t->dtype==1)UpdateImpl<bfloat16_t>(gi,gh,bi,bh,hidden,out,hn,t,s,dir,idx);else UpdateImpl<float>(gi,gh,bi,bh,hidden,out,hn,t,s,dir,idx);}

template<class T> __aicore__ inline void FinalImpl(GM_ADDR x,GM_ADDR y,const __gm__ GruTiling*t){const __gm__ T*X=(const __gm__ T*)x;__gm__ T*Y=(__gm__ T*)y;uint64_t F=t->D*t->H,n=t->S*t->B*F;for(uint64_t p=GetBlockIdx();p<n;p+=1U){uint64_t k=p%F,q=p/F,b=q%t->B,s=q/t->B;uint64_t dst=t->batchFirst?((b*t->S+s)*F+k):p;Y[dst]=X[p];}}
extern "C" __global__ __aicore__ __attribute__((aic)) void gru_final(GM_ADDR x,GM_ADDR y,GM_ADDR tt){if(GetSubBlockIdx()!=0)return;auto*t=(const __gm__ GruTiling*)tt;if(t->dtype==0)FinalImpl<half>(x,y,t);else if(t->dtype==1)FinalImpl<bfloat16_t>(x,y,t);else FinalImpl<float>(x,y,t);}
