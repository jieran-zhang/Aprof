#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "swi_glu_tiling.h"

template <typename T>
class KernelSwiGlu {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const __gm__ SwiGluTilingData *tiling) {
        tiling_ = tiling;
        outputOffset_ = static_cast<uint64_t>(AscendC::GetBlockIdx()) * tiling_->blockLength;
        const uint64_t remain = tiling_->outputLength > outputOffset_
            ? tiling_->outputLength - outputOffset_ : 0;
        length_ = remain < tiling_->blockLength ? remain : tiling_->blockLength;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), tiling_->outputLength * 2);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), tiling_->outputLength);
        const uint32_t rawBytes = tiling_->tileElements * sizeof(T);
        pipe_.InitBuffer(x0Q_, 1, rawBytes);
        pipe_.InitBuffer(x1Q_, 1, rawBytes);
        pipe_.InitBuffer(outQ_, 1, rawBytes);
        if constexpr (!std::is_same<T, float>::value) {
            pipe_.InitBuffer(fp0_, tiling_->tileElements * sizeof(float));
            pipe_.InitBuffer(fp1_, tiling_->tileElements * sizeof(float));
            pipe_.InitBuffer(fpTmp_, tiling_->tileElements * sizeof(float));
        }
    }

    __aicore__ inline void Process() {
        uint64_t localOff = 0;
        while (localOff < length_) {
            const uint64_t outIndex = outputOffset_ + localOff;
            const uint64_t inSegment = outIndex % tiling_->segmentLength;
            uint64_t count64 = length_ - localOff;
            const uint64_t toBoundary = tiling_->segmentLength - inSegment;
            if (count64 > toBoundary) count64 = toBoundary;
            if (count64 > tiling_->tileElements) count64 = tiling_->tileElements;
            const uint32_t count = static_cast<uint32_t>(count64);
            const uint64_t segment = outIndex / tiling_->segmentLength;
            const uint64_t x0Index = outIndex + segment * tiling_->segmentLength;
            CopyIn(x0Index, x0Index + tiling_->segmentLength, count);
            Compute(count);
            CopyOut(outIndex, count);
            localOff += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t x0Index, uint64_t x1Index, uint32_t count) {
        auto x0 = x0Q_.AllocTensor<T>();
        auto x1 = x1Q_.AllocTensor<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(x0, x_[x0Index], p, pad);
        AscendC::DataCopyPad(x1, x_[x1Index], p, pad);
        x0Q_.EnQue(x0);
        x1Q_.EnQue(x1);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto x0 = x0Q_.DeQue<T>();
        auto x1 = x1Q_.DeQue<T>();
        auto out = outQ_.AllocTensor<T>();
        if constexpr (std::is_same<T, float>::value) {
            AscendC::Muls(out, x0, -1.0f, count);
            AscendC::Exp(out, out, count);
            AscendC::Adds(out, out, 1.0f, count);
            AscendC::Div(out, x0, out, count);
            AscendC::Mul(out, out, x1, count);
        } else {
            auto f0 = fp0_.Get<float>();
            auto f1 = fp1_.Get<float>();
            auto tmp = fpTmp_.Get<float>();
            AscendC::Cast(f0, x0, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(f1, x1, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Muls(tmp, f0, -1.0f, count);
            AscendC::Exp(tmp, tmp, count);
            AscendC::Adds(tmp, tmp, 1.0f, count);
            AscendC::Div(tmp, f0, tmp, count);
            AscendC::Mul(tmp, tmp, f1, count);
            constexpr auto mode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(out, tmp, mode, count);
        }
        outQ_.EnQue(out);
        x1Q_.FreeTensor(x1);
        x0Q_.FreeTensor(x0);
    }

    __aicore__ inline void CopyOut(uint64_t outIndex, uint32_t count) {
        auto out = outQ_.DeQue<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(y_[outIndex], out, p);
        outQ_.FreeTensor(out);
    }

    AscendC::TPipe pipe_;
    const __gm__ SwiGluTilingData *tiling_;
    uint64_t outputOffset_, length_;
    AscendC::GlobalTensor<T> x_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> x0Q_, x1Q_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fp0_, fp1_, fpTmp_;
};

extern "C" __global__ __aicore__ void swi_glu_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ SwiGluTilingData *t =
        reinterpret_cast<const __gm__ SwiGluTilingData *>(tilingAddr);
    if (t->dtype == SWIGLU_FLOAT32) {
        KernelSwiGlu<float> op; op.Init(x, y, t); op.Process();
    } else if (t->dtype == SWIGLU_FLOAT16) {
        KernelSwiGlu<half> op; op.Init(x, y, t); op.Process();
    } else {
        KernelSwiGlu<bfloat16_t> op; op.Init(x, y, t); op.Process();
    }
}
