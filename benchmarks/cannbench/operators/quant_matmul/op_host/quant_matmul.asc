#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "../op_kernel/quant_matmul_kernel.asc"

namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
bool Read(const std::string&p,void*d,size_t n){std::ifstream f(p,std::ios::binary);return bool(f.read((char*)d,n));}
bool Write(const std::string&p,const void*d,size_t n){std::ofstream f(p,std::ios::binary);return bool(f.write((const char*)d,n));}
AscendC::tiling::TCubeTiling MakeTiling(int m,int n,int k){
 matmul_tiling::PlatformInfo platform{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};
 matmul_tiling::MatmulApiTiling api(platform);using matmul_tiling::TPosition;using matmul_tiling::CubeFormat;using matmul_tiling::DataType;
 if(api.SetAType(TPosition::GM,CubeFormat::ND,DataType::DT_INT8,false)||api.SetBType(TPosition::GM,CubeFormat::ND,DataType::DT_INT8,false)||api.SetCType(TPosition::GM,CubeFormat::ND,DataType::DT_INT32)||api.SetBiasType(TPosition::GM,CubeFormat::ND,DataType::DT_INT32)||api.SetShape(m,n,k)||api.SetOrgShape(m,n,k)||api.SetBias(false)||api.SetFixSplit(-1,-1,std::min(k,256)))throw std::runtime_error("matmul tiling setup failed");
 AscendC::tiling::TCubeTiling t{};if(api.GetTiling(t))throw std::runtime_error("matmul GetTiling failed");return t;
}
struct Buf{void*h=nullptr,*d=nullptr;size_t n=0;};
}
int main(int argc,char**argv){
 bool init=false,selected=false;aclrtStream stream=nullptr;std::vector<Buf> bufs;
 try{
  uint32_t m=std::stoul(Arg(argc,argv,"--m")),k=std::stoul(Arg(argc,argv,"--k")),n=std::stoul(Arg(argc,argv,"--n")),batches=std::stoul(Arg(argc,argv,"--batches","1"));
  uint32_t sc=std::stoul(Arg(argc,argv,"--scale-count")),oc=std::stoul(Arg(argc,argv,"--offset-count","0"));bool hp=Arg(argc,argv,"--pertoken","-")!="-",ho=Arg(argc,argv,"--offset","-")!="-";
  std::string sd=Arg(argc,argv,"--scale-dtype"),od=Arg(argc,argv,"--output-dtype"),bd=Arg(argc,argv,"--bias-dtype","none"),bp=Arg(argc,argv,"--bias","-");uint32_t bk=bd=="int32"?1:bd=="bfloat16"?2:bd=="float16"?3:bd=="float32"?4:0,br=std::stoul(Arg(argc,argv,"--bias-rank3","0"));
  uint64_t ac=uint64_t(batches)*m*k,bc=uint64_t(batches)*k*n,yc=uint64_t(batches)*m*n;size_t biasCount=bk?(br?uint64_t(batches)*n:n):0;
  auto add=[&](size_t bytes,const std::string&path,bool input){Buf x;x.n=std::max<size_t>(bytes,1);Check(aclrtMallocHost(&x.h,x.n),"host malloc");Check(aclrtMalloc(&x.d,x.n,ACL_MEM_MALLOC_HUGE_FIRST),"device malloc");if(input){if(!Read(path,x.h,bytes))throw std::runtime_error("read "+path);Check(aclrtMemcpy(x.d,x.n,x.h,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");}bufs.push_back(x);return bufs.size()-1;};
  int dev=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(dev),"set device");selected=true;Check(aclrtCreateStream(&stream),"stream");uint32_t blocks=1;
  auto ia=add(ac,Arg(argc,argv,"--x1"),true),ib=add(bc,Arg(argc,argv,"--x2"),true),is=add(size_t(sc)*(sd=="bfloat16"?2:4),Arg(argc,argv,"--scale"),true);
  auto io=add(size_t(oc)*4,Arg(argc,argv,"--offset",""),ho),ip=add(size_t(m)*4,Arg(argc,argv,"--pertoken",""),hp),ii=add(biasCount*(bk==1||bk==4?4:2),bp,bk),ic=add(yc*4,"",false),iy=add(yc*2,"",false),it=add(sizeof(AscendC::tiling::TCubeTiling),"",false);
  auto tile=MakeTiling(m,n,k);Check(aclrtMemcpy(bufs[it].d,bufs[it].n,&tile,sizeof(tile),ACL_MEMCPY_HOST_TO_DEVICE),"tiling H2D");
  for(uint32_t batch=0;batch<batches;++batch){uint64_t ao=uint64_t(batch)*m*k,bo=uint64_t(batch)*k*n,co=uint64_t(batch)*m*n;quant_matmul_cube<<<1,nullptr,stream>>>((uint8_t*)bufs[ia].d,(uint8_t*)bufs[ib].d,(uint8_t*)bufs[ic].d,(uint8_t*)bufs[it].d,ao,bo,co,uint64_t(m)*k,uint64_t(k)*n,uint64_t(m)*n);Check(aclrtSynchronizeStream(stream),"cube sync");}
  auto args=[&](auto kernel){kernel<<<blocks,nullptr,stream>>>((uint8_t*)bufs[ic].d,(uint8_t*)bufs[is].d,(uint8_t*)bufs[io].d,(uint8_t*)bufs[ip].d,(uint8_t*)bufs[ii].d,(uint8_t*)bufs[iy].d,yc,m,n,batches,sc,oc,ho,hp,bk,br,1U);};
  if(od=="float16")args(quant_dequant_fp16_f32);else if(sd=="bfloat16")args(quant_dequant_bf16_bf16);else args(quant_dequant_bf16_f32);Check(aclrtSynchronizeStream(stream),"dequant sync");Check(aclrtMemcpy(bufs[iy].h,bufs[iy].n,bufs[iy].d,yc*2,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");if(!Write(Arg(argc,argv,"--output"),bufs[iy].h,yc*2))throw std::runtime_error("write output");
  std::cout<<"quant_matmul completed batches="<<batches<<" M="<<m<<" K="<<k<<" N="<<n<<" output="<<od<<"\n";
  for(auto&x:bufs){if(x.d)aclrtFree(x.d);if(x.h)aclrtFreeHost(x.h);}aclrtDestroyStream(stream);aclrtResetDevice(dev);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"quant_matmul failed: "<<e.what()<<"\n";for(auto&x:bufs){if(x.d)aclrtFree(x.d);if(x.h)aclrtFreeHost(x.h);}if(stream)aclrtDestroyStream(stream);if(selected)aclrtResetDevice(0);if(init)aclFinalize();return 1;}
}
