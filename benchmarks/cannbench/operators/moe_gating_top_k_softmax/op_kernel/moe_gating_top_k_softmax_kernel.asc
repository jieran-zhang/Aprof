#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "moe_gating_top_k_softmax_tiling.h"
template<typename T>__aicore__ inline float MoeToFloat(T v){if constexpr(std::is_same<T,float>::value)return v;uint16_t r=*reinterpret_cast<uint16_t*>(&v);uint32_t bits=0;if constexpr(std::is_same<T,bfloat16_t>::value)bits=uint32_t(r)<<16;else{uint32_t sign=uint32_t(r&0x8000U)<<16,exp=(r>>10)&31U,m=r&1023U;bits=sign;if(exp==31U){bits|=0x7f800000U|(m<<13);if(m)bits|=0x400000U;}else if(exp)bits|=((exp+112U)<<23)|(m<<13);else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}m&=1023U;bits|=(uint32_t(e+127)<<23)|(m<<13);}}return *reinterpret_cast<float*>(&bits);}
template<typename T>class MoeGatingKernel{public:
 __aicore__ inline void Init(GM_ADDR xa,GM_ADDR fa,GM_ADDR ya,GM_ADDR ea,GM_ADDR ra,const __gm__ MoeGatingTilingData*t){t_=t;x_=reinterpret_cast<const __gm__ T*>(xa);finished_=reinterpret_cast<const __gm__ uint8_t*>(fa);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ya),t->outputNumel);expert_=reinterpret_cast<__gm__ int32_t*>(ea);row_=reinterpret_cast<__gm__ int32_t*>(ra);pipe_.InitBuffer(logits_,2048*4);pipe_.InitBuffer(outFp_,1024*4);if constexpr(!std::is_same<T,float>::value)pipe_.InitBuffer(outRaw_,1024*2);}
 __aicore__ inline void Process(){uint64_t rs=uint64_t(AscendC::GetBlockIdx())*t_->blockRows,re=rs+t_->blockRows;if(re>t_->rows)re=t_->rows;const int32_t expertCount=int32_t(t_->experts);const int32_t topCount=int32_t(t_->k);auto logits=logits_.Get<float>();auto out=outFp_.Get<float>();for(uint64_t r=rs;r<re;++r){float mx=-3.402823466e38F;uint64_t base=r*t_->experts;for(uint32_t e=0;e<t_->experts;++e){float v=MoeToFloat<T>(x_[base+e]);logits.SetValue(e,v);if(v>mx)mx=v;}for(uint32_t e=0;e<t_->experts;++e)logits.SetValue(e,logits.GetValue(e)-mx);AscendC::PipeBarrier<PIPE_ALL>();AscendC::Exp(logits,logits,expertCount);AscendC::PipeBarrier<PIPE_ALL>();float sum=0.0f;for(uint32_t e=0;e<t_->experts;++e)sum+=logits.GetValue(e);bool fin=t_->hasFinished&&finished_[r]!=0;for(uint32_t j=0;j<t_->k;++j){float best=-1.0f;int32_t idx=0;for(uint32_t e=0;e<t_->experts;++e){float v=logits.GetValue(e);if(v>best){best=v;idx=int32_t(e);}}out.SetValue(j,best/sum);logits.SetValue(uint32_t(idx),-1.0f);expert_[r*t_->k+j]=fin?int32_t(t_->experts):idx;row_[r*t_->k+j]=int32_t(j*t_->rows+r);}if constexpr(std::is_same<T,float>::value){for(uint32_t j=0;j<t_->k;++j)y_.SetValue(r*t_->k+j,out.GetValue(j));}else{auto raw=outRaw_.Get<T>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::PipeBarrier<PIPE_ALL>();AscendC::Cast(raw,out,mode,topCount);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,uint32_t(t_->k*2),0,0,0};AscendC::DataCopyPad(y_[r*t_->k],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();}}}
 private:const __gm__ MoeGatingTilingData*t_;const __gm__ T*x_;const __gm__ uint8_t*finished_;AscendC::GlobalTensor<T>y_;__gm__ int32_t*expert_;__gm__ int32_t*row_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>logits_,outFp_,outRaw_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void moe_gating_top_k_softmax_kernel(GM_ADDR x,GM_ADDR finished,GM_ADDR y,GM_ADDR expert,GM_ADDR row,GM_ADDR til){const __gm__ MoeGatingTilingData*t=reinterpret_cast<const __gm__ MoeGatingTilingData*>(til);if(t->dtype==MOE_FP16){MoeGatingKernel<half>op;op.Init(x,finished,y,expert,row,t);op.Process();}else if(t->dtype==MOE_BF16){MoeGatingKernel<bfloat16_t>op;op.Init(x,finished,y,expert,row,t);op.Process();}else{MoeGatingKernel<float>op;op.Init(x,finished,y,expert,row,t);op.Process();}}
