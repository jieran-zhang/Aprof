#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "resize_bilinear_tiling.h"
template<typename T>__aicore__ inline float ResizeToFloat(T v){
 if constexpr(std::is_same<T,float>::value)return v;
 uint16_t r=*reinterpret_cast<uint16_t*>(&v);uint32_t bits=0;
 if constexpr(std::is_same<T,bfloat16_t>::value)bits=uint32_t(r)<<16;
 else{uint32_t sign=uint32_t(r&0x8000U)<<16,exp=(r>>10)&31U,m=r&1023U;bits=sign;if(exp==31U){bits|=0x7f800000U|(m<<13);if(m)bits|=0x400000U;}else if(exp)bits|=((exp+112U)<<23)|(m<<13);else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}m&=1023U;bits|=(uint32_t(e+127)<<23)|(m<<13);}}
 return *reinterpret_cast<float*>(&bits);
}
__aicore__ inline int64_t ResizeFloor(float v){int64_t x=static_cast<int64_t>(v);if(float(x)>v)--x;return x;}
__aicore__ inline float ResizeCoord(uint64_t out,float inSize,float outSize,uint32_t align){float o=float(static_cast<int32_t>(out));if(align){if(outSize<=1.0f)return 0.0f;float scale=(inSize-1.0f)/(outSize-1.0f);return o*scale;}float scale=inSize/outSize;float v=(o+0.5f)*scale-0.5f;if(v<0.0f)v=0.0f;if(v>inSize-1.0f)v=inSize-1.0f;return v;}
template<typename T>__aicore__ inline float ResizeOne(const __gm__ T*x,uint64_t linear,const __gm__ ResizeBilinearTilingData*t){uint64_t s=linear%t->outputSpatial,nc=linear/t->outputSpatial,oh=s/t->outW,ow=s%t->outW;float ih=ResizeCoord(oh,t->inHf,t->outHf,t->alignCorners),iw=ResizeCoord(ow,t->inWf,t->outWf,t->alignCorners);int64_t h0=ResizeFloor(ih),w0=ResizeFloor(iw),h1=h0+1,w1=w0+1;if(uint64_t(h1)>=t->inH)h1=h0;if(uint64_t(w1)>=t->inW)w1=w0;float dh=ih-float(h0),dw=iw-float(w0),ah=1.0f-dh,aw=1.0f-dw;uint64_t base=nc*t->inputSpatial;float a=ResizeToFloat<T>(x[base+uint64_t(h0)*t->inW+uint64_t(w0)]),b=ResizeToFloat<T>(x[base+uint64_t(h0)*t->inW+uint64_t(w1)]),c=ResizeToFloat<T>(x[base+uint64_t(h1)*t->inW+uint64_t(w0)]),d=ResizeToFloat<T>(x[base+uint64_t(h1)*t->inW+uint64_t(w1)]);return a*ah*aw+b*ah*dw+c*dh*aw+d*dh*dw;}
template<typename T>class ResizeB16 {public:__aicore__ inline void Init(GM_ADDR xa,GM_ADDR ya,const __gm__ ResizeBilinearTilingData*t){t_=t;x_=reinterpret_cast<const __gm__ T*>(xa);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ya),t->outputNumel);pipe_.InitBuffer(fp_,K*4);pipe_.InitBuffer(raw_,K*2);}__aicore__ inline void Process(){uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->blockLength,end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;auto fp=fp_.Get<float>();auto raw=raw_.Get<T>();for(uint64_t off=begin;off<end;off+=K){uint32_t count=uint32_t(end-off<K?end-off:K);for(uint32_t i=0;i<count;++i)fp.SetValue(i,ResizeOne<T>(x_,off+i,t_));AscendC::PipeBarrier<PIPE_ALL>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(raw,fp,mode,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[off],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();}}private:static constexpr uint32_t K=1024;const __gm__ ResizeBilinearTilingData*t_;const __gm__ T*x_;AscendC::GlobalTensor<T>y_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>fp_,raw_;};
__aicore__ inline void ResizeFloat(GM_ADDR xa,GM_ADDR ya,const __gm__ ResizeBilinearTilingData*t){const __gm__ float*x=reinterpret_cast<const __gm__ float*>(xa);__gm__ float*y=reinterpret_cast<__gm__ float*>(ya);uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t->blockLength,end=begin+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;for(uint64_t i=begin;i<end;++i)y[i]=ResizeOne<float>(x,i,t);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void resize_bilinear_kernel(GM_ADDR x,GM_ADDR y,GM_ADDR til){const __gm__ ResizeBilinearTilingData*t=reinterpret_cast<const __gm__ ResizeBilinearTilingData*>(til);if(t->dtype==RESIZE_FP16){ResizeB16<half>op;op.Init(x,y,t);op.Process();}else if(t->dtype==RESIZE_BF16){ResizeB16<bfloat16_t>op;op.Init(x,y,t);op.Process();}else ResizeFloat(x,y,t);}
