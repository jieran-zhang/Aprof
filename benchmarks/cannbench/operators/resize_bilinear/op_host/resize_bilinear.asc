#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "resize_bilinear_tiling.h"
#include "data_utils.h"
#include "../op_kernel/resize_bilinear_kernel.asc"
namespace{void C(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}std::vector<uint64_t>S(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string z;while(getline(q,z,','))o.push_back(std::stoull(z));return o;}uint64_t N(const std::vector<uint64_t>&s){uint64_t n=1;for(auto v:s)n*=v;return n;}uint32_t D(const std::string&s){if(s=="float16")return RESIZE_FP16;if(s=="float32")return RESIZE_FP32;if(s=="bfloat16")return RESIZE_BF16;throw std::invalid_argument("dtype");}}
int main(int argc,char**argv){if(argc<2)return 2;int dev=0;bool init=false,set=false;aclrtStream st=nullptr;void *hx=nullptr,*hy=nullptr,*dx=nullptr,*dy=nullptr,*dt=nullptr;try{auto sh=S(A(argc,argv,"--shape"));auto os=S(A(argc,argv,"--output-size"));if(os.size()!=2)throw std::invalid_argument("output size");uint32_t dtype=D(A(argc,argv,"--dtype"));size_t item=dtype==RESIZE_FP32?4:2;dev=std::stoi(A(argc,argv,"--device","0"));C(aclInit(nullptr),"init");init=true;C(aclrtSetDevice(dev),"set");set=true;int64_t cores=1;C(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");auto t=ComputeResizeBilinearTiling(sh,os[0],os[1],dtype,std::stoi(A(argc,argv,"--align-corners","0"))!=0,cores);size_t xb=N(sh)*item,yb=t.outputNumel*item;C(aclrtCreateStream(&st),"stream");C(aclrtMallocHost(&hx,xb),"host x");C(aclrtMallocHost(&hy,yb),"host y");C(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"dev x");C(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"dev y");C(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");if(!ReadFile(A(argc,argv,"--input"),hx,xb))throw std::runtime_error("read");C(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d x");C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"h2d tiling");auto a=std::chrono::steady_clock::now();resize_bilinear_kernel<<<t.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));C(aclrtSynchronizeStream(st),"sync");auto b=std::chrono::steady_clock::now();C(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"d2h");if(!WriteFile(A(argc,argv,"--output"),hy,yb))throw std::runtime_error("write");std::cout<<"resize_bilinear completed numel="<<t.outputNumel<<" blocks="<<t.blockNum<<" kernel_us="<<std::chrono::duration<double,std::micro>(b-a).count()<<"\n";for(void*p:{dt,dy,dx})aclrtFree(p);for(void*p:{hy,hx})aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
