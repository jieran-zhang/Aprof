#include <chrono>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "unique_tiling.h"
#include "data_utils.h"
#include "../op_kernel/unique_kernel.asc"
namespace{
void C(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
uint32_t D(const std::string&s){if(s=="float16")return UNIQUE_FP16;if(s=="float32")return UNIQUE_FP32;if(s=="bfloat16")return UNIQUE_BF16;if(s=="int8")return UNIQUE_INT8;if(s=="int32")return UNIQUE_INT32;if(s=="int64")return UNIQUE_INT64;if(s=="uint8")return UNIQUE_UINT8;throw std::invalid_argument("dtype");}
size_t Z(uint32_t d){return(d==UNIQUE_INT8||d==UNIQUE_UINT8)?1:(d==UNIQUE_FP16||d==UNIQUE_BF16)?2:(d==UNIQUE_FP32||d==UNIQUE_INT32)?4:8;}
}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: unique --dtype T --return-inverse 0|1 --input F --y F --inverse F --meta F [--device N]\n";return 2;}int dev=0;bool init=false,set=false;aclrtStream st=nullptr;void *dx=nullptr,*ka=nullptr,*kb=nullptr,*dy=nullptr,*di=nullptr,*dh=nullptr,*dc=nullptr,*dt=nullptr;try{
 std::string dtypeName=A(argc,argv,"--dtype");uint32_t dtype=D(dtypeName);size_t item=Z(dtype);bool needInv=std::stoi(A(argc,argv,"--return-inverse","0"))!=0;std::vector<uint8_t>x;if(!ReadAll(A(argc,argv,"--input"),x)||x.size()%item)throw std::runtime_error("read input");uint64_t n=x.size()/item;dev=std::stoi(A(argc,argv,"--device","0"));C(aclInit(nullptr),"init");init=true;C(aclrtSetDevice(dev),"set");set=true;int64_t cores=1;C(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");auto t=ComputeUniqueTiling(n,dtype,needInv,cores);size_t keyBytes=size_t(n)*8,invBytes=needInv?keyBytes:8,yMax=std::max<size_t>(1,x.size());C(aclrtCreateStream(&st),"stream");C(aclrtMalloc(&dx,x.size(),ACL_MEM_MALLOC_HUGE_FIRST),"dev input");C(aclrtMalloc(&ka,keyBytes,ACL_MEM_MALLOC_HUGE_FIRST),"dev keys a");C(aclrtMalloc(&kb,keyBytes,ACL_MEM_MALLOC_HUGE_FIRST),"dev keys b");C(aclrtMalloc(&dy,yMax,ACL_MEM_MALLOC_HUGE_FIRST),"dev y");C(aclrtMalloc(&di,invBytes,ACL_MEM_MALLOC_HUGE_FIRST),"dev inverse");C(aclrtMalloc(&dh,512*8,ACL_MEM_MALLOC_HUGE_FIRST),"dev histogram");C(aclrtMalloc(&dc,8,ACL_MEM_MALLOC_HUGE_FIRST),"dev count");C(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"dev tiling");C(aclrtMemcpy(dx,x.size(),x.data(),x.size(),ACL_MEMCPY_HOST_TO_DEVICE),"h2d input");C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"h2d tiling");auto k0=std::chrono::steady_clock::now();unique_encode_kernel<<<t.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(ka),static_cast<uint8_t*>(dt));void*src=ka;void*dst=kb;for(uint32_t p=0;p<t.radixPasses;++p){unique_radix_kernel<<<1,nullptr,st>>>(static_cast<uint8_t*>(src),static_cast<uint8_t*>(dst),static_cast<uint8_t*>(dh),static_cast<uint8_t*>(dt),p*8);void*tmp=src;src=dst;dst=tmp;}void*uniqueKeys=dst;unique_emit_kernel<<<1,nullptr,st>>>(static_cast<uint8_t*>(src),static_cast<uint8_t*>(uniqueKeys),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(dt));if(needInv)unique_inverse_kernel<<<t.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(uniqueKeys),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(di),static_cast<uint8_t*>(dt));C(aclrtSynchronizeStream(st),"sync");auto k1=std::chrono::steady_clock::now();uint64_t count=0;C(aclrtMemcpy(&count,8,dc,8,ACL_MEMCPY_DEVICE_TO_HOST),"d2h count");if(count>n)throw std::runtime_error("invalid unique count");std::vector<uint8_t>y(size_t(count)*item);if(!y.empty())C(aclrtMemcpy(y.data(),y.size(),dy,y.size(),ACL_MEMCPY_DEVICE_TO_HOST),"d2h y");if(!WriteAll(A(argc,argv,"--y"),y.data(),y.size()))throw std::runtime_error("write y");std::vector<int64_t>inv;if(needInv){inv.resize(n);C(aclrtMemcpy(inv.data(),invBytes,di,invBytes,ACL_MEMCPY_DEVICE_TO_HOST),"d2h inverse");if(!WriteAll(A(argc,argv,"--inverse"),inv.data(),invBytes))throw std::runtime_error("write inverse");}double us=std::chrono::duration<double,std::micro>(k1-k0).count();std::string meta="{\"unique_count\":"+std::to_string(count)+",\"kernel_us\":"+std::to_string(us)+",\"implementation\":\"npu_radix_sort\"}";if(!WriteAll(A(argc,argv,"--meta"),meta.data(),meta.size()))throw std::runtime_error("write meta");std::cout<<"unique completed unique_count="<<count<<" kernel_us="<<us<<" implementation=npu_radix_sort\n";for(void*p:{dt,dc,dh,di,dy,kb,ka,dx})aclrtFree(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"unique failed: "<<e.what()<<"\n";for(void*p:{dt,dc,dh,di,dy,kb,ka,dx})if(p)aclrtFree(p);if(st)aclrtDestroyStream(st);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}}
