#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "maximum_tiling.h"
#include "data_utils.h"
#include "../op_kernel/maximum_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string token;
    while (std::getline(ss, token, ',')) out.push_back(std::stoull(token));
    return out;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return MAX_FLOAT16; if (s == "float32") return MAX_FLOAT32;
    if (s == "bfloat16") return MAX_BFLOAT16; if (s == "int8") return MAX_INT8;
    if (s == "int32") return MAX_INT32; if (s == "int64") return MAX_INT64;
    throw std::invalid_argument("unsupported dtype: " + s);
}
size_t ItemSize(uint32_t d) { return d == MAX_INT8 ? 1 : (d == MAX_FLOAT16 || d == MAX_BFLOAT16 ? 2 : (d == MAX_INT64 ? 8 : 4)); }
uint64_t Numel(const std::vector<uint64_t> &shape) { uint64_t n = 1; for (auto d : shape) n *= d; return n; }
}

int main(int argc, char **argv) {
    if (argc < 2) { std::cerr << "usage: maximum --x1-shape DIMS --x2-shape DIMS --dtype TYPE --x1 FILE --x2 FILE --output FILE [--device N]\n"; return 2; }
    int device = 0; aclrtStream stream = nullptr;
    void *hostX1 = nullptr, *hostX2 = nullptr, *hostOut = nullptr;
    void *devX1 = nullptr, *devX2 = nullptr, *devOut = nullptr, *devTiling = nullptr;
    try {
        const auto s1 = Shape(Arg(argc, argv, "--x1-shape")), s2 = Shape(Arg(argc, argv, "--x2-shape"));
        const uint32_t dtype = DType(Arg(argc, argv, "--dtype")); const size_t item = ItemSize(dtype);
        const size_t x1Bytes = Numel(s1) * item, x2Bytes = Numel(s2) * item;
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit"); Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1; Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeMaximumTiling(s1, s2, dtype, cores); const size_t outBytes = tiling.totalLength * item;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostX1, x1Bytes), "aclrtMallocHost x1"); Check(aclrtMallocHost(&hostX2, x2Bytes), "aclrtMallocHost x2");
        Check(aclrtMallocHost(&hostOut, outBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devX1, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x1"); Check(aclrtMalloc(&devX2, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x2");
        Check(aclrtMalloc(&devOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output"); Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--x1"), hostX1, x1Bytes)) throw std::runtime_error("read x1 failed");
        if (!ReadFile(Arg(argc, argv, "--x2"), hostX2, x2Bytes)) throw std::runtime_error("read x2 failed");
        Check(aclrtMemcpy(devX1, x1Bytes, hostX1, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x1"); Check(aclrtMemcpy(devX2, x2Bytes, hostX2, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x2");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        maximum_kernel<<<tiling.blockNum, nullptr, stream>>>(static_cast<uint8_t *>(devX1), static_cast<uint8_t *>(devX2), static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize"); Check(aclrtMemcpy(hostOut, outBytes, devOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, outBytes)) throw std::runtime_error("write output failed");
        std::cout << "maximum_kernel completed: numel=" << tiling.totalLength << " blocks=" << tiling.blockNum << " tile=" << tiling.tileElements << "\n";
        aclrtFree(devTiling); aclrtFree(devOut); aclrtFree(devX2); aclrtFree(devX1); aclrtFreeHost(hostOut); aclrtFreeHost(hostX2); aclrtFreeHost(hostX1); aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return 0;
    } catch (const std::exception &e) {
        std::cerr << "maximum failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOut) aclrtFree(devOut); if (devX2) aclrtFree(devX2); if (devX1) aclrtFree(devX1);
        if (hostOut) aclrtFreeHost(hostOut); if (hostX2) aclrtFreeHost(hostX2); if (hostX1) aclrtFreeHost(hostX1); if (stream) aclrtDestroyStream(stream);
        aclrtResetDevice(device); aclFinalize(); return 1;
    }
}
