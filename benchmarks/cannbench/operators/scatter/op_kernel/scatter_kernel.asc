#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "scatter_tiling.h"

__aicore__ inline float ScatterHalfToFloat(half value) {
    const uint16_t bits = *reinterpret_cast<uint16_t *>(&value);
    const uint32_t sign = static_cast<uint32_t>(bits & 0x8000U) << 16;
    const uint32_t exponent = (bits >> 10) & 0x1fU;
    uint32_t mantissa = bits & 0x03ffU;
    uint32_t result = sign;
    if (exponent == 0x1fU) {
        result |= 0x7f800000U | (mantissa << 13);
        if (mantissa != 0) result |= 0x00400000U;
    } else if (exponent != 0) {
        result |= (exponent + 112U) << 23;
        result |= mantissa << 13;
    } else if (mantissa != 0) {
        int32_t unbiasedExponent = -14;
        while ((mantissa & 0x0400U) == 0) {
            mantissa <<= 1;
            --unbiasedExponent;
        }
        mantissa &= 0x03ffU;
        result |= static_cast<uint32_t>(unbiasedExponent + 127) << 23;
        result |= mantissa << 13;
    }
    return *reinterpret_cast<float *>(&result);
}

__aicore__ inline half ScatterFloatToHalfRne(float value) {
    const uint32_t bits = *reinterpret_cast<uint32_t *>(&value);
    const uint16_t sign = static_cast<uint16_t>((bits >> 16) & 0x8000U);
    const uint32_t exponent = (bits >> 23) & 0xffU;
    uint32_t mantissa = bits & 0x7fffffU;
    uint16_t result = sign;
    if (exponent == 0xffU) {
        result = static_cast<uint16_t>(sign | (mantissa == 0 ? 0x7c00U : 0x7e00U));
    } else {
        int32_t halfExponent = static_cast<int32_t>(exponent) - 127 + 15;
        if (halfExponent >= 31) {
            result = static_cast<uint16_t>(sign | 0x7c00U);
        } else if (halfExponent <= 0) {
            if (halfExponent >= -10) {
                mantissa |= 0x800000U;
                const uint32_t shift = static_cast<uint32_t>(14 - halfExponent);
                uint32_t rounded = mantissa >> shift;
                const uint32_t remainder = mantissa & ((1U << shift) - 1U);
                const uint32_t halfway = 1U << (shift - 1U);
                if (remainder > halfway || (remainder == halfway && (rounded & 1U))) ++rounded;
                result = static_cast<uint16_t>(sign | rounded);
            }
        } else {
            uint32_t rounded = mantissa >> 13;
            const uint32_t remainder = mantissa & 0x1fffU;
            if (remainder > 0x1000U || (remainder == 0x1000U && (rounded & 1U))) ++rounded;
            if (rounded == 0x400U) {
                rounded = 0;
                ++halfExponent;
                if (halfExponent >= 31) {
                    result = static_cast<uint16_t>(sign | 0x7c00U);
                    return *reinterpret_cast<half *>(&result);
                }
            }
            result = static_cast<uint16_t>(sign | (static_cast<uint32_t>(halfExponent) << 10) | rounded);
        }
    }
    return *reinterpret_cast<half *>(&result);
}

template <typename T>
__aicore__ inline T ScatterReadGmBypass(__gm__ T *address) {
    if constexpr (sizeof(T) == 8) {
        uint64_t bits = AscendC::ReadGmByPassDCache(reinterpret_cast<__gm__ uint64_t *>(address));
        return *reinterpret_cast<T *>(&bits);
    } else if constexpr (sizeof(T) == 4) {
        uint32_t bits = AscendC::ReadGmByPassDCache(reinterpret_cast<__gm__ uint32_t *>(address));
        return *reinterpret_cast<T *>(&bits);
    } else {
        uint16_t bits = AscendC::ReadGmByPassDCache(reinterpret_cast<__gm__ uint16_t *>(address));
        return *reinterpret_cast<T *>(&bits);
    }
}

template <typename T>
__aicore__ inline void ScatterWriteGmBypass(__gm__ T *address, T value) {
    if constexpr (sizeof(T) == 8) {
        const uint64_t bits = *reinterpret_cast<uint64_t *>(&value);
        AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint64_t *>(address), bits);
    } else if constexpr (sizeof(T) == 4) {
        const uint32_t bits = *reinterpret_cast<uint32_t *>(&value);
        AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t *>(address), bits);
    } else {
        const uint16_t bits = *reinterpret_cast<uint16_t *>(&value);
        AscendC::WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t *>(address), bits);
    }
}

template <typename T>
__aicore__ inline T ScatterAddValue(T a, T b) { return a + b; }

template <>
__aicore__ inline half ScatterAddValue<half>(half a, half b) {
    const float af = ScatterHalfToFloat(a);
    const float bf = ScatterHalfToFloat(b);
    return ScatterFloatToHalfRne(af + bf);
}

template <>
__aicore__ inline bfloat16_t ScatterAddValue<bfloat16_t>(bfloat16_t a, bfloat16_t b) {
    const float af = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(a);
    const float bf = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(b);
    return AscendC::ScalarCast<float, bfloat16_t, AscendC::RoundMode::CAST_RINT>(af + bf);
}

template <typename T>
__aicore__ inline T ScatterMultiplyValue(T a, T b) { return a * b; }

template <>
__aicore__ inline half ScatterMultiplyValue<half>(half a, half b) {
    const float af = ScatterHalfToFloat(a);
    const float bf = ScatterHalfToFloat(b);
    return ScatterFloatToHalfRne(af * bf);
}

template <>
__aicore__ inline bfloat16_t ScatterMultiplyValue<bfloat16_t>(bfloat16_t a, bfloat16_t b) {
    const float af = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(a);
    const float bf = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(b);
    return AscendC::ScalarCast<float, bfloat16_t, AscendC::RoundMode::CAST_RINT>(af * bf);
}

template <typename T>
__aicore__ inline T ScatterMinValue(T a, T b) { return b < a ? b : a; }

template <>
__aicore__ inline half ScatterMinValue<half>(half a, half b) {
    const float af = ScatterHalfToFloat(a);
    const float bf = ScatterHalfToFloat(b);
    return bf < af ? b : a;
}

template <>
__aicore__ inline bfloat16_t ScatterMinValue<bfloat16_t>(bfloat16_t a, bfloat16_t b) {
    const float af = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(a);
    const float bf = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(b);
    return bf < af ? b : a;
}

template <typename T>
__aicore__ inline T ScatterMaxValue(T a, T b) { return b > a ? b : a; }

template <>
__aicore__ inline half ScatterMaxValue<half>(half a, half b) {
    const float af = ScatterHalfToFloat(a);
    const float bf = ScatterHalfToFloat(b);
    return bf > af ? b : a;
}

template <>
__aicore__ inline bfloat16_t ScatterMaxValue<bfloat16_t>(bfloat16_t a, bfloat16_t b) {
    const float af = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(a);
    const float bf = AscendC::ScalarCast<bfloat16_t, float, AscendC::RoundMode::CAST_NONE>(b);
    return bf > af ? b : a;
}

template <typename T, typename IndexT>
__aicore__ inline void ScatterProcess(GM_ADDR indices, GM_ADDR updates, GM_ADDR output, GM_ADDR accumulator,
                                      const __gm__ ScatterTilingData *t) {
    __gm__ const IndexT *indexGm = reinterpret_cast<__gm__ const IndexT *>(indices);
    __gm__ const T *updateGm = reinterpret_cast<__gm__ const T *>(updates);
    __gm__ T *outGm = reinterpret_cast<__gm__ T *>(output);
    __gm__ float *accumulatorGm = reinterpret_cast<__gm__ float *>(accumulator);
    for (uint64_t linear = 0; linear < t->updateLength; ++linear) {
        uint64_t rem = linear;
        uint64_t target = 0;
        for (int32_t axis = static_cast<int32_t>(t->rank) - 1; axis >= 0; --axis) {
            const uint64_t coord = rem % t->updateShape[axis];
            rem /= t->updateShape[axis];
            const uint64_t outCoord = static_cast<uint32_t>(axis) == t->dim
                                          ? static_cast<uint64_t>(indexGm[linear]) : coord;
            target += outCoord * t->dataStride[axis];
        }
        const T update = updateGm[linear];
        if constexpr (std::is_same<T, half>::value) {
            if (t->reduce == SCATTER_ADD || t->reduce == SCATTER_MULTIPLY) {
                const float updateFloat = ScatterHalfToFloat(update);
                const float currentFloat = accumulatorGm[target];
                const float resultFloat = t->reduce == SCATTER_ADD
                                              ? currentFloat + updateFloat : currentFloat * updateFloat;
                accumulatorGm[target] = resultFloat;
                continue;
            }
        }
        if (t->reduce == SCATTER_UPDATE) {
            outGm[target] = update;
        } else {
            const T current = outGm[target];
            T result;
            if (t->reduce == SCATTER_ADD) result = ScatterAddValue<T>(current, update);
            else if (t->reduce == SCATTER_MULTIPLY) result = ScatterMultiplyValue<T>(current, update);
            else if (t->reduce == SCATTER_AMIN) result = ScatterMinValue<T>(current, update);
            else result = ScatterMaxValue<T>(current, update);
            outGm[target] = result;
        }
    }
    if constexpr (std::is_same<T, half>::value) {
        if (t->reduce == SCATTER_ADD || t->reduce == SCATTER_MULTIPLY) {
            AscendC::GlobalTensor<float> accumulatorTensor;
            accumulatorTensor.SetGlobalBuffer(accumulatorGm, t->dataLength);
            AscendC::DataCacheCleanAndInvalid<float, AscendC::CacheLine::ENTIRE_DATA_CACHE,
                                              AscendC::DcciDst::CACHELINE_OUT>(accumulatorTensor);
        }
    }
    if (t->reduce != SCATTER_UPDATE &&
        !(std::is_same<T, half>::value &&
          (t->reduce == SCATTER_ADD || t->reduce == SCATTER_MULTIPLY))) {
        AscendC::GlobalTensor<T> outputTensor;
        outputTensor.SetGlobalBuffer(outGm, t->dataLength);
        AscendC::DataCacheCleanAndInvalid<T, AscendC::CacheLine::ENTIRE_DATA_CACHE,
                                          AscendC::DcciDst::CACHELINE_OUT>(outputTensor);
    }
}

template <typename T>
__aicore__ inline void ScatterDispatchIndex(GM_ADDR indices, GM_ADDR updates, GM_ADDR output, GM_ADDR accumulator,
                                             const __gm__ ScatterTilingData *t) {
    if (t->indexType == SCATTER_INDEX_INT32)
        ScatterProcess<T, int32_t>(indices, updates, output, accumulator, t);
    else
        ScatterProcess<T, int64_t>(indices, updates, output, accumulator, t);
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void scatter_kernel(
    GM_ADDR indices, GM_ADDR updates, GM_ADDR output, GM_ADDR accumulator, GM_ADDR tilingAddr) {
    if (AscendC::GetBlockIdx() != 0) return;
    const __gm__ ScatterTilingData *t =
        reinterpret_cast<const __gm__ ScatterTilingData *>(tilingAddr);
    if (t->dataType == SCATTER_FLOAT16) ScatterDispatchIndex<half>(indices, updates, output, accumulator, t);
    else if (t->dataType == SCATTER_FLOAT32) ScatterDispatchIndex<float>(indices, updates, output, accumulator, t);
    else if (t->dataType == SCATTER_BFLOAT16) ScatterDispatchIndex<bfloat16_t>(indices, updates, output, accumulator, t);
    else if (t->dataType == SCATTER_INT32) ScatterDispatchIndex<int32_t>(indices, updates, output, accumulator, t);
    else ScatterDispatchIndex<int64_t>(indices, updates, output, accumulator, t);
}

template <typename SrcT, typename DstT, AscendC::RoundMode mode>
class ScatterConvertKernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                const __gm__ ScatterTilingData *t) {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->convertBlockLength;
        const uint64_t remain = t->dataLength > begin ? t->dataLength - begin : 0;
        length_ = remain < t->convertBlockLength ? remain : t->convertBlockLength;
        input_.SetGlobalBuffer(reinterpret_cast<__gm__ SrcT *>(input) + begin, length_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ DstT *>(output) + begin, length_);
        pipe_.InitBuffer(inputQ_, 1, kTileElements * sizeof(SrcT));
        pipe_.InitBuffer(outputQ_, 1, kTileElements * sizeof(DstT));
    }

    __aicore__ inline void Process() {
        for (uint64_t offset = 0; offset < length_; offset += kTileElements) {
            const uint32_t count = static_cast<uint32_t>(
                length_ - offset < kTileElements ? length_ - offset : kTileElements);
            auto inputLocal = inputQ_.AllocTensor<SrcT>();
            AscendC::DataCopyExtParams inputParams{
                1, static_cast<uint32_t>(count * sizeof(SrcT)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<SrcT> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(inputLocal, input_[offset], inputParams, pad);
            inputQ_.EnQue(inputLocal);
            inputLocal = inputQ_.DeQue<SrcT>();
            auto outputLocal = outputQ_.AllocTensor<DstT>();
            AscendC::Cast(outputLocal, inputLocal, mode, count);
            outputQ_.EnQue(outputLocal);
            inputQ_.FreeTensor(inputLocal);
            outputLocal = outputQ_.DeQue<DstT>();
            AscendC::DataCopyExtParams outputParams{
                1, static_cast<uint32_t>(count * sizeof(DstT)), 0, 0, 0};
            AscendC::DataCopyPad(output_[offset], outputLocal, outputParams);
            outputQ_.FreeTensor(outputLocal);
        }
    }

private:
    static constexpr uint32_t kTileElements = 4096;
    uint64_t length_;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<SrcT> input_;
    AscendC::GlobalTensor<DstT> output_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQ_;
};

extern "C" __global__ __aicore__ __attribute__((aiv)) void scatter_half_to_float_kernel(
    GM_ADDR input, GM_ADDR accumulator, GM_ADDR tilingAddr) {
    const __gm__ ScatterTilingData *t =
        reinterpret_cast<const __gm__ ScatterTilingData *>(tilingAddr);
    ScatterConvertKernel<half, float, AscendC::RoundMode::CAST_NONE> op;
    op.Init(input, accumulator, t);
    op.Process();
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void scatter_float_to_half_kernel(
    GM_ADDR accumulator, GM_ADDR output, GM_ADDR tilingAddr) {
    const __gm__ ScatterTilingData *t =
        reinterpret_cast<const __gm__ ScatterTilingData *>(tilingAddr);
    ScatterConvertKernel<float, half, AscendC::RoundMode::CAST_RINT> op;
    op.Init(accumulator, output, t);
    op.Process();
}
