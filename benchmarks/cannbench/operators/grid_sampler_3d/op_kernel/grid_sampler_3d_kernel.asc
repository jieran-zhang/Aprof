#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "grid_sampler_3d_tiling.h"

template <typename T>
__aicore__ inline float GridToFloat(T value) {
    if constexpr (std::is_same<T, half>::value) {
        const uint16_t raw = *reinterpret_cast<uint16_t *>(&value);
        const uint32_t sign = static_cast<uint32_t>(raw & 0x8000U) << 16;
        const uint32_t exp = (raw >> 10) & 0x1fU;
        uint32_t mantissa = raw & 0x3ffU;
        uint32_t bits = sign;
        if (exp == 0x1fU) {
            bits |= 0x7f800000U | (mantissa << 13);
            if (mantissa) bits |= 0x400000U;
        } else if (exp) {
            bits |= ((exp + 112U) << 23) | (mantissa << 13);
        } else if (mantissa) {
            int32_t e = -14;
            while ((mantissa & 0x400U) == 0) { mantissa <<= 1; --e; }
            mantissa &= 0x3ffU;
            bits |= (static_cast<uint32_t>(e + 127) << 23) | (mantissa << 13);
        }
        return *reinterpret_cast<float *>(&bits);
    } else return value;
}

template <typename T>
__aicore__ inline T GridFromFloat(float value) {
    if constexpr (std::is_same<T, half>::value)
        return AscendC::ScalarCast<float, half, AscendC::RoundMode::CAST_RINT>(value);
    else
        return value;
}

__aicore__ inline float GridClamp(float value, float low, float high) {
    if (value < low) return low;
    if (value > high) return high;
    return value;
}

__aicore__ inline int64_t GridFloor(float value) {
    int64_t out = static_cast<int64_t>(value);
    if (static_cast<float>(out) > value) --out;
    return out;
}

__aicore__ inline int64_t GridRoundEven(float value) {
    const int64_t low = GridFloor(value);
    const float fraction = value - static_cast<float>(low);
    if (fraction < 0.5f) return low;
    if (fraction > 0.5f) return low + 1;
    return (low & 1LL) == 0 ? low : low + 1;
}

__aicore__ inline float GridReflect(float value, uint64_t size, float sizeFloat, uint32_t alignCorners) {
    if (size <= 1) return 0.0f;
    const float low = alignCorners ? 0.0f : -0.5f;
    const float high = alignCorners ? sizeFloat - 1.0f : sizeFloat - 0.5f;
    const float span = high - low;
    float distance = value - low;
    if (distance < 0.0f) distance = -distance;
    int64_t flips = static_cast<int64_t>(distance / span);
    float extra = distance - static_cast<float>(flips) * span;
    float reflected = (flips & 1LL) == 0 ? extra + low : high - extra;
    return GridClamp(reflected, 0.0f, sizeFloat - 1.0f);
}

__aicore__ inline float GridUnnormalize(float coord, float size, uint32_t alignCorners) {
    if (alignCorners) return ((coord + 1.0f) * (size - 1.0f)) * 0.5f;
    return ((coord + 1.0f) * size - 1.0f) * 0.5f;
}

__aicore__ inline float GridApplyPadding(float coord, uint64_t size, float sizeFloat,
                                         uint32_t padding, uint32_t alignCorners) {
    if (padding == GRID_BORDER)
        return GridClamp(coord, 0.0f, sizeFloat - 1.0f);
    if (padding == GRID_REFLECTION)
        return GridReflect(coord, size, sizeFloat, alignCorners);
    return coord;
}

template <typename T>
__aicore__ inline float GridRead(const __gm__ T *x, uint64_t base,
                                 int64_t z, int64_t y, int64_t xx,
                                 const __gm__ GridSampler3DTilingData *t) {
    if (z < 0 || y < 0 || xx < 0 || static_cast<uint64_t>(z) >= t->d ||
        static_cast<uint64_t>(y) >= t->h || static_cast<uint64_t>(xx) >= t->w)
        return 0.0f;
    const uint64_t offset = base + (static_cast<uint64_t>(z) * t->h +
        static_cast<uint64_t>(y)) * t->w + static_cast<uint64_t>(xx);
    return GridToFloat<T>(x[offset]);
}

template <typename T>
__aicore__ inline float GridSampler3DOne(const __gm__ T *x, const __gm__ T *grid,
                                          uint64_t linear,
                                          const __gm__ GridSampler3DTilingData *t) {
        const uint64_t inputSpatial = t->d * t->h * t->w;
        const uint64_t spatial = linear % t->spatialOut;
        const uint64_t nc = linear / t->spatialOut;
        const uint64_t channel = nc % t->c;
        const uint64_t batch = nc / t->c;
        const uint64_t gridBase = (batch * t->spatialOut + spatial) * 3;
        float ix = GridUnnormalize(GridToFloat<T>(grid[gridBase]), t->wFloat, t->alignCorners);
        float iy = GridUnnormalize(GridToFloat<T>(grid[gridBase + 1]), t->hFloat, t->alignCorners);
        float iz = GridUnnormalize(GridToFloat<T>(grid[gridBase + 2]), t->dFloat, t->alignCorners);
        ix = GridApplyPadding(ix, t->w, t->wFloat, t->padding, t->alignCorners);
        iy = GridApplyPadding(iy, t->h, t->hFloat, t->padding, t->alignCorners);
        iz = GridApplyPadding(iz, t->d, t->dFloat, t->padding, t->alignCorners);
        const uint64_t xBase = (batch * t->c + channel) * inputSpatial;
        float result = 0.0f;
        if (t->interpolation == GRID_NEAREST) {
            const int64_t xn = GridRoundEven(ix), yn = GridRoundEven(iy), zn = GridRoundEven(iz);
            result = GridRead<T>(x, xBase, zn, yn, xn, t);
        } else {
            const int64_t x0 = GridFloor(ix), y0 = GridFloor(iy), z0 = GridFloor(iz);
            const int64_t x1 = x0 + 1, y1 = y0 + 1, z1 = z0 + 1;
            const float dx = ix - static_cast<float>(x0);
            const float dy = iy - static_cast<float>(y0);
            const float dz = iz - static_cast<float>(z0);
            const float wx0 = 1.0f - dx, wy0 = 1.0f - dy, wz0 = 1.0f - dz;
            result += GridRead<T>(x, xBase, z0, y0, x0, t) * wx0 * wy0 * wz0;
            result += GridRead<T>(x, xBase, z0, y0, x1, t) * dx  * wy0 * wz0;
            result += GridRead<T>(x, xBase, z0, y1, x0, t) * wx0 * dy  * wz0;
            result += GridRead<T>(x, xBase, z0, y1, x1, t) * dx  * dy  * wz0;
            result += GridRead<T>(x, xBase, z1, y0, x0, t) * wx0 * wy0 * dz;
            result += GridRead<T>(x, xBase, z1, y0, x1, t) * dx  * wy0 * dz;
            result += GridRead<T>(x, xBase, z1, y1, x0, t) * wx0 * dy  * dz;
            result += GridRead<T>(x, xBase, z1, y1, x1, t) * dx  * dy  * dz;
        }
        return result;
}

template <typename T>
__aicore__ inline void GridSampler3DScalar(GM_ADDR xAddr, GM_ADDR gridAddr, GM_ADDR yAddr,
                                            const __gm__ GridSampler3DTilingData *t) {
    const __gm__ T *x = reinterpret_cast<const __gm__ T *>(xAddr);
    const __gm__ T *grid = reinterpret_cast<const __gm__ T *>(gridAddr);
    __gm__ T *out = reinterpret_cast<__gm__ T *>(yAddr);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->outputNumel) end = t->outputNumel;
    for (uint64_t linear = begin; linear < end; ++linear) {
        out[linear] = GridFromFloat<T>(GridSampler3DOne<T>(x, grid, linear, t));
    }
}

class GridSampler3DHalf {
public:
    __aicore__ inline void Init(GM_ADDR xAddr, GM_ADDR gridAddr, GM_ADDR yAddr,
                                const __gm__ GridSampler3DTilingData *t) {
        t_ = t;
        x_ = reinterpret_cast<const __gm__ half *>(xAddr);
        grid_ = reinterpret_cast<const __gm__ half *>(gridAddr);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yAddr), t->outputNumel);
        pipe_.InitBuffer(fpBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(rawBuf_, kTile * sizeof(half));
    }
    __aicore__ inline void Process() {
        const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->blockLength;
        uint64_t end = begin + t_->blockLength;
        if (end > t_->outputNumel) end = t_->outputNumel;
        auto fp = fpBuf_.Get<float>();
        auto raw = rawBuf_.Get<half>();
        for (uint64_t offset = begin; offset < end; offset += kTile) {
            const uint32_t count = static_cast<uint32_t>(end - offset < kTile ? end - offset : kTile);
            for (uint32_t i = 0; i < count; ++i)
                fp.SetValue(i, GridSampler3DOne<half>(x_, grid_, offset + i, t_));
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Cast(raw, fp, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams copy{1, count * static_cast<uint32_t>(sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPad(y_[offset], raw, copy);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    static constexpr uint32_t kTile = 1024;
    const __gm__ GridSampler3DTilingData *t_;
    const __gm__ half *x_;
    const __gm__ half *grid_;
    AscendC::GlobalTensor<half> y_;
    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpBuf_, rawBuf_;
};

extern "C" __global__ __aicore__ __attribute__((aiv)) void grid_sampler_3d_kernel(
    GM_ADDR x, GM_ADDR grid, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ GridSampler3DTilingData *t =
        reinterpret_cast<const __gm__ GridSampler3DTilingData *>(tilingAddr);
    if (t->dtype == GRID_FP16) {
        GridSampler3DHalf op; op.Init(x, grid, y, t); op.Process();
    } else GridSampler3DScalar<float>(x, grid, y, t);
}
