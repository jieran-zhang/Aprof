#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "rms_norm_tiling.h"
#include "data_utils.h"
#include "../op_kernel/rms_norm_kernel.asc"

namespace {
void Check(aclError ret,const char *what){if(ret!=ACL_SUCCESS)throw std::runtime_error(std::string(what)+" failed: "+std::to_string(ret));}
std::string Arg(int argc,char **argv,const std::string &name,const std::string &def=""){for(int i=1;i+1<argc;++i)if(argv[i]==name)return argv[i+1];return def;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream ss(s);std::string t;while(std::getline(ss,t,','))o.push_back(std::stoull(t));return o;}
uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto d:s)n*=d;return n;}
uint32_t DType(const std::string&s){if(s=="float16")return RMS_FLOAT16;if(s=="float32")return RMS_FLOAT32;if(s=="bfloat16")return RMS_BFLOAT16;throw std::invalid_argument("unsupported dtype: "+s);}
size_t ItemSize(uint32_t d){return d==RMS_FLOAT32?4:2;}
}

int main(int argc,char **argv){
 if(argc<2){std::cerr<<"usage: rms_norm --shape DIMS --dtype TYPE --epsilon E --x FILE --gamma FILE --output FILE [--device N]\n";return 2;}
 int device=2;bool initialized=false,deviceSet=false;aclrtStream stream=nullptr;
 void *hostX=nullptr,*hostGamma=nullptr,*hostY=nullptr,*devX=nullptr,*devGamma=nullptr,*devY=nullptr,*devTiling=nullptr;
 try{
  const auto shape=Shape(Arg(argc,argv,"--shape"));if(shape.size()<2||shape.size()>8)throw std::invalid_argument("rank must be in [2,8]");
  const uint32_t dtype=DType(Arg(argc,argv,"--dtype"));const uint32_t hidden=static_cast<uint32_t>(shape.back());
  const float epsilon=std::stof(Arg(argc,argv,"--epsilon","1e-6"));const uint64_t numel=Numel(shape);const size_t item=ItemSize(dtype);
  const size_t xBytes=numel*item,gammaBytes=hidden*item;device=std::stoi(Arg(argc,argv,"--device","2"));
  Check(aclInit(nullptr),"aclInit");initialized=true;Check(aclrtSetDevice(device),"aclrtSetDevice");deviceSet=true;
  int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"query vector cores");
  const auto tiling=ComputeRmsNormTiling(numel,hidden,dtype,epsilon,cores);
  Check(aclrtCreateStream(&stream),"aclrtCreateStream");Check(aclrtMallocHost(&hostX,xBytes),"aclrtMallocHost x");
  Check(aclrtMallocHost(&hostGamma,gammaBytes),"aclrtMallocHost gamma");Check(aclrtMallocHost(&hostY,xBytes),"aclrtMallocHost y");
  Check(aclrtMalloc(&devX,xBytes,ACL_MEM_MALLOC_HUGE_FIRST),"aclrtMalloc x");Check(aclrtMalloc(&devGamma,gammaBytes,ACL_MEM_MALLOC_HUGE_FIRST),"aclrtMalloc gamma");
  Check(aclrtMalloc(&devY,xBytes,ACL_MEM_MALLOC_HUGE_FIRST),"aclrtMalloc y");Check(aclrtMalloc(&devTiling,sizeof(tiling),ACL_MEM_MALLOC_HUGE_FIRST),"aclrtMalloc tiling");
  if(!ReadFile(Arg(argc,argv,"--x"),hostX,xBytes))throw std::runtime_error("read x failed");
  if(!ReadFile(Arg(argc,argv,"--gamma"),hostGamma,gammaBytes))throw std::runtime_error("read gamma failed");
  Check(aclrtMemcpy(devX,xBytes,hostX,xBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x");Check(aclrtMemcpy(devGamma,gammaBytes,hostGamma,gammaBytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D gamma");
  Check(aclrtMemcpy(devTiling,sizeof(tiling),&tiling,sizeof(tiling),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
  rms_norm_kernel<<<tiling.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(devX),static_cast<uint8_t*>(devGamma),static_cast<uint8_t*>(devY),static_cast<uint8_t*>(devTiling));
  Check(aclrtSynchronizeStream(stream),"kernel synchronize");Check(aclrtMemcpy(hostY,xBytes,devY,xBytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");
  if(!WriteFile(Arg(argc,argv,"--output"),hostY,xBytes))throw std::runtime_error("write output failed");
  std::cout<<"rms_norm_kernel completed: rows="<<tiling.rows<<" hidden="<<hidden<<" blocks="<<tiling.blockNum<<"\n";
  aclrtFree(devTiling);devTiling=nullptr;aclrtFree(devY);devY=nullptr;aclrtFree(devGamma);devGamma=nullptr;aclrtFree(devX);devX=nullptr;
  aclrtFreeHost(hostY);hostY=nullptr;aclrtFreeHost(hostGamma);hostGamma=nullptr;aclrtFreeHost(hostX);hostX=nullptr;aclrtDestroyStream(stream);stream=nullptr;
  aclrtResetDevice(device);deviceSet=false;aclFinalize();initialized=false;return 0;
 }catch(const std::exception&e){std::cerr<<"rms_norm failed: "<<e.what()<<"\n";
  if(devTiling)aclrtFree(devTiling);if(devY)aclrtFree(devY);if(devGamma)aclrtFree(devGamma);if(devX)aclrtFree(devX);
  if(hostY)aclrtFreeHost(hostY);if(hostGamma)aclrtFreeHost(hostGamma);if(hostX)aclrtFreeHost(hostX);if(stream)aclrtDestroyStream(stream);
  if(deviceSet)aclrtResetDevice(device);if(initialized)aclFinalize();return 1;}
}
