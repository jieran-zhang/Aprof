#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "gather_tiling.h"

template <typename Raw, typename IndexT>
__aicore__ inline void GatherScalar(GM_ADDR xAddr, GM_ADDR indexAddr, GM_ADDR yAddr,
                                    const __gm__ GatherTilingData *t) {
    __gm__ Raw *x = reinterpret_cast<__gm__ Raw *>(xAddr);
    __gm__ IndexT *index = reinterpret_cast<__gm__ IndexT *>(indexAddr);
    __gm__ Raw *y = reinterpret_cast<__gm__ Raw *>(yAddr);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->totalLength) end = t->totalLength;
    for (uint64_t linear = begin; linear < end; ++linear) {
        const IndexT rawIndex = index[linear];
        if (rawIndex < 0 || static_cast<uint64_t>(rawIndex) >= t->gatherDimSize) {
            // Host rejects invalid input; retain a device-side memory-safety guard.
            y[linear] = static_cast<Raw>(0);
            continue;
        }
        uint64_t rem = linear;
        uint64_t source = 0;
        for (int d = static_cast<int>(t->rank) - 1; d >= 0; --d) {
            const uint64_t coord = rem % t->indexShape[d];
            rem /= t->indexShape[d];
            source += (static_cast<uint32_t>(d) == t->dim
                ? static_cast<uint64_t>(rawIndex) : coord) * t->xStride[d];
        }
        y[linear] = x[source];
    }
}

template <typename Raw>
__aicore__ inline void DispatchGatherIndex(GM_ADDR x, GM_ADDR index, GM_ADDR y,
                                           const __gm__ GatherTilingData *t) {
    if (t->indexDtype == GATHER_INDEX_INT8) GatherScalar<Raw, int8_t>(x, index, y, t);
    else if (t->indexDtype == GATHER_INDEX_INT32) GatherScalar<Raw, int32_t>(x, index, y, t);
    else GatherScalar<Raw, int64_t>(x, index, y, t);
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void gather_kernel(
    GM_ADDR x, GM_ADDR index, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ GatherTilingData *t = reinterpret_cast<const __gm__ GatherTilingData *>(tilingAddr);
    // Gather is a bit-preserving copy, so dispatch by storage width rather than arithmetic dtype.
    if (t->xItemBytes == 1) DispatchGatherIndex<uint8_t>(x, index, y, t);
    else if (t->xItemBytes == 2) DispatchGatherIndex<uint16_t>(x, index, y, t);
    else if (t->xItemBytes == 4) DispatchGatherIndex<uint32_t>(x, index, y, t);
    else DispatchGatherIndex<uint64_t>(x, index, y, t);
}
