#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "gather_tiling.h"
#include "data_utils.h"
#include "../op_kernel/gather_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
std::vector<uint64_t> Shape(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string token;
    while (std::getline(ss, token, ',')) out.push_back(std::stoull(token));
    return out;
}
uint64_t Numel(const std::vector<uint64_t> &shape) { uint64_t n = 1; for (uint64_t d : shape) n *= d; return n; }
uint32_t XItemBytes(const std::string &s) {
    if (s == "int8") return 1;
    if (s == "float16" || s == "bfloat16") return 2;
    if (s == "float32" || s == "int32") return 4;
    if (s == "int64") return 8;
    throw std::invalid_argument("unsupported x dtype: " + s);
}
uint32_t IndexDType(const std::string &s) {
    if (s == "int8") return GATHER_INDEX_INT8;
    if (s == "int32") return GATHER_INDEX_INT32;
    if (s == "int64") return GATHER_INDEX_INT64;
    throw std::invalid_argument("unsupported index dtype: " + s);
}
size_t IndexItemBytes(uint32_t d) { return d == GATHER_INDEX_INT8 ? 1 : (d == GATHER_INDEX_INT32 ? 4 : 8); }
template <typename T>
void ValidateIndices(const void *data, uint64_t count, uint64_t upper) {
    const T *p = static_cast<const T *>(data);
    for (uint64_t i = 0; i < count; ++i) {
        if (p[i] < 0 || static_cast<uint64_t>(p[i]) >= upper)
            throw std::invalid_argument("index value out of [0, x.shape[dim]) at linear offset " + std::to_string(i));
    }
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: gather --x-shape DIMS --index-shape DIMS --x-dtype TYPE "
                     "--index-dtype int8|int32|int64 --dim N --x FILE --index FILE --output FILE [--device N]\n";
        return 2;
    }
    int device = 2; bool initialized = false, deviceSet = false; aclrtStream stream = nullptr;
    void *hostX = nullptr, *hostIndex = nullptr, *hostOut = nullptr;
    void *devX = nullptr, *devIndex = nullptr, *devOut = nullptr, *devTiling = nullptr;
    try {
        const auto xShape = Shape(Arg(argc, argv, "--x-shape"));
        const auto indexShape = Shape(Arg(argc, argv, "--index-shape"));
        const uint32_t xItem = XItemBytes(Arg(argc, argv, "--x-dtype"));
        const uint32_t indexDtype = IndexDType(Arg(argc, argv, "--index-dtype"));
        const int64_t dimArg = std::stoll(Arg(argc, argv, "--dim", "0"));
        if (dimArg < 0) throw std::invalid_argument("negative dim is outside this operator specification");
        const uint32_t dim = static_cast<uint32_t>(dimArg);
        const uint64_t xNumel = Numel(xShape), indexNumel = Numel(indexShape);
        const size_t xBytes = xNumel * xItem, indexBytes = indexNumel * IndexItemBytes(indexDtype);
        device = std::stoi(Arg(argc, argv, "--device", "2"));
        Check(aclInit(nullptr), "aclInit"); initialized = true;
        Check(aclrtSetDevice(device), "aclrtSetDevice"); deviceSet = true;
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeGatherTiling(xShape, indexShape, dim, xItem, indexDtype, cores);
        const size_t outBytes = tiling.totalLength * xItem;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostX, xBytes), "aclrtMallocHost x");
        Check(aclrtMallocHost(&hostIndex, indexBytes), "aclrtMallocHost index");
        Check(aclrtMallocHost(&hostOut, outBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devX, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
        Check(aclrtMalloc(&devIndex, indexBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc index");
        Check(aclrtMalloc(&devOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--x"), hostX, xBytes)) throw std::runtime_error("read x failed");
        if (!ReadFile(Arg(argc, argv, "--index"), hostIndex, indexBytes)) throw std::runtime_error("read index failed");
        if (indexDtype == GATHER_INDEX_INT8) ValidateIndices<int8_t>(hostIndex, indexNumel, tiling.gatherDimSize);
        else if (indexDtype == GATHER_INDEX_INT32) ValidateIndices<int32_t>(hostIndex, indexNumel, tiling.gatherDimSize);
        else ValidateIndices<int64_t>(hostIndex, indexNumel, tiling.gatherDimSize);
        Check(aclrtMemcpy(devX, xBytes, hostX, xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x");
        Check(aclrtMemcpy(devIndex, indexBytes, hostIndex, indexBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D index");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        gather_kernel<<<tiling.blockNum, nullptr, stream>>>(static_cast<uint8_t *>(devX),
            static_cast<uint8_t *>(devIndex), static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOut, outBytes, devOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, outBytes)) throw std::runtime_error("write output failed");
        std::cout << "gather_kernel completed: numel=" << tiling.totalLength << " blocks=" << tiling.blockNum << "\n";
        aclrtFree(devTiling); devTiling = nullptr; aclrtFree(devOut); devOut = nullptr;
        aclrtFree(devIndex); devIndex = nullptr; aclrtFree(devX); devX = nullptr;
        aclrtFreeHost(hostOut); hostOut = nullptr; aclrtFreeHost(hostIndex); hostIndex = nullptr;
        aclrtFreeHost(hostX); hostX = nullptr; aclrtDestroyStream(stream); stream = nullptr;
        aclrtResetDevice(device); deviceSet = false; aclFinalize(); initialized = false; return 0;
    } catch (const std::exception &e) {
        std::cerr << "gather failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOut) aclrtFree(devOut);
        if (devIndex) aclrtFree(devIndex); if (devX) aclrtFree(devX);
        if (hostOut) aclrtFreeHost(hostOut); if (hostIndex) aclrtFreeHost(hostIndex);
        if (hostX) aclrtFreeHost(hostX); if (stream) aclrtDestroyStream(stream);
        if (deviceSet) aclrtResetDevice(device); if (initialized) aclFinalize(); return 1;
    }
}
