#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "gcd_tiling.h"

template <typename T, typename U>
__aicore__ inline U UnsignedMagnitude(T value) {
    // Same mathematical widening intent as golden.py's int16 -> int32 path;
    // unsigned two's-complement magnitude also remains defined for INT_MIN.
    const U bits = static_cast<U>(value);
    return value < 0 ? static_cast<U>(~bits) + static_cast<U>(1) : bits;
}

template <typename T, typename U>
__aicore__ inline void GcdScalar(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 const __gm__ GcdTilingData *t) {
    __gm__ T *a = reinterpret_cast<__gm__ T *>(x1);
    __gm__ T *b = reinterpret_cast<__gm__ T *>(x2);
    __gm__ T *out = reinterpret_cast<__gm__ T *>(y);
    const uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->blockLength;
    uint64_t end = begin + t->blockLength;
    if (end > t->totalLength) end = t->totalLength;
    for (uint64_t linear = begin; linear < end; ++linear) {
        uint64_t rem = linear, ai = 0, bi = 0;
        for (int dim = static_cast<int>(t->rank) - 1; dim >= 0; --dim) {
            const uint64_t coord = rem % t->outShape[dim];
            rem /= t->outShape[dim];
            ai += coord * t->x1Stride[dim];
            bi += coord * t->x2Stride[dim];
        }
        U av = UnsignedMagnitude<T, U>(a[ai]);
        U bv = UnsignedMagnitude<T, U>(b[bi]);
        while (bv != 0) {
            const U next = av % bv;
            av = bv;
            bv = next;
        }
        out[linear] = static_cast<T>(av);
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void gcd_kernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR tilingAddr) {
    const __gm__ GcdTilingData *t = reinterpret_cast<const __gm__ GcdTilingData *>(tilingAddr);
    if (t->dtype == GCD_INT16) GcdScalar<int16_t, uint16_t>(x1, x2, y, t);
    else if (t->dtype == GCD_INT32) GcdScalar<int32_t, uint32_t>(x1, x2, y, t);
    else GcdScalar<int64_t, uint64_t>(x1, x2, y, t);
}
