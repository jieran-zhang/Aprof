#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "moe_re_routing_tiling.h"

// This kernel constructs both required reductions/mappings on the device.  The
// count matrix is row-major (rank, expert), while the output is expert-major.
template <typename CountT>
__aicore__ inline void BuildRouting(
    GM_ADDR countsAddr, GM_ADDR scalesAddr, GM_ADDR indexAddr, GM_ADDR outputScalesAddr,
    GM_ADDR expertCountAddr,
    const __gm__ MoeReRoutingTilingData *t) {
    if (AscendC::GetBlockIdx() != 0) return;
    const __gm__ CountT *counts = reinterpret_cast<const __gm__ CountT *>(countsAddr);
    __gm__ int32_t *index = reinterpret_cast<__gm__ int32_t *>(indexAddr);
    const __gm__ float *scales = reinterpret_cast<const __gm__ float *>(scalesAddr);
    __gm__ float *outputScales = reinterpret_cast<__gm__ float *>(outputScalesAddr);
    __gm__ CountT *expertCount = reinterpret_cast<__gm__ CountT *>(expertCountAddr);
    uint64_t dst = 0;
    for (uint32_t e = 0; e < t->experts; ++e) {
        CountT expertTotal = static_cast<CountT>(0);
        for (uint32_t r = 0; r < t->ranks; ++r) {
            uint64_t cell = static_cast<uint64_t>(r) * t->experts + e;
            uint64_t count = static_cast<uint64_t>(counts[cell]);
            expertTotal = static_cast<CountT>(expertTotal + counts[cell]);
            uint64_t src = 0;
            for (uint64_t p = 0; p < cell; ++p) src += static_cast<uint64_t>(counts[p]);
            for (uint64_t k = 0; k < count; ++k) {
                index[dst] = static_cast<int32_t>(src + k);
                outputScales[dst] = t->hasScales ? scales[src + k] : 0.0f;
                ++dst;
            }
        }
        expertCount[e] = expertTotal;
    }
}

template <typename TokenT>
__aicore__ inline void GatherRouting(
    GM_ADDR tokensAddr, GM_ADDR indexAddr, GM_ADDR outputAddr,
    const __gm__ MoeReRoutingTilingData *t) {
    const __gm__ int32_t *index = reinterpret_cast<const __gm__ int32_t *>(indexAddr);
    AscendC::GlobalTensor<TokenT> tokens;
    AscendC::GlobalTensor<TokenT> output;
    tokens.SetGlobalBuffer(reinterpret_cast<__gm__ TokenT *>(tokensAddr), t->tokens * t->hidden);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ TokenT *>(outputAddr), t->tokens * t->hidden);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuffer;
    uint32_t rowBytes = static_cast<uint32_t>(t->hidden * sizeof(TokenT));
    uint32_t alignedBytes = ((rowBytes + 31U) / 32U) * 32U;
    pipe.InitBuffer(rowBuffer, alignedBytes);
    auto row = rowBuffer.Get<TokenT>();
    AscendC::DataCopyExtParams copy{1, rowBytes, 0, 0, 0};
    AscendC::DataCopyPadExtParams<TokenT> pad{true, 0, 0, static_cast<TokenT>(0)};
    uint64_t begin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t->tokensPerBlock;
    uint64_t end = begin + t->tokensPerBlock;
    if (end > t->tokens) end = t->tokens;
    for (uint64_t dst = begin; dst < end; ++dst) {
        uint64_t src = static_cast<uint64_t>(index[dst]);
        uint64_t srcBase = src * t->hidden;
        uint64_t dstBase = dst * t->hidden;
        AscendC::DataCopyPad(row, tokens[srcBase], copy, pad);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyPad(output[dstBase], row, copy);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void moe_re_routing_build_kernel(
    GM_ADDR counts, GM_ADDR scales, GM_ADDR index, GM_ADDR outputScales,
    GM_ADDR expertCount, GM_ADDR tilingAddr) {
    const __gm__ MoeReRoutingTilingData *t =
        reinterpret_cast<const __gm__ MoeReRoutingTilingData *>(tilingAddr);
    if (t->countDtype == MRR_INT64) BuildRouting<int64_t>(counts, scales, index, outputScales, expertCount, t);
    else BuildRouting<int32_t>(counts, scales, index, outputScales, expertCount, t);
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void moe_re_routing_gather_kernel(
    GM_ADDR tokens, GM_ADDR index, GM_ADDR output, GM_ADDR tilingAddr) {
    const __gm__ MoeReRoutingTilingData *t =
        reinterpret_cast<const __gm__ MoeReRoutingTilingData *>(tilingAddr);
    if (t->tokenDtype == MRR_FLOAT16)
        GatherRouting<half>(tokens, index, output, t);
    else if (t->tokenDtype == MRR_BFLOAT16)
        GatherRouting<bfloat16_t>(tokens, index, output, t);
    else
        GatherRouting<int8_t>(tokens, index, output, t);
}
