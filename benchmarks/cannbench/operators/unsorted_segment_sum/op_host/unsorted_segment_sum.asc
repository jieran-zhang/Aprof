#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "unsorted_segment_sum_tiling.h"
#include "../op_kernel/unsorted_segment_sum_kernel.asc"
namespace{void C(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+": "+std::to_string(r));}std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}std::vector<uint64_t>S(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string x;while(std::getline(q,x,','))o.push_back(std::stoull(x));return o;}uint32_t DT(const std::string&s){if(s=="float16")return USS_F16;if(s=="float32")return USS_F32;if(s=="bfloat16")return USS_BF16;if(s=="int32")return USS_I32;if(s=="int64")return USS_I64;throw std::invalid_argument("dtype");}uint32_t IT(const std::string&s){if(s=="int32")return USS_ID_I32;if(s=="int64")return USS_ID_I64;throw std::invalid_argument("id dtype");}size_t Z(uint32_t d){return d==USS_F16||d==USS_BF16?2:(d==USS_I64?8:4);}}
int main(int argc,char**argv){if(argc<2)return 2;int dev=2;aclrtStream st=nullptr;void *hd=nullptr,*hi=nullptr,*hy=nullptr,*dd=nullptr,*di=nullptr,*dy=nullptr,*da=nullptr,*dt=nullptr;try{auto sh=S(A(argc,argv,"--shape"));if(sh.empty())throw std::invalid_argument("shape");uint64_t N=sh[0],inner=1;for(size_t i=1;i<sh.size();++i)inner*=sh[i];uint64_t seg=std::stoull(A(argc,argv,"--num-segments"));uint32_t dtype=DT(A(argc,argv,"--dtype")),idtype=IT(A(argc,argv,"--id-dtype"));size_t item=Z(dtype),db=N*inner*item,ib=N*(idtype==USS_ID_I64?8:4),yb=seg*inner*item;dev=std::stoi(A(argc,argv,"--device","2"));C(aclInit(nullptr),"init");C(aclrtSetDevice(dev),"device");int64_t cores=1;C(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");auto t=ComputeUss(N,inner,seg,dtype,idtype,cores);C(aclrtCreateStream(&st),"stream");C(aclrtMallocHost(&hd,db),"host data");C(aclrtMallocHost(&hi,ib),"host ids");C(aclrtMallocHost(&hy,yb),"host out");C(aclrtMalloc(&dd,db,ACL_MEM_MALLOC_HUGE_FIRST),"data");C(aclrtMalloc(&di,ib,ACL_MEM_MALLOC_HUGE_FIRST),"ids");C(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"out");size_t accumItem=(dtype==USS_F16||dtype==USS_BF16)?4:item,ab=t.workspaceLength*accumItem;C(aclrtMalloc(&da,ab,ACL_MEM_MALLOC_HUGE_FIRST),"accum");C(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"tiling");if(!ReadFile(A(argc,argv,"--data"),hd,db)||!ReadFile(A(argc,argv,"--ids"),hi,ib))throw std::runtime_error("read");C(aclrtMemcpy(dd,db,hd,db,ACL_MEMCPY_HOST_TO_DEVICE),"h2d data");C(aclrtMemcpy(di,ib,hi,ib,ACL_MEMCPY_HOST_TO_DEVICE),"h2d ids");C(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"h2d tiling");C(aclrtMemset(da,ab,0,ab),"zero");C(aclrtSynchronizeStream(st),"zero sync");unsorted_segment_sum_kernel<<<1,nullptr,st>>>(static_cast<uint8_t*>(dd),static_cast<uint8_t*>(di),static_cast<uint8_t*>(da),static_cast<uint8_t*>(dt));C(aclrtSynchronizeStream(st),"sum");unsorted_segment_sum_finish<<<t.convertBlockNum,nullptr,st>>>(static_cast<uint8_t*>(da),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));C(aclrtSynchronizeStream(st),"finish");C(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"d2h");if(!WriteFile(A(argc,argv,"--output"),hy,yb))throw std::runtime_error("write");std::cout<<"unsorted_segment_sum completed N="<<N<<" inner="<<inner<<" segments="<<seg<<"\n";for(void*p:{dt,da,dy,di,dd})if(p)aclrtFree(p);for(void*p:{hy,hi,hd})if(p)aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
