#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "depthwise_conv_2d_tiling.h"
#include "data_utils.h"
#include "../op_kernel/depthwise_conv_2d_kernel.asc"

namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<uint64_t> Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string z;while(getline(q,z,','))o.push_back(std::stoull(z));return o;}
uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto v:s)n*=v;return n;}
uint32_t DType(const std::string&s){if(s=="float16")return DEPTHWISE_FP16;if(s=="float32")return DEPTHWISE_FP32;if(s=="bfloat16")return DEPTHWISE_BF16;throw std::invalid_argument("unsupported dtype");}
}
int main(int argc,char**argv){
 if(argc<2){std::cerr<<"usage: depthwise_conv_2d --shape N,C,H,W --weight-shape C,KH,KW --kernel-size KH,KW --stride SH,SW --padding PH,PW --dilation DH,DW --groups C --dtype TYPE --input FILE --weight FILE --bias FILE --output FILE [--device N]\n";return 2;}
 int dev=0;bool init=false,set=false;aclrtStream st=nullptr;void *hx=nullptr,*hw=nullptr,*hb=nullptr,*hy=nullptr,*dx=nullptr,*dw=nullptr,*db=nullptr,*dy=nullptr,*dt=nullptr;
 try{
  auto xshape=Shape(Arg(argc,argv,"--shape")),wshape=Shape(Arg(argc,argv,"--weight-shape")),kernel=Shape(Arg(argc,argv,"--kernel-size")),stride=Shape(Arg(argc,argv,"--stride")),padding=Shape(Arg(argc,argv,"--padding")),dilation=Shape(Arg(argc,argv,"--dilation"));
  uint64_t groups=std::stoull(Arg(argc,argv,"--groups"));uint32_t dtype=DType(Arg(argc,argv,"--dtype"));size_t item=dtype==DEPTHWISE_FP32?4:2;dev=std::stoi(Arg(argc,argv,"--device","0"));
  Check(aclInit(nullptr),"init");init=true;Check(aclrtSetDevice(dev),"set");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");
  auto t=ComputeDepthwiseConv2DTiling(xshape,wshape,kernel,stride,padding,dilation,groups,dtype,cores);size_t xb=Numel(xshape)*item,wb=Numel(wshape)*item,bb=xshape[1]*item,yb=t.outputNumel*item;
  Check(aclrtCreateStream(&st),"stream");
  Check(aclrtMallocHost(&hx,xb),"host x");Check(aclrtMallocHost(&hw,wb),"host weight");Check(aclrtMallocHost(&hb,bb),"host bias");Check(aclrtMallocHost(&hy,yb),"host y");
  Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"device x");Check(aclrtMalloc(&dw,wb,ACL_MEM_MALLOC_HUGE_FIRST),"device weight");Check(aclrtMalloc(&db,bb,ACL_MEM_MALLOC_HUGE_FIRST),"device bias");Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"device y");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");
  if(!ReadFile(Arg(argc,argv,"--input"),hx,xb)||!ReadFile(Arg(argc,argv,"--weight"),hw,wb)||!ReadFile(Arg(argc,argv,"--bias"),hb,bb))throw std::runtime_error("read input file");
  Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d x");Check(aclrtMemcpy(dw,wb,hw,wb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d weight");Check(aclrtMemcpy(db,bb,hb,bb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d bias");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"h2d tiling");
  auto a=std::chrono::steady_clock::now();depthwise_conv_2d_kernel<<<t.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(st),"sync");auto btime=std::chrono::steady_clock::now();
  Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"d2h");if(!WriteFile(Arg(argc,argv,"--output"),hy,yb))throw std::runtime_error("write output");
  std::cout<<"depthwise_conv_2d completed numel="<<t.outputNumel<<" blocks="<<t.blockNum<<" kernel_us="<<std::chrono::duration<double,std::micro>(btime-a).count()<<"\n";
  for(void*p:{dt,dy,db,dw,dx})aclrtFree(p);for(void*p:{hy,hb,hw,hx})aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"depthwise_conv_2d failed: "<<e.what()<<"\n";for(void*p:{dt,dy,db,dw,dx})if(p)aclrtFree(p);for(void*p:{hy,hb,hw,hx})if(p)aclrtFreeHost(p);if(st)aclrtDestroyStream(st);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}
}
