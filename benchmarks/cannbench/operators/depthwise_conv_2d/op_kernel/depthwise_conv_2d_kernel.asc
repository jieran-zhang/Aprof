#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "depthwise_conv_2d_tiling.h"

template<typename T>__aicore__ inline float DepthwiseToFloat(T v){
 if constexpr(std::is_same<T,float>::value)return v;
 uint16_t r=*reinterpret_cast<uint16_t*>(&v);uint32_t bits=0;
 if constexpr(std::is_same<T,bfloat16_t>::value)bits=uint32_t(r)<<16;
 else{uint32_t sign=uint32_t(r&0x8000U)<<16,exp=(r>>10)&31U,m=r&1023U;bits=sign;if(exp==31U){bits|=0x7f800000U|(m<<13);if(m)bits|=0x400000U;}else if(exp)bits|=((exp+112U)<<23)|(m<<13);else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}m&=1023U;bits|=(uint32_t(e+127)<<23)|(m<<13);}}
 return *reinterpret_cast<float*>(&bits);
}
template<typename T>__aicore__ inline float DepthwiseOne(const __gm__ T*x,const __gm__ T*w,const __gm__ T*b,uint64_t linear,const __gm__ DepthwiseConv2DTilingData*t){
 uint64_t s=linear%t->outputSpatial,nc=linear/t->outputSpatial,c=nc%t->c,n=nc/t->c,oh=s/t->outW,ow=s%t->outW;
 float sum=DepthwiseToFloat<T>(b[c]);uint64_t xbase=(n*t->c+c)*t->inputSpatial,wbase=c*t->kernelSpatial;
 for(uint64_t kh=0;kh<t->kH;++kh){int64_t ih=int64_t(oh*t->strideH+kh*t->dilationH)-int64_t(t->padH);if(ih<0||ih>=int64_t(t->inH))continue;
  for(uint64_t kw=0;kw<t->kW;++kw){int64_t iw=int64_t(ow*t->strideW+kw*t->dilationW)-int64_t(t->padW);if(iw>=0&&iw<int64_t(t->inW))sum+=DepthwiseToFloat<T>(x[xbase+uint64_t(ih)*t->inW+uint64_t(iw)])*DepthwiseToFloat<T>(w[wbase+kh*t->kW+kw]);}}
 return sum;
}
template<typename T>class DepthwiseB16 {public:
 __aicore__ inline void Init(GM_ADDR xa,GM_ADDR wa,GM_ADDR ba,GM_ADDR ya,const __gm__ DepthwiseConv2DTilingData*t){t_=t;x_=reinterpret_cast<const __gm__ T*>(xa);w_=reinterpret_cast<const __gm__ T*>(wa);b_=reinterpret_cast<const __gm__ T*>(ba);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ya),t->outputNumel);pipe_.InitBuffer(fp_,K*4);pipe_.InitBuffer(raw_,K*2);}
 __aicore__ inline void Process(){uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->blockLength,end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;auto fp=fp_.Get<float>();auto raw=raw_.Get<T>();for(uint64_t off=begin;off<end;off+=K){uint32_t count=uint32_t(end-off<K?end-off:K);for(uint32_t i=0;i<count;++i)fp.SetValue(i,DepthwiseOne<T>(x_,w_,b_,off+i,t_));AscendC::PipeBarrier<PIPE_ALL>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(raw,fp,mode,count);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,count*2U,0,0,0};AscendC::DataCopyPad(y_[off],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();}}
 private:static constexpr uint32_t K=1024;const __gm__ DepthwiseConv2DTilingData*t_;const __gm__ T*x_;const __gm__ T*w_;const __gm__ T*b_;AscendC::GlobalTensor<T>y_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>fp_,raw_;
};
__aicore__ inline void DepthwiseFloat(GM_ADDR xa,GM_ADDR wa,GM_ADDR ba,GM_ADDR ya,const __gm__ DepthwiseConv2DTilingData*t){const __gm__ float*x=reinterpret_cast<const __gm__ float*>(xa);const __gm__ float*w=reinterpret_cast<const __gm__ float*>(wa);const __gm__ float*b=reinterpret_cast<const __gm__ float*>(ba);__gm__ float*y=reinterpret_cast<__gm__ float*>(ya);uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t->blockLength,end=begin+t->blockLength;if(end>t->outputNumel)end=t->outputNumel;for(uint64_t i=begin;i<end;++i)y[i]=DepthwiseOne<float>(x,w,b,i,t);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void depthwise_conv_2d_kernel(GM_ADDR x,GM_ADDR w,GM_ADDR b,GM_ADDR y,GM_ADDR til){const __gm__ DepthwiseConv2DTilingData*t=reinterpret_cast<const __gm__ DepthwiseConv2DTilingData*>(til);if(t->dtype==DEPTHWISE_FP16){DepthwiseB16<half>op;op.Init(x,w,b,y,t);op.Process();}else if(t->dtype==DEPTHWISE_BF16){DepthwiseB16<bfloat16_t>op;op.Init(x,w,b,y,t);op.Process();}else DepthwiseFloat(x,w,b,y,t);}
