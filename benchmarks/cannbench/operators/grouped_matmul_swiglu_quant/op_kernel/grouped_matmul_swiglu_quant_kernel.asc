#pragma once
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
using namespace AscendC;
using namespace matmul;

class GmsqCubeKernel {
public:
  using AType=MatmulType<TPosition::GM,CubeFormat::ND,int8_t,false>;
  using BType=MatmulType<TPosition::GM,CubeFormat::ND,int8_t,false>;
  using CType=MatmulType<TPosition::GM,CubeFormat::ND,int32_t,false>;
  using BiasType=MatmulType<TPosition::GM,CubeFormat::ND,int32_t,false>;
  MatmulImpl<AType,BType,CType,BiasType> mm;
  GlobalTensor<int8_t>a_,b_;GlobalTensor<int32_t>c_;
  __aicore__ inline void Init(GM_ADDR a,GM_ADDR b,GM_ADDR c,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){a_.SetGlobalBuffer((__gm__ int8_t*)a+ao,ac);b_.SetGlobalBuffer((__gm__ int8_t*)b+bo,bc);c_.SetGlobalBuffer((__gm__ int32_t*)c+co,cc);}
  __aicore__ inline void Process(){mm.SetTensorA(a_);mm.SetTensorB(b_);mm.IterateAll(c_);mm.End();}
};
extern "C" __global__ __aicore__ __attribute__((aic)) void gmsq_cube(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR til,uint64_t ao,uint64_t bo,uint64_t co,uint64_t ac,uint64_t bc,uint64_t cc){
  AscendC::tiling::TCubeTiling t{};const __gm__ int32_t*s=(const __gm__ int32_t*)til;int32_t*d=(int32_t*)&t;for(uint32_t i=0;i<sizeof(t)/4;++i)d[i]=s[i];TPipe p;GmsqCubeKernel op;op.mm.SetSubBlockIdx(0);op.mm.Init(&t,&p);op.Init(a,b,c,ao,bo,co,ac,bc,cc);op.Process();
}
__aicore__ inline int32_t GmsqRoundEven(float v){int32_t n=(int32_t)v;float f=v-(float)n;if(f>0.5f||(f==0.5f&&(n&1)))++n;if(f<-0.5f||(f==-0.5f&&(n&1)))--n;return n;}
extern "C" __global__ __aicore__ __attribute__((aiv)) void gmsq_post(GM_ADDR acc,GM_ADDR ws,GM_ADDR xs,GM_ADDR y,GM_ADDR ys,uint64_t rowStart,uint32_t rows,uint32_t n,uint32_t blockRows){
  const __gm__ int32_t*a=(const __gm__ int32_t*)acc;const __gm__ float*w=(const __gm__ float*)ws;const __gm__ float*x=(const __gm__ float*)xs;__gm__ int8_t*out=(__gm__ int8_t*)y;GlobalTensor<float>scale;scale.SetGlobalBuffer((__gm__ float*)ys);uint32_t h=n/2;uint32_t aligned=((h+7)/8)*8;TPipe p;TBuf<TPosition::VECCALC>lb,rb,sb;p.InitBuffer(lb,aligned*4);p.InitBuffer(rb,aligned*4);p.InitBuffer(sb,32);auto l=lb.Get<float>();auto r=rb.Get<float>();auto sl=sb.Get<float>();uint64_t begin=rowStart+uint64_t(GetBlockIdx())*blockRows,end=begin+blockRows,limit=rowStart+rows;if(end>limit)end=limit;
  for(uint64_t row=begin;row<end;++row){float as=x[row];uint64_t base=row*uint64_t(n);for(uint32_t j=0;j<h;++j){l.SetValue(j,float(a[base+j])*as*w[j]);r.SetValue(j,float(a[base+h+j])*as*w[h+j]);}PipeBarrier<PIPE_ALL>();for(uint32_t j=0;j<h;++j)l.SetValue(j,-l.GetValue(j));PipeBarrier<PIPE_ALL>();Exp(l,l,h);PipeBarrier<PIPE_ALL>();float mx=0.0f;for(uint32_t j=0;j<h;++j){float left=float(a[base+j])*as*w[j];float v=(left/(1.0f+l.GetValue(j)))*r.GetValue(j);l.SetValue(j,v);float av=v<0?-v:v;if(av>mx)mx=av;}float s=mx/127.0f;if(s<1.17549435e-38f)s=1.17549435e-38f;sl.SetValue(0,s);PipeBarrier<PIPE_ALL>();DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(scale[row],sl,cp);for(uint32_t j=0;j<h;++j){int32_t q=GmsqRoundEven(l.GetValue(j)/s);if(q>127)q=127;if(q<-128)q=-128;out[row*uint64_t(h)+j]=(int8_t)q;}}
}
