#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "top_k_tiling.h"

template<typename T> __aicore__ inline bool TopKIsNan(T){return false;}
template<> __aicore__ inline bool TopKIsNan<float>(float v){uint32_t b=*reinterpret_cast<uint32_t*>(&v);return (b&0x7fffffffU)>0x7f800000U;}
template<> __aicore__ inline bool TopKIsNan<half>(half v){uint16_t b=*reinterpret_cast<uint16_t*>(&v);return (b&0x7c00U)==0x7c00U&&(b&0x3ffU);}
template<> __aicore__ inline bool TopKIsNan<bfloat16_t>(bfloat16_t v){uint16_t b=*reinterpret_cast<uint16_t*>(&v);return (b&0x7f80U)==0x7f80U&&(b&0x7fU);}
__aicore__ inline float TopKHalfFloat(half v){uint16_t h=*reinterpret_cast<uint16_t*>(&v);uint32_t sign=static_cast<uint32_t>(h&0x8000U)<<16,exp=(h>>10)&31U,m=h&1023U,b=sign;if(exp==31)b|=0x7f800000U|(m<<13);else if(exp)b|=(exp+112U)<<23|(m<<13);else if(m){int e=-14;while(!(m&1024U)){m<<=1;--e;}b|=static_cast<uint32_t>(e+127)<<23|((m&1023U)<<13);}return *reinterpret_cast<float*>(&b);}
__aicore__ inline float TopKBfloatFloat(bfloat16_t v){uint32_t b=static_cast<uint32_t>(*reinterpret_cast<uint16_t*>(&v))<<16;return *reinterpret_cast<float*>(&b);}
template<typename T> __aicore__ inline bool TopKLess(T a,T b){return a<b;}
template<> __aicore__ inline bool TopKLess<half>(half a,half b){return TopKHalfFloat(a)<TopKHalfFloat(b);}
template<> __aicore__ inline bool TopKLess<bfloat16_t>(bfloat16_t a,bfloat16_t b){return TopKBfloatFloat(a)<TopKBfloatFloat(b);}
template<typename T> __aicore__ inline bool TopKBetter(T a,T b,bool largest){
    const bool an=TopKIsNan<T>(a),bn=TopKIsNan<T>(b);if(an||bn){if(an&&bn)return false;return largest?an:!an;}
    return largest?TopKLess<T>(b,a):TopKLess<T>(a,b);
}
template<typename T> __aicore__ inline bool TopKWorse(T a,T b,bool largest){return TopKBetter<T>(b,a,largest);}

template<typename T> class TopKHeap {
public:
 __aicore__ inline void Init(GM_ADDR input,GM_ADDR values,GM_ADDR indices,const __gm__ TopKTilingData*t){
  t_=t;x_=reinterpret_cast<__gm__ T*>(input);y_=reinterpret_cast<__gm__ T*>(values);idx_=reinterpret_cast<__gm__ int64_t*>(indices);
  pipe_.InitBuffer(valueBuf_,2048*sizeof(T));pipe_.InitBuffer(indexBuf_,2048*sizeof(int64_t));
 }
 __aicore__ inline void SiftDown(AscendC::LocalTensor<T>&hv,AscendC::LocalTensor<int64_t>&hi,uint32_t root,uint32_t n){
  const bool largest=t_->largest;while(true){uint32_t child=root*2+1;if(child>=n)return;
   if(child+1<n&&TopKWorse<T>(hv.GetValue(child+1),hv.GetValue(child),largest))++child;
   if(!TopKWorse<T>(hv.GetValue(child),hv.GetValue(root),largest))return;
   T tv=hv.GetValue(root);int64_t ti=hi.GetValue(root);hv.SetValue(root,hv.GetValue(child));hi.SetValue(root,hi.GetValue(child));hv.SetValue(child,tv);hi.SetValue(child,ti);root=child;}
 }
 __aicore__ inline void Process(){auto hv=valueBuf_.Get<T>();auto hi=indexBuf_.Get<int64_t>();const bool largest=t_->largest;
  uint64_t begin,end;
  if(t_->inner>1&&(t_->inner*sizeof(T))%32!=0){const uint64_t outerPer=(t_->outer+t_->blockNum-1)/t_->blockNum,ob=AscendC::GetBlockIdx()*outerPer,oe=(ob+outerPer<t_->outer?ob+outerPer:t_->outer);begin=ob*t_->inner;end=oe*t_->inner;}
  else{uint64_t per=(t_->sequenceCount+t_->blockNum-1)/t_->blockNum;per=((per+31)/32)*32;begin=AscendC::GetBlockIdx()*per;end=(begin+per<t_->sequenceCount?begin+per:t_->sequenceCount);}
  for(uint64_t seq=begin;seq<end;++seq){uint64_t outer=seq/t_->inner,inner=seq%t_->inner,base=outer*t_->axis*t_->inner+inner;
   for(uint32_t j=0;j<t_->k;++j){hv.SetValue(j,x_[base+static_cast<uint64_t>(j)*t_->inner]);hi.SetValue(j,j);}
   if(t_->k>1)for(int64_t r=static_cast<int64_t>(t_->k)/2-1;r>=0;--r)SiftDown(hv,hi,static_cast<uint32_t>(r),t_->k);
   for(uint64_t a=t_->k;a<t_->axis;++a){T v=x_[base+a*t_->inner];if(TopKBetter<T>(v,hv.GetValue(0),largest)){hv.SetValue(0,v);hi.SetValue(0,a);SiftDown(hv,hi,0,t_->k);}}
   uint64_t outBase=outer*static_cast<uint64_t>(t_->k)*t_->inner+inner;
   for(uint32_t n=t_->k;n>0;--n){y_[outBase+static_cast<uint64_t>(n-1)*t_->inner]=hv.GetValue(0);idx_[outBase+static_cast<uint64_t>(n-1)*t_->inner]=hi.GetValue(0);
    if(n>1){hv.SetValue(0,hv.GetValue(n-1));hi.SetValue(0,hi.GetValue(n-1));SiftDown(hv,hi,0,n-1);}}
  }
 }
private:const __gm__ TopKTilingData*t_;__gm__ T*x_;__gm__ T*y_;__gm__ int64_t*idx_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>valueBuf_,indexBuf_;
};
template<typename T>__aicore__ inline void TopKRun(GM_ADDR x,GM_ADDR y,GM_ADDR i,const __gm__ TopKTilingData*t){TopKHeap<T>op;op.Init(x,y,i,t);op.Process();}
extern "C" __global__ __aicore__ __attribute__((aiv)) void top_k_kernel(GM_ADDR x,GM_ADDR y,GM_ADDR indices,GM_ADDR tiling){
 const __gm__ TopKTilingData*t=reinterpret_cast<const __gm__ TopKTilingData*>(tiling);
 if(t->dtype==TOPK_INT8)TopKRun<int8_t>(x,y,indices,t);else if(t->dtype==TOPK_UINT8)TopKRun<uint8_t>(x,y,indices,t);
 else if(t->dtype==TOPK_INT32)TopKRun<int32_t>(x,y,indices,t);else if(t->dtype==TOPK_INT64)TopKRun<int64_t>(x,y,indices,t);
 else if(t->dtype==TOPK_FLOAT16)TopKRun<half>(x,y,indices,t);else if(t->dtype==TOPK_FLOAT32)TopKRun<float>(x,y,indices,t);else TopKRun<bfloat16_t>(x,y,indices,t);
}
