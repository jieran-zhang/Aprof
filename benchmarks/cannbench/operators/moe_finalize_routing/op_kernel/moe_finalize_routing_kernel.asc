#pragma once
#include <cstdint>
#include <type_traits>
#include "kernel_operator.h"
#include "moe_finalize_routing_tiling.h"

template<typename T> __aicore__ inline float MfrFloat(T v) { return static_cast<float>(v); }
template<> __aicore__ inline float MfrFloat<half>(half v) {
    uint16_t h=*reinterpret_cast<uint16_t*>(&v); uint32_t s=uint32_t(h&0x8000U)<<16,e=(h>>10)&31U,m=h&1023U,b=s;
    if(e==31U){b|=0x7f800000U|(m<<13);if(m)b|=0x400000U;}else if(e)b|=((e+112U)<<23)|(m<<13);
    else if(m){int32_t x=-14;while(!(m&1024U)){m<<=1;--x;}b|=(uint32_t(x+127)<<23)|((m&1023U)<<13);}return *reinterpret_cast<float*>(&b);
}
template<> __aicore__ inline float MfrFloat<bfloat16_t>(bfloat16_t v) {
    uint32_t b=uint32_t(*reinterpret_cast<uint16_t*>(&v))<<16; return *reinterpret_cast<float*>(&b);
}

template<typename T, typename S> class MoeFinalizeKernel {
public:
    __aicore__ inline void Init(GM_ADDR expanded, GM_ADDR mapping, GM_ADDR skip1, GM_ADDR skip2,
        GM_ADDR bias, GM_ADDR scales, GM_ADDR experts, GM_ADDR output, const __gm__ MoeFinalizeTilingData *t) {
        t_=t; expanded_=reinterpret_cast<const __gm__ T*>(expanded); mapping_=reinterpret_cast<const __gm__ int32_t*>(mapping);
        skip1_=reinterpret_cast<const __gm__ T*>(skip1); skip2_=reinterpret_cast<const __gm__ T*>(skip2);
        bias_=reinterpret_cast<const __gm__ T*>(bias); scales_=reinterpret_cast<const __gm__ S*>(scales);
        experts_=reinterpret_cast<const __gm__ int32_t*>(experts); output_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output),t->outputNumel);
        pipe_.InitBuffer(fpBuf_,TILE*sizeof(float)); if constexpr(!std::is_same<T,float>::value)pipe_.InitBuffer(rawBuf_,TILE*sizeof(T));
    }
    __aicore__ inline float One(uint64_t pos) {
        uint64_t row=pos/t_->hidden,col=pos-row*t_->hidden; float out=0.0f;
        if(t_->hasSkip1)out=MfrFloat<T>(skip1_[pos]); if(t_->hasSkip2)out=out+MfrFloat<T>(skip2_[pos]);
        for(uint32_t k=0;k<t_->k;++k){uint64_t mapPos=(t_->dropPadMode<2)?uint64_t(k)*t_->rows+row:row*t_->k+k;
            int32_t src=mapping_[mapPos]; if(src<0||uint64_t(src)>=t_->expandedRows)continue;
            float term=MfrFloat<T>(expanded_[uint64_t(src)*t_->hidden+col]);
            if(t_->hasBias){int32_t e=experts_[row*t_->k+k];if(e>=0&&uint32_t(e)<t_->experts)term=term+MfrFloat<T>(bias_[uint64_t(e)*t_->hidden+col]);}
            float scale=t_->hasScales?MfrFloat<S>(scales_[row*t_->k+k]):1.0f;
            // The golden materializes multiplication before the ordered add.  Volatile prevents
            // the device compiler from contracting these two specified FP32 rounding points.
            volatile float product=scale*term; out=out+product;
        } return out;
    }
    __aicore__ inline void Process() {
        uint64_t begin=uint64_t(AscendC::GetBlockIdx())*t_->blockLength,end=begin+t_->blockLength;if(end>t_->outputNumel)end=t_->outputNumel;
        auto fp=fpBuf_.Get<float>(); for(uint64_t off=begin;off<end;off+=TILE){uint32_t n=uint32_t(end-off<TILE?end-off:TILE);
            for(uint32_t i=0;i<n;++i)fp.SetValue(i,One(off+i)); AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams cp{1,n*uint32_t(sizeof(T)),0,0,0};
            if constexpr(std::is_same<T,float>::value){AscendC::DataCopyPad(output_[off],fp,cp);}else{auto raw=rawBuf_.Get<T>();
                constexpr auto rm=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;
                AscendC::Cast(raw,fp,rm,n);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(output_[off],raw,cp);}
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }
private:
    static constexpr uint32_t TILE=1024; const __gm__ MoeFinalizeTilingData*t_; const __gm__ T *expanded_,*skip1_,*skip2_,*bias_;
    const __gm__ S *scales_; const __gm__ int32_t *mapping_,*experts_; AscendC::GlobalTensor<T> output_; AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fpBuf_,rawBuf_;
};
template<typename T> __aicore__ inline void MfrDispatchScale(GM_ADDR x,GM_ADDR m,GM_ADDR s1,GM_ADDR s2,GM_ADDR b,GM_ADDR s,GM_ADDR e,GM_ADDR y,const __gm__ MoeFinalizeTilingData*t){
    if(t->scaleDtype==MFR_FLOAT32){MoeFinalizeKernel<T,float>o;o.Init(x,m,s1,s2,b,s,e,y,t);o.Process();}
    else if(t->scaleDtype==MFR_BFLOAT16){MoeFinalizeKernel<T,bfloat16_t>o;o.Init(x,m,s1,s2,b,s,e,y,t);o.Process();}
    else {MoeFinalizeKernel<T,half>o;o.Init(x,m,s1,s2,b,s,e,y,t);o.Process();}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void moe_finalize_routing_kernel(GM_ADDR x,GM_ADDR m,GM_ADDR s1,GM_ADDR s2,GM_ADDR b,GM_ADDR s,GM_ADDR e,GM_ADDR y,GM_ADDR ta){
    const __gm__ MoeFinalizeTilingData*t=reinterpret_cast<const __gm__ MoeFinalizeTilingData*>(ta);
    if(t->dtype==MFR_FLOAT32)MfrDispatchScale<float>(x,m,s1,s2,b,s,e,y,t);else if(t->dtype==MFR_BFLOAT16)MfrDispatchScale<bfloat16_t>(x,m,s1,s2,b,s,e,y,t);else MfrDispatchScale<half>(x,m,s1,s2,b,s,e,y,t);
}
