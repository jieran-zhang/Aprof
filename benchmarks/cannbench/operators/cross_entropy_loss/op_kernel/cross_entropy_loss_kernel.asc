#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "cross_entropy_loss_tiling.h"
template<typename T>class KernelCE{public:
 __aicore__ inline void Init(GM_ADDR x,GM_ADDR target,GM_ADDR y,GM_ADDR sums,GM_ADDR counts,const __gm__ CeTiling*t){t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));target_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(target),t_->positions);y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));sums_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sums),t_->positions);counts_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(counts),t_->positions);uint32_t raw=(t_->alignedC+4096)*sizeof(T),fp=t_->alignedC*sizeof(float);pipe_.InitBuffer(rawBuf_,raw);if constexpr(!std::is_same<T,float>::value)pipe_.InitBuffer(fpBuf_,fp);pipe_.InitBuffer(workBuf_,4096);pipe_.InitBuffer(scalarBuf_,32);begin_=static_cast<uint64_t>(AscendC::GetBlockIdx())*t_->posPerBlock;uint64_t r=t_->positions>begin_?t_->positions-begin_:0;num_=r<t_->posPerBlock?r:t_->posPerBlock;}
 __aicore__ inline void Process(){for(uint64_t i=0;i<num_;++i){uint64_t p=begin_+i;int64_t label=target_.GetValue(p);if(label==t_->ignoreIndex){Store(p,0);continue;}Store(p,One(p,label));}}
 __aicore__ inline void ProcessReduce(){if(AscendC::GetBlockIdx()!=0)return;float total=0.0f,valid=0.0f;for(uint64_t p=0;p<t_->positions;++p){int64_t label=target_.GetValue(p);if(label==t_->ignoreIndex)continue;total+=One(p,label);valid+=1.0f;}if(t_->reduction==1)total=valid>0.0f?total/valid:0.0f;Store(0,total);}
private:
 __aicore__ inline void Gather(const AscendC::LocalTensor<T>&dst,uint64_t p){uint64_t innerIdx=p%t_->inner,outer=p/t_->inner;if(t_->inner==1){AscendC::DataCopyExtParams cp{1,static_cast<uint32_t>(t_->C*sizeof(T)),0,0,0};AscendC::DataCopyPad(dst,x_[outer*t_->C],cp,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::PipeBarrier<PIPE_ALL>();return;}constexpr uint32_t lanes=32/sizeof(T),maxBlocks=256;uint64_t group;if(t_->inner>=lanes){group=(innerIdx/lanes)*lanes;if(group+lanes>t_->inner)group=t_->inner-lanes;}else group=0;uint32_t lane=static_cast<uint32_t>(innerIdx-group);auto gathered=dst[t_->alignedC];uint64_t done=0;while(done<t_->C){uint32_t blocks=static_cast<uint32_t>((t_->C-done)<maxBlocks?(t_->C-done):maxBlocks);AscendC::DataCopyExtParams cp{static_cast<uint16_t>(blocks),32,static_cast<uint32_t>((t_->inner-lanes)*sizeof(T)),0,0};AscendC::DataCopyPad(gathered,x_[outer*t_->C*t_->inner+group+done*t_->inner],cp,AscendC::DataCopyPadExtParams<T>{true,0,0,static_cast<T>(0)});AscendC::PipeBarrier<PIPE_ALL>();for(uint32_t b=0;b<blocks;++b)dst.SetValue(done+b,gathered.GetValue(b*lanes+lane));AscendC::PipeBarrier<PIPE_ALL>();done+=blocks;}}
 __aicore__ inline float One(uint64_t p,int64_t label){auto raw=rawBuf_.Get<T>();Gather(raw,p);AscendC::LocalTensor<float>v;if constexpr(std::is_same<T,float>::value)v=raw;else{v=fpBuf_.Get<float>();AscendC::Cast(v,raw,AscendC::RoundMode::CAST_NONE,static_cast<uint32_t>(t_->C));AscendC::PipeBarrier<PIPE_ALL>();}float chosen=v.GetValue(label);auto work=workBuf_.Get<float>();auto scalar=scalarBuf_.Get<float>();const uint32_t n=static_cast<uint32_t>(t_->C);AscendC::ReduceMax(scalar,v,work,n,false);AscendC::PipeBarrier<PIPE_ALL>();float mx=scalar.GetValue(0);AscendC::Adds(v,v,-mx,n);AscendC::PipeBarrier<PIPE_V>();AscendC::Exp(v,v,n);AscendC::PipeBarrier<PIPE_V>();AscendC::ReduceSum(scalar,v,work,n);AscendC::PipeBarrier<PIPE_ALL>();float total=scalar.GetValue(0);AscendC::Duplicate(scalar,total,1);AscendC::PipeBarrier<PIPE_V>();AscendC::Ln(scalar,scalar,1);AscendC::PipeBarrier<PIPE_ALL>();return scalar.GetValue(0)+mx-chosen;}
 __aicore__ inline void Store(uint64_t p,float value){auto scalar=scalarBuf_.Get<float>();scalar.SetValue(0,value);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyExtParams cp{1,static_cast<uint32_t>(sizeof(T)),0,0,0};if constexpr(std::is_same<T,float>::value)AscendC::DataCopyPad(y_[p],scalar,cp);else{auto raw=rawBuf_.Get<T>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(raw,scalar,mode,1);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(y_[p],raw,cp);}}
 AscendC::TPipe pipe_;const __gm__ CeTiling*t_;AscendC::GlobalTensor<T>x_,y_;AscendC::GlobalTensor<int64_t>target_;AscendC::GlobalTensor<float>sums_,counts_;uint64_t begin_,num_;AscendC::TBuf<AscendC::TPosition::VECCALC>rawBuf_,fpBuf_,workBuf_,scalarBuf_;};
template<typename T>__aicore__ inline void Finish(GM_ADDR y,GM_ADDR sums,GM_ADDR counts,const __gm__ CeTiling*t){if(AscendC::GetBlockIdx()!=0)return;AscendC::GlobalTensor<float>s,c;s.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sums),t->positions);c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(counts),t->positions);AscendC::TPipe pipe;AscendC::TBuf<AscendC::TPosition::VECCALC>copyBuf,fpBuf,rawBuf;constexpr uint32_t tile=1024;pipe.InitBuffer(copyBuf,tile*sizeof(float));pipe.InitBuffer(fpBuf,32);if constexpr(!std::is_same<T,float>::value)pipe.InitBuffer(rawBuf,32);auto local=copyBuf.Get<float>();float total=0,n=0;for(uint64_t off=0;off<t->positions;off+=tile){uint32_t len=static_cast<uint32_t>((t->positions-off)<tile?(t->positions-off):tile);AscendC::DataCopyExtParams in{1,static_cast<uint32_t>(len*sizeof(float)),0,0,0};AscendC::DataCopyPad(local,s[off],in,AscendC::DataCopyPadExtParams<float>{true,0,0,0.0f});AscendC::PipeBarrier<PIPE_ALL>();for(uint32_t j=0;j<len;++j)total+=local.GetValue(j);AscendC::DataCopyPad(local,c[off],in,AscendC::DataCopyPadExtParams<float>{true,0,0,0.0f});AscendC::PipeBarrier<PIPE_ALL>();for(uint32_t j=0;j<len;++j)n+=local.GetValue(j);}if(t->reduction==1)total=n>0?total/n:0;auto fp=fpBuf.Get<float>();fp.SetValue(0,total);AscendC::PipeBarrier<PIPE_ALL>();AscendC::GlobalTensor<T>out;out.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y),1);AscendC::DataCopyExtParams cp{1,static_cast<uint32_t>(sizeof(T)),0,0,0};if constexpr(std::is_same<T,float>::value)AscendC::DataCopyPad(out[0],fp,cp);else{auto raw=rawBuf.Get<T>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?AscendC::RoundMode::CAST_ROUND:AscendC::RoundMode::CAST_NONE;AscendC::Cast(raw,fp,mode,1);AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(out[0],raw,cp);}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void cross_entropy_kernel(GM_ADDR x,GM_ADDR target,GM_ADDR y,GM_ADDR sums,GM_ADDR counts,GM_ADDR ta){const __gm__ CeTiling*t=reinterpret_cast<const __gm__ CeTiling*>(ta);if(t->dtype==CE_F16){KernelCE<half>o;o.Init(x,target,y,sums,counts,t);o.Process();}else if(t->dtype==CE_F32){KernelCE<float>o;o.Init(x,target,y,sums,counts,t);o.Process();}else{KernelCE<bfloat16_t>o;o.Init(x,target,y,sums,counts,t);o.Process();}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void cross_entropy_reduce(GM_ADDR x,GM_ADDR target,GM_ADDR y,GM_ADDR sums,GM_ADDR counts,GM_ADDR ta){const __gm__ CeTiling*t=reinterpret_cast<const __gm__ CeTiling*>(ta);if(t->dtype==CE_F16){KernelCE<half>o;o.Init(x,target,y,sums,counts,t);o.ProcessReduce();}else if(t->dtype==CE_F32){KernelCE<float>o;o.Init(x,target,y,sums,counts,t);o.ProcessReduce();}else{KernelCE<bfloat16_t>o;o.Init(x,target,y,sums,counts,t);o.ProcessReduce();}}
extern "C" __global__ __aicore__ __attribute__((aiv)) void cross_entropy_finish(GM_ADDR y,GM_ADDR sums,GM_ADDR counts,GM_ADDR ta){const __gm__ CeTiling*t=reinterpret_cast<const __gm__ CeTiling*>(ta);if(t->dtype==CE_F16)Finish<half>(y,sums,counts,t);else if(t->dtype==CE_F32)Finish<float>(y,sums,counts,t);else Finish<bfloat16_t>(y,sums,counts,t);}
