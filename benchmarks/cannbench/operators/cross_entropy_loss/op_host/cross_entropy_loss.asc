#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "cross_entropy_loss_tiling.h"
#include "../op_kernel/cross_entropy_loss_kernel.asc"
namespace{void C(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+": "+std::to_string(r));}std::string A(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}std::vector<uint64_t>S(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string x;while(std::getline(q,x,','))o.push_back(std::stoull(x));return o;}uint32_t DT(const std::string&s){if(s=="float16")return CE_F16;if(s=="float32")return CE_F32;if(s=="bfloat16")return CE_BF16;throw std::invalid_argument("dtype");}size_t I(uint32_t d){return d==CE_F32?4:2;}}
int main(int argc,char**argv){if(argc<2)return 2;int dev=2;bool init=false,set=false;aclrtStream st=nullptr;void*hx=nullptr,*ht=nullptr,*hy=nullptr,*dx=nullptr,*dt=nullptr,*dy=nullptr,*ds=nullptr,*dc=nullptr,*dtil=nullptr;try{auto sh=S(A(argc,argv,"--shape"));if(sh.size()<2||sh.size()>8)throw std::invalid_argument("rank");uint64_t N=sh[0],Cdim=sh[1],inner=1;for(size_t i=2;i<sh.size();++i)inner*=sh[i];uint32_t dtype=DT(A(argc,argv,"--dtype"));std::string red=A(argc,argv,"--reduction","mean");uint32_t reduction=red=="none"?0:(red=="mean"?1:2);int64_t ignore=std::stoll(A(argc,argv,"--ignore","-100"));size_t item=I(dtype),xb=N*Cdim*inner*item,tb=N*inner*8,yb=(reduction==0?N*inner:1)*item;dev=std::stoi(A(argc,argv,"--device","2"));C(aclInit(nullptr),"init");init=true;C(aclrtSetDevice(dev),"set");set=true;int64_t cores=1;C(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");auto til=ComputeCe(N,Cdim,inner,dtype,reduction,ignore,cores);C(aclrtCreateStream(&st),"stream");auto mh=[&](void**p,size_t n){C(aclrtMallocHost(p,n),"mh");};auto md=[&](void**p,size_t n){C(aclrtMalloc(p,n,ACL_MEM_MALLOC_HUGE_FIRST),"md");};mh(&hx,xb);mh(&ht,tb);mh(&hy,yb);md(&dx,xb);md(&dt,tb);md(&dy,yb);md(&ds,til.positions*4);md(&dc,til.positions*4);md(&dtil,sizeof(til));if(!ReadFile(A(argc,argv,"--input"),hx,xb)||!ReadFile(A(argc,argv,"--target"),ht,tb))throw std::runtime_error("read");C(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"x");C(aclrtMemcpy(dt,tb,ht,tb,ACL_MEMCPY_HOST_TO_DEVICE),"t");C(aclrtMemcpy(dtil,sizeof(til),&til,sizeof(til),ACL_MEMCPY_HOST_TO_DEVICE),"til");if(reduction==0)cross_entropy_kernel<<<til.blockNum,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dt),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(ds),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(dtil));else cross_entropy_reduce<<<1,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dt),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(ds),static_cast<uint8_t*>(dc),static_cast<uint8_t*>(dtil));C(aclrtSynchronizeStream(st),"kernel");C(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"out");if(!WriteFile(A(argc,argv,"--output"),hy,yb))throw std::runtime_error("write");std::cout<<"cross_entropy_loss completed positions="<<til.positions<<" C="<<til.C<<"\n";for(void*p:{dtil,dc,ds,dy,dt,dx})aclrtFree(p);for(void*p:{hy,ht,hx})aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
