#pragma once

#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;
using namespace matmul;

template <typename X, typename Bias, bool TRANSPOSE_WEIGHT>
class GroupedMatmulCubeKernel {
public:
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, X, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, X, TRANSPOSE_WEIGHT>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, X, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, Bias, false>;
    MatmulImpl<AType, BType, CType, BiasType> mm;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y,
                               uint64_t xOffset, uint64_t weightOffset,
                               uint64_t biasOffset, uint64_t yOffset,
                               bool hasBias, uint64_t xCount,
                               uint64_t weightCount, uint64_t yCount)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ X *>(x) + xOffset, xCount);
        weightGm.SetGlobalBuffer(reinterpret_cast<__gm__ X *>(weight) + weightOffset, weightCount);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ X *>(y) + yOffset, yCount);
        hasBias_ = hasBias;
        if (hasBias_) {
            biasGm.SetGlobalBuffer(reinterpret_cast<__gm__ Bias *>(bias) + biasOffset);
        }
    }

    __aicore__ inline void Process()
    {
        mm.SetTensorA(xGm);
        mm.SetTensorB(weightGm, TRANSPOSE_WEIGHT);
        if (hasBias_) {
            mm.SetBias(biasGm);
        }
        mm.IterateAll(yGm);
        mm.End();
    }

private:
    GlobalTensor<X> xGm;
    GlobalTensor<X> weightGm;
    GlobalTensor<Bias> biasGm;
    GlobalTensor<X> yGm;
    bool hasBias_ = false;
};

template <typename X, typename Bias, bool TRANSPOSE_WEIGHT>
__aicore__ inline void RunGroupedMatmul(GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y,
                                        GM_ADDR cubeTiling, uint64_t xOffset,
                                        uint64_t weightOffset, uint64_t biasOffset,
                                        uint64_t yOffset, uint32_t hasBias,
                                        uint64_t xCount, uint64_t weightCount,
                                        uint64_t yCount)
{
    AscendC::tiling::TCubeTiling localTiling{};
    const __gm__ int32_t *srcTiling = reinterpret_cast<const __gm__ int32_t *>(cubeTiling);
    int32_t *dstTiling = reinterpret_cast<int32_t *>(&localTiling);
    for (uint32_t i = 0; i < sizeof(localTiling) / sizeof(int32_t); ++i) {
        dstTiling[i] = srcTiling[i];
    }
    TPipe pipe;
    GroupedMatmulCubeKernel<X, Bias, TRANSPOSE_WEIGHT> op;
    // Direct-launch Cube path: initialise the Matmul object locally.  The
    // framework registration macro is for mixed/KFC scheduling and is not
    // needed for this one-AIC launch.
    op.mm.SetSubBlockIdx(0);
    op.mm.Init(&localTiling, &pipe);
    op.Init(x, weight, bias, y, xOffset, weightOffset, biasOffset, yOffset,
            hasBias != 0, xCount, weightCount, yCount);
    op.Process();
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_fp16(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<half, half, false>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_fp16_transpose(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<half, half, true>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_bf16(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<bfloat16_t, float, false>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_bf16_transpose(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<bfloat16_t, float, true>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_fp32(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<float, float, false>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

extern "C" __global__ __aicore__ __attribute__((aic)) void grouped_matmul_fp32_transpose(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, GM_ADDR cubeTiling,
    uint64_t xOffset, uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint64_t xCount, uint64_t weightCount, uint64_t yCount)
{
    RunGroupedMatmul<float, float, true>(x, weight, bias, y, cubeTiling, xOffset,
        weightOffset, biasOffset, yOffset, hasBias, xCount, weightCount, yCount);
}

__aicore__ inline __attribute__((noinline)) float GroupedMatmulOrderedAdd(float lhs, float rhs)
{
    volatile float rounded = lhs + rhs;
    return rounded;
}

union GmmFloatBits { float f; uint32_t u; };

__aicore__ inline float GmmHalfBitsToFloat(uint16_t h)
{
    uint32_t sign=uint32_t(h&0x8000U)<<16,exp=(h>>10)&31U,m=h&1023U,bits=sign;
    if(exp==31U)bits|=0x7f800000U|(m<<13);
    else if(exp)bits|=(exp+112U)<<23|(m<<13);
    else if(m){int32_t e=-14;while((m&1024U)==0){m<<=1;--e;}bits|=uint32_t(e+127)<<23|((m&1023U)<<13);}
    GmmFloatBits out;out.u=bits;return out.f;
}

__aicore__ inline uint32_t GmmShiftRightJam(uint32_t v, uint32_t dist)
{
    if (dist == 0) return v;
    if (dist < 32) return (v >> dist) | ((v << (32 - dist)) != 0);
    return v != 0;
}

// Integer IEEE-754 binary32 addition.  This prevents the AIV compiler from
// reassociating a long cancellation-sensitive FP32 reduction.
__aicore__ inline __attribute__((noinline)) uint32_t GmmSoftFloatAdd(uint32_t a, uint32_t b)
{
    uint32_t signA=a>>31,signB=b>>31,expA=(a>>23)&255U,expB=(b>>23)&255U;
    uint32_t fracA=a&0x7fffffU,fracB=b&0x7fffffU;
    if(expA==255U){if(fracA)return a|0x00400000U;if(expB==255U&&fracB==0&&signA!=signB)return 0x7fc00000U;return a;}
    if(expB==255U){if(fracB)return b|0x00400000U;return b;}
    uint32_t sigA=fracA|(expA?0x800000U:0U),sigB=fracB|(expB?0x800000U:0U);
    uint32_t eA=expA?expA:1U,eB=expB?expB:1U;
    if(eA<eB||(eA==eB&&sigA<sigB)){uint32_t t;t=a;a=b;b=t;t=signA;signA=signB;signB=t;t=eA;eA=eB;eB=t;t=sigA;sigA=sigB;sigB=t;}
    sigA<<=3;sigB=GmmShiftRightJam(sigB<<3,eA-eB);uint32_t sigZ;uint32_t expZ=eA;
    if(signA==signB){sigZ=sigA+sigB;if(sigZ&0x08000000U){sigZ=GmmShiftRightJam(sigZ,1);++expZ;}}
    else{sigZ=sigA-sigB;if(sigZ==0)return 0;while((sigZ&0x04000000U)==0&&expZ>1U){sigZ<<=1;--expZ;}}
    uint32_t round=sigZ&7U,sig=sigZ>>3;if(round>4U||(round==4U&&(sig&1U)))++sig;
    if(sig&0x01000000U){sig>>=1;++expZ;}
    if(expZ>=255U)return (signA<<31)|0x7f800000U;
    uint32_t outExp=(expZ==1U&&sig<0x800000U)?0U:expZ;
    return (signA<<31)|(outExp<<23)|(sig&0x7fffffU);
}

__aicore__ inline uint16_t GmmFloatBitsToHalf(uint32_t u)
{
    uint16_t sign=uint16_t((u>>16)&0x8000U);uint32_t exp=(u>>23)&255U,frac=u&0x7fffffU;
    if(exp==255U)return uint16_t(sign|(frac?0x7e00U:0x7c00U));
    int32_t he=int32_t(exp)-112;
    if(he>=31)return uint16_t(sign|0x7c00U);
    if(he<=0){
        if(he<-10)return sign;
        uint32_t mant=frac|0x800000U,shift=uint32_t(14-he);uint32_t out=mant>>shift;
        uint32_t rem=mant&((1U<<shift)-1U),half=1U<<(shift-1U);
        if(rem>half||(rem==half&&(out&1U)))++out;
        return uint16_t(sign|out);
    }
    uint32_t outFrac=frac>>13,rem=frac&0x1fffU;
    if(rem>0x1000U||(rem==0x1000U&&(outFrac&1U)))++outFrac;
    if(outFrac==0x400U){outFrac=0;++he;if(he>=31)return uint16_t(sign|0x7c00U);}
    return uint16_t(sign|(uint32_t(he)<<10)|outFrac);
}

__aicore__ inline uint32_t GmmHalfMulToFloatBits(uint16_t a, uint16_t b)
{
    uint32_t sign=uint32_t((a^b)&0x8000U)<<16,ea=(a>>10)&31U,eb=(b>>10)&31U;
    uint32_t fa=a&1023U,fb=b&1023U;
    if(ea==31U||eb==31U){if((ea==31U&&fa)||(eb==31U&&fb))return 0x7fc00000U;if(((a&0x7fffU)==0)||((b&0x7fffU)==0))return 0x7fc00000U;return sign|0x7f800000U;}
    uint32_t sa=fa|(ea?1024U:0U),sb=fb|(eb?1024U:0U);if(sa==0||sb==0)return sign;
    int32_t pa=(ea?int32_t(ea):1)-25,pb=(eb?int32_t(eb):1)-25;uint32_t prod=sa*sb;
    uint32_t pos=0,tmp=prod;while(tmp>1U){tmp>>=1;++pos;}int32_t outExp=pa+pb+int32_t(pos)+127;
    uint32_t sig=prod<<(23U-pos);
    return sign|(uint32_t(outExp)<<23)|(sig&0x7fffffU);
}

template <bool TRANSPOSE_WEIGHT>
__aicore__ inline void RunFp16SensitiveCorrection(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, uint64_t xOffset,
    uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint32_t rows, uint32_t k, uint32_t n, uint32_t launchedBlocks)
{
    const __gm__ half *xPtr = reinterpret_cast<const __gm__ half *>(x) + xOffset;
    const __gm__ half *wPtr = reinterpret_cast<const __gm__ half *>(weight) + weightOffset;
    const __gm__ half *bPtr = reinterpret_cast<const __gm__ half *>(bias) + biasOffset;
    __gm__ half *yPtr = reinterpret_cast<__gm__ half *>(y) + yOffset;
    __gm__ volatile uint16_t *yBits = reinterpret_cast<__gm__ volatile uint16_t *>(y) + yOffset;
    const __gm__ uint16_t *xBits = reinterpret_cast<const __gm__ uint16_t *>(x) + xOffset;
    const __gm__ uint16_t *wBits = reinterpret_cast<const __gm__ uint16_t *>(weight) + weightOffset;
    const __gm__ uint16_t *bBits = reinterpret_cast<const __gm__ uint16_t *>(bias) + biasOffset;
    TPipe correctionPipe;
    TBuf<TPosition::VECCALC> accBuf;
    correctionPipe.InitBuffer(accBuf, 32);
    LocalTensor<float> accTensor = accBuf.Get<float>();
    __ubuf__ volatile float *accPtr = reinterpret_cast<__ubuf__ volatile float *>(accTensor.GetPhyAddr());
    uint64_t total = uint64_t(rows) * n;
    uint64_t logicalBlock=uint64_t(AscendC::GetBlockIdx())*2U+AscendC::GetSubBlockIdx();
    for (uint64_t idx = logicalBlock; idx < total; idx += launchedBlocks) {
        uint16_t currentBits=yBits[idx],absBits=currentBits&0x7fffU;
        // Cube is retained for the dense body.  Recompute only cancellation-
        // sensitive small outputs and the IEEE-half overflow boundary.
        if (!(absBits < 0x4c00U || absBits >= 0x7befU)) continue;
        uint32_t r = idx / n, c = idx - uint64_t(r) * n;
        uint32_t accBits = 0;
        for (uint32_t kk = 0; kk < k; ++kk) {
            uint16_t xb=xBits[uint64_t(r)*k+kk];
            uint16_t wb=wBits[TRANSPOSE_WEIGHT?uint64_t(c)*k+kk:uint64_t(kk)*n+c];
            accBits=GmmSoftFloatAdd(accBits,GmmHalfMulToFloatBits(xb,wb));
        }
        if (hasBias){GmmFloatBits bbits;bbits.f=GmmHalfBitsToFloat(bBits[c]);accBits=GmmSoftFloatAdd(accBits,bbits.u);}
        yBits[idx]=GmmFloatBitsToHalf(accBits);
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void grouped_matmul_fp16_correct(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, uint64_t xOffset,
    uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint32_t rows, uint32_t k, uint32_t n, uint32_t launchedBlocks)
{
    RunFp16SensitiveCorrection<false>(x, weight, bias, y, xOffset, weightOffset,
        biasOffset, yOffset, hasBias, rows, k, n, launchedBlocks);
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void grouped_matmul_fp16_correct_transpose(
    GM_ADDR x, GM_ADDR weight, GM_ADDR bias, GM_ADDR y, uint64_t xOffset,
    uint64_t weightOffset, uint64_t biasOffset, uint64_t yOffset,
    uint32_t hasBias, uint32_t rows, uint32_t k, uint32_t n, uint32_t launchedBlocks)
{
    RunFp16SensitiveCorrection<true>(x, weight, bias, y, xOffset, weightOffset,
        biasOffset, yOffset, hasBias, rows, k, n, launchedBlocks);
}
