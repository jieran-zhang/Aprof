#include <algorithm>
#include <cstdlib>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/grouped_matmul_kernel.asc"

namespace {
void Check(aclError r, const char *what) {
    if (r != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(r));
}
std::string Arg(int n, char **v, const std::string &key, const std::string &fallback = "") {
    for (int i = 1; i + 1 < n; ++i) if (v[i] == key) return v[i + 1];
    return fallback;
}
std::vector<int64_t> Ints(const std::string &s) {
    std::vector<int64_t> out; std::stringstream ss(s); std::string z;
    while (std::getline(ss, z, ',')) if (!z.empty()) out.push_back(std::stoll(z));
    return out;
}
struct TypeInfo {
    size_t item;
    matmul_tiling::DataType tileType;
    bool bf16;
    bool fp32;
};
TypeInfo Type(const std::string &s) {
    if (s == "float16") return {2, matmul_tiling::DataType::DT_FLOAT16, false, false};
    if (s == "bfloat16") return {2, matmul_tiling::DataType::DT_BF16, true, false};
    if (s == "float32") return {4, matmul_tiling::DataType::DT_FLOAT, false, true};
    throw std::invalid_argument("unsupported dtype: " + s);
}
AscendC::tiling::TCubeTiling MakeTiling(int m, int n, int k, const TypeInfo &xType,
                                        const TypeInfo &biasType, bool transpose, bool hasBias) {
    // Ascend910_93 / dav-2201 on-chip capacities. The API computes a safe
    // single-core Cube schedule; one direct kernel launch is issued per group.
    matmul_tiling::PlatformInfo platform{platform_ascendc::SocVersion::ASCEND910B,
        512 * 1024ULL, 128 * 1024ULL, 192 * 1024ULL, 64 * 1024ULL, 64 * 1024ULL};
    matmul_tiling::MatmulApiTiling api(platform);
    using matmul_tiling::TPosition; using matmul_tiling::CubeFormat;
    if (api.SetAType(TPosition::GM, CubeFormat::ND, xType.tileType, false) != 0 ||
        api.SetBType(TPosition::GM, CubeFormat::ND, xType.tileType, transpose) != 0 ||
        api.SetCType(TPosition::GM, CubeFormat::ND, xType.tileType) != 0 ||
        api.SetBiasType(TPosition::GM, CubeFormat::ND, biasType.tileType) != 0 ||
        api.SetShape(m, n, k) != 0 || api.SetOrgShape(m, n, k) != 0 ||
        api.SetBias(hasBias) != 0) {
        throw std::runtime_error("MatmulApiTiling parameter setup failed");
    }
    if (api.SetFixSplit(-1, -1, std::min(k, 128)) != 0) {
        throw std::runtime_error("MatmulApiTiling fixed-K setup failed");
    }
    AscendC::tiling::TCubeTiling out{};
    if (api.GetTiling(out) != 0) throw std::runtime_error("MatmulApiTiling::GetTiling failed");
    if (std::getenv("GMM_DUMP_TILING")) {
        std::cerr << "cube_tiling m=" << m << " n=" << n << " k=" << k
                  << " baseM=" << out.baseM << " baseN=" << out.baseN << " baseK=" << out.baseK
                  << " depthA1=" << out.depthA1 << " depthB1=" << out.depthB1 << "\n";
    }
    return out;
}
}

int main(int argc, char **argv) {
    int device = 0; bool initialized = false, selected = false; aclrtStream stream = nullptr;
    void *hx=nullptr,*hw=nullptr,*hb=nullptr,*hy=nullptr,*dx=nullptr,*dw=nullptr,*db=nullptr,*dy=nullptr,*dt=nullptr;
    try {
        int64_t m=std::stoll(Arg(argc,argv,"--m")), k=std::stoll(Arg(argc,argv,"--k"));
        int64_t n=std::stoll(Arg(argc,argv,"--n")), e=std::stoll(Arg(argc,argv,"--experts"));
        auto ends=Ints(Arg(argc,argv,"--group-list")); int split=std::stoi(Arg(argc,argv,"--split-item","0"));
        bool transpose=std::stoi(Arg(argc,argv,"--transpose-weight","0")) != 0;
        std::string dtypeName=Arg(argc,argv,"--dtype"), biasDtypeName=Arg(argc,argv,"--bias-dtype",dtypeName);
        std::string biasPath=Arg(argc,argv,"--bias","-"); bool hasBias=biasPath!="-" && !biasPath.empty();
        if(m<=0||k<=0||n<=0||e<=0||ends.size()!=size_t(e)||ends.back()!=m||
           !std::is_sorted(ends.begin(),ends.end())||split<0||split>3)
            throw std::invalid_argument("invalid shape/group_list/split_item");
        auto xt=Type(dtypeName), bt=Type(biasDtypeName);
        if (!hasBias) bt=xt;
        if (xt.bf16 && hasBias && !bt.fp32) throw std::invalid_argument("bf16 bias cases require float32 bias");
        if (!xt.bf16 && hasBias && biasDtypeName != dtypeName) throw std::invalid_argument("bias dtype mismatch");
        size_t xb=size_t(m)*k*xt.item, wb=size_t(e)*k*n*xt.item, yb=size_t(m)*n*xt.item;
        size_t bb=hasBias?size_t(e)*n*bt.item:1;
        device=std::stoi(Arg(argc,argv,"--device","0")); Check(aclInit(nullptr),"aclInit");initialized=true;
        Check(aclrtSetDevice(device),"aclrtSetDevice");selected=true;Check(aclrtCreateStream(&stream),"create stream");
        int64_t vectorCores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&vectorCores),"query vector cores");
        if(std::getenv("GMM_DUMP_TILING"))std::cerr<<"vector_cores="<<vectorCores<<"\n";
        Check(aclrtMallocHost(&hx,xb),"host x");Check(aclrtMallocHost(&hw,wb),"host weight");
        Check(aclrtMallocHost(&hy,yb),"host y");if(hasBias)Check(aclrtMallocHost(&hb,bb),"host bias");
        if(!ReadFile(Arg(argc,argv,"--input"),hx,xb)||!ReadFile(Arg(argc,argv,"--weight"),hw,wb)||
           (hasBias&&!ReadFile(biasPath,hb,bb))) throw std::runtime_error("read input file failed");
        Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"device x");
        Check(aclrtMalloc(&dw,wb,ACL_MEM_MALLOC_HUGE_FIRST),"device weight");
        Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"device y");
        Check(aclrtMalloc(&db,bb,ACL_MEM_MALLOC_HUGE_FIRST),"device bias");
        Check(aclrtMalloc(&dt,sizeof(AscendC::tiling::TCubeTiling),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");
        Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D x");
        Check(aclrtMemcpy(dw,wb,hw,wb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D weight");
        if(hasBias)Check(aclrtMemcpy(db,bb,hb,bb,ACL_MEMCPY_HOST_TO_DEVICE),"H2D bias");
        int64_t start=0; int launched=0;
        for(int64_t g=0;g<e;++g){
            int64_t stop=ends[g], gm=stop-start; if(gm==0){start=stop;continue;}
            auto tile=MakeTiling(int(gm),int(n),int(k),xt,bt,transpose,hasBias);
            Check(aclrtMemcpy(dt,sizeof(tile),&tile,sizeof(tile),ACL_MEMCPY_HOST_TO_DEVICE),"H2D tiling");
            uint64_t xo=uint64_t(start)*k, wo=uint64_t(g)*k*n, bo=uint64_t(g)*n, yo=uint64_t(start)*n;
            uint64_t xc=uint64_t(gm)*k,wc=uint64_t(k)*n,yc=uint64_t(gm)*n;
            if(dtypeName=="float16"){
                if(transpose) grouped_matmul_fp16_transpose<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
                else grouped_matmul_fp16<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
            } else if(dtypeName=="bfloat16"){
                if(transpose) grouped_matmul_bf16_transpose<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
                else grouped_matmul_bf16<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
            } else {
                if(transpose) grouped_matmul_fp32_transpose<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
                else grouped_matmul_fp32<<<1,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt),xo,wo,bo,yo,hasBias,xc,wc,yc);
            }
            // Each direct MatmulImpl launch owns the same runtime Cube
            // workspace and tiling buffer.  Serialize groups so neither is
            // reused while the preceding expert is still executing.
            Check(aclrtSynchronizeStream(stream),"group kernel sync");
            if(dtypeName=="float16" && k>=1024 && n>=2048){
                // dav-2201 reports 40 vector subcores, while direct AIV block
                // indices are the 20 parent AI cores (two subcores share one
                // block index). Launch/stride by unique parent indices.
                uint32_t blocks=1;
                uint32_t logicalBlocks=blocks*2U;
                if(transpose) grouped_matmul_fp16_correct_transpose<<<blocks,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),xo,wo,bo,yo,hasBias,uint32_t(gm),uint32_t(k),uint32_t(n),logicalBlocks);
                else grouped_matmul_fp16_correct<<<blocks,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),xo,wo,bo,yo,hasBias,uint32_t(gm),uint32_t(k),uint32_t(n),logicalBlocks);
                Check(aclrtSynchronizeStream(stream),"sensitive correction sync");
            }
            ++launched;start=stop;
        }
        Check(aclrtSynchronizeStream(stream),"kernel sync");Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"D2H y");
        if(!WriteFile(Arg(argc,argv,"--output"),hy,yb))throw std::runtime_error("write output failed");
        std::cout<<"grouped_matmul completed groups="<<e<<" launched_nonempty="<<launched
                 <<" M="<<m<<" K="<<k<<" N="<<n<<" split_item="<<split<<" transpose="<<transpose<<"\n";
        for(void*p:{dt,dy,db,dw,dx})if(p)aclrtFree(p);for(void*p:{hy,hb,hw,hx})if(p)aclrtFreeHost(p);
        aclrtDestroyStream(stream);aclrtResetDevice(device);aclFinalize();return 0;
    } catch(const std::exception &ex) {
        std::cerr<<"grouped_matmul failed: "<<ex.what()<<"\n";
        for(void*p:{dt,dy,db,dw,dx})if(p)aclrtFree(p);for(void*p:{hy,hb,hw,hx})if(p)aclrtFreeHost(p);
        if(stream)aclrtDestroyStream(stream);if(selected)aclrtResetDevice(device);if(initialized)aclFinalize();return 1;
    }
}
