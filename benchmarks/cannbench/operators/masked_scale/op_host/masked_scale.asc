#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "masked_scale_tiling.h"
#include "data_utils.h"
#include "../op_kernel/masked_scale_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return MS_FLOAT16;
    if (s == "float32") return MS_FLOAT32;
    if (s == "bfloat16") return MS_BFLOAT16;
    if (s == "int8") return MS_INT8;
    if (s == "uint8") return MS_UINT8;
    throw std::invalid_argument("unsupported dtype: " + s);
}
size_t ItemSize(uint32_t dtype) {
    return dtype == MS_FLOAT32 ? 4 : (dtype == MS_INT8 || dtype == MS_UINT8 ? 1 : 2);
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: masked_scale --numel N --x-dtype TYPE --mask-dtype TYPE "
                     "--x FILE --mask FILE --output FILE [--scale X] [--device N]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    void *hostX = nullptr, *hostMask = nullptr, *hostOut = nullptr;
    void *devX = nullptr, *devMask = nullptr, *devOut = nullptr, *devTiling = nullptr;
    try {
        const uint64_t n = std::stoull(Arg(argc, argv, "--numel"));
        const uint32_t xDtype = DType(Arg(argc, argv, "--x-dtype"));
        const uint32_t maskDtype = DType(Arg(argc, argv, "--mask-dtype"));
        if (xDtype > MS_BFLOAT16) throw std::invalid_argument("x must be a floating dtype");
        const size_t xBytes = n * ItemSize(xDtype);
        const size_t maskBytes = n * ItemSize(maskDtype);
        const float scale = std::stof(Arg(argc, argv, "--scale", "1"));
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        const auto tiling = ComputeMaskedScaleTiling(n, xDtype, maskDtype, cores, scale);
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        Check(aclrtMallocHost(&hostX, xBytes), "aclrtMallocHost x");
        Check(aclrtMallocHost(&hostMask, maskBytes), "aclrtMallocHost mask");
        Check(aclrtMallocHost(&hostOut, xBytes), "aclrtMallocHost output");
        Check(aclrtMalloc(&devX, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
        Check(aclrtMalloc(&devMask, maskBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc mask");
        Check(aclrtMalloc(&devOut, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc output");
        Check(aclrtMalloc(&devTiling, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");
        if (!ReadFile(Arg(argc, argv, "--x"), hostX, xBytes)) throw std::runtime_error("read x failed");
        if (!ReadFile(Arg(argc, argv, "--mask"), hostMask, maskBytes)) throw std::runtime_error("read mask failed");
        Check(aclrtMemcpy(devX, xBytes, hostX, xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x");
        Check(aclrtMemcpy(devMask, maskBytes, hostMask, maskBytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D mask");
        Check(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
        masked_scale_kernel<<<tiling.blockNum, nullptr, stream>>>(
            static_cast<uint8_t *>(devX), static_cast<uint8_t *>(devMask),
            static_cast<uint8_t *>(devOut), static_cast<uint8_t *>(devTiling));
        Check(aclrtSynchronizeStream(stream), "kernel synchronize");
        Check(aclrtMemcpy(hostOut, xBytes, devOut, xBytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
        if (!WriteFile(Arg(argc, argv, "--output"), hostOut, xBytes)) throw std::runtime_error("write output failed");
        std::cout << "masked_scale_kernel completed: numel=" << n << " blocks=" << tiling.blockNum
                  << " tile=" << tiling.tileElements << "\n";
        aclrtFree(devTiling); aclrtFree(devOut); aclrtFree(devMask); aclrtFree(devX);
        aclrtFreeHost(hostOut); aclrtFreeHost(hostMask); aclrtFreeHost(hostX);
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "masked_scale failed: " << e.what() << "\n";
        if (devTiling) aclrtFree(devTiling); if (devOut) aclrtFree(devOut);
        if (devMask) aclrtFree(devMask); if (devX) aclrtFree(devX);
        if (hostOut) aclrtFreeHost(hostOut); if (hostMask) aclrtFreeHost(hostMask);
        if (hostX) aclrtFreeHost(hostX); if (stream) aclrtDestroyStream(stream);
        aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
