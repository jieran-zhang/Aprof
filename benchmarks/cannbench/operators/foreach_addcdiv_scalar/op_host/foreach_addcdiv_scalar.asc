#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "foreach_addcdiv_scalar_tiling.h"
#include "../op_kernel/foreach_addcdiv_scalar_kernel.asc"

namespace {
void Check(aclError ret, const char *what) {
    if (ret != ACL_SUCCESS) throw std::runtime_error(std::string(what) + " failed: " + std::to_string(ret));
}
std::string Arg(int argc, char **argv, const std::string &name, const std::string &def = "") {
    for (int i = 1; i + 1 < argc; ++i) if (argv[i] == name) return argv[i + 1];
    return def;
}
uint32_t DType(const std::string &s) {
    if (s == "float16") return FOREACH_ADCDIV_FLOAT16;
    if (s == "float32") return FOREACH_ADCDIV_FLOAT32;
    if (s == "bfloat16") return FOREACH_ADCDIV_BFLOAT16;
    throw std::invalid_argument("unsupported dtype: " + s);
}
std::vector<uint64_t> Lengths(const std::string &s) {
    std::vector<uint64_t> out; std::stringstream ss(s); std::string item;
    while (std::getline(ss, item, ',')) out.push_back(std::stoull(item));
    if (out.empty()) throw std::invalid_argument("--lengths must not be empty");
    return out;
}
void ReadExact(std::ifstream &f, void *p, size_t n, const char *what) {
    if (!f.read(reinterpret_cast<char *>(p), n)) throw std::runtime_error(std::string("read ") + what + " failed");
}
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "usage: foreach_addcdiv_scalar --lengths N[,N...] --dtype TYPE --scalar X "
                     "--x1 FILE --x2 FILE --x3 FILE --output FILE [--device 0]\n";
        return 2;
    }
    int device = 0;
    aclrtStream stream = nullptr;
    void *dx1 = nullptr, *dx2 = nullptr, *dx3 = nullptr, *dy = nullptr, *dt = nullptr;
    try {
        const auto lengths = Lengths(Arg(argc, argv, "--lengths"));
        const std::string dtypeName = Arg(argc, argv, "--dtype");
        const uint32_t dtype = DType(dtypeName);
        const size_t elemBytes = dtype == FOREACH_ADCDIV_FLOAT32 ? 4 : 2;
        const float scalar = std::stof(Arg(argc, argv, "--scalar"));
        device = std::stoi(Arg(argc, argv, "--device", "0"));
        std::ifstream f1(Arg(argc, argv, "--x1"), std::ios::binary);
        std::ifstream f2(Arg(argc, argv, "--x2"), std::ios::binary);
        std::ifstream f3(Arg(argc, argv, "--x3"), std::ios::binary);
        std::ofstream fo(Arg(argc, argv, "--output"), std::ios::binary | std::ios::trunc);
        if (!f1 || !f2 || !f3 || !fo) throw std::runtime_error("open TensorList files failed");

        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(device), "aclrtSetDevice");
        int64_t cores = 1;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores), "query vector cores");
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        constexpr uint64_t kChunkElements = 8ULL * 1024 * 1024;
        const size_t maxBytes = static_cast<size_t>(kChunkElements) * elemBytes;
        Check(aclrtMalloc(&dx1, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x1");
        Check(aclrtMalloc(&dx2, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x2");
        Check(aclrtMalloc(&dx3, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x3");
        Check(aclrtMalloc(&dy, maxBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
        Check(aclrtMalloc(&dt, sizeof(ForeachAddcdivTilingData), ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc tiling");

        uint64_t launches = 0;
        for (uint64_t tensorLength : lengths) {
            for (uint64_t off = 0; off < tensorLength; off += kChunkElements) {
                const uint64_t n = std::min<uint64_t>(kChunkElements, tensorLength - off);
                const size_t bytes = static_cast<size_t>(n) * elemBytes;
                std::vector<uint8_t> h1(bytes), h2(bytes), h3(bytes), ho(bytes);
                ReadExact(f1, h1.data(), bytes, "x1");
                ReadExact(f2, h2.data(), bytes, "x2");
                ReadExact(f3, h3.data(), bytes, "x3");
                Check(aclrtMemcpy(dx1, maxBytes, h1.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x1");
                Check(aclrtMemcpy(dx2, maxBytes, h2.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x2");
                Check(aclrtMemcpy(dx3, maxBytes, h3.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "H2D x3");
                const auto tiling = ComputeForeachAddcdivTiling(n, dtype, cores, scalar);
                Check(aclrtMemcpy(dt, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "H2D tiling");
                foreach_addcdiv_scalar_kernel<<<tiling.blockNum, nullptr, stream>>>(
                    static_cast<uint8_t *>(dx1), static_cast<uint8_t *>(dx2),
                    static_cast<uint8_t *>(dx3), static_cast<uint8_t *>(dy), static_cast<uint8_t *>(dt));
                Check(aclrtSynchronizeStream(stream), "kernel synchronize");
                Check(aclrtMemcpy(ho.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "D2H output");
                if (!fo.write(reinterpret_cast<const char *>(ho.data()), bytes)) throw std::runtime_error("write output failed");
                ++launches;
            }
        }
        std::cout << "foreach_addcdiv_scalar completed: tensors=" << lengths.size()
                  << " launches=" << launches << " dtype=" << dtypeName << "\n";
        aclrtFree(dt); aclrtFree(dy); aclrtFree(dx3); aclrtFree(dx2); aclrtFree(dx1);
        aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 0;
    } catch (const std::exception &e) {
        std::cerr << "foreach_addcdiv_scalar failed: " << e.what() << "\n";
        if (dt) aclrtFree(dt); if (dy) aclrtFree(dy); if (dx3) aclrtFree(dx3);
        if (dx2) aclrtFree(dx2); if (dx1) aclrtFree(dx1);
        if (stream) aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
        return 1;
    }
}
