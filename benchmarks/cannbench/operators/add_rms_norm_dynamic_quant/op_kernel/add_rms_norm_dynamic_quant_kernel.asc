#pragma once
#include <type_traits>
#include "kernel_operator.h"
#include "add_rms_norm_dynamic_quant_tiling.h"

template <typename T>
class KernelAddRmsNormDynamicQuant {
public:
    static constexpr uint32_t kTile = 2048;

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR gamma, GM_ADDR y,
                                GM_ADDR xOut, GM_ADDR scaleOut,
                                const __gm__ AddRmsQuantTilingData *t) {
        t_ = t;
        const uint64_t rowBegin = static_cast<uint64_t>(AscendC::GetBlockIdx()) * t_->rowsPerBlock;
        rowBegin_ = rowBegin;
        const uint64_t remain = t_->rows > rowBegin ? t_->rows - rowBegin : 0;
        rowCount_ = remain < t_->rowsPerBlock ? remain : t_->rowsPerBlock;
        const uint64_t numel = t_->rows * t_->hidden;
        x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), numel);
        x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), numel);
        gamma_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(gamma), t_->hidden);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(y), numel);
        xOut_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(xOut), numel);
        scaleOut_ = reinterpret_cast<__gm__ float *>(scaleOut);
        pipe_.InitBuffer(x1Buf_, kTile * sizeof(T));
        pipe_.InitBuffer(x2Buf_, kTile * sizeof(T));
        pipe_.InitBuffer(gammaBuf_, kTile * sizeof(T));
        pipe_.InitBuffer(xOutBuf_, kTile * sizeof(T));
        pipe_.InitBuffer(yQ_, 1, kTile * sizeof(int8_t));
        pipe_.InitBuffer(fp1Buf_, kTile * sizeof(float));
        pipe_.InitBuffer(fp2Buf_, kTile * sizeof(float));
        pipe_.InitBuffer(fp3Buf_, kTile * sizeof(float));
        pipe_.InitBuffer(reduceWorkBuf_, kTile * sizeof(float));
        pipe_.InitBuffer(reduceOutBuf_, 64);
        pipe_.InitBuffer(invBuf_, 32);
    }

    __aicore__ inline void Process() {
        for (uint64_t local = 0; local < rowCount_; ++local) ProcessRow(rowBegin_ + local);
    }

private:
    __aicore__ inline uint32_t TileCount(uint32_t start) const {
        const uint32_t remain = t_->hidden - start;
        return remain < kTile ? remain : kTile;
    }

    __aicore__ inline void LoadPair(uint64_t base, uint32_t start, uint32_t count,
                                    AscendC::LocalTensor<T> a, AscendC::LocalTensor<T> b) {
        AscendC::DataCopyExtParams cp{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(a, x1_[base + start], cp, pad);
        AscendC::DataCopyPad(b, x2_[base + start], cp, pad);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void MakeSum(uint32_t count, AscendC::LocalTensor<T> a,
                                   AscendC::LocalTensor<T> b,
                                   AscendC::LocalTensor<float> sum) {
        auto tmp = fp2Buf_.Get<float>();
        AscendC::Cast(sum, a, AscendC::RoundMode::CAST_NONE, count);
        AscendC::Cast(tmp, b, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(sum, sum, tmp, count);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void LoadGamma(uint32_t start, uint32_t count,
                                     AscendC::LocalTensor<float> gammaFp) {
        auto raw = gammaBuf_.Get<T>();
        AscendC::DataCopyExtParams cp{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(raw, gamma_[start], cp, pad);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Cast(gammaFp, raw, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ProcessRow(uint64_t row) {
        const uint64_t base = row * t_->hidden;
        auto a = x1Buf_.Get<T>();
        auto b = x2Buf_.Get<T>();
        auto sumFp = fp1Buf_.Get<float>();
        auto scratch = reduceWorkBuf_.Get<float>();
        auto reduced = reduceOutBuf_.Get<float>();
        float squareSum = 0.0f;

        // Pass 1: the fused FP32 add supplies both xOut and RMS statistics.
        for (uint32_t start = 0; start < t_->hidden; start += kTile) {
            const uint32_t count = TileCount(start);
            LoadPair(base, start, count, a, b);
            MakeSum(count, a, b, sumFp);
            auto square = fp3Buf_.Get<float>();
            AscendC::Mul(square, sumFp, sumFp, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum<float>(reduced, square, scratch, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_ALL>();
            squareSum += reduced.GetValue(0);

            auto xOutLocal = xOutBuf_.Get<T>();
            constexpr auto castMode = std::is_same<T, bfloat16_t>::value
                ? AscendC::RoundMode::CAST_ROUND : AscendC::RoundMode::CAST_NONE;
            AscendC::Cast(xOutLocal, sumFp, castMode, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::DataCopyExtParams cp{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(xOut_[base + start], xOutLocal, cp);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        const float meanPlusEps = squareSum * t_->invHidden + t_->epsilon;
        auto scalar = reduceOutBuf_.Get<float>();
        auto invTensor = invBuf_.Get<float>();
        AscendC::Duplicate(scalar, meanPlusEps, 1);
        AscendC::Rsqrt(invTensor, scalar, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        float invRms = invTensor.GetValue(0);
        invRms = invRms * (1.5f - 0.5f * meanPlusEps * invRms * invRms);
        invRms = invRms * (1.5f - 0.5f * meanPlusEps * invRms * invRms);

        // Pass 2: find max(abs((x1+x2)*invRms*gamma)) in FP32.
        float absMax = 0.0f;
        bool hasNan = false;
        for (uint32_t start = 0; start < t_->hidden; start += kTile) {
            const uint32_t count = TileCount(start);
            LoadPair(base, start, count, a, b);
            MakeSum(count, a, b, sumFp);
            auto gammaFp = fp3Buf_.Get<float>();
            LoadGamma(start, count, gammaFp);
            AscendC::Muls(sumFp, sumFp, invRms, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(sumFp, sumFp, gammaFp, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Abs(sumFp, sumFp, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceMax(reduced, sumFp, scratch, static_cast<int32_t>(count), false);
            AscendC::PipeBarrier<PIPE_ALL>();
            const float tileMax = reduced.GetValue(0);
            if (tileMax != tileMax) { absMax = tileMax; hasNan = true; }
            else if (!hasNan && tileMax > absMax) absMax = tileMax;
        }
        float clamped = absMax;
        if (!hasNan && clamped < 1.0e-12f) clamped = 1.0e-12f;
        scaleOut_[row] = clamped / 127.0f;
        const float inverseScale = 127.0f / clamped;

        // Pass 3: reconstruct normalized values and quantize on device.
        for (uint32_t start = 0; start < t_->hidden; start += kTile) {
            const uint32_t count = TileCount(start);
            const uint32_t aligned = ((count + 63U) / 64U) * 64U;
            LoadPair(base, start, count, a, b);
            MakeSum(count, a, b, sumFp);
            auto gammaFp = fp3Buf_.Get<float>();
            LoadGamma(start, count, gammaFp);
            AscendC::Muls(sumFp, sumFp, invRms, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(sumFp, sumFp, gammaFp, count);
            AscendC::PipeBarrier<PIPE_V>();
            // Scale while still in FP32. AscendQuant's internal FP16 path can
            // otherwise overflow large finite y_norm before applying scale.
            AscendC::Muls(sumFp, sumFp, inverseScale, count);
            AscendC::PipeBarrier<PIPE_V>();
            auto yLocal = yQ_.AllocTensor<int8_t>();
            AscendC::AscendQuant<float>(yLocal, sumFp, 1.0f, 0.0f, aligned);
            yQ_.EnQue(yLocal);
            yLocal = yQ_.DeQue<int8_t>();
            AscendC::DataCopyExtParams cp{1, count, 0, 0, 0};
            AscendC::DataCopyPad(y_[base + start], yLocal, cp);
            yQ_.FreeTensor(yLocal);
        }
    }

    AscendC::TPipe pipe_;
    const __gm__ AddRmsQuantTilingData *t_;
    uint64_t rowBegin_, rowCount_;
    AscendC::GlobalTensor<T> x1_, x2_, gamma_, xOut_;
    AscendC::GlobalTensor<int8_t> y_;
    __gm__ float *scaleOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> x1Buf_, x2Buf_, gammaBuf_, xOutBuf_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> yQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fp1Buf_, fp2Buf_, fp3Buf_, reduceWorkBuf_, reduceOutBuf_, invBuf_;
};

extern "C" __global__ __aicore__ __vector__ void add_rms_norm_dynamic_quant_kernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR gamma, GM_ADDR y, GM_ADDR xOut,
    GM_ADDR scaleOut, GM_ADDR tilingAddr) {
    const __gm__ AddRmsQuantTilingData *t =
        reinterpret_cast<const __gm__ AddRmsQuantTilingData *>(tilingAddr);
    if (t->dtype == ADD_RMS_QUANT_FLOAT16) {
        KernelAddRmsNormDynamicQuant<half> op;
        op.Init(x1, x2, gamma, y, xOut, scaleOut, t); op.Process();
    } else {
        KernelAddRmsNormDynamicQuant<bfloat16_t> op;
        op.Init(x1, x2, gamma, y, xOut, scaleOut, t); op.Process();
    }
}
