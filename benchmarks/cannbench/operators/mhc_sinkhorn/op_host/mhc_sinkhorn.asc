#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "mhc_sinkhorn_tiling.h"
#include "../op_kernel/mhc_sinkhorn_kernel.asc"
namespace{void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}std::string Arg(int c,char**v,const std::string&n,const std::string&d=""){for(int i=1;i+1<c;++i)if(v[i]==n)return v[i+1];return d;}std::vector<uint64_t>Shape(const std::string&s){std::vector<uint64_t>o;std::stringstream ss(s);std::string z;while(std::getline(ss,z,','))o.push_back(std::stoull(z));return o;}uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto v:s)n*=v;return n;}}
int main(int argc,char**argv){if(argc<2){std::cerr<<"usage: mhc_sinkhorn --shape B,N,N --iter-step N --eps F --input FILE --output FILE [--device N]\n";return 2;}int device=0;bool init=false,set=false;aclrtStream stream=nullptr;void *hx=nullptr,*hy=nullptr,*dx=nullptr,*dy=nullptr,*dt=nullptr;
 try{auto shape=Shape(Arg(argc,argv,"--shape"));device=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"aclInit");init=true;Check(aclrtSetDevice(device),"device");set=true;int64_t cores=1;Check(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");auto t=ComputeMhcSinkhornTiling(shape,std::stoul(Arg(argc,argv,"--iter-step","20")),std::stof(Arg(argc,argv,"--eps","1e-6")),cores);size_t bytes=Numel(shape)*sizeof(float);Check(aclrtCreateStream(&stream),"stream");Check(aclrtMallocHost(&hx,bytes),"host x");Check(aclrtMallocHost(&hy,bytes),"host y");Check(aclrtMalloc(&dx,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device x");Check(aclrtMalloc(&dy,bytes,ACL_MEM_MALLOC_HUGE_FIRST),"device y");Check(aclrtMalloc(&dt,sizeof(t),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");if(!ReadFile(Arg(argc,argv,"--input"),hx,bytes))throw std::runtime_error("read input");Check(aclrtMemcpy(dx,bytes,hx,bytes,ACL_MEMCPY_HOST_TO_DEVICE),"H2D");Check(aclrtMemcpy(dt,sizeof(t),&t,sizeof(t),ACL_MEMCPY_HOST_TO_DEVICE),"tiling");mhc_sinkhorn_kernel<<<t.blockNum,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dy),static_cast<uint8_t*>(dt));Check(aclrtSynchronizeStream(stream),"kernel");Check(aclrtMemcpy(hy,bytes,dy,bytes,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");if(!WriteFile(Arg(argc,argv,"--output"),hy,bytes))throw std::runtime_error("write output");std::cout<<"mhc_sinkhorn_kernel completed: matrices="<<t.batch<<" n="<<t.n<<" blocks="<<t.blockNum<<"\n";for(void*p:{dt,dy,dx})aclrtFree(p);for(void*p:{hy,hx})aclrtFreeHost(p);aclrtDestroyStream(stream);stream=nullptr;aclrtResetDevice(device);set=false;aclFinalize();init=false;return 0;
 }catch(const std::exception&e){std::cerr<<"mhc_sinkhorn failed: "<<e.what()<<"\n";if(dt)aclrtFree(dt);if(dy)aclrtFree(dy);if(dx)aclrtFree(dx);if(hy)aclrtFreeHost(hy);if(hx)aclrtFreeHost(hx);if(stream)aclrtDestroyStream(stream);if(set)aclrtResetDevice(device);if(init)aclFinalize();return 1;}}
