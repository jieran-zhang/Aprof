#pragma once
#include "kernel_operator.h"
#include "mhc_sinkhorn_tiling.h"

class KernelMhcSinkhorn{
public:
 __aicore__ inline void Init(GM_ADDR x,GM_ADDR y,const __gm__ MhcSinkhornTilingData*t){t_=t;x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x),t->batch*t->matrixSize);y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),t->batch*t->matrixSize);pipe_.InitBuffer(matrixBuf_,256*sizeof(float));pipe_.InitBuffer(rawBuf_,256*sizeof(float));}
 __aicore__ inline void Process(){uint64_t begin=static_cast<uint64_t>(AscendC::GetBlockIdx())*t_->blockLength,end=begin+t_->blockLength;if(end>t_->batch)end=t_->batch;for(uint64_t b=begin;b<end;++b)One(b);}
private:
 __aicore__ inline void One(uint64_t batch){auto m=matrixBuf_.Get<float>();auto raw=rawBuf_.Get<float>();uint32_t count=static_cast<uint32_t>(t_->matrixSize);AscendC::DataCopyExtParams cp{1,count*4U,0,0,0};AscendC::DataCopyPad(raw,x_[batch*t_->matrixSize],cp,AscendC::DataCopyPadExtParams<float>{true,0,0,0.0f});AscendC::PipeBarrier<PIPE_ALL>();const uint32_t stride=((t_->n+7U)/8U)*8U;for(uint32_t r=0;r<t_->n;++r)for(uint32_t c=0;c<t_->n;++c)m.SetValue(r*stride+c,raw.GetValue(r*t_->n+c));AscendC::PipeBarrier<PIPE_ALL>();
  // First iteration: stable row softmax plus eps.
  const int32_t width=static_cast<int32_t>(t_->n);for(uint32_t r=0;r<t_->n;++r){uint32_t base=r*stride;float mx=m.GetValue(base);for(uint32_t c=1;c<t_->n;++c){float v=m.GetValue(base+c);if(v>mx)mx=v;}AscendC::Adds(m[base],m[base],-mx,width);AscendC::PipeBarrier<PIPE_V>();AscendC::Exp(m[base],m[base],width);AscendC::PipeBarrier<PIPE_ALL>();float sum=0.0f;for(uint32_t c=0;c<t_->n;++c)sum+=m.GetValue(base+c);for(uint32_t c=0;c<t_->n;++c)m.SetValue(base+c,m.GetValue(base+c)/sum+t_->eps);}
  AscendC::PipeBarrier<PIPE_ALL>();ColNormalize(m,stride);
  for(uint32_t it=1;it<t_->iterStep;++it){RowNormalize(m,stride);ColNormalize(m,stride);}AscendC::PipeBarrier<PIPE_ALL>();for(uint32_t r=0;r<t_->n;++r)for(uint32_t c=0;c<t_->n;++c)raw.SetValue(r*t_->n+c,m.GetValue(r*stride+c));AscendC::PipeBarrier<PIPE_ALL>();AscendC::DataCopyPad(y_[batch*t_->matrixSize],raw,cp);AscendC::PipeBarrier<PIPE_ALL>();
 }
 __aicore__ inline void RowNormalize(const AscendC::LocalTensor<float>&m,uint32_t stride){for(uint32_t r=0;r<t_->n;++r){uint32_t base=r*stride;float sum=0.0f;for(uint32_t c=0;c<t_->n;++c)sum+=m.GetValue(base+c);sum+=t_->eps;for(uint32_t c=0;c<t_->n;++c)m.SetValue(base+c,m.GetValue(base+c)/sum);}AscendC::PipeBarrier<PIPE_ALL>();}
 __aicore__ inline void ColNormalize(const AscendC::LocalTensor<float>&m,uint32_t stride){for(uint32_t c=0;c<t_->n;++c){float sum=0.0f;for(uint32_t r=0;r<t_->n;++r)sum+=m.GetValue(r*stride+c);sum+=t_->eps;for(uint32_t r=0;r<t_->n;++r)m.SetValue(r*stride+c,m.GetValue(r*stride+c)/sum);}AscendC::PipeBarrier<PIPE_ALL>();}
 const __gm__ MhcSinkhornTilingData*t_;AscendC::TPipe pipe_;AscendC::TBuf<AscendC::TPosition::VECCALC>matrixBuf_,rawBuf_;AscendC::GlobalTensor<float>x_,y_;
};
extern "C" __global__ __aicore__ __attribute__((aiv)) void mhc_sinkhorn_kernel(GM_ADDR x,GM_ADDR y,GM_ADDR ta){const __gm__ MhcSinkhornTilingData*t=reinterpret_cast<const __gm__ MhcSinkhornTilingData*>(ta);KernelMhcSinkhorn op;op.Init(x,y,t);op.Process();}
