#pragma once
#include <cstdint>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

using namespace AscendC;
using namespace matmul;

template <typename T>
__aicore__ inline float ConvToFloat(T v)
{
    if constexpr (std::is_same<T, float>::value) return v;
    uint16_t raw = *reinterpret_cast<uint16_t *>(&v); uint32_t bits = 0;
    if constexpr (std::is_same<T, bfloat16_t>::value) bits = uint32_t(raw) << 16;
    else {
        uint32_t sign=uint32_t(raw&0x8000U)<<16, exp=(raw>>10)&31U, mant=raw&1023U; bits=sign;
        if(exp==31U){bits|=0x7f800000U|(mant<<13);if(mant)bits|=0x400000U;}
        else if(exp)bits|=((exp+112U)<<23)|(mant<<13);
        else if(mant){int e=-14;while((mant&1024U)==0){mant<<=1;--e;}mant&=1023U;bits|=(uint32_t(e+127)<<23)|(mant<<13);}
    }
    return *reinterpret_cast<float *>(&bits);
}

template <typename T>
__aicore__ inline T ConvFromFloat(float value)
{
    if constexpr (std::is_same<T, float>::value) return value;
    uint32_t bits=*reinterpret_cast<uint32_t *>(&value); uint16_t raw;
    if constexpr (std::is_same<T,bfloat16_t>::value) {
        uint32_t lsb=(bits>>16)&1U; raw=uint16_t((bits+0x7fffU+lsb)>>16);
    } else {
        uint32_t sign=(bits>>16)&0x8000U, exp=(bits>>23)&255U, mant=bits&0x7fffffU;
        if(exp==255U) raw=uint16_t(sign|0x7c00U|(mant?0x0200U:0U));
        else {
            int32_t he=int32_t(exp)-127+15;
            if(he>=31) raw=uint16_t(sign|0x7c00U);
            else if(he<=0) {
                if(he<-10) raw=uint16_t(sign);
                else {mant|=0x800000U;uint32_t shift=uint32_t(14-he);uint32_t q=mant>>shift,rem=mant&((1U<<shift)-1U),halfway=1U<<(shift-1);if(rem>halfway||(rem==halfway&&(q&1U)))++q;raw=uint16_t(sign|q);}
            } else {uint32_t q=mant>>13,rem=mant&0x1fffU;if(rem>0x1000U||(rem==0x1000U&&(q&1U)))if(++q==0x400U){q=0;if(++he>=31){raw=uint16_t(sign|0x7c00U);return *reinterpret_cast<T *>(&raw);}}raw=uint16_t(sign|(uint32_t(he)<<10)|q);}
        }
    }
    return *reinterpret_cast<T *>(&raw);
}

template <typename T>
__aicore__ inline void Im2Col(GM_ADDR xa, GM_ADDR cola, uint64_t n, uint64_t cin,
    uint64_t h, uint64_t w, uint64_t kh, uint64_t kw, uint64_t oh, uint64_t ow,
    uint64_t sh, uint64_t sw, uint64_t pt, uint64_t pl, uint64_t dh, uint64_t dw,
    uint64_t total, uint64_t blockLength)
{
    constexpr uint32_t TILE=1024;const __gm__ T *x=reinterpret_cast<const __gm__ T *>(xa);GlobalTensor<T>col;col.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(cola),total);TPipe pipe;TBuf<TPosition::VECCALC>buf;pipe.InitBuffer(buf,TILE*sizeof(T));auto raw=buf.Get<T>();
    uint64_t begin=uint64_t(GetBlockIdx())*blockLength,end=begin+blockLength;if(end>total)end=total;
    uint64_t ksize=cin*kh*kw, spatial=oh*ow, inputSpatial=h*w;
    for(uint64_t off=begin;off<end;off+=TILE){uint32_t count=uint32_t(end-off<TILE?end-off:TILE);
      for(uint32_t i=0;i<count;++i){uint64_t linear=off+i;
        uint64_t kval=linear%ksize,m=linear/ksize,s=m%spatial,batch=m/spatial,owv=s%ow,ohv=s/ow;uint64_t kwv=kval%kw,q=kval/kw,khv=q%kh,ci=q/kh;
        int64_t ih=int64_t(ohv*sh+khv*dh)-int64_t(pt),iw=int64_t(owv*sw+kwv*dw)-int64_t(pl);T v{};if(ih>=0&&ih<int64_t(h)&&iw>=0&&iw<int64_t(w))v=x[(batch*cin+ci)*inputSpatial+uint64_t(ih)*w+uint64_t(iw)];raw.SetValue(i,v);
      }
      PipeBarrier<PIPE_ALL>();DataCopyExtParams cp{1,uint32_t(count*sizeof(T)),0,0,0};DataCopyPad(col[off],raw,cp);PipeBarrier<PIPE_ALL>();
    }
}

__aicore__ inline void Im2ColBf16Float(GM_ADDR xa,GM_ADDR cola,uint64_t n,uint64_t cin,uint64_t h,uint64_t w,uint64_t kh,uint64_t kw,uint64_t oh,uint64_t ow,uint64_t sh,uint64_t sw,uint64_t pt,uint64_t pl,uint64_t dh,uint64_t dw,uint64_t total,uint64_t blockLength){
 constexpr uint32_t TILE=1024;const __gm__ bfloat16_t*x=reinterpret_cast<const __gm__ bfloat16_t*>(xa);GlobalTensor<float>col;col.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(cola),total);TPipe pipe;TBuf<TPosition::VECCALC>buf;pipe.InitBuffer(buf,TILE*4);auto fp=buf.Get<float>();uint64_t begin=uint64_t(GetBlockIdx())*blockLength,end=begin+blockLength;if(end>total)end=total;uint64_t ksize=cin*kh*kw,spatial=oh*ow,inputSpatial=h*w;
 for(uint64_t off=begin;off<end;off+=TILE){uint32_t count=uint32_t(end-off<TILE?end-off:TILE);for(uint32_t i=0;i<count;++i){uint64_t linear=off+i,kval=linear%ksize,m=linear/ksize,s=m%spatial,batch=m/spatial,owv=s%ow,ohv=s/ow,kwv=kval%kw,q=kval/kw,khv=q%kh,ci=q/kh;int64_t ih=int64_t(ohv*sh+khv*dh)-int64_t(pt),iw=int64_t(owv*sw+kwv*dw)-int64_t(pl);float v=0;if(ih>=0&&ih<int64_t(h)&&iw>=0&&iw<int64_t(w))v=ConvToFloat<bfloat16_t>(x[(batch*cin+ci)*inputSpatial+uint64_t(ih)*w+uint64_t(iw)]);fp.SetValue(i,v);}PipeBarrier<PIPE_ALL>();DataCopyExtParams cp{1,count*4U,0,0,0};DataCopyPad(col[off],fp,cp);PipeBarrier<PIPE_ALL>();}
}

__aicore__ inline void Bf16WeightFloat(GM_ADDR srca,GM_ADDR dsta,uint64_t total,uint64_t blockLength){
 constexpr uint32_t TILE=1024;const __gm__ bfloat16_t*src=reinterpret_cast<const __gm__ bfloat16_t*>(srca);GlobalTensor<float>dst;dst.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dsta),total);TPipe pipe;TBuf<TPosition::VECCALC>buf;pipe.InitBuffer(buf,TILE*4);auto fp=buf.Get<float>();uint64_t begin=uint64_t(GetBlockIdx())*blockLength,end=begin+blockLength;if(end>total)end=total;
 for(uint64_t off=begin;off<end;off+=TILE){uint32_t count=uint32_t(end-off<TILE?end-off:TILE);for(uint32_t i=0;i<count;++i)fp.SetValue(i,ConvToFloat<bfloat16_t>(src[off+i]));PipeBarrier<PIPE_ALL>();DataCopyExtParams cp{1,count*4U,0,0,0};DataCopyPad(dst[off],fp,cp);PipeBarrier<PIPE_ALL>();}
}

template <typename T>
class ConvMatmulKernel {
public:
    using AType=MatmulType<TPosition::GM,CubeFormat::ND,T,false>;
    using BType=MatmulType<TPosition::GM,CubeFormat::ND,T,true>;
    using CType=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;
    using BiasType=MatmulType<TPosition::GM,CubeFormat::ND,float,false>;
    MatmulImpl<AType,BType,CType,BiasType> mm;
    __aicore__ inline void Run(GM_ADDR col,GM_ADDR weight,GM_ADDR mat,GM_ADDR cubeTiling){
        AscendC::tiling::TCubeTiling t{};const __gm__ int32_t*src=reinterpret_cast<const __gm__ int32_t*>(cubeTiling);int32_t*dst=reinterpret_cast<int32_t*>(&t);
        for(uint32_t i=0;i<sizeof(t)/sizeof(int32_t);++i)dst[i]=src[i];
        TPipe pipe;GlobalTensor<T>a,b;GlobalTensor<float>c;a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(col));b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(weight));c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mat));
        mm.SetSubBlockIdx(0);mm.Init(&t,&pipe);mm.SetTensorA(a);mm.SetTensorB(b,true);mm.IterateAll(c);mm.End();
    }
};

template <typename T>
__aicore__ inline void Postprocess(GM_ADDR mata,GM_ADDR biasa,GM_ADDR ya,uint64_t cout,uint64_t spatial,uint64_t total,uint64_t blockLength){
    constexpr uint32_t TILE=1024;const __gm__ float*mat=reinterpret_cast<const __gm__ float*>(mata);const __gm__ T*bias=reinterpret_cast<const __gm__ T*>(biasa);GlobalTensor<T>y;y.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(ya),total);TPipe pipe;TBuf<TPosition::VECCALC>fpBuf,rawBuf;pipe.InitBuffer(fpBuf,TILE*sizeof(float));auto fp=fpBuf.Get<float>();if constexpr(!std::is_same<T,float>::value)pipe.InitBuffer(rawBuf,TILE*sizeof(T));
    uint64_t begin=uint64_t(GetBlockIdx())*blockLength,end=begin+blockLength;if(end>total)end=total;
    for(uint64_t off=begin;off<end;off+=TILE){uint32_t count=uint32_t(end-off<TILE?end-off:TILE);for(uint32_t i=0;i<count;++i){uint64_t linear=off+i,s=linear%spatial,nc=linear/spatial,c=nc%cout,n=nc/cout;fp.SetValue(i,mat[(n*spatial+s)*cout+c]+ConvToFloat<T>(bias[c]));}PipeBarrier<PIPE_ALL>();
      if constexpr(std::is_same<T,float>::value){DataCopyExtParams cp{1,count*4U,0,0,0};DataCopyPad(y[off],fp,cp);}else{auto raw=rawBuf.Get<T>();constexpr auto mode=std::is_same<T,bfloat16_t>::value?RoundMode::CAST_ROUND:RoundMode::CAST_NONE;Cast(raw,fp,mode,count);PipeBarrier<PIPE_ALL>();DataCopyExtParams cp{1,uint32_t(count*sizeof(T)),0,0,0};DataCopyPad(y[off],raw,cp);}PipeBarrier<PIPE_ALL>();
    }
}

#define CONV_ENTRIES(NAME,TYPE) \
extern "C" __global__ __aicore__ __attribute__((aiv)) void conv_2d_im2col_##NAME(GM_ADDR x,GM_ADDR col,uint64_t n,uint64_t cin,uint64_t h,uint64_t w,uint64_t kh,uint64_t kw,uint64_t oh,uint64_t ow,uint64_t sh,uint64_t sw,uint64_t pt,uint64_t pl,uint64_t dh,uint64_t dw,uint64_t total,uint64_t blockLength){Im2Col<TYPE>(x,col,n,cin,h,w,kh,kw,oh,ow,sh,sw,pt,pl,dh,dw,total,blockLength);} \
extern "C" __global__ __aicore__ __attribute__((aic)) void conv_2d_matmul_##NAME(GM_ADDR col,GM_ADDR weight,GM_ADDR mat,GM_ADDR tiling){ConvMatmulKernel<TYPE> op;op.Run(col,weight,mat,tiling);} \
extern "C" __global__ __aicore__ __attribute__((aiv)) void conv_2d_post_##NAME(GM_ADDR mat,GM_ADDR bias,GM_ADDR y,uint64_t cout,uint64_t spatial,uint64_t total,uint64_t blockLength){Postprocess<TYPE>(mat,bias,y,cout,spatial,total,blockLength);}

CONV_ENTRIES(fp16,half)
CONV_ENTRIES(bf16,bfloat16_t)
CONV_ENTRIES(fp32,float)
#undef CONV_ENTRIES

extern "C" __global__ __aicore__ __attribute__((aiv)) void conv_2d_im2col_bf16_float(GM_ADDR x,GM_ADDR col,uint64_t n,uint64_t cin,uint64_t h,uint64_t w,uint64_t kh,uint64_t kw,uint64_t oh,uint64_t ow,uint64_t sh,uint64_t sw,uint64_t pt,uint64_t pl,uint64_t dh,uint64_t dw,uint64_t total,uint64_t blockLength){Im2ColBf16Float(x,col,n,cin,h,w,kh,kw,oh,ow,sh,sw,pt,pl,dh,dw,total,blockLength);}
extern "C" __global__ __aicore__ __attribute__((aiv)) void conv_2d_weight_bf16_float(GM_ADDR src,GM_ADDR dst,uint64_t total,uint64_t blockLength){Bf16WeightFloat(src,dst,total,blockLength);}

__aicore__ inline uint32_t ConvShiftRightJam(uint32_t value, uint32_t distance)
{
    if (distance == 0) return value;
    if (distance < 32) return (value >> distance) | ((value << (32 - distance)) != 0);
    return value != 0;
}

// Integer IEEE-754 binary32 addition keeps the long cancellation-sensitive
// reduction in source order.  Plain scalar `acc += product` is reassociated by
// the AIV compiler for large K and reproduces the same low-output outliers as
// Cube instead of providing an independent correction candidate.
__aicore__ inline __attribute__((noinline)) uint32_t ConvSoftFloatAdd(uint32_t a, uint32_t b)
{
    uint32_t signA=a>>31,signB=b>>31,expA=(a>>23)&255U,expB=(b>>23)&255U;
    uint32_t fracA=a&0x7fffffU,fracB=b&0x7fffffU;
    if(expA==255U){if(fracA)return a|0x00400000U;if(expB==255U&&fracB==0&&signA!=signB)return 0x7fc00000U;return a;}
    if(expB==255U){if(fracB)return b|0x00400000U;return b;}
    uint32_t sigA=fracA|(expA?0x800000U:0U),sigB=fracB|(expB?0x800000U:0U);
    uint32_t eA=expA?expA:1U,eB=expB?expB:1U;
    if(eA<eB||(eA==eB&&sigA<sigB)){uint32_t t;t=a;a=b;b=t;t=signA;signA=signB;signB=t;t=eA;eA=eB;eB=t;t=sigA;sigA=sigB;sigB=t;}
    sigA<<=3;sigB=ConvShiftRightJam(sigB<<3,eA-eB);uint32_t sigZ;uint32_t expZ=eA;
    if(signA==signB){sigZ=sigA+sigB;if(sigZ&0x08000000U){sigZ=ConvShiftRightJam(sigZ,1);++expZ;}}
    else{sigZ=sigA-sigB;if(sigZ==0)return 0;while((sigZ&0x04000000U)==0&&expZ>1U){sigZ<<=1;--expZ;}}
    uint32_t round=sigZ&7U,sig=sigZ>>3;if(round>4U||(round==4U&&(sig&1U)))++sig;
    if(sig&0x01000000U){sig>>=1;++expZ;}
    if(expZ>=255U)return (signA<<31)|0x7f800000U;
    uint32_t outExp=(expZ==1U&&sig<0x800000U)?0U:expZ;
    return (signA<<31)|(outExp<<23)|(sig&0x7fffffU);
}

__aicore__ inline void CorrectBf16Sensitive(
    GM_ADDR xa, GM_ADDR wa, GM_ADDR biasa, GM_ADDR ya, uint64_t cin,
    uint64_t h, uint64_t w, uint64_t cout, uint64_t kh, uint64_t kw,
    uint64_t oh, uint64_t ow, uint64_t sh, uint64_t sw, uint64_t pt,
    uint64_t pl, uint64_t dh, uint64_t dw, uint64_t total,
    uint32_t launchedLogicalBlocks)
{
    const __gm__ bfloat16_t *x=reinterpret_cast<const __gm__ bfloat16_t *>(xa);
    const __gm__ bfloat16_t *weight=reinterpret_cast<const __gm__ bfloat16_t *>(wa);
    const __gm__ bfloat16_t *bias=reinterpret_cast<const __gm__ bfloat16_t *>(biasa);
    __gm__ volatile uint16_t *yBits=reinterpret_cast<__gm__ volatile uint16_t *>(ya);
    // A direct one-block AIV launch on dav-2201 exposes one parent block index;
    // GetSubBlockIdx() does not provide a second independently scheduled loop.
    uint64_t logicalBlock=uint64_t(GetBlockIdx());
    uint64_t spatial=oh*ow,inputSpatial=h*w,kPlane=kh*kw;
    for(uint64_t idx=logicalBlock;idx<total;idx+=launchedLogicalBlocks){
        uint16_t currentRaw=yBits[idx];
        // 0.0625 is deliberately local: only cancellation-sensitive outputs
        // are recomputed; the dense Cube result remains authoritative elsewhere.
        if((currentRaw&0x7fffU)>=0x3d80U)continue;
        uint64_t s=idx%spatial,nc=idx/spatial,co=nc%cout,batch=nc/cout;
        uint64_t ohv=s/ow,owv=s%ow;uint32_t accBits=0;
        for(uint64_t ci=0;ci<cin;++ci){
            for(uint64_t khv=0;khv<kh;++khv){
                int64_t ih=int64_t(ohv*sh+khv*dh)-int64_t(pt);
                if(ih<0||ih>=int64_t(h))continue;
                for(uint64_t kwv=0;kwv<kw;++kwv){
                    int64_t iw=int64_t(owv*sw+kwv*dw)-int64_t(pl);
                    if(iw<0||iw>=int64_t(w))continue;
                    float xv=ConvToFloat<bfloat16_t>(x[(batch*cin+ci)*inputSpatial+uint64_t(ih)*w+uint64_t(iw)]);
                    float wv=ConvToFloat<bfloat16_t>(weight[(co*cin+ci)*kPlane+khv*kw+kwv]);
                    float product=xv*wv;uint32_t productBits=*reinterpret_cast<uint32_t *>(&product);
                    accBits=ConvSoftFloatAdd(accBits,productBits);
                }
            }
        }
        float bv=ConvToFloat<bfloat16_t>(bias[co]);uint32_t biasBits=*reinterpret_cast<uint32_t *>(&bv);
        accBits=ConvSoftFloatAdd(accBits,biasBits);
        float ordered=*reinterpret_cast<float *>(&accBits);
        // Use the source-order FP32 result for cancellation-sensitive outputs;
        // it is independent of both Cube and the host convolution backend.
        bfloat16_t corrected=ConvFromFloat<bfloat16_t>(ordered);
        yBits[idx]=*reinterpret_cast<uint16_t *>(&corrected);
    }
}

extern "C" __global__ __aicore__ __attribute__((aiv)) void conv_2d_correct_bf16(
    GM_ADDR x,GM_ADDR weight,GM_ADDR bias,GM_ADDR y,uint64_t cin,uint64_t h,uint64_t w,
    uint64_t cout,uint64_t kh,uint64_t kw,uint64_t oh,uint64_t ow,uint64_t sh,uint64_t sw,
    uint64_t pt,uint64_t pl,uint64_t dh,uint64_t dw,uint64_t total,uint32_t launchedLogicalBlocks)
{
    CorrectBf16Sensitive(x,weight,bias,y,cin,h,w,cout,kh,kw,oh,ow,sh,sw,pt,pl,dh,dw,total,launchedLogicalBlocks);
}
