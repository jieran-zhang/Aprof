#include <chrono>
#include <cstdint>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "data_utils.h"
#include "../op_kernel/conv_2d_kernel.asc"

namespace {
void Check(aclError r,const char*w){if(r!=ACL_SUCCESS)throw std::runtime_error(std::string(w)+" failed: "+std::to_string(r));}
std::string Arg(int n,char**v,const std::string&k,const std::string&d=""){for(int i=1;i+1<n;++i)if(v[i]==k)return v[i+1];return d;}
std::vector<uint64_t> ParseShape(const std::string&s){std::vector<uint64_t>o;std::stringstream q(s);std::string z;while(getline(q,z,','))o.push_back(std::stoull(z));return o;}
uint64_t Numel(const std::vector<uint64_t>&s){uint64_t n=1;for(auto v:s)n*=v;return n;}
struct TypeInfo{size_t item;matmul_tiling::DataType tile;};
TypeInfo Type(const std::string&s){if(s=="float16")return{2,matmul_tiling::DataType::DT_FLOAT16};if(s=="bfloat16")return{2,matmul_tiling::DataType::DT_BF16};if(s=="float32")return{4,matmul_tiling::DataType::DT_FLOAT};throw std::invalid_argument("unsupported dtype");}
AscendC::tiling::TCubeTiling MakeTiling(int m,int n,int k,const TypeInfo&t){
 matmul_tiling::PlatformInfo platform{platform_ascendc::SocVersion::ASCEND910B,512*1024ULL,128*1024ULL,192*1024ULL,64*1024ULL,64*1024ULL};matmul_tiling::MatmulApiTiling api(platform);
 using matmul_tiling::TPosition;using matmul_tiling::CubeFormat;
 if(api.SetAType(TPosition::GM,CubeFormat::ND,t.tile,false)!=0||api.SetBType(TPosition::GM,CubeFormat::ND,t.tile,true)!=0||api.SetCType(TPosition::GM,CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT)!=0||api.SetBiasType(TPosition::GM,CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT)!=0||api.SetShape(m,n,k)!=0||api.SetOrgShape(m,n,k)!=0||api.SetBias(false)!=0)throw std::runtime_error("matmul tiling setup");
 AscendC::tiling::TCubeTiling out{};if(api.GetTiling(out)!=0)throw std::runtime_error("matmul tiling failed");return out;
}
}
int main(int argc,char**argv){
 int dev=0;bool init=false,set=false;aclrtStream st=nullptr;void *hx=nullptr,*hw=nullptr,*hb=nullptr,*hy=nullptr,*dx=nullptr,*dw=nullptr,*dwf=nullptr,*db=nullptr,*dy=nullptr,*dcol=nullptr,*dmat=nullptr,*dt=nullptr;
 try{
  auto xs=ParseShape(Arg(argc,argv,"--shape")),ws=ParseShape(Arg(argc,argv,"--weight-shape")),stride=ParseShape(Arg(argc,argv,"--strides")),pads=ParseShape(Arg(argc,argv,"--pads")),dilation=ParseShape(Arg(argc,argv,"--dilations"));if(xs.size()!=4||ws.size()!=4||stride.size()!=2||pads.size()!=4||dilation.size()!=2)throw std::invalid_argument("invalid args");
  uint64_t oh=(xs[2]+pads[0]+pads[1]-dilation[0]*(ws[2]-1)-1)/stride[0]+1,ow=(xs[3]+pads[2]+pads[3]-dilation[1]*(ws[3]-1)-1)/stride[1]+1,m=xs[0]*oh*ow,k=xs[1]*ws[2]*ws[3],nn=ws[0];std::vector<uint64_t>ys{xs[0],nn,oh,ow};
  std::string dtype=Arg(argc,argv,"--dtype");auto ti=Type(dtype),computeTi=dtype=="bfloat16"?Type("float32"):ti;size_t xb=Numel(xs)*ti.item,wb=Numel(ws)*ti.item,bb=nn*ti.item,yb=Numel(ys)*ti.item,colb=m*k*computeTi.item,matb=m*nn*sizeof(float),wfb=Numel(ws)*sizeof(float);
  dev=std::stoi(Arg(argc,argv,"--device","0"));Check(aclInit(nullptr),"init");init=true;Check(aclrtSetDevice(dev),"set");set=true;Check(aclrtCreateStream(&st),"stream");int64_t cores=1;Check(aclrtGetDeviceInfo(dev,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores),"cores");
  Check(aclrtMallocHost(&hx,xb),"host x");Check(aclrtMallocHost(&hw,wb),"host weight");Check(aclrtMallocHost(&hb,bb),"host bias");Check(aclrtMallocHost(&hy,yb),"host y");if(!ReadFile(Arg(argc,argv,"--input"),hx,xb)||!ReadFile(Arg(argc,argv,"--weight"),hw,wb)||!ReadFile(Arg(argc,argv,"--bias"),hb,bb))throw std::runtime_error("read inputs");
  Check(aclrtMalloc(&dx,xb,ACL_MEM_MALLOC_HUGE_FIRST),"device x");Check(aclrtMalloc(&dw,wb,ACL_MEM_MALLOC_HUGE_FIRST),"device weight");if(dtype=="bfloat16")Check(aclrtMalloc(&dwf,wfb,ACL_MEM_MALLOC_HUGE_FIRST),"device fp32 weight");Check(aclrtMalloc(&db,bb,ACL_MEM_MALLOC_HUGE_FIRST),"device bias");Check(aclrtMalloc(&dy,yb,ACL_MEM_MALLOC_HUGE_FIRST),"device y");Check(aclrtMalloc(&dcol,colb,ACL_MEM_MALLOC_HUGE_FIRST),"device im2col");Check(aclrtMalloc(&dmat,matb,ACL_MEM_MALLOC_HUGE_FIRST),"device mat");Check(aclrtMalloc(&dt,sizeof(AscendC::tiling::TCubeTiling),ACL_MEM_MALLOC_HUGE_FIRST),"device tiling");
  Check(aclrtMemcpy(dx,xb,hx,xb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d x");Check(aclrtMemcpy(dw,wb,hw,wb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d weight");Check(aclrtMemcpy(db,bb,hb,bb,ACL_MEMCPY_HOST_TO_DEVICE),"h2d bias");auto tile=MakeTiling(int(m),int(nn),int(k),computeTi);Check(aclrtMemcpy(dt,sizeof(tile),&tile,sizeof(tile),ACL_MEMCPY_HOST_TO_DEVICE),"h2d tiling");
  uint64_t alignElems=32/computeTi.item,colTotal=m*k,colBlock=((colTotal+uint64_t(cores)-1)/uint64_t(cores)+alignElems-1)/alignElems*alignElems,outTotal=Numel(ys),outAlign=32/ti.item,outBlock=((outTotal+uint64_t(cores)-1)/uint64_t(cores)+outAlign-1)/outAlign*outAlign,weightTotal=Numel(ws),weightBlock=((weightTotal+uint64_t(cores)-1)/uint64_t(cores)+7)/8*8;auto begin=std::chrono::steady_clock::now();
  if(dtype=="float16")conv_2d_im2col_fp16<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dcol),xs[0],xs[1],xs[2],xs[3],ws[2],ws[3],oh,ow,stride[0],stride[1],pads[0],pads[2],dilation[0],dilation[1],colTotal,colBlock);
  else if(dtype=="bfloat16"){conv_2d_im2col_bf16_float<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dcol),xs[0],xs[1],xs[2],xs[3],ws[2],ws[3],oh,ow,stride[0],stride[1],pads[0],pads[2],dilation[0],dilation[1],colTotal,colBlock);conv_2d_weight_bf16_float<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dw),static_cast<uint8_t*>(dwf),weightTotal,weightBlock);}
  else conv_2d_im2col_fp32<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dcol),xs[0],xs[1],xs[2],xs[3],ws[2],ws[3],oh,ow,stride[0],stride[1],pads[0],pads[2],dilation[0],dilation[1],colTotal,colBlock);
  Check(aclrtSynchronizeStream(st),"im2col sync");
  std::string dump=Arg(argc,argv,"--dump-col");if(!dump.empty()){void*hc=nullptr;Check(aclrtMallocHost(&hc,colb),"host col debug");Check(aclrtMemcpy(hc,colb,dcol,colb,ACL_MEMCPY_DEVICE_TO_HOST),"d2h col debug");if(!WriteFile(dump,hc,colb))throw std::runtime_error("write col debug");aclrtFreeHost(hc);}
  if(dtype=="float16")conv_2d_matmul_fp16<<<tile.usedCoreNum,nullptr,st>>>(static_cast<uint8_t*>(dcol),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(dt));
  else if(dtype=="bfloat16")conv_2d_matmul_fp32<<<tile.usedCoreNum,nullptr,st>>>(static_cast<uint8_t*>(dcol),static_cast<uint8_t*>(dwf),static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(dt));
  else conv_2d_matmul_fp32<<<tile.usedCoreNum,nullptr,st>>>(static_cast<uint8_t*>(dcol),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(dt));
  Check(aclrtSynchronizeStream(st),"matmul sync");
  if(dtype=="float16")conv_2d_post_fp16<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),nn,oh*ow,outTotal,outBlock);
  else if(dtype=="bfloat16")conv_2d_post_bf16<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),nn,oh*ow,outTotal,outBlock);
  else conv_2d_post_fp32<<<cores,nullptr,st>>>(static_cast<uint8_t*>(dmat),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),nn,oh*ow,outTotal,outBlock);
  if(dtype=="bfloat16"&&k>=2048){
    constexpr uint32_t correctionBlocks=1,logicalBlocks=correctionBlocks;
    conv_2d_correct_bf16<<<correctionBlocks,nullptr,st>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dw),static_cast<uint8_t*>(db),static_cast<uint8_t*>(dy),xs[1],xs[2],xs[3],nn,ws[2],ws[3],oh,ow,stride[0],stride[1],pads[0],pads[2],dilation[0],dilation[1],outTotal,logicalBlocks);
  }
  Check(aclrtSynchronizeStream(st),"kernel sync");auto end=std::chrono::steady_clock::now();Check(aclrtMemcpy(hy,yb,dy,yb,ACL_MEMCPY_DEVICE_TO_HOST),"d2h");if(!WriteFile(Arg(argc,argv,"--output"),hy,yb))throw std::runtime_error("write output");std::cout<<"conv_2d completed numel="<<outTotal<<" im2col_bytes="<<colb<<" cube_cores="<<tile.usedCoreNum<<" kernel_us="<<std::chrono::duration<double,std::micro>(end-begin).count()<<"\n";
  for(void*p:{dt,dmat,dcol,dy,db,dwf,dw,dx})if(p)aclrtFree(p);for(void*p:{hy,hb,hw,hx})aclrtFreeHost(p);aclrtDestroyStream(st);aclrtResetDevice(dev);aclFinalize();return 0;
 }catch(const std::exception&e){std::cerr<<"conv_2d failed: "<<e.what()<<"\n";for(void*p:{dt,dmat,dcol,dy,db,dwf,dw,dx})if(p)aclrtFree(p);for(void*p:{hy,hb,hw,hx})if(p)aclrtFreeHost(p);if(st)aclrtDestroyStream(st);if(set)aclrtResetDevice(dev);if(init)aclFinalize();return 1;}
}
