#include "kernel_operator.h"
#include "aprof_vector_tiling.h"
#include "aprof_variant_config.h"

using namespace AscendC;

namespace {
constexpr uint32_t kFp32BlockElems = 8;
constexpr float kSlope = 1.702f;

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

__aicore__ inline uint32_t AlignUpU32(uint32_t value, uint32_t align)
{
    return ((value + align - 1) / align) * align;
}

__aicore__ inline void LoadTiling(__gm__ uint8_t* tilingGM, AprofVectorTilingData& tiling)
{
    __gm__ AprofVectorTilingData* ptr = reinterpret_cast<__gm__ AprofVectorTilingData*>(tilingGM);
    tiling.inputElements = ptr->inputElements;
    tiling.outputElements = ptr->outputElements;
    tiling.inputStride = ptr->inputStride;
    tiling.outputStride = ptr->outputStride;
    tiling.elemsPerCore = ptr->elemsPerCore;
    tiling.tileLength = ptr->tileLength;
    tiling.tileLengthAligned = ptr->tileLengthAligned;
    tiling.tileNum = ptr->tileNum;
    tiling.tailLength = ptr->tailLength;
    tiling.variantFlags = ptr->variantFlags;
}
} // namespace

// Baseline formula for fast_gelu grad (grad_in = grad_out * d/dx fast_gelu):
//   emx       = exp(-1.702 * x)
//   one_plus  = 1 + emx
//   denom     = one_plus * one_plus
//   numer     = one_plus - emx * (1.702 * x)
//   dydx      = numer / denom
//   dx        = grad * dydx     (grad = x for the benchmark)
//
// Inject (APROF_INJECT_API_RECOMPUTE): recompute exp twice and decompose
// (1+emx)^2 as 1 + 2*emx + emx*emx, blowing up vector op count and GM-independent
// recomputation -> API / algorithm inefficiency.
extern "C" __global__ __vector__ void fast_gelu_grad_kernel(__gm__ uint8_t* inputGM, __gm__ uint8_t* outputGM,
                                                            __gm__ uint8_t* tilingGM)
{
    AprofVectorTilingData tiling;
    LoadTiling(tilingGM, tiling);
    if (tiling.outputElements == 0 || tiling.tileLength == 0 || tiling.tileLengthAligned == 0) {
        return;
    }

    const uint32_t blockIdx = GetBlockIdx();
    const uint32_t coreStart = blockIdx * tiling.elemsPerCore;
    if (coreStart >= tiling.outputElements) {
#if APROF_INJECT_DYNSHAPE
        PipeBarrier<PIPE_ALL>();
#endif
        return;
    }
    const uint32_t coreElems = MinU32(tiling.elemsPerCore, tiling.outputElements - coreStart);

    TPipe pipe;
    TBuf<> aBuf;
    TBuf<> tmpBuf;
    TBuf<> tmp2Buf;
    TBuf<> numerBuf;
    TBuf<> denomBuf;
    TBuf<> outBuf;
    pipe.InitBuffer(aBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(tmpBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(tmp2Buf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(numerBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(denomBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(outBuf, tiling.tileLengthAligned * sizeof(float));

    LocalTensor<float> aLocal = aBuf.Get<float>();
    LocalTensor<float> tmpLocal = tmpBuf.Get<float>();
    LocalTensor<float> tmp2Local = tmp2Buf.Get<float>();
    LocalTensor<float> numerLocal = numerBuf.Get<float>();
    LocalTensor<float> denomLocal = denomBuf.Get<float>();
    LocalTensor<float> outLocal = outBuf.Get<float>();

    GlobalTensor<float> inputGlobal;
    GlobalTensor<float> outputGlobal;
    inputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inputGM), tiling.inputStride);
    outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outputGM), tiling.outputStride);

    for (uint32_t tileIdx = 0; tileIdx < tiling.tileNum; ++tileIdx) {
        const uint32_t localOffset = tileIdx * tiling.tileLength;
        if (localOffset >= coreElems) {
            PipeBarrier<PIPE_ALL>();
            continue;
        }
        const uint32_t curN = MinU32(tiling.tileLength, coreElems - localOffset);
        const uint32_t curAligned = AlignUpU32(curN, kFp32BlockElems);
        const uint32_t outOffset = coreStart + localOffset;
#if APROF_INJECT_SCALAR_LOOP
        // APROF_PATCH_SCALAR_LOOP: redundant scalar loop used only to create scalar-control pressure.
        uint32_t aprofScalarWaste = 0;
        for (uint32_t aprofI = 0; aprofI < 64; ++aprofI) {
            aprofScalarWaste += aprofI + tileIdx;
        }
        if (aprofScalarWaste == 0xFFFFFFFFU) {
            PipeBarrier<PIPE_ALL>();
        }
#endif

        DataCopyParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = curAligned / kFp32BlockElems;
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        DataCopy(aLocal, inputGlobal[outOffset], copyParams);
        PipeBarrier<PIPE_ALL>();

        // emx = exp(-1.702 * x)
        Muls(tmpLocal, aLocal, -kSlope, curN);
        PipeBarrier<PIPE_V>();
        Exp(tmpLocal, tmpLocal, curN);
        PipeBarrier<PIPE_V>();

        // sx = 1.702 * x
        Muls(tmp2Local, aLocal, kSlope, curN);
        PipeBarrier<PIPE_V>();

#if APROF_INJECT_API_RECOMPUTE
        // Recompute exp(-1.702*x) again for the numerator branch (wasted work).
        LocalTensor<float> emx2Local = tmp2Local; // alias slot for second exp result
        Muls(emx2Local, aLocal, -kSlope, curN);
        PipeBarrier<PIPE_V>();
        Exp(emx2Local, emx2Local, curN);
        PipeBarrier<PIPE_V>();
        // denom = 1 + 2*emx + emx*emx  (3 ops instead of one Mul)
        Add(denomLocal, tmpLocal, tmpLocal, curN);               // 2*emx
        PipeBarrier<PIPE_V>();
        Mul(numerLocal, tmpLocal, tmpLocal, curN);               // emx*emx
        PipeBarrier<PIPE_V>();
        Add(denomLocal, denomLocal, numerLocal, curN);           // 2*emx + emx^2
        PipeBarrier<PIPE_V>();
        Adds(denomLocal, denomLocal, 1.0f, curN);                // 1 + 2*emx + emx^2
        PipeBarrier<PIPE_V>();
        // numer = 1 + emx2 - emx2 * sx
        Mul(numerLocal, emx2Local, tmp2Local, curN);             // emx2 * sx
        PipeBarrier<PIPE_V>();
        Sub(numerLocal, emx2Local, numerLocal, curN);            // emx2 - emx2*sx
        PipeBarrier<PIPE_V>();
        Adds(numerLocal, numerLocal, 1.0f, curN);                // 1 + emx2 - emx2*sx
#else
        // one_plus = 1 + emx  (held in denomLocal temporarily)
        Adds(denomLocal, tmpLocal, 1.0f, curN);
        PipeBarrier<PIPE_V>();
        // emx_sx = emx * sx  (in numerLocal)
        Mul(numerLocal, tmpLocal, tmp2Local, curN);
        PipeBarrier<PIPE_V>();
        // numer = one_plus - emx_sx
        Sub(numerLocal, denomLocal, numerLocal, curN);
        PipeBarrier<PIPE_V>();
        // denom = one_plus * one_plus
        Mul(denomLocal, denomLocal, denomLocal, curN);
#endif
        PipeBarrier<PIPE_V>();

        // dydx = numer / denom
        Div(tmpLocal, numerLocal, denomLocal, curN);
        PipeBarrier<PIPE_V>();
        // dx = grad * dydx (grad = x for benchmark)
        Mul(outLocal, aLocal, tmpLocal, curN);

        PipeBarrier<PIPE_ALL>();
        DataCopy(outputGlobal[outOffset], outLocal, copyParams);
    }
}
