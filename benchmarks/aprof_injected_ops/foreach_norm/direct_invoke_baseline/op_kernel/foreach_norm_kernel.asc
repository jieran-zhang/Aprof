#include "kernel_operator.h"
#include "aprof_foreach_tiling.h"
#include "aprof_variant_config.h"

using namespace AscendC;

namespace {
constexpr uint32_t kFp32BlockElems = 8;

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

__aicore__ inline uint32_t AlignUpU32(uint32_t value, uint32_t align)
{
    return ((value + align - 1) / align) * align;
}

__aicore__ inline void LoadTiling(__gm__ uint8_t* tilingGM, AprofForeachTilingData& tiling)
{
    __gm__ AprofForeachTilingData* ptr = reinterpret_cast<__gm__ AprofForeachTilingData*>(tilingGM);
    tiling.numTensors = ptr->numTensors;
    tiling.tensorLength = ptr->tensorLength;
    tiling.tileLength = ptr->tileLength;
    tiling.tileLengthAligned = ptr->tileLengthAligned;
    tiling.tensorsPerCore = ptr->tensorsPerCore;
    tiling.inputStride = ptr->inputStride;
    tiling.outputStride = ptr->outputStride;
    tiling.blockdim = ptr->blockdim;
    tiling.variantFlags = ptr->variantFlags;
}
} // namespace

// foreach_norm: for each tensor in the input list, compute L2 norm.
//   out[i] = sqrt(sum_j x[i*tensorLength + j]^2)
//
// feature toggle block
//   APROF_FEATURE_02: between processing each tensor, reload its first tile
//                           from GM a second time into a throwaway buffer, doubling
//                           GM->UB traffic (data move bottleneck).
extern "C" __global__ __vector__ void foreach_norm_kernel(__gm__ uint8_t* inputGM, __gm__ uint8_t* outputGM,
                                                          __gm__ uint8_t* tilingGM)
{
    AprofForeachTilingData tiling;
    LoadTiling(tilingGM, tiling);
    if (tiling.numTensors == 0 || tiling.tensorLength == 0 || tiling.tileLength == 0 ||
        tiling.tileLengthAligned == 0) {
        return;
    }

    const uint32_t blockIdx = GetBlockIdx();
    const uint32_t tensorStart = blockIdx * tiling.tensorsPerCore;
    if (tensorStart >= tiling.numTensors) {
        return;
    }
    const uint32_t coreTensors = MinU32(tiling.tensorsPerCore, tiling.numTensors - tensorStart);

    TPipe pipe;
    TBuf<> aBuf;
    TBuf<> tmpBuf;
    TBuf<> workBuf;
    TBuf<> sumBuf;
    TBuf<> accBuf;
    TBuf<> trashBuf;
    pipe.InitBuffer(aBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(tmpBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(workBuf, tiling.tileLengthAligned * sizeof(float));
    pipe.InitBuffer(sumBuf, kFp32BlockElems * sizeof(float));
    pipe.InitBuffer(accBuf, kFp32BlockElems * sizeof(float));
    pipe.InitBuffer(trashBuf, tiling.tileLengthAligned * sizeof(float));

    LocalTensor<float> aLocal = aBuf.Get<float>();
    LocalTensor<float> tmpLocal = tmpBuf.Get<float>();
    LocalTensor<float> workLocal = workBuf.Get<float>();
    LocalTensor<float> sumLocal = sumBuf.Get<float>();
    LocalTensor<float> accLocal = accBuf.Get<float>();
    LocalTensor<float> trashLocal = trashBuf.Get<float>();

    GlobalTensor<float> inputGlobal;
    GlobalTensor<float> outputGlobal;
    inputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inputGM), tiling.inputStride);
    outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outputGM), tiling.outputStride);

    DataCopyParams copyParams;
    copyParams.blockCount = 1;
    copyParams.srcStride = 0;
    copyParams.dstStride = 0;

    for (uint32_t t = 0; t < coreTensors; ++t) {
        const uint32_t tensorIdx = tensorStart + t;
        const uint32_t inBase = tensorIdx * tiling.tensorLength;
        const uint32_t numTiles = (tiling.tensorLength + tiling.tileLength - 1) / tiling.tileLength;

        Duplicate<float>(accLocal, 0.0f, kFp32BlockElems);
        PipeBarrier<PIPE_V>();

        for (uint32_t tileIdx = 0; tileIdx < numTiles; ++tileIdx) {
            const uint32_t localOffset = tileIdx * tiling.tileLength;
            const uint32_t curN = MinU32(tiling.tileLength, tiling.tensorLength - localOffset);
            const uint32_t curAligned = AlignUpU32(curN, kFp32BlockElems);
            copyParams.blockLen = curAligned / kFp32BlockElems;

            DataCopy(aLocal, inputGlobal[inBase + localOffset], copyParams);
            PipeBarrier<PIPE_ALL>();

#if APROF_FEATURE_02
            // Spurious reload of the same tile into a throwaway buffer: doubles GM->UB
            // traffic per tile and competes for MTE2 bandwidth.
            DataCopy(trashLocal, inputGlobal[inBase + localOffset], copyParams);
            PipeBarrier<PIPE_ALL>();
#endif

            // tmp = a * a
            Mul(tmpLocal, aLocal, aLocal, curN);
            PipeBarrier<PIPE_V>();

            // tileSum = sum(tmp)
            ReduceSum<float>(sumLocal, tmpLocal, workLocal, curN);
            PipeBarrier<PIPE_V>();

            // acc += tileSum
            Add(accLocal, accLocal, sumLocal, kFp32BlockElems);
            PipeBarrier<PIPE_V>();
        }

        // out = sqrt(acc)
        Sqrt(accLocal, accLocal, kFp32BlockElems);
        PipeBarrier<PIPE_V>();
        DataCopyParams outParams;
        outParams.blockCount = 1;
        outParams.blockLen = 1;
        outParams.srcStride = 0;
        outParams.dstStride = 0;
        DataCopy(outputGlobal[tensorIdx], accLocal, outParams);
        PipeBarrier<PIPE_ALL>();
    }
}
