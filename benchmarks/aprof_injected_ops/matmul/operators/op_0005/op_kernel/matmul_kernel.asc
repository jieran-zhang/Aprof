#include "kernel_operator.h"
#include "aprof_matmul_tiling.h"
#include "aprof_variant_config.h"

using namespace AscendC;

namespace {
constexpr uint32_t kFp32BlockElems = 8;

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

__aicore__ inline uint32_t AlignUpU32(uint32_t value, uint32_t align)
{
    return ((value + align - 1) / align) * align;
}

__aicore__ inline void LoadTiling(__gm__ uint8_t* tilingGM, AprofMatmulTilingData& tiling)
{
    __gm__ AprofMatmulTilingData* ptr = reinterpret_cast<__gm__ AprofMatmulTilingData*>(tilingGM);
    tiling.m = ptr->m;
    tiling.n = ptr->n;
    tiling.k = ptr->k;
    tiling.tileM = ptr->tileM;
    tiling.tileMAligned = ptr->tileMAligned;
    tiling.tileN = ptr->tileN;
    tiling.tileNAligned = ptr->tileNAligned;
    tiling.rowsPerCore = ptr->rowsPerCore;
    tiling.inputStride = ptr->inputStride;
    tiling.outputStride = ptr->outputStride;
    tiling.blockdim = ptr->blockdim;
    tiling.variantFlags = ptr->variantFlags;
}
} // namespace

// Simplified tiled GEMM (C[M,N] = A[M,K] * B[K,N]) using Vector Mul + Add (not Cube).
// Input layout: inputGM = [A (m*k floats, row-major)] ++ [B (k*n floats, row-major)].
// Output layout: outputGM = C (m*n floats, row-major).
//
// Each core handles rowsPerCore rows of C. The tile loop walks output tiles
// [1 row x tileN cols] and contains the anchor patterns for skill auto-patch.
extern "C" __global__ __vector__ void matmul_kernel(__gm__ uint8_t* inputGM, __gm__ uint8_t* outputGM,
                                                     __gm__ uint8_t* tilingGM)
{
    AprofMatmulTilingData tiling;
    LoadTiling(tilingGM, tiling);
    if (tiling.m == 0 || tiling.n == 0 || tiling.k == 0 ||
        tiling.tileN == 0 || tiling.tileNAligned == 0) {
        return;
    }

    const uint32_t blockIdx = GetBlockIdx();
    const uint32_t rowStart = blockIdx * tiling.rowsPerCore;
    if (rowStart >= tiling.m) {
        return;
    }
    const uint32_t coreRows = MinU32(tiling.rowsPerCore, tiling.m - rowStart);
    const uint32_t coreStart = rowStart * tiling.n; // C element offset for this core's first row

    TPipe pipe;
    TBuf<> aBuf;
    TBuf<> bBuf;
    TBuf<> accBuf;
    TBuf<> outBuf;
    pipe.InitBuffer(aBuf, tiling.tileNAligned * sizeof(float));
    pipe.InitBuffer(bBuf, tiling.tileNAligned * sizeof(float));
    pipe.InitBuffer(accBuf, tiling.tileNAligned * sizeof(float));
    pipe.InitBuffer(outBuf, tiling.tileNAligned * sizeof(float));

    LocalTensor<float> aLocal = aBuf.Get<float>();
    LocalTensor<float> bLocal = bBuf.Get<float>();
    LocalTensor<float> accLocal = accBuf.Get<float>();
    LocalTensor<float> outLocal = outBuf.Get<float>();

    GlobalTensor<float> inputGlobal;
    GlobalTensor<float> outputGlobal;
    inputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inputGM), tiling.inputStride);
    outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outputGM), tiling.outputStride);

    const uint32_t aElems = tiling.m * tiling.k;     // B region starts here in the input buffer
    const uint32_t tilesPerRow = (tiling.n + tiling.tileN - 1) / tiling.tileN;
    const uint32_t totalTiles = coreRows * tilesPerRow;

    DataCopyParams copyParams;
    copyParams.blockCount = 1;
    copyParams.srcStride = 0;
    copyParams.dstStride = 0;

    for (uint32_t tileIdx = 0; tileIdx < totalTiles; ++tileIdx) {
        const uint32_t rowInCore = tileIdx / tilesPerRow;
        const uint32_t colTile = tileIdx % tilesPerRow;
        const uint32_t row = rowStart + rowInCore;
        const uint32_t colStart = colTile * tiling.tileN;
        const uint32_t curN = MinU32(tiling.tileN, tiling.n - colStart);
        const uint32_t curAligned = AlignUpU32(curN, kFp32BlockElems);
        const uint32_t localOffset = rowInCore * tiling.n + colStart;
        const uint32_t outOffset = coreStart + localOffset;

        copyParams.blockLen = curAligned / kFp32BlockElems;

        DataCopy(aLocal, inputGlobal[outOffset], copyParams);
        PipeBarrier<PIPE_ALL>();

        // Load B[row, colStart..colStart+curN] segment for the K-reduction step.
        DataCopy(bLocal, inputGlobal[aElems + row * tiling.n + colStart], copyParams);
        PipeBarrier<PIPE_ALL>();

        // acc = 0
        Duplicate<float>(outLocal, 0.0f, curAligned);
        PipeBarrier<PIPE_V>();

        // Simplified MAC: outLocal += aLocal * bLocal (Vector Mul + Add, not Cube).
        Mul(accLocal, aLocal, bLocal, curN);
        PipeBarrier<PIPE_V>();
        Add(outLocal, outLocal, accLocal, curN);
        PipeBarrier<PIPE_V>();

        DataCopy(outputGlobal[outOffset], outLocal, copyParams);
    }
}
